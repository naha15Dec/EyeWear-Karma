@using BanGiay.Models;
@model BanGiay.ViewModel.PostVM
@{
    ViewBag.Title = "Thêm bài viết";
    var login = Session["LoginInformation"] as taiKhoanThanhVien;
    string acc = login != null ? login.taiKhoan : "";
}

<div class="content-wrapper">
    <section class="content-header">
        <div class="container-fluid">
            <div class="row mb-2">
                <div class="col-sm-6">
                    <h1>Thêm bài viết</h1>
                </div>
                <div class="col-sm-6">
                    <ol class="breadcrumb float-sm-right">
                        <li class="breadcrumb-item"><a href='@Url.Action("Index","Dashboard")'>Dashboard</a></li>
                        <li class="breadcrumb-item active">Thêm bài viết</li>
                    </ol>
                </div>
            </div>
        </div>
    </section>

    <div class="container-fluid ">
        @using (Html.BeginForm("AddBlog", "ListBlog", FormMethod.Post, new { enctype = "multipart/form-data" }))
        {
            @Html.AntiForgeryToken()
            <div class="row">
                <div class="col-md-6">
                    <div class="card card-success">
                        <div class="card-header">
                            <h3 class="card-title">Thông tin chính</h3>
                        </div>
                        <div class="card-body">
                            <div class="form-group">
                                <label for="tsp">Tên bài viết</label>
                                @Html.TextBoxFor(m => m.NamePost, new { @class = "form-control", placeholder = "Tên bài viết dưới 50 ký tự" })
                                @Html.ValidationMessageFor(m => m.NamePost, "", new { @class = "text-danger" })
                            </div>
                            <div class="form-group">
                                <label for="ndtt">Nội dung tóm tắt</label>
                                @Html.TextAreaFor(m => m.SummaryContent, new { @class = "form-control", placeholder = "Nội dung tóm tắt ..." })
                                @Html.ValidationMessageFor(m => m.SummaryContent, "", new { @class = "text-danger" })
                            </div>
                            <div class="form-group">
                                <div class="row">
                                    <div class="col-md-6">
                                        <label for="ngaydang">Ngày đăng</label>
                                        @Html.TextBoxFor(
                                            m => m.DatePost,
                                            "{0:dd/MM/yyyy HH:mm}",
                                            new { @class = "form-control", @readonly = "readonly" }
                                        )
                                    </div>
                                    <div class="col-md-6">
                                        <label for="taikhoan">Tài khoản</label>
                                        @Html.TextBoxFor(
                                            m => m.Account,
                                            new { @class = "form-control", @readonly = "readonly", Value = acc }
                                        )
                                    </div>
                                </div>
                            </div>
                            <div class="form-group">
                                <div class="row">
                                    <div class="col-md-6">
                                        @* Giá trị thật để submit về server *@
                                        @Html.HiddenFor(m => m.View)
                                    </div>
                                    <div class="col-md-6">
                                        <label for="solandoc">Số lần đọc</label>
                                        @Html.TextBox("ViewDisplay", Model.View, new { @class = "form-control", @readonly = "readonly" })
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="card card-secondary">
                        <div class="card-header">
                            <h3 class="card-title">Hình đại diện cho bài viết</h3>
                        </div>
                        <div id="imagePreviewSingle" style="min-height:300px; min-width:300px;" class="m-auto"></div>
                        <div class="card-body">
                            <div class="input-group">
                                <div class="custom-file">
                                    <input type="file" class="custom-file-input" id="inputSingleFile" name="imageAvatar">
                                    <label class="custom-file-label" for="inputSingleFile">Chọn ảnh đại diện</label>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-12">
                    <div class="card card-primary">
                        <div class="card-header">
                            <h3 class="card-title">Giới thiệu chi tiết về sản phẩm</h3>
                        </div>
                        <div class="card-body">
                            @Html.TextAreaFor(
                                m => m.Content,
                                new
                                {
                                    @class = "textarea",
                                    placeholder = "Nội dung bài viết ...",
                                    id = "ndbv",
                                    style = "width: 100%; height: 600px;"
                                })
                            @Html.ValidationMessageFor(m => m.Content, "", new { @class = "text-danger" })
                        </div>
                    </div>

                    @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                    <button type="submit" class="btn btn-success p-2 d-block" style="margin:auto;">Đăng bài viết</button>
                </div>
            </div>
        }
    </div>
</div>

<script src="https://cdn.tiny.cloud/1/zihqpwrk4mgc8xsa9hlg2hm0etuz7f7dh1ovyeioicuygk8v/tinymce/6/tinymce.min.js" referrerpolicy="origin"></script>
<script>
    tinymce.init({
        selector: '.textarea#ndbv',
        plugins: 'anchor autolink charmap codesample emoticons image link lists media searchreplace table visualblocks wordcount',
        toolbar: 'undo redo | blocks fontfamily fontsize | bold italic underline strikethrough | link image media table | align lineheight | numlist bullist indent outdent | emoticons charmap | removeformat',
    });

    document.getElementById('inputSingleFile').addEventListener('change', function () {
        var file = this.files[0];
        if (file) {
            var reader = new FileReader();
            reader.onload = function (e) {
                var imagePreview = document.getElementById('imagePreviewSingle');
                var img = document.createElement('img');
                img.src = e.target.result;
                img.style.maxWidth = '100%';
                imagePreview.innerHTML = '';
                imagePreview.appendChild(img);
            };
            reader.readAsDataURL(file);
        }
    });
</script>
