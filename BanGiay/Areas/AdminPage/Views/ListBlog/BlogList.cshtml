@using BanGiay.Models;
@model BanGiay.ViewModel.PostVM
@{
    ViewBag.Title = "Danh sách bài viết";
    List<baiViet> Posts = ViewData["ArticleList"] as List<baiViet>;
}
<style>
    form {
        display: inline;
    }

    .custom-modal-dialog {
        max-width: 80%; /* Đặt chiều rộng tùy chỉnh cho modal */
    }
</style>

<div class="content-wrapper">
    <section class="content-header">
        <div class="container-fluid">
            <div class="row mb-2">
                <div class="col-sm-6">
                    <h1>@ViewBag.HeaderList</h1>
                </div>
                <div class="col-sm-6">
                    <ol class="breadcrumb float-sm-right">
                        <li class="breadcrumb-item"><a href='@Url.Action("Index","Dashboard")'>Dashboard</a></li>
                        <li class="breadcrumb-item active">@ViewBag.HeaderList</li>
                    </ol>
                </div>
            </div>
        </div>
    </section>
    <section class="content">
        <div class="container-fluid">
            <div class="row">
                <div class="col-12">
                    <div class="card">
                        <div class="card-header">
                            @using (Html.BeginForm("FindPostByName", "ListBlog"))
                            {
                                <div class="float-right form-inline">
                                    <input class="form-control" type="search" name="namePost" placeholder="Nhập tên bài viết" aria-label="Search">
                                    <div class="">
                                        <button class="btn btn-sidebar"><i class="fas fa-search fa-fw"></i></button>
                                    </div>
                                </div>
                            }
                        </div>
                        <div class="card-body">
                            <table id="example2" class="table table-bordered table-hover">
                                <thead>
                                    <tr>
                                        <th>Mã bài viết</th>
                                        <th>Tên bài viết</th>
                                        <th>Ngày đăng</th>
                                        <th>Lệnh</th>
                                        <th>Trạng thái</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Posts)
                                    {

                                        <tr>
                                            <td>
                                                @if (item.daDuyet == true)
                                                {
                                                    <a target="_blank" href='@Url.Action("DetailBlog","Blog",new {area="",idBlog=item.maBV })'>@item.maBV</a>
                                                }
                                                else
                                                {
                                                    @item.maBV
                                                }
                                            </td>
                                            <td>@item.tenBV</td>
                                            <td>@item.ngayDang</td>
                                            <td>
                                                @using (Html.BeginForm("Update", "ListBlog", FormMethod.Post, new { @enctype = "multipart/form-data" }))
                                                {
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="idPost" value="@item.maBV" />
                                                    <button type="button" class="btn btn-primary" data-toggle="modal" data-target="#customModal@(item.maBV)">Sửa</button>
                                                    <div class="modal fade" id="customModal@(item.maBV)" tabindex="-1" role="dialog">
                                                        <div class="modal-dialog custom-modal-dialog">
                                                            <div class="modal-content">
                                                                <div class="modal-header">
                                                                    <h5 class="modal-title" id="customModalLabel">Chỉnh sửa thông tin</h5>
                                                                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                                                                        <span aria-hidden="true">&times;</span>
                                                                    </button>
                                                                </div>
                                                                <div class="modal-body">
                                                                    <div class="row">
                                                                        <div class="col-md-6">
                                                                            <div class="card card-success">
                                                                                <div class="card-header">
                                                                                    <h3 class="card-title">Thông tin chính</h3>
                                                                                </div>
                                                                                <div class="card-body">
                                                                                    <div class="form-group">
                                                                                        <label>Tên bài viết</label>
                                                                                        <input type="text" class="form-control" value="@item.tenBV" name="NamePost" />
                                                                                    </div>
                                                                                    <div class="form-group">
                                                                                        <label>Nội dung tóm tắt</label>
                                                                                        <input type="text" class="form-control" value="@item.ndTomTat" name="SummaryContent" />

                                                                                    </div>

                                                                                    <div class="form-group">
                                                                                        <div class="row">
                                                                                            <div class="col-md-6">
                                                                                                <label>Ngày đăng</label>
                                                                                                <input type="text" class="form-control" value="@item.ngayDang" name="DatePost" disabled="disabled" />
                                                                                            </div>
                                                                                            <div class="col-md-6">
                                                                                                <label>Tài khoản</label>
                                                                                                <input class="form-control" type="text" value="@item.taiKhoan" name="Account" disabled="disabled" />
                                                                                            </div>
                                                                                        </div>
                                                                                    </div>
                                                                                    <div class="form-group">
                                                                                        <div class="row">
                                                                                            <div class="col-md-6">
                                                                                                <input type="hidden" />
                                                                                            </div>
                                                                                            <div class="col-md-6">
                                                                                                <label>Số lần đọc</label>
                                                                                                <input type="text" class="form-control" , value="@item.luotXem" disabled="disabled" />
                                                                                            </div>
                                                                                        </div>
                                                                                    </div>
                                                                                </div>
                                                                            </div>
                                                                        </div>
                                                                        <div class="col-md-6">
                                                                            <div class="card card-secondary">
                                                                                <div class="card card-secondary">
                                                                                    <div class="card-header">
                                                                                        <h3 class="card-title">Hình đại diện sản phẩm</h3>
                                                                                    </div>
                                                                                    <div id="imagePreviewSingle-@item.maBV" min-height="300px" min-width="300px" class="m-auto">
                                                                                        <img src="@item.hinhDD" width="500px" />
                                                                                    </div>
                                                                                    <div class="card-body">
                                                                                        <div class="input-group">
                                                                                            <div class="custom-file">
                                                                                                <input type="file" class="custom-file-input" id="inputSingleFile-@item.maBV" name="imageAvatar">
                                                                                                <label class="custom-file-label" for="inputSingleFile-@item.maBV">Chọn ảnh đại diện</label>
                                                                                            </div>
                                                                                        </div>
                                                                                    </div>
                                                                                </div>
                                                                            </div>
                                                                        </div>
                                                                    </div>
                                                                    <div class="row">
                                                                        <div class="col-md-12">
                                                                            <div class="card card-primary">
                                                                                <div class="card-header">
                                                                                    <h3 class="card-title">Thông tin chi tiết về bài viết</h3>
                                                                                </div>
                                                                                <form role="form">
                                                                                    <div class="card-body">
                                                                                        <input class="textarea" id="ndbv" style="width: 100%; height: 600px;" name="Content" value="@item.noiDung" />
                                                                                    </div>
                                                                                </form>
                                                                            </div>
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                                <div class="modal-footer">
                                                                    <button type="submit" class="btn btn-primary">Lưu</button>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                }
                                                @using (Html.BeginForm("Delete", "ListBlog", FormMethod.Post))
                                                {
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="idPost" value="@item.maBV" />
                                                    <button class="btn btn-danger ">Xóa</button>
                                                }
                                            </td>
                                            @if (item.daDuyet == true)
                                            {
                                                <td><span style="color: #fff;background-color:green;border-radius:15%;padding:5px ;font-size:13px;display:inline-block;">đã duyệt</span></td>
                                            }
                                            else
                                            {
                                                <td><span style="color: #fff;background-color:red;border-radius:15%;padding:5px ;font-size:13px;display:inline-block;">Chờ duyệt</span></td>
                                            }

                                        </tr>
                                    }
                                </tbody>
                                <tfoot>
                                    <tr>
                                        <th>Mã bài viết</th>
                                        <th>Tên bài viết</th>
                                        <th>Trạng thái</th>
                                        <th>Ngày đăng</th>
                                        <th>Lệnh</th>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>
<script src="https://cdn.tiny.cloud/1/zihqpwrk4mgc8xsa9hlg2hm0etuz7f7dh1ovyeioicuygk8v/tinymce/6/tinymce.min.js" referrerpolicy="origin"></script>
<script src="https://code.jquery.com/jquery-3.6.4.min.js"></script>
<script>
    $(document).ready(function () {
        $("[id^='inputSingleFile-']").change(function () {
            var maSP = this.id.replace('inputSingleFile-', '');
            showImagePreview(this, maSP);
        });

        $("[id^='inputSingleFile-']").each(function () {
            var maSP = this.id.replace('inputSingleFile-', '');
            var hinhDD = $("#imagePreviewSingle-" + maSP + " img").attr("src");
            showImagePreview(this, maSP, hinhDD);
        });

        function showImagePreview(input, maSP, existingImageSrc) {
            var reader = new FileReader();

            reader.onload = function (e) {
                $("#imagePreviewSingle-" + maSP).html('<img src="' + (e.target.result || existingImageSrc) + '" width="300px"/>');
            };
            reader.readAsDataURL(input.files && input.files[0]);
        }
    });

    $(document).ready(function () {
        // Đặt biến để theo dõi mã bài viết đang được chỉnh sửa
        var currentPostId = null;
        $('.btn-primary').on('click', function () {
            var postId = $(this).closest('tr').find('td:first').text(); // Lấy mã bài viết
            currentPostId = postId; // Lưu lại mã bài viết đang được chỉnh sửa
            $('#customModal' + postId).modal('show'); // Mở modal tương ứng
        });

        // Sự kiện khi nút "Lưu" hoặc "Đóng" trong modal được nhấn
        $('.modal-footer button').on('click', function () {
            $('#customModal' + currentPostId).modal('hide'); // Đóng modal tương ứng
            currentPostId = null; // Đặt lại mã bài viết đang được chỉnh sửa
        });
    });

    tinymce.init({
        selector: '.textarea#ndbv',
        plugins: 'anchor autolink charmap codesample emoticons image link lists media searchreplace table visualblocks wordcount',
        toolbar: 'undo redo | blocks fontfamily fontsize | bold italic underline strikethrough | link image media table | align lineheight | numlist bullist indent outdent | emoticons charmap | removeformat',
    });

    document.getElementById('inputSingleFile').addEventListener('change', function () {
        var file = this.files[0];
        if (file) {
            var reader = new FileReader();
            reader.onload = function (e) {
                var imagePreview = document.getElementById('imagePreviewSingle');
                var img = document.createElement('img');
                img.src = e.target.result;
                img.style.maxWidth = '100%';
                imagePreview.innerHTML = '';
                imagePreview.appendChild(img);
            };
            reader.readAsDataURL(file);
        }
    });
</script>

