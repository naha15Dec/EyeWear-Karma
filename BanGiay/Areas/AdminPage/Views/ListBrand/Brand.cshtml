@using BanGiay.Models;
@model BanGiay.Models.thuongHieu

@{
    ViewBag.Title = "Thương hiệu";
    List<thuongHieu> dsThuongHieu = ViewData["danhSachThuongHieu"] as List<thuongHieu>;
}
<style>
    form {
        display: inline;
    }
</style>

<div class="content-wrapper">
    <section class="content-header">
        <div class="container-fluid">
            <div class="row mb-2">
                <div class="col-sm-6">
                    <h1>Thương hiệu</h1>
                </div>
                <div class="col-sm-6">
                    <ol class="breadcrumb float-sm-right">
                        <li class="breadcrumb-item"><a href='@Url.Action("Index","Dashboard")'>Dashboard</a></li>
                        <li class="breadcrumb-item active">Thương hiệu</li>
                    </ol>
                </div>
            </div>
        </div>
    </section>

    <section class="content">
        <div class="container-fluid">
            <div class="row">
                <div class="col-md-6">
                    <div class="card card-primary">
                        <div class="card-header">
                            <h3 class="card-title">Thông tin chính</h3>
                        </div>
                        <div class="card-body">
                            <table id="example2" class="table table-bordered table-hover">
                                <thead>
                                    <tr>
                                        <th>Mã Thương Hiệu</th>
                                        <th>Tên </th>
                                        <th>Xuất xứ</th>
                                        <th>Lệnh</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (thuongHieu item in dsThuongHieu)
                                    {

                                        <tr>
                                            <td>@item.maThuongHieu</td>
                                            <td>@item.tenThuongHieu</td>
                                            <td>@item.xuatXu</td>

                                            <td>
                                                @using (Html.BeginForm("Update", "ListBrand", FormMethod.Post))
                                                {
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="mth" value="@item.maThuongHieu" />
                                                    <button class="btn btn-success">Sửa</button>
                                                }
                                                @using (Html.BeginForm("Delete", "ListBrand", FormMethod.Post))
                                                {
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="mth" value="@item.maThuongHieu" />
                                                    <button class="btn btn-danger">Xóa</button>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                                <tfoot>
                                    <tr>
                                        <th>Mã Thương Hiệu</th>
                                        <th>Tên </th>
                                        <th>Xuất xứ</th>
                                        <th>Lệnh</th>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    @using (Html.BeginForm("AddBrand", "ListBrand", FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()
                        <div class="row">
                            <div class="col-md-12">
                                <div class="card card-primary">
                                    <div class="card-header">
                                        <h3 class="card-title">Thông tin chính</h3>
                                    </div>
                                    <div class="card-body">
                                        <div class="form-group">
                                            <label>Tên thương hiệu</label>
                                            @Html.TextBoxFor(m => m.tenThuongHieu, new { @class = "form-control", placeholder = "Tên thương hiệu" })
                                        </div>
                                        <div class="form-group">
                                            <label>Xuất xứ</label>
                                            @Html.TextBoxFor(m => m.xuatXu, new { @class = "form-control", placeholder = "Xuất xứ" })
                                        </div>
                                        <div class="form-group">
                                            <label>Ghi Chú</label>
                                            @Html.TextAreaFor(m => m.ghiChu, new { @class = "form-control", placeholder = "Ghi chú " })
                                        </div>
                                        <button type="submit" class="btn btn-success">Lưu</button>
                                    </div>
                                </div>
                            </div>
                        </div>

                        @Html.HiddenFor(m => m.maThuongHieu)
                    }
                </div>
            </div>
        </div>
    </section>
</div>
