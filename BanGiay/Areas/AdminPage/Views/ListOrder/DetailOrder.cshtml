@using BanGiay.Models;
@model BanGiay.Models.donHang
@{
    ViewBag.Title = "Chi tiết đơn hàng";
    List<chiTietDonHang> details = ViewData["listOfProductInOrder"] as List<chiTietDonHang>;
    thongTinCuaHang mostRecentChanges = ViewData["MostRecentChanges"] as thongTinCuaHang;
}
<div class="content-wrapper">
    <section class="content-header">
        <div class="container-fluid">
            <div class="row mb-2">
                <div class="col-sm-6">
                    <h1>Chi tiết đơn hàng</h1>
                </div>
                <div class="col-sm-6">
                    <ol class="breadcrumb float-sm-right">
                        <li class="breadcrumb-item"><a href="@Url.Action("Index", "Dashboard")">Dashboard</a></li>
                        <li class="breadcrumb-item"><a href="@Url.Action("OrdersList", "ListOrder")">Danh sách đơn hàng</a></li>
                        <li class="breadcrumb-item active">Chi tiết đơn hàng #@Model.soDH</li>
                    </ol>
                </div>
            </div>
        </div>
    </section>

    <section class="content">
        <div class="container-fluid">
            <div class="row">
                <div class="col-12">
                    <div class="invoice p-3 mb-3">
                        <div class="row">
                            <div class="col-12">
                                <h4>
                                    <i class="fas fa-globe"></i> Karmar Shop
                                    <small class="float-right">Ngày tạo đơn: @Model.ngayDat</small>
                                </h4>
                            </div>
                        </div>
                        <div class="row invoice-info">
                            <div class="col-sm-4 invoice-col">
                                Địa chỉ lấy hàng
                                <address>
                                    <strong>Kar Shop</strong><br>
                                    @mostRecentChanges.diaChiLayHang  <br>
                                    Số điện thoại: @mostRecentChanges.soDTLienHe<br>
                                    Email: @mostRecentChanges.emailLienHe
                                </address>
                            </div>
                            <div class="col-sm-4 invoice-col">
                                Địa chỉ giao hàng
                                <address>
                                    <strong>@Model.khachHang.tenKH</strong><br>
                                    @Model.diachiGH<br>
                                    Số điện thoại: @Model.khachHang.soDT <br>
                                    Email: @Model.khachHang.email
                                </address>
                            </div>
                            <div class="col-sm-4 invoice-col">
                                <b>Số đơn hàng #@Model.soDH</b><br>
                                <br>
                                <b>Mã khách hàng:</b> @Model.maKH<br>
                                <b>Thanh toán:</b>  @(Model.trangThai == true ? (Model.loaiThanhToan.Equals("Payment_Before") ? "Đã thanh toán" : "Đã thanh toán qua VNPay") : (Model.loaiThanhToan.Equals("Payment_Before") ? "Chưa thanh toán" : "Đã thanh toán qua VNPay"))<br>
                                <b>Tài khoản:</b> @(Model.taiKhoan == null ? "Chưa có" : Model.taiKhoan)
                            </div> 
                           
                        </div>
                        <div class="row">
                            <div class="col-12 table-responsive">
                                <table class="table table-striped">
                                    <thead>
                                        <tr>
                                            <th>Mã sản phẩm</th>
                                            <th>Tên sản phẩm</th>
                                            <th>Số lượng</th>
                                            <th>Giá bán</th>
                                            <th>Giảm giá</th>
                                            <th>Tổng giá</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var item in details)
                                        {
                                            <tr>
                                                <td>@item.maSP</td>
                                                <td>@item.sanPham.tenSP</td>
                                                <td>@item.soLuong</td>
                                                <td>@item.giaBan</td>
                                                <td>@item.giamGia</td>
                                                <td>@((item.giaBan - item.giamGia) * item.soLuong)</td>
                                            </tr>
                                        }

                                    </tbody>
                                </table>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-6">
                                <p class="lead">Phương thức thanh toán của đơn hàng: @Model.loaiThanhToan</p>
                                <p>Ghi chú: @Model.ghiChu</p>
                            </div>
                            <div class="col-6">
                                <p class="lead">Giá trị đơn hàng: #@Model.soDH</p>

                                <div class="table-responsive">
                                    <table class="table">
                                        <tr>
                                            <th>Phí giao hàng:</th>
                                            <td>Free</td>
                                        </tr>
                                        <tr>
                                            <th>Tổng giá trị đơn hàng:</th>
                                            <td>@ViewData["totalPrice"]</td>
                                        </tr>
                                    </table>
                                </div>
                            </div>
                        </div>
                        <div class="row no-print">
                            <div class="col-12">
                                <a class="btn btn-primary" href="@Url.Action("OrdersList", "ListOrder", new {enable="disable" })">Quay về danh sách đơn hàng</a>
                                @if (Model.trangThai == false)
                                {
                                    <a href="@Url.Action("OrderSuccess","ListOrder",new {numberOfOrder=Model.soDH})" class="btn btn-success float-right">Hoàn thành</a>
                                }
                                @*Xóa hoặc hủy đơn hàng*@
                                <button type="button" class="btn btn-danger" data-toggle="modal" data-target="#customModal@(Model.soDH)">@(Model.trangThai == true ? "Xóa đơn hàng" : "Hủy đơn hàng")</button>
                                <div class="modal fade" id="customModal@(Model.soDH)" tabindex="-1" role="dialog">
                                    <div class="modal-dialog custom-modal-dialog">
                                        <div class="modal-content">
                                            <div class="modal-header">
                                                <h5 class="modal-title">@(Model.trangThai == true ? "Xóa đơn hàng" : "Hủy đơn hàng")</h5>
                                                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                                                    <span aria-hidden="true">&times;</span>
                                                </button>
                                            </div>
                                            <div class="modal-body">
                                                <p>Bạn có chắc chắn @(Model.trangThai == true ? "xóa đơn " : "hủy đơn") hàng này không</p>
                                            </div>
                                            <div class="modal-footer">
                                                <a href='@Url.Action("CancelOrder", "ListOrder", new {numberOfOrder=Model.soDH })' type="button" class="btn btn-primary">Chắc chắn</a>
                                                <button type="button" class="btn btn-secondary" data-dismiss="modal">Đóng</button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                @*Xóa hoặc hủy đơn hàng*@
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>
