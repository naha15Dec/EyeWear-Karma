@using BanGiay.Models;
@{
    ViewBag.Title = "Đơn hàng";
    List<donHang> Orders = ViewData["listOrders"] as List<donHang>;
}
<style>
    form {
        display: inline;
    }
</style>
<div class="content-wrapper">
    <section class="content-header">
        <div class="container-fluid">
            <div class="row mb-2">
                <div class="col-sm-6">
                    <h1>@ViewBag.titleListOrder</h1>
                </div>
                <div class="col-sm-6">
                    <ol class="breadcrumb float-sm-right">
                        <li class="breadcrumb-item"><a href='@Url.Action("Index","Dashboard")'>Dashboard</a></li>
                        <li class="breadcrumb-item active">@ViewBag.titleListOrder</li>
                    </ol>
                </div>
            </div>
        </div>
    </section>

    <section class="content">
        <div class="container-fluid">
            <div class="row">
                <div class="col-12">
                    <div class="card">
                        <div class="card-header">
                            @using (Html.BeginForm("FindOrderByNumber", "ListOrder"))
                            {
                                <div class="float-right form-inline">
                                    <input class="form-control" type="search" name="numberOfOrder" placeholder="Nhập số đơn hàng" aria-label="Search">
                                    <div class="">
                                        <button class="btn btn-sidebar"><i class="fas fa-search fa-fw"></i></button>
                                    </div>
                                </div>
                            }
                        </div>
                        <div class="card-body">
                            <table id="example2" class="table table-bordered table-hover">
                                <thead>
                                    <tr>
                                        <th>Số đơn hàng</th>
                                        <th>Tài khoản</th>
                                        <th>Ngày Đặt</th>
                                        <th>Lệnh</th>
                                        <th>Trạng thái</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Orders)
                                    {

                                        <tr>
                                            <td>@item.soDH</td>
                                            <td>@item.taiKhoan</td>
                                            <td>@item.ngayDat</td>
                                            <td>
                                                <a href='@Url.Action("DetailOrder","ListOrder",new {numberOfOrder = item.soDH })' class="btn btn-primary">Chi tiết</a>

                                                @*Xóa hoặc hủy đơn hàng*@
                                                <button type="button" class="btn btn-danger" data-toggle="modal" data-target="#customModal@(item.soDH)">@(item.trangThai == true ? "Xóa đơn hàng" : "Hủy đơn hàng")</button>
                                                <div class="modal fade" id="customModal@(item.soDH)" tabindex="-1" role="dialog">
                                                    <div class="modal-dialog custom-modal-dialog">

                                                        <div class="modal-content">
                                                            <div class="modal-header">
                                                                <h5 class="modal-title">@(item.trangThai == true ? "Xóa đơn hàng" : "Hủy đơn hàng")</h5>
                                                                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                                                                    <span aria-hidden="true">&times;</span>
                                                                </button>
                                                            </div>
                                                            <div class="modal-body">
                                                                <p>Bạn có chắc chắn @(item.trangThai == true ? "xóa đơn " : "hủy đơn") hàng này không</p>
                                                            </div>
                                                            <div class="modal-footer">
                                                                <a href='@Url.Action("CancelOrder", "ListOrder", new {numberOfOrder=item.soDH })' type="button" class="btn btn-primary">Chắc chắn</a>
                                                                <button type="button" class="btn btn-secondary" data-dismiss="modal">Đóng</button>
                                                            </div>

                                                        </div>
                                                    </div>
                                                </div>
                                            </td>
                                            @*Xóa hoặc hủy đơn hàng*@
                                            @if (item.trangThai == true)
                                            {
                                                <td><span style="color: #fff;background-color:green;border-radius:15%;padding:5px ;font-size:13px;display:inline-block;">Thành công</span></td>
                                            }
                                            else
                                            {
                                                <td><span style="color: #fff;background-color:red;border-radius:15%;padding:5px ;font-size:13px;display:inline-block;">Đang xử lí</span></td>
                                            }

                                        </tr>
                                    }
                                </tbody>
                                <tfoot>
                                    <tr>
                                        <th>Số đơn hàng</th>
                                        <th>Tài khoản</th>
                                        <th>Ngày Đặt</th>
                                        <th>Lệnh</th>
                                        <th>Trạng thái</th>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>
