@using BanGiay.Models;
@model BanGiay.ViewModel.ProductVM
@{
    ViewBag.Title = "Thêm sản phẩm";
    List<thuongHieu> Brands = (ViewData["Brands"] as List<thuongHieu>);
    List<loaiSP> Categories = (ViewData["Categories"] as List<loaiSP>);
    string taiKhoan = (Session["LoginInformation"] as taiKhoanThanhVien).taiKhoan;
}

<div class="content-wrapper">
    <section class="content-header">
        <div class="container-fluid">
            <div class="row mb-2">
                <div class="col-sm-6">
                    <h1>Thêm sản phẩm</h1>
                </div>
                <div class="col-sm-6">
                    <ol class="breadcrumb float-sm-right">
                        <li class="breadcrumb-item"><a href='@Url.Action("Index","Dashboard")'>Dashboard</a></li>
                        <li class="breadcrumb-item active">Thêm sản phẩm</li>
                    </ol>
                </div>
            </div>
        </div>
    </section>

    <div class="container-fluid ">
        @using (Html.BeginForm("AddProduct", "ListProduct", FormMethod.Post, new { @enctype = "multipart/form-data" }))
        {
            @Html.AntiForgeryToken()

            <div class="row">
                <div class="col-md-12">
                    <div class="card card-success">
                        <div class="card-header">
                            <h3 class="card-title">Thông tin sản phẩm</h3>
                        </div>
                        <div class="card-body">
                            @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                            <div class="form-group">
                                <label for="tsp">Tên sản phẩm</label>
                                @Html.TextBoxFor(m => m.NameProduct, new { @class = "form-control", placeholder = "Tên sản phẩm dưới 100 ký tự" })
                                @Html.ValidationMessageFor(m => m.NameProduct, "", new { @class = "text-danger" })
                            </div>

                            <div class="form-group">
                                <label for="ndtt">Mô tả tóm tắt</label>
                                @Html.TextAreaFor(m => m.SummaryDescription, new { @class = "form-control", placeholder = "Mô tả tóm tắt ..." })
                                @Html.ValidationMessageFor(m => m.SummaryDescription, "", new { @class = "text-danger" })
                            </div>

                            <div class="form-group">
                                <label>Giới thiệu chi tiết sản phẩm</label>
                                @Html.TextAreaFor(
                                    m => m.Description,
                                    new
                                    {
                                        @class = "textarea",
                                        placeholder = "Nội dung sản phẩm ...",
                                        id = "ndbv",
                                        style = "width: 100%; height: 600px;"
                                    })
                                @Html.ValidationMessageFor(m => m.Description, "", new { @class = "text-danger" })
                            </div>

                            <div class="form-group">
                                <div class="row">
                                    <div class="col-md-4">
                                        <label for="ngaydang">Ngày đăng</label>
                                        @Html.TextBoxFor(m => m.DateProduct,
                                            new { @class = "form-control", placeholder = DateTime.Now, disabled = "disabled" })
                                    </div>
                                    <div class="col-md-4">
                                        <label for="taikhoan">Tài khoản</label>
                                        @Html.TextBoxFor(m => m.Account,
                                            new { @class = "form-control", placeholder = taiKhoan, disabled = "disabled" })
                                    </div>
                                    <div class="col-md-4">
                                        <label>Trạng thái</label>
                                        <select name="StatusProduct" class="form-control">
                                            <option value="true">Còn hàng</option>
                                            <option value="false">Hết hàng</option>
                                        </select>
                                    </div>
                                </div>
                            </div>

                            <div class="form-group">
                                <div class="row">
                                    <div class="col-md-2">
                                        <label>Thương hiệu</label>
                                        @Html.DropDownListFor(
                                            m => m.IDBrand,
                                            new SelectList(Brands, "maThuongHieu", "tenThuongHieu"),
                                            "-- Chọn thương hiệu --",
                                            new { @class = "form-control" })
                                        @Html.ValidationMessageFor(m => m.IDBrand, "", new { @class = "text-danger" })
                                    </div>

                                    <div class="col-md-2">
                                        <label>Loại sản phẩm</label>
                                        @Html.DropDownListFor(
                                            m => m.IDTypeProduct,
                                            new SelectList(Categories, "maLoai", "tenLoai"),
                                            "-- Chọn loại sản phẩm --",
                                            new { @class = "form-control" })
                                        @Html.ValidationMessageFor(m => m.IDTypeProduct, "", new { @class = "text-danger" })
                                    </div>

                                    <div class="col-md-2">
                                        <label>Giới tính</label>
                                        @Html.DropDownListFor(
                                            m => m.Sex,
                                            new SelectList(new[] { "Nam", "Nữ", "Unisex" }),
                                            "-- Chọn giới tính --",
                                            new { @class = "form-control" })
                                        @Html.ValidationMessageFor(m => m.Sex, "", new { @class = "text-danger" })
                                    </div>

                                    <div class="col-md-3">
                                        <label>Giá (VND)</label>
                                        <div class="input-group">
                                            @Html.TextBoxFor(
                                                m => m.Price,
                                                new
                                                {
                                                    @class = "form-control text-right currency-input",
                                                    autocomplete = "off"
                                                })
                                            <div class="input-group-append">
                                                <span class="input-group-text">₫</span>
                                            </div>
                                        </div>
                                        @Html.ValidationMessageFor(m => m.Price, "", new { @class = "text-danger" })
                                    </div>

                                    <div class="col-md-3">
                                        <label>Giảm giá (VND)</label>
                                        <div class="input-group">
                                            @Html.TextBoxFor(
                                                m => m.Discount,
                                                new
                                                {
                                                    @class = "form-control text-right currency-input",
                                                    autocomplete = "off"
                                                })
                                            <div class="input-group-append">
                                                <span class="input-group-text">₫</span>
                                            </div>
                                        </div>
                                        @Html.ValidationMessageFor(m => m.Discount, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                            </div>

                        </div>
                    </div>
                </div>

                <!-- ẢNH CHI TIẾT -->
                <div class="col-md-8">
                    <div class="card card-secondary">
                        <div class="card-header">
                            <h3 class="card-title">Hình minh họa cho sản phẩm</h3>
                        </div>
                        <div id="imagePreviewMulti" style="text-align:center; display:inline;"></div>
                        <div class="card-body">
                            <div class="input-group">
                                <div class="custom-file">
                                    <input type="file" class="custom-file-input" id="inputMultiFile" name="images" multiple="multiple">
                                    <label class="custom-file-label" for="inputMultiFile">Chọn ảnh</label>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- ẢNH ĐẠI DIỆN -->
                <div class="col-md-4">
                    <div class="card card-secondary">
                        <div class="card-header">
                            <h3 class="card-title">Hình đại diện cho sản phẩm</h3>
                        </div>
                        <div id="imagePreviewSingle" min-height="300px" min-width="300px" class="m-auto"></div>
                        <div class="card-body">
                            <div class="input-group">
                                <div class="custom-file">
                                    <input type="file" class="custom-file-input" id="inputSingleFile" name="imageAvatar">
                                    <label class="custom-file-label" for="inputSingleFile">Chọn ảnh đại diện</label>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <button type="submit" class="btn btn-success p-2 d-block" style="margin:auto;">Đăng sản phẩm</button>
        }
    </div>
</div>

<script src="https://cdn.tiny.cloud/1/mjx5bcjxjzsekqcvy1ai2z4fspdr4j94doloncihjvicobhw/tinymce/6/tinymce.min.js" referrerpolicy="origin"></script>

<script>
    tinymce.init({
        selector: '.textarea#ndbv',
        plugins: 'anchor autolink charmap codesample emoticons image link lists media searchreplace table visualblocks wordcount',
        toolbar: 'undo redo | blocks fontfamily fontsize | bold italic underline strikethrough | link image media table | align lineheight | numlist bullist indent outdent | emoticons charmap | removeformat',
    });

    // Ảnh sản phẩm (nhiều ảnh)
    document.getElementById('inputMultiFile').addEventListener('change', function () {
        var files = this.files;
        var imagePreview = document.getElementById('imagePreviewMulti');
        imagePreview.innerHTML = '';
        for (var i = 0; i < files.length; i++) {
            var file = files[i];
            if (file) {
                var reader = new FileReader();
                reader.onload = function (e) {
                    var img = document.createElement('img');
                    img.src = e.target.result;
                    img.style.maxWidth = '150px';
                    img.style.margin = '5px';
                    imagePreview.appendChild(img);
                };
                reader.readAsDataURL(file);
            }
        }
    });

    // Ảnh đại diện sản phẩm
    document.getElementById('inputSingleFile').addEventListener('change', function () {
        var file = this.files[0];
        if (file) {
            var reader = new FileReader();
            reader.onload = function (e) {
                var imagePreview = document.getElementById('imagePreviewSingle');
                var img = document.createElement('img');
                img.src = e.target.result;
                img.style.maxWidth = '100%';
                imagePreview.innerHTML = '';
                imagePreview.appendChild(img);
            };
            reader.readAsDataURL(file);
        }
    });

    // ====== AUTO FORMAT VND CHO GIÁ & GIẢM GIÁ ======
    function formatVndValue(value) {
        // Lấy toàn bộ số
        var numeric = value.replace(/[^\d]/g, "");
        if (!numeric) return "";
        var number = parseInt(numeric, 10);
        if (isNaN(number)) return "";
        // 1500000 -> "1.500.000"
        return number.toLocaleString("vi-VN");
    }

    (function () {
        var currencyInputs = document.querySelectorAll(".currency-input");

        currencyInputs.forEach(function (input) {
            // Khi focus: bỏ format, chỉ để số thô
            input.addEventListener("focus", function () {
                var numeric = this.value.replace(/[^\d]/g, "");
                this.value = numeric;
            });

            // Khi blur: format theo VND
            input.addEventListener("blur", function () {
                this.value = formatVndValue(this.value);
            });

            // Nếu ban đầu đã có giá trị (edit lại form) thì format luôn
            if (input.value) {
                input.value = formatVndValue(input.value);
            }
        });

        // Trước khi submit form: bỏ dấu chấm, chỉ giữ số để gửi lên server
        var forms = document.querySelectorAll("form");
        forms.forEach(function (form) {
            form.addEventListener("submit", function () {
                var inputs = form.querySelectorAll(".currency-input");
                inputs.forEach(function (input) {
                    input.value = input.value.replace(/[^\d]/g, "");
                });
            });
        });
    })();
</script>
