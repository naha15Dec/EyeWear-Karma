@using BanGiay.Models;
@model BanGiay.ViewModel.ProductVM
@{
    ViewBag.Title = "Sản phẩm";
    List<sanPham> dsSanPham = ViewData["listProduct"] as List<sanPham>;
    List<thuongHieu> Brands = (ViewData["Brands"] as List<thuongHieu>);
    List<loaiSP> Categories = (ViewData["Categories"] as List<loaiSP>);
}
<style>
    form {
        display: inline;
    }

    .custom-modal-dialog {
        max-width: 80%;
    }
</style>

<div class="content-wrapper">
    <section class="content-header">
        <div class="container-fluid">
            <div class="row mb-2">
                <div class="col-sm-6">
                    <h1>Danh sách sản phẩm</h1>
                </div>
                <div class="col-sm-6">
                    <ol class="breadcrumb float-sm-right">
                        <li class="breadcrumb-item"><a href='@Url.Action("Index","Dashboard")'>Dashboard</a></li>
                        <li class="breadcrumb-item active">Danh sách sản phẩm</li>
                    </ol>
                </div>
            </div>
        </div>
    </section>

    <section class="content">
        <div class="container-fluid">
            <div class="row">
                <div class="col-12">
                    <div class="card">
                        <div class="card-header">
                            @using (Html.BeginForm("FindProductByName", "ListProduct"))
                            {
                                <div class="float-right form-inline">
                                    <input class="form-control" type="search" name="nameProduct" placeholder="Nhập tên sản phẩm" aria-label="Search">
                                    <div class="">
                                        <button class="btn btn-sidebar"><i class="fas fa-search fa-fw"></i></button>
                                    </div>
                                </div>
                            }
                        </div>
                        <div class="card-body">
                            <table id="example2" class="table table-bordered table-hover">
                                <thead>
                                    <tr>
                                        <th>Mã sản phẩm</th>
                                        <th>Tên sản phẩm</th>
                                        <th>Ngày đăng</th>
                                        <th>Giá</th>
                                        <th>Lệnh</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in dsSanPham)
                                    {
                                        <tr>
                                            <td>
                                                @if (item.trangThai == true)
                                                {
                                                    <a target="_blank" href='@Url.Action("DetailProduct","Product",new {area="",idProduct=item.maSP })'>@item.maSP</a>
                                                }
                                                else
                                                {
                                                    @item.maSP
                                                }
                                            </td>
                                            <td>@item.tenSP</td>
                                            <td>@item.ngayDang</td>
                                            <td class="text-right">
                                                @String.Format(
                                                    System.Globalization.CultureInfo.GetCultureInfo("vi-VN"),
                                                    "{0:c0}",
                                                    item.giaBan
                                                )
                                            </td>
                                            <td>
                                                @using (Html.BeginForm("Update", "ListProduct", FormMethod.Post, new { @enctype = "multipart/form-data" }))
                                                {
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="idProduct" value="@item.maSP" />
                                                    <button type="button" class="btn btn-primary" data-toggle="modal" data-target="#customModal@(item.maSP)">Sửa</button>
                                                    <div class="modal fade" id="customModal@(item.maSP)" tabindex="-1" role="dialog">
                                                        <div class="modal-dialog custom-modal-dialog">
                                                            <div class="modal-content">
                                                                <div class="modal-header">
                                                                    <h5 class="modal-title" id="customModalLabel">Chỉnh sửa thông tin</h5>
                                                                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                                                                        <span aria-hidden="true">&times;</span>
                                                                    </button>
                                                                </div>
                                                                <div class="modal-body">
                                                                    <div class="row">
                                                                        <div class="col-md-12">
                                                                            <div class="card card-success">
                                                                                <div class="card-header">
                                                                                    <h3 class="card-title">Thông tin sản phẩm</h3>
                                                                                </div>
                                                                                <div class="card-body">
                                                                                    <div class="form-group">
                                                                                        <label>Tên sản phẩm</label>
                                                                                        <input type="text" name="NameProduct" class="form-control" placeholder="@item.tenSP" value="@item.tenSP" />
                                                                                    </div>
                                                                                    <div class="form-group">
                                                                                        <label>Mô tả tóm tắt</label>
                                                                                        <input type="text" name="SummaryDescription" class="form-control" placeholder="@item.moTaTomTat" value="@item.moTaTomTat" />
                                                                                        <div class="form-group">
                                                                                            <label>Giới thiệu chi tiết sản phẩm</label>
                                                                                            <input class="textarea" id="ndbv" style="width: 100%; height: 600px;" name="Description" value="@item.moTa" />
                                                                                        </div>
                                                                                        <div class="form-group">
                                                                                            <div class="row">
                                                                                                <div class="col-md-4">
                                                                                                    <label>Ngày đăng</label>
                                                                                                    <input type="text" name="DateProduct" class="form-control" placeholder="@item.ngayDang" disabled="disabled" />
                                                                                                </div>
                                                                                                <div class="col-md-4">
                                                                                                    <label>Tài khoản</label>
                                                                                                    <input type="text" name="Account" class="form-control" placeholder="@item.taiKhoan" disabled="disabled" />
                                                                                                </div>
                                                                                                <div class="col-md-4">
                                                                                                    <label>Trạng thái </label>
                                                                                                    <select name="StatusProduct" class="form-control">
                                                                                                        <option value=true @(item.trangThai == true ? "selected" : "")>Còn hàng</option>
                                                                                                        <option value=false @(item.trangThai == false ? "selected" : "")>Hết hàng</option>
                                                                                                    </select>
                                                                                                </div>
                                                                                            </div>
                                                                                        </div>
                                                                                        <div class="form-group">
                                                                                            <div class="row">
                                                                                                <div class="col-md-2">
                                                                                                    <label>Thương hiệu</label>
                                                                                                    <select class="form-control" name="IDBrand">
                                                                                                        @foreach (var thuonghieu in Brands)
                                                                                                        {
                                                                                                            <option value="@thuonghieu.maThuongHieu" @(item.maThuongHieu == thuonghieu.maThuongHieu ? "selected" : "")>@thuonghieu.tenThuongHieu</option>
                                                                                                        }
                                                                                                    </select>
                                                                                                </div>
                                                                                                <div class="col-md-2">
                                                                                                    <label>Loại sản phẩm</label>
                                                                                                    <select class="form-control" name="IDTypeProduct">
                                                                                                        @foreach (var loai in Categories)
                                                                                                        {
                                                                                                            <option value="@loai.maLoai" @(item.maLoai == loai.maLoai ? "selected" : "")>@loai.tenLoai</option>
                                                                                                        }
                                                                                                    </select>
                                                                                                </div>
                                                                                                <div class="col-md-2">
                                                                                                    <label>Giới tính</label>
                                                                                                    <select class="form-control" name="Sex">
                                                                                                        <option value="Nam" @(item.gioiTinh == true ? "selected" : "")>Nam</option>
                                                                                                        <option value="Nữ" @(item.gioiTinh == false ? "selected" : "")>Nữ</option>
                                                                                                    </select>
                                                                                                </div>
                                                                                                <div class="col-md-2">
                                                                                                    <label>Size</label>
                                                                                                    <input type="text" name="SizeProduct" value="@item.kichThuoc" class="form-control" />
                                                                                                </div>
                                                                                                <div class="col-md-2">
                                                                                                    <label>Giá (VND)</label>
                                                                                                    <div class="input-group">
                                                                                                        <input name="Price"
                                                                                                               class="form-control text-right currency-input"
                                                                                                               value="@item.giaBan"
                                                                                                               autocomplete="off" />
                                                                                                        <div class="input-group-append">
                                                                                                            <span class="input-group-text">₫</span>
                                                                                                        </div>
                                                                                                    </div>
                                                                                                </div>
                                                                                                <div class="col-md-2">
                                                                                                    <label>Giảm giá (VND)</label>
                                                                                                    <div class="input-group">
                                                                                                        <input name="Discount"
                                                                                                               class="form-control text-right currency-input"
                                                                                                               value="@item.giamGia"
                                                                                                               autocomplete="off" />
                                                                                                        <div class="input-group-append">
                                                                                                            <span class="input-group-text">₫</span>
                                                                                                        </div>
                                                                                                    </div>
                                                                                                </div>
                                                                                            </div>
                                                                                        </div>
                                                                                    </div>
                                                                                </div>
                                                                            </div>
                                                                            <div class="row">
                                                                                <div class="col-md-8">
                                                                                    <div class="card card-secondary">
                                                                                        <div class="card-header">
                                                                                            <h3 class="card-title">Hình sản phẩm</h3>
                                                                                        </div>

                                                                                        <div id="imagePreview-@item.maSP" name="images" style="text-align: center;display:inline;">
                                                                                            @foreach (var image in item.danhSachHinhs)
                                                                                            {
                                                                                                if (image.maSP == item.maSP)
                                                                                                {
                                                                                                    <img src="@image.hinhSP" width="150px" />
                                                                                                }
                                                                                            }
                                                                                        </div>
                                                                                        <div class="card-body">
                                                                                            <label for="exampleInputFile-@item.maSP">File input</label>
                                                                                            <div class="input-group">
                                                                                                <div class="custom-file">
                                                                                                    <input type="file" class="custom-file-input" id="exampleInputFile-@item.maSP" name="images" multiple="multiple" data-productid="@item.maSP">
                                                                                                    <label class="custom-file-label" for="exampleInputFile-@item.maSP">Choose file</label>
                                                                                                    <input type="hidden" id="tempImagePath" name="tempImagePath" />
                                                                                                </div>
                                                                                                <div class="input-group-append">
                                                                                                    <button type="button" class="btn btn-primary upload-button" data-productid="@item.maSP">Upload</button>
                                                                                                </div>
                                                                                            </div>
                                                                                        </div>

                                                                                    </div>
                                                                                </div>
                                                                                <div class="col-md-4">
                                                                                    <div class="card card-secondary">
                                                                                        <div class="card-header">
                                                                                            <h3 class="card-title">Hình đại diện sản phẩm</h3>
                                                                                        </div>
                                                                                        <div id="imagePreviewSingle-@item.maSP" min-height="300px" min-width="300px" class="m-auto">
                                                                                            <img src="@item.hinhDD" width="150px" />
                                                                                        </div>
                                                                                        <div class="card-body">
                                                                                            <div class="input-group">
                                                                                                <div class="custom-file">
                                                                                                    <input type="file" class="custom-file-input" id="inputSingleFile-@item.maSP" name="imageAvatar">
                                                                                                    <label class="custom-file-label" for="inputSingleFile-@item.maSP">Chọn ảnh đại diện</label>
                                                                                                </div>
                                                                                            </div>
                                                                                        </div>
                                                                                    </div>
                                                                                </div>
                                                                            </div>
                                                                        </div>
                                                                    </div>
                                                                    <div class="modal-footer">
                                                                        <button type="submit" class="btn btn-primary">Lưu</button>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                }
                                                @using (Html.BeginForm("Delete", "ListProduct", FormMethod.Post))
                                                {
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="idProduct" value="@item.maSP" />
                                                    <button class="btn btn-danger ">Xóa</button>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                                <tfoot>
                                    <tr>
                                        <th>Mã sản phẩm</th>
                                        <th>Tên sản phẩm</th>
                                        <th>Ngày đăng</th>
                                        <th>Giá</th>
                                        <th>Lệnh</th>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.tiny.cloud/1/mjx5bcjxjzsekqcvy1ai2z4fspdr4j94doloncihjvicobhw/tinymce/6/tinymce.min.js" referrerpolicy="origin"></script>

<script>
    $(document).ready(function () {
        $('input[type="file"]').on('change', function () {
            var productId = $(this).data('productid');
            var imagePreview = $('#imagePreview-' + productId);
            var input = this;
            var tempImagePath = $('#tempImagePath');

            var preview = imagePreview;
            preview.empty();

            for (var i = 0; i < input.files.length; i++) {
                var file = input.files[i];
                var reader = new FileReader();

                reader.onload = function (e) {
                    var img = $('<img>').attr('src', e.target.result);
                    img.css('max-width', '150px');
                    preview.append(img);
                    tempImagePath.val(e.target.result);
                };
                reader.readAsDataURL(file);
            }
        });
    });

    $(document).ready(function () {
        $("[id^='inputSingleFile-']").change(function () {
            var maSP = this.id.replace('inputSingleFile-', '');
            showImagePreview(this, maSP);
        });

        $("[id^='inputSingleFile-']").each(function () {
            var maSP = this.id.replace('inputSingleFile-', '');
            var hinhDD = $("#imagePreviewSingle-" + maSP + " img").attr("src");
            showImagePreview(this, maSP, hinhDD);
        });

        function showImagePreview(input, maSP, existingImageSrc) {
            var reader = new FileReader();

            reader.onload = function (e) {
                $("#imagePreviewSingle-" + maSP).html('<img src="' + (e.target.result || existingImageSrc) + '" width="150px"/>');
            };
            reader.readAsDataURL(input.files && input.files[0]);
        }
    });

    tinymce.init({
        selector: '.textarea#ndbv',
        plugins: 'anchor autolink charmap codesample emoticons image link lists media searchreplace table visualblocks wordcount',
        toolbar: 'undo redo | blocks fontfamily fontsize | bold italic underline strikethrough | link image media table | align lineheight | numlist bullist indent outdent | emoticons charmap | removeformat',
    });

    // ====== AUTO FORMAT VND CHO INPUT GIÁ & GIẢM GIÁ TRONG MODAL ======
    function formatVndValue(value) {
        var numeric = value.replace(/[^\d]/g, "");
        if (!numeric) return "";
        var number = parseInt(numeric, 10);
        if (isNaN(number)) return "";
        return number.toLocaleString("vi-VN"); // 1500000 -> "1.500.000"
    }

    (function () {
        // Format tất cả input có class currency-input (trong các modal)
        var currencyInputs = document.querySelectorAll(".currency-input");

        currencyInputs.forEach(function (input) {
            // Khi focus: bỏ format, chỉ để số thô
            input.addEventListener("focus", function () {
                var numeric = this.value.replace(/[^\d]/g, "");
                this.value = numeric;
            });

            // Khi blur: format VND
            input.addEventListener("blur", function () {
                this.value = formatVndValue(this.value);
            });

            // Nếu ban đầu đã có giá trị thì format luôn
            if (input.value) {
                input.value = formatVndValue(input.value);
            }
        });

        // Trước khi submit các form (Update từng sản phẩm): bỏ dấu . , chỉ giữ số
        var forms = document.querySelectorAll("form");
        forms.forEach(function (form) {
            form.addEventListener("submit", function () {
                var inputs = form.querySelectorAll(".currency-input");
                inputs.forEach(function (input) {
                    input.value = input.value.replace(/[^\d]/g, "");
                });
            });
        });
    })();
</script>
