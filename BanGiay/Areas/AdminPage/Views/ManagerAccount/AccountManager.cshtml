@using BanGiay.Models;
@{
    List<taiKhoanThanhVien> Accounts = (ViewData["AccountList"] as List<taiKhoanThanhVien>);
    List<nhomTaiKhoan> Permisstions = (ViewData["PermisstionList"] as List<nhomTaiKhoan>);
    ViewBag.Title = "Quản lý tài khoản";
}
<style>
    form{
        display: inline;
    }
</style>

<div class="content-wrapper">
    <section class="content-header">
        <div class="container-fluid">
            <div class="row mb-2">
                <div class="col-sm-6">
                    <h1>Quản lí tài khoản</h1>
                  
                </div>
                <div class="col-sm-6">
                    <ol class="breadcrumb float-sm-right">
                        <li class="breadcrumb-item"><a href='@Url.Action("Index","Dashboard")'>Dashboard</a></li>
                        <li class="breadcrumb-item active">Quản lí tài khoản</li>
                    </ol>
                </div>
            </div>
        </div>
    </section>

    <section class="content">
        <div class="container-fluid">
            <div class="row">
                <div class="col-12">
                    <div class="card">
                        <div class="card-header">
                            @using (Html.BeginForm("FindAccountByUsername", "ManagerAccount"))
                            {
                                <div class="float-right form-inline">
                                    <input class="form-control" type="search" name="username" placeholder="Nhập tên tài khoản" aria-label="Search">
                                    <div class="input-group-append">
                                        <button class="btn btn-sidebar"><i class="fas fa-search fa-fw"></i></button>
                                    </div>
                                </div>
                            }
                        </div>
                        <div class="card-body">
                            <table id="example2" class="table table-bordered table-hover">
                                <thead>
                                    <tr>
                                        <th>Tài khoản</th>
                                        <th>Số dư</th>
                                        <th>Loại tài khoản</th>
                                        <th>Lệnh</th>
                                        <th>Trạng thái</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Accounts)
                                    {
                                        <tr>
                                            <td>@item.taiKhoan</td>
                                            <td>@item.soTien</td>
                                            <td>@item.nhomTaiKhoan.tenNhom</td>
                                            <td>
                                                @using (Html.BeginForm("DetailAccountUser", "ManagerAccount", FormMethod.Post))
                                                {
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="userName" value="@item.taiKhoan"/>
                                                    <button type="submit" class="btn btn-primary">Chi tiết</button>
                                                }
                                                @using (Html.BeginForm("DisableAccount", "ManagerAccount", FormMethod.Post))
                                                {
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="userName" value="@item.taiKhoan" />
                                                    if (item.trangThai == true)
                                                    {
                                                        <button type="submit" class="btn btn-default">Vô hiệu</button>
                                                    }
                                                    else
                                                    {
                                                        <button type="submit" class="btn btn-warning">Mở khóa</button>
                                                    }
                                                }
                                                @using (Html.BeginForm("DeleteAccount", "ManagerAccount", FormMethod.Post))
                                                {
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="userName" value="@item.taiKhoan" />
                                                    <button type="submit" class="btn btn-danger">Xóa</button>
                                                }
                                            </td>
                                            <td>@(item.trangThai == true ? "Hoạt động" : "cấm")</td>
                                        </tr>
                                    }
                                </tbody>
                                <tfoot>
                                    <tr>
                                        <th>Tài khoản</th>
                                        <th>Số dư</th>
                                        <th>Loại tài khoản</th>
                                        <th>Lệnh</th>
                                        <th>Trạng thái</th>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>
@*<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>*@