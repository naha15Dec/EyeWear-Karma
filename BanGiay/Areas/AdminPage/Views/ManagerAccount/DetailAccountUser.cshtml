@using BanGiay.Models;
@model BanGiay.Models.taiKhoanThanhVien
@{
    ViewBag.Title = "Chi tiết tài khoản";
    List<nhomTaiKhoan> Permisstions = (ViewData["PermisstionList"] as List<nhomTaiKhoan>);
}
<div class="content-wrapper">
    <section class="content-header">
        <div class="container-fluid">
            <div class="row mb-2">
                <div class="col-sm-6">
                    <h1>Profile</h1>
                </div>
                <div class="col-sm-6">
                    <ol class="breadcrumb float-sm-right">
                        <li class="breadcrumb-item"><a href="#">Home</a></li>
                        <li class="breadcrumb-item active">User Profile</li>
                    </ol>
                </div>
            </div>
        </div>
    </section>

    <section class="content">
        <div class="container-fluid">
            <div class="row">
                <div class="col-md-3">

                    <div class="card card-primary card-outline">
                        <div class="card-body box-profile">
                            <div class="text-center">
                                <img class="profile-user-img img-fluid img-circle"
                                     src="~/Asset/img/image_Account.jpg"
                                     alt="User profile picture">
                            </div>

                            <h3 class="profile-username text-center">@Model.hoDem @Model.tenTV</h3>

                            <p class="text-muted text-center">@Model.taiKhoan</p>

                            <ul class="list-group list-group-unbordered mb-3">
                                <li class="list-group-item">
                                    <b>Vai trò</b> <a class="float-right">@Model.nhomTaiKhoan.tenNhom</a>
                                </li>
                                <li class="list-group-item">
                                    <b>Số dư</b> <a class="float-right">@Model.soTien</a>
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>
                <div class="col-md-9">
                    <div class="card">
                        <div class="card-header p-2">
                            <ul class="nav nav-pills">
                                <li class="nav-item"><a class="nav-link active" href="#profileInformationAccount" data-toggle="tab">Thông tin tài khoản</a></li>
                                <li class="nav-item"><a class="nav-link" href="#changePassword" data-toggle="tab">Đổi mật khẩu</a></li>
                                <li class="nav-item"><a class="nav-link" href="#changePermisstion" data-toggle="tab">Vai trò tài khoản</a></li>
                            </ul>
                        </div>
                        <div class="card-body">
                            <div class="tab-content">
                                <div class="tab-pane active" id="profileInformationAccount">
                                    @using (Html.BeginForm("UpdateInformationAccount", "ManagerAccount", FormMethod.Post))
                                    {
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="userName" value="@Model.taiKhoan" />
                                        <div class="form-group row">
                                            <label for="UserName" class="col-sm-2 col-form-label">Tài khoản</label>
                                            <div class="col-sm-10">
                                                <input type="text" class="form-control" id="UserName" name="UserName" value="@Model.taiKhoan" disabled>
                                            </div>
                                        </div>

                                        <div class="form-group row">
                                            <label for="Email" class="col-sm-2 col-form-label">Email</label>
                                            <div class="col-sm-10">
                                                <input type="email" class="form-control" id="Email" name="Email" value="@Model.email">
                                            </div>
                                        </div>
                                        <div class="form-group row">
                                            <label for="Mobile" class="col-sm-2 col-form-label">Số điện thoại</label>
                                            <div class="col-sm-10">
                                                <input type="text" class="form-control" id="Mobile" name="Mobile" value="@Model.soDT">
                                            </div>
                                        </div>
                                        <div class="form-group row">
                                            <label for="LastName" class="col-sm-2 col-form-label">Họ</label>
                                            <div class="col-sm-10">
                                                <input type="text" class="form-control" id="LastName" name="LastName" value="@Model.hoDem">
                                            </div>
                                        </div>
                                        <div class="form-group row">
                                            <label for="FirstName" class="col-sm-2 col-form-label">Tên</label>
                                            <div class="col-sm-10">
                                                <input type="text" class="form-control" id="FirstName" name="FirstName" value="@Model.tenTV">
                                            </div>
                                        </div>
                                        <div class="form-group row">
                                            <label for="DateCreateAccount" class="col-sm-2 col-form-label">Ngày sinh</label>
                                            <div class="col-sm-10">
                                                <input type="text" class="form-control" id="DateCreateAccount" name="DateCreateAccount" value="@(string.Format("{0:dd/MM/yyyy}",Model.ngaysinh))" disabled>
                                            </div>
                                        </div>
                                        <div class="form-group row">
                                            <label class="col-sm-2 col-form-label">Giới tính</label>
                                            <div class="col-sm-10">
                                                <select name="Sex" class="form-control">
                                                    <option value="Nam" @(Model.gioiTinh == true ? "selected" : "")>Nam</option>
                                                    <option value="Nữ" @(Model.gioiTinh == false ? "selected" : "")>Nữ</option>
                                                </select>
                                            </div>
                                        </div>
                                        <div class="form-group row">
                                            <label class="col-sm-2 col-form-label">Địa chỉ</label>
                                            <div class="col-sm-10">
                                                <input type="text" class="form-control" id="Address" name="Address" value="@Model.diaChi">
                                            </div>
                                        </div>
                                        <div class="form-group row">
                                            <label class="col-sm-2 col-form-label">Trạng thái</label>
                                            <div class="col-sm-10">
                                                <input type="text" class="form-control" id="StatusAccount" name="StatusAccount" value="@(Model.trangThai == true ? "Hoạt động" : "Cấm")" disabled>
                                            </div>
                                        </div>
                                        <div class="form-group row">
                                            <div class="offset-sm-2 col-sm-10">
                                                <button type="submit" class="btn btn-success">Lưu</button>
                                            </div>
                                        </div>
                                    }
                                </div>
                                <div class="tab-pane" id="changePassword">
                                    @using (Html.BeginForm("ChangePassword", "ManagerAccount", FormMethod.Post))
                                    {
                                        @Html.AntiForgeryToken()
                                        <div class="form-group row">
                                            <input type="hidden" name="userName" value="@Model.taiKhoan" />
                                            <label for="inputName" class="col-sm-2 col-form-label">Tài khoản</label>
                                            <div class="col-sm-10">
                                                <input type="text" class="form-control" id="inputName" name="UserName" value="@Model.taiKhoan" disabled>
                                            </div>
                                        </div>
                                        <div class="form-group row">
                                            <label for="Password" class="col-sm-2 col-form-label">Mật khẩu mới</label>
                                            <div class="col-sm-10">
                                                <input type="password" class="form-control" id="Password" name="Password">
                                            </div>
                                        </div>
                                        <div class="form-group row">
                                            <label for="ComfirmPassword" class="col-sm-2 col-form-label">Nhập lại mật khẩu mới</label>
                                            <div class="col-sm-10">
                                                <input type="password" class="form-control" id="ComfirmPassword" name="ComfirmPassword">
                                            </div>
                                        </div>
                                        <div class="form-group row">
                                            <div class="offset-sm-2 col-sm-10">
                                                <button type="submit" class="btn btn-success">Lưu</button>
                                            </div>
                                        </div>
                                    }
                                </div>

                                <div class="tab-pane" id="changePermisstion">
                                    @using (Html.BeginForm("UpdatePermisstionAccount", "ManagerAccount", FormMethod.Post))
                                    {
                                        @Html.AntiForgeryToken()
                                        <div class="form-group row">
                                            <input type="hidden" name="userName" value="@Model.taiKhoan" />
                                            <label for="inputName" class="col-sm-2 col-form-label">Tài khoản</label>
                                            <div class="col-sm-10">
                                                <input type="text" class="form-control" id="inputName" name="UserName" value="@Model.taiKhoan" disabled>
                                            </div>
                                        </div>
                                        <div class="form-group row">
                                            <label for="inputName" class="col-sm-2 col-form-label">Vai trò</label>
                                            <div class="col-sm-10">
                                                <select name="permisstionID" class="form-control">
                                                    @foreach (var permisstion in Permisstions)
                                                    {
                                                        <option value="@permisstion.maNhom" @(Model.nhomTaiKhoan.tenNhom.Equals(permisstion.tenNhom) ? "selected":"")>@permisstion.tenNhom</option>
                                                    }
                                                </select>
                                            </div>
                                        </div>
                                        <div class="form-group row">
                                            <div class="offset-sm-2 col-sm-10">
                                                <button type="submit" class="btn btn-success">Lưu</button>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>

