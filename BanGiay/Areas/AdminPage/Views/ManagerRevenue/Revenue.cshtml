@using BanGiay.Models;
@{
    ViewBag.Title = "Quản lý doanh thu";
}
<div class="content-wrapper">
    <div class="card">
        <div class="card-footer">
            <div class="row">
                <div class="col-sm-4 col-6">
                    <div class="description-block border-right">
                        <h5 class="description-header">@(string.Format("{0 :N0}", (int)ViewData["totalRevenue"]))</h5> 
                        <span class="description-text">Tổng doanh thu</span>
                    </div>
                </div>
                <div class="col-sm-4 col-6">
                    <div class="description-block border-right">
                        <h5 class="description-header">@(string.Format("{0 :N0}", (int)ViewData["totalMonthRevenue"]))</h5>
                        <span class="description-text">Doanh thu tháng</span>
                    </div>
                </div>
                <div class="col-sm-4 col-12">
                    <div class="description-block">
                        <h5 class="description-header">@(string.Format("{0 :N0}", (int)ViewData["totalTodayRevenue"]))</h5>
                        <span class="description-text">Doanh thu hôm nay</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card-body">
        <div class="tab-content">
            <div class="tab-pane active" id="profileInformationAccount">
                <input type="hidden" name="idAccount" value="" />
                <div class="form-group row">
                    <label  class="col-sm-4 col-form-label">Số sản phẩm đã bán hôm nay</label>
                    <div class="col-sm-8">
                        <input type="text" class="form-control"  value="@((int)ViewData["totalProductSoldToday"])" disabled>
                    </div>
                </div>
                <div class="form-group row">
                    <label class="col-sm-4 col-form-label">Số sản phẩm đã bán trong tháng này</label>
                    <div class="col-sm-8">
                        <input type="text" class="form-control"value="@((int)ViewData["totalProductSoldMonth"])" disabled>
                    </div>
                </div>
                <div class="form-group row">
                    <label class="col-sm-4 col-form-label">Số đơn hàng đã thành công trong tháng này</label>
                    <div class="col-sm-8">
                        <input type="text" class="form-control" value="@((int)ViewData["totalOrderSuccess"])" disabled>
                    </div>
                </div>
                <div class="form-group row">
                    <label class="col-sm-4 col-form-label">Số đơn hàng thanh toán tự động trong tháng</label>
                    <div class="col-sm-8">
                        <input type="text" class="form-control" value="@((int)ViewData["totalOrderPaymentAuto"])" disabled>
                    </div>
                </div>
                <div class="form-group row">
                    <label class="col-sm-4 col-form-label">Số đơn hàng thanh toán sau khi giao trong tháng</label>
                    <div class="col-sm-8">
                        <input type="text" class="form-control" value="@((int)ViewData["totalOrderPaymentAfterDelivery"])" disabled>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


