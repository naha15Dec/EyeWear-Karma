@using BanGiay.Models;
@model BanGiay.ViewModel.UpdateAccount
@{
    ViewBag.Title = "Thông tin";
    taiKhoanThanhVien Account = (Session["LoginInformation"] as taiKhoanThanhVien);

}
<div class="content-wrapper">
    <section class="content-header">
        <div class="container-fluid">
            <div class="row mb-2">
                <div class="col-sm-6">
                    <h1>Thông tin tài khoản</h1>
                </div>
                <div class="col-sm-6">
                    <ol class="breadcrumb float-sm-right">
                        <li class="breadcrumb-item"><a href='@Url.Action("Index","Dashboard")'>Dashboard</a></li>
                        <li class="breadcrumb-item active">Thông tin</li>
                    </ol>
                </div>
            </div>
        </div>
    </section>

    <section class="content">
        <div class="container-fluid">
            <div class="row">
                <div class="col-md-3">

                    <div class="card card-primary card-outline">
                        <div class="card-body box-profile">
                            <div class="text-center">
                                <img class="profile-user-img img-fluid img-circle"
                                     src="~/Asset/img/image_Account.jpg"
                                     alt="User profile picture">
                            </div>

                            <h3 class="profile-username text-center">@Account.hoDem @Account.tenTV</h3>

                            <p class="text-muted text-center">@Account.taiKhoan</p>

                            <ul class="list-group list-group-unbordered mb-3">
                                <li class="list-group-item">
                                    <b>Số dư</b> <a class="float-right">@Account.soTien</a>
                                </li>
                                <li class="list-group-item">
                                    <b>Nhóm tài khoản </b> <a class="float-right">@Account.nhomTaiKhoan.tenNhom</a>
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>
                <div class="col-md-9">
                    <div class="card">
                        <div class="card-header p-2">
                            <ul class="nav nav-pills">
                                <li class="nav-item"><a class="nav-link active" href="#profileInformationAccount" data-toggle="tab">Thông tin tài khoản</a></li>
                                <li class="nav-item"><a class="nav-link" href="#changePassword" data-toggle="tab">Đổi mật khẩu</a></li>

                            </ul>
                        </div>
                        <div class="card-body">
                            <div class="tab-content">
                                <div class="tab-pane active" id="profileInformationAccount">
                                    @using (Html.BeginForm("UpdateInformationAccount", "Profile", FormMethod.Post))
                                    {
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="idAccount" value="@Account.taiKhoan" />
                                        <div class="form-group row">
                                            <label for="UserName" class="col-sm-2 col-form-label">Tài khoản</label>
                                            <div class="col-sm-10">
                                                <input type="text" class="form-control" id="UserName" name="UserName" value="@Account.taiKhoan" disabled>
                                            </div>
                                        </div>
                                        //adsd
                                        <div class="form-group row">
                                            <label for="AmountOfMoney" class="col-sm-2 col-form-label">Số dư</label>
                                            <div class="col-sm-10">
                                                <input type="text" class="form-control" id="AmountOfMoney" name="AmountOfMoney" value="@Account.soTien">
                                            </div>
                                        </div>

                                        <div class="form-group row">
                                            <label for="Email" class="col-sm-2 col-form-label">Email</label>
                                            <div class="col-sm-10">
                                                <input type="email" class="form-control" id="Email" name="Email" value="@Account.email" disabled>
                                            </div>
                                        </div>
                                        <div class="form-group row">
                                            <label for="Mobile" class="col-sm-2 col-form-label">Số điện thoại</label>
                                            <div class="col-sm-10">
                                                <input type="text" class="form-control" id="Mobile" name="Mobile" value="@Account.soDT">
                                            </div>
                                        </div>
                                        <div class="form-group row">
                                            <label for="LastName" class="col-sm-2 col-form-label">Họ</label>
                                            <div class="col-sm-10">
                                                <input type="text" class="form-control" id="LastName" name="LastName" value="@Account.hoDem">
                                            </div>
                                        </div>
                                        <div class="form-group row">
                                            <label for="FirstName" class="col-sm-2 col-form-label">Tên</label>
                                            <div class="col-sm-10">
                                                <input type="text" class="form-control" id="FirstName" name="FirstName" value="@Account.tenTV">
                                            </div>
                                        </div>
                                        <div class="form-group row">
                                            <label class="col-sm-2 col-form-label">Giới tính</label>
                                            <div class="col-sm-10">
                                                <select name="Sex" class="form-control">
                                                    <option value="Nam" @(Account.gioiTinh == true ? "selected" : "")>Nam</option>
                                                    <option value="Nữ" @(Account.gioiTinh == false ? "selected" : "")>Nữ</option>
                                                </select>
                                            </div>
                                        </div>
                                        <div class="form-group row">
                                            <label class="col-sm-2 col-form-label">Địa chỉ</label>
                                            <div class="col-sm-10">
                                                <input type="text" class="form-control" id="Address" name="Address" value="@Account.diaChi">
                                            </div>
                                        </div>
                                        <div class="form-group row">
                                            <label class="col-sm-2 col-form-label">Trạng thái tài khoản</label>
                                            <div class="col-sm-10">
                                                <input type="text" class="form-control" id="StatusAccount" name="StatusAccount" value="@(Account.trangThai == true ? "Hoạt động" : "Cấm")" disabled>
                                            </div>
                                        </div>
                                        <div class="form-group row">
                                            <div class="offset-sm-2 col-sm-10">
                                                <button type="submit" class="btn btn-success">Lưu</button>
                                            </div>
                                        </div>
                                    }
                                </div>
                                <div class="tab-pane" id="changePassword">
                                    @using (Html.BeginForm("ChangePasswordAccount", "Profile", FormMethod.Post))
                                    {
                                        @Html.AntiForgeryToken()
                                        <div class="form-group row">
                                            <input type="hidden" name="idAccount" value="@Account.taiKhoan" />
                                            <label for="inputName" class="col-sm-2 col-form-label">Tài khoản</label>
                                            <div class="col-sm-10">
                                                <input type="text" class="form-control" id="inputName" name="UserName" value="@Account.taiKhoan" disabled>
                                            </div>
                                        </div>
                                        <div class="form-group row">
                                            <label for="inputPassCurrent" class="col-sm-2 col-form-label">Mật khẩu cũ</label>
                                            <div class="col-sm-10">
                                                <input type="password" class="form-control" id="inputPassCurrent" name="passwdCurrent">
                                            </div>
                                        </div>
                                        <div class="form-group row">
                                            <label for="Password" class="col-sm-2 col-form-label">Mật khẩu mới</label>
                                            <div class="col-sm-10">
                                                <input type="password" class="form-control" id="Password" name="Password">
                                            </div>
                                        </div>
                                        <div class="form-group row">
                                            <label for="ComfirmPassword" class="col-sm-2 col-form-label">Nhập lại mật khẩu mới</label>
                                            <div class="col-sm-10">
                                                <input type="password" class="form-control" id="ComfirmPassword" name="ComfirmPassword">
                                            </div>
                                        </div>
                                        <div class="form-group row">
                                            <div class="offset-sm-2 col-sm-10">
                                                <button type="submit" class="btn btn-success">Lưu</button>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>
