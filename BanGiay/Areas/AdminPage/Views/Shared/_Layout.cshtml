@using BanGiay.Models;
@{ 
    taiKhoanThanhVien account = (Session["LoginInformation"] as taiKhoanThanhVien);
    DoAnLTW2Entities db = new DoAnLTW2Entities();
    int NumberOfPostWaitingActivate = db.baiViets.Where(m => m.daDuyet == false).Count();
    int NumberOfOrderProcessing = db.donHangs.Where(m => m.trangThai == false).Count();
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - Admin</title>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Source+Sans+Pro:300,400,400i,700&display=fallback">
    <link rel="stylesheet" href="https://code.ionicframework.com/ionicons/2.0.1/css/ionicons.min.css">
    <link href="/Content/fontawesome-free/css/all.min.css" rel="stylesheet" />
    <link href="/Content/adminlte.min.css" rel="stylesheet" />
    <link href="/Content/dataTables.bootstrap4.min.css" rel="stylesheet" />
    <link href="/Content/responsive.bootstrap4.min.css" rel="stylesheet" />
    <link href="/Content/buttons.bootstrap4.min.css" rel="stylesheet" />
    <link href="/Content/ekko-lightbox.css" rel="stylesheet" />
    <link href="~/Content/tempusdominus-bootstrap-4.min.css" rel="stylesheet" />
    <link href="~/Content/icheck-bootstrap.min.css" rel="stylesheet" />
    <link href="~/Content/jqvmap.min.css" rel="stylesheet" />
    <link href="~/Content/OverlayScrollbars.min.css" rel="stylesheet" />
    <link href="~/Content/daterangepicker.css" rel="stylesheet" />
    <link href="~/Content/summernote-bs4.min.css" rel="stylesheet" />
</head>
<body>
    <div class="wrapper">
        <nav class="main-header navbar navbar-expand navbar-white navbar-light">
            <ul class="navbar-nav">
                <li class="nav-item"><a class="nav-link" data-widget="pushmenu" href="#" role="button"><i class="fas fa-bars"></i></a></li>
                <li class="nav-item d-none d-sm-inline-block"><a href="@Url.Action("Index","Home",new {area="" })" class="nav-link">Trang chủ website</a></li>
            </ul>
            <ul class="navbar-nav ml-auto">
                <li class="nav-item dropdown user-menu">
                    <a href="#" class="nav-link dropdown-toggle" data-toggle="dropdown">
                        <img src="~/Asset/img/image_Account.jpg" class="user-image img-circle elevation-2" alt="User Image">
                        <span class="d-none d-md-inline">@account.hoDem @account.tenTV</span>
                    </a>
                    <ul class="dropdown-menu dropdown-menu-lg dropdown-menu-right">
                        <li class="user-header bg-primary">
                            <img src="~/Asset/img/image_Account.jpg" class="img-circle elevation-2" alt="User Image">
                            <p>@account.hoDem @account.tenTV<small>@account.taiKhoan</small></p>
                        </li>
                        <li class="user-footer">
                            <a href="@Url.Action("Index","Profile")" class="btn btn-default btn-flat">Thông tin</a>
                            <a href="@Url.Action("LogoutAccount","Account",new {area="" })" class="btn btn-default btn-flat float-right">Đăng xuất</a>
                        </li>
                    </ul>
                </li>
                <li class="nav-item">
                    <a class="nav-link" data-widget="fullscreen" href="#" role="button"><i class="fas fa-expand-arrows-alt"></i></a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" data-widget="control-sidebar" data-slide="true" href="#" role="button"><i class="fas fa-th-large"></i></a>
                </li>
            </ul>
        </nav>
        <aside class="main-sidebar sidebar-dark-primary elevation-4">
            <a href="@Url.Action("Index","Dashboard")" class="brand-link">
                <img src="~/Asset/img/AdminLTELogo.png" alt="AdminLTE Logo" class="brand-image img-circle elevation-3" style="opacity: .8">
                <span class="brand-text font-weight-light">KarmaEyewear</span>
            </a>
            <div class="sidebar">
                <nav class="mt-2">
                    <ul class="nav nav-pills nav-sidebar flex-column" data-widget="treeview" role="menu" data-accordion="false">
                        <li class="nav-item">
                            <a href='@Url.Action("Index","Dashboard")' class="nav-link">
                                <i class="nav-icon fas fa-tachometer-alt"></i>
                                <p>Dashboard</p>
                            </a>
                        </li>
                        <li class="nav-header">Nhân viên</li>
                        <li class="nav-item">
                            <a href="#" class="nav-link">
                                <i class="nav-icon fas fa-copy"></i>
                                <p>Bài viết<i class="fas fa-angle-left right"></i></p>
                            </a>
                            <ul class="nav nav-treeview">
                                <li class="nav-item">
                                    <a href='@Url.Action("AddBlog","ListBlog")' class="nav-link">
                                        <i class="far fa-circle nav-icon"></i>
                                        <p>Thêm bài viết</p>
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a href='@Url.Action("BlogList","ListBlog",new{typeBlog="enable" })' class="nav-link">
                                        <i class="far fa-circle nav-icon"></i>
                                        <p>Danh sách bài viết</p>
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a href='@Url.Action("BlogList","ListBlog",new{typeBlog="not enable" })' class="nav-link">
                                        <i class="far fa-circle nav-icon"></i>
                                        <p>Danh sách chờ duyệt</p>
                                    </a>
                                </li>
                            </ul>
                        </li>
                        <li class="nav-item">
                            <a href="#" class="nav-link"><i class="nav-icon far fa-plus-square"></i><p>Sản phẩm<i class="right fas fa-angle-left"></i></p></a>
                            <ul class="nav nav-treeview">
                                <li class="nav-item">
                                    <a href='@Url.Action("AddProduct","ListProduct")' class="nav-link"><i class="far fa-circle nav-icon"></i><p>Thêm sản phẩm</p></a>
                                </li>
                                <li class="nav-item">
                                    <a href='@Url.Action("ProductsList","ListProduct")' class="nav-link"><i class="far fa-circle nav-icon"></i><p>Danh sách sản phẩm</p></a>
                                </li>
                                <li class="nav-item">
                                    <a href='@Url.Action("ProductType","ListTypeProduct")' class="nav-link"><i class="far fa-circle nav-icon"></i><p>Loại sản phẩm</p></a>
                                </li>
                                <li class="nav-item">
                                    <a href='@Url.Action("Brand","ListBrand")' class="nav-link"><i class="far fa-circle nav-icon"></i><p>Thương hiệu</p></a>
                                </li>
                            </ul>
                        </li>
                        <li class="nav-item">
                            <a href="#" class="nav-link">
                                <i class="nav-icon fas fa-tree"></i>
                                <p>Đơn hàng
                                    <i class="fas fa-angle-left right"></i>
                                    @if (NumberOfOrderProcessing > 0){<span class="badge badge-danger right">@NumberOfOrderProcessing</span>}
                                </p>
                            </a>
                            <ul class="nav nav-treeview">
                                <li class="nav-item">
                                    <a href="@Url.Action("OrdersList","ListOrder",new {enable="disable"})" class="nav-link">
                                        <i class="far fa-circle nav-icon"></i>
                                        <p>Đơn hàng đang xử lí</p>
                                        @if (NumberOfOrderProcessing > 0){<span class="badge badge-danger right">@NumberOfOrderProcessing</span>}
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a href="@Url.Action("OrdersList","ListOrder",new {enable="enable"})" class="nav-link">
                                        <i class="far fa-circle nav-icon"></i>
                                        <p>Đơn hàng thành công</p>
                                    </a>
                                </li>
                            </ul>
                        </li>
                        <li class="nav-header">Quản trị</li>
                        <li class="nav-item">
                            <a href="#" class="nav-link">
                                <i class="nav-icon fas fa-book"></i>
                                <p>
                                    Quản lý bài viết
                                    <i class="fas fa-angle-left right"></i>

                                    @if (NumberOfPostWaitingActivate > 0 && account.maNhom == 1)
                                    {
                                        <span class="badge badge-danger right">@NumberOfPostWaitingActivate</span>
                                    }
                                </p>
                            </a>
                            <ul class="nav nav-treeview">
                                <li class="nav-item">
                                    <a href="@Url.Action("ManagerBlog","ManagerBlog",new {activate="activate"})" class="nav-link">
                                        <i class="far fa-circle nav-icon"></i>
                                        <p>Bài viết đã duyệt</p>
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a href="@Url.Action("ManagerBlog","ManagerBlog",new {activate="not_activate"})" class="nav-link">
                                        <i class="far fa-circle nav-icon"></i>
                                        <p>Bài viết chờ duyệt</p>
                                        @if (NumberOfPostWaitingActivate > 0 && account.maNhom == 1)
                                        {
                                            <span class="badge badge-danger right">@NumberOfPostWaitingActivate</span>
                                        }

                                    </a>
                                </li>
                            </ul>
                        </li>
                        <li class="nav-item">
                            <a href="#" class="nav-link">
                                <i class="nav-icon fas fa-book"></i>
                                <p>
                                    Quản lý sản phẩm
                                    <i class="fas fa-angle-left right"></i>
                                </p>
                            </a>
                            <ul class="nav nav-treeview">
                                <li class="nav-item">
                                    <a href="@Url.Action("Index","ManagerProduct",new {statusProduct="stock"})" class="nav-link">
                                        <i class="far fa-circle nav-icon"></i>
                                        <p>Danh sách còn hàng</p>
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a href="@Url.Action("Index","ManagerProduct",new {statusProduct="outOfStock"})" class="nav-link">
                                        <i class="far fa-circle nav-icon"></i>
                                        <p>Danh sách hết hàng</p>
                                    </a>
                                </li>
                            </ul>
                        </li>
                        <li class="nav-item">
                            <a href="@Url.Action("AccountManager","ManagerAccount")" class="nav-link">
                                <i class="nav-icon fas fa-key"></i>
                                <p>Quản lý tài khoản</p>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a href="@Url.Action("Revenue","ManagerRevenue")" class="nav-link">
                                <i class="nav-icon fas fa-money-bill-wave"></i>
                                <p>Doanh thu</p>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a href="@Url.Action("Index","SettingInformationWebsite")" class="nav-link">
                                <i class="nav-icon fas fa-money-bill-wave"></i>
                                <p>Thông tin cửa hàng</p>
                            </a>
                        </li>
                    </ul>
                </nav>
            </div>
        </aside>
        @RenderBody()
        <footer class="main-footer">
            <strong>Copyright <a href="https://karmasneaker.site">KarmaEyeWear.site</a>.</strong>
        </footer>
    </div>


    <script src="~/Scripts/jquery.min.js"></script>
    <script src="~/Scripts/bootstrap.bundle.min.js"></script>
    <script src="~/Scripts/adminlte.min.js"></script>
    <script src="~/Scripts/demo.js"></script>
    <script src="~/Scripts/jquery.dataTables.min.js"></script>
    <script src="~/Scripts/dataTables.bootstrap4.min.js"></script>
    <script src="~/Scripts/dataTables.responsive.min.js"></script>
    <script src="~/Scripts/responsive.bootstrap4.min.js"></script>
    <script src="~/Scripts/dataTables.buttons.min.js"></script>
    <script src="~/Scripts/buttons.bootstrap4.min.js"></script>
    <script src="~/Scripts/jszip.min.js"></script>
    <script src="~/Scripts/pdfmake.min.js"></script>
    <script src="~/Scripts/vfs_fonts.js"></script>
    <script src="~/Scripts/buttons.html5.min.js"></script>
    <script src="~/Scripts/buttons.print.min.js"></script>
    <script src="~/Scripts/buttons.colVis.min.js"></script>
    <script src="~/Scripts/ekko-lightbox.min.js"></script>
    <script src="~/Scripts/jquery.filterizr.min.js"></script>
    <script src="~/Scripts/jquery-ui.min.js"></script>
    <script src="~/Scripts/Chart.min.js"></script>
    <script src="~/Scripts/sparkline.js"></script>
    <script src="~/Scripts/jquery.vmap.min.js"></script>
    <script src="~/Scripts/jquery.vmap.usa.js"></script>
    <script src="~/Scripts/jquery.knob.min.js"></script>
    <script src="~/Scripts/moment.min.js"></script>
    <script src="~/Scripts/daterangepicker.js"></script>
    <script src="~/Scripts/tempusdominus-bootstrap-4.min.js"></script>
    <script src="~/Scripts/jquery.overlayScrollbars.min.js"></script>
    <script src="~/Scripts/dashboard.js"></script>

    <script>
        $(function () {
            $("#example1").DataTable({
                "responsive": true, "lengthChange": false, "autoWidth": false,
                "buttons": ["copy", "csv", "excel", "pdf", "print", "colvis"]
            }).buttons().container().appendTo('#example1_wrapper .col-md-6:eq(0)');
            $('#example2').DataTable({
                "paging": true,
                "lengthChange": false,
                "searching": false,
                "ordering": true,
                "info": true,
                "autoWidth": false,
                "responsive": true,
            });
        });
        $.widget.bridge('uibutton', $.ui.button)
    </script>
</body>
</html>