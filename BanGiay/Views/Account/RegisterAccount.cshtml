@model BanGiay.ViewModel.Register
@{
    ViewBag.Title = "Đăng ký";
}
<section class="banner-area organic-breadcrumb">
    <div class="container">
        <div class="breadcrumb-banner d-flex flex-wrap align-items-center justify-content-end">
            <div class="col-first">
                <h1>Đăng ký</h1>
                <nav class="d-flex align-items-center">
                    <a href="@Url.Action("Index","Home")">Trang chủ<span class="lnr lnr-arrow-right"></span></a>
                    <a href="@Url.Action("RegisterAccount","Account")">Đăng ký</a>
                </nav>
            </div>
        </div>
    </div>
</section>

<section class="login_box_area section_gap">
    <div class="container">
        <div class="row">
            <!-- Cột hình + link đăng nhập -->
            <div class="col-lg-6">
                <div class="login_box_img">
                    <img class="img-fluid" src="@Url.Content("~/Asset/img/login.jpg")" alt="Đăng ký">
                    <div class="hover">
                        <h4>Bạn đã có tài khoản ?</h4>
                        <p>Nếu đã có hãy click đăng nhập vào website để tận hưởng thời gian mua sắm</p>
                        <a class="primary-btn" href='@Url.Action("LoginAccount","Account")'>Đăng nhập</a>
                    </div>
                </div>
            </div>

            <!-- Cột form -->
            <div class="col-lg-6">
                <div class="login_form_inner register_form">
                    <h3>Đăng ký</h3>

                    @using (Html.BeginForm("RegisterAccount", "Account", FormMethod.Post, new { @class = "row login_form", id = "registerForm", autocomplete = "off" }))
                    {
                        @Html.AntiForgeryToken()

                        <div class="col-md-12">
                            @Html.ValidationSummary(true, "", new { @style = "color:red; margin-bottom:10px;" })
                            <div id="ajaxMessage" style="color:red; margin-bottom:10px;"></div>
                        </div>

                        <div class="col-md-12 form-group">
                            @Html.TextBoxFor(m => m.Username, new { @class = "form-control", placeholder = "Tài khoản" })
                            @Html.ValidationMessageFor(m => m.Username, "", new { @style = "color:red;" })
                        </div>
                        <div class="col-md-12 form-group">
                            @Html.PasswordFor(m => m.Password, new { @class = "form-control", placeholder = "Mật khẩu" })
                            @Html.ValidationMessageFor(m => m.Password, "", new { @style = "color:red;" })
                        </div>
                        <div class="col-md-12 form-group">
                            @Html.PasswordFor(m => m.ComfirmPassword, new { @class = "form-control", placeholder = "Nhập lại mật khẩu" })
                            @Html.ValidationMessageFor(m => m.ComfirmPassword, "", new { @style = "color:red;" })
                        </div>
                        <div class="col-md-6 form-group">
                            @Html.TextBoxFor(m => m.Mobile, new { @class = "form-control", placeholder = "Số điện thoại" })
                            @Html.ValidationMessageFor(m => m.Mobile, "", new { @style = "color:red;" })
                        </div>
                        <div class="col-md-6 form-group">
                            @Html.TextBoxFor(m => m.Email, new { @class = "form-control", placeholder = "Email" })
                            @Html.ValidationMessageFor(m => m.Email, "", new { @style = "color:red;" })
                        </div>
                        <div class="col-md-6 form-group">
                            @Html.TextBoxFor(m => m.LastName, new { @class = "form-control", placeholder = "Họ" })
                            @Html.ValidationMessageFor(m => m.LastName, "", new { @style = "color:red;" })
                        </div>
                        <div class="col-md-6 form-group">
                            @Html.TextBoxFor(m => m.FirstName, new { @class = "form-control", placeholder = "Tên" })
                            @Html.ValidationMessageFor(m => m.FirstName, "", new { @style = "color:red;" })
                        </div>
                        <div class="col-md-6 form-group">
                            @Html.TextBoxFor(m => m.DateOfBirth, new { @class = "form-control", type = "date" })
                            @Html.ValidationMessageFor(m => m.DateOfBirth, "", new { @style = "color:red;" })
                        </div>
                        <div class="col-md-6 form-group">
                            @{
                                var sexList = new[]
                                {
                                    new { Value = "", Text = "Chọn giới tính" },
                                    new { Value = "Nam", Text = "Nam" },
                                    new { Value = "Nữ", Text = "Nữ" }
                                };
                            }
                            @Html.DropDownListFor(
                                m => m.Sex,
                                new SelectList(sexList, "Value", "Text"),
                                new { @class = "form-control w-100 h-100" })
                            @Html.ValidationMessageFor(m => m.Sex, "", new { @style = "color:red;" })
                        </div>

                        <div class="col-md-12 form-group">
                            <button type="submit" class="primary-btn" id="btnRegister">Đăng ký</button>

                            <a style="cursor:pointer; margin-left:15px;" data-toggle="modal" data-target="#customModal">
                                Quên mật khẩu
                            </a>

                            <!-- Modal quên mật khẩu -->
                            <div class="modal fade" id="customModal" tabindex="-1" role="dialog">
                                <div class="modal-dialog custom-modal-dialog">
                                    <div class="modal-content">
                                        <div class="modal-header">
                                            <h5 class="modal-title">Thông báo</h5>
                                            <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                                                <span aria-hidden="true">&times;</span>
                                            </button>
                                        </div>
                                        <div class="modal-body">
                                            <p>
                                                Bạn hãy liên hệ qua thông tin để được cấp lại mật khẩu:
                                                <a href="tel:0942962762"><i class="fa fa-phone"></i> 094.296.2762</a>
                                                <a href="mailto:nguyennhat025.go@gmail.com"><i class="fa fa-envelope"></i> nguyennhat025.go@gmail.com</a>
                                            </p>
                                        </div>
                                        <div class="modal-footer">
                                            <button type="button" class="btn btn-secondary" data-dismiss="modal">Đóng</button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</section>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<!-- Nếu layout của bạn đã có jQuery rồi thì có thể bỏ dòng trên -->

<script>
    $(function () {

        $("#registerForm").on("submit", function (e) {
            e.preventDefault(); // Không reload trang

            var form = $(this);

            // Nếu đang dùng unobtrusive validation phía client
            if (form.valid && !form.valid()) {
                return; // Form phía client đã lỗi → không gửi Ajax
            }

            $("#btnRegister").prop("disabled", true).text("Đang xử lý...");
            $("#ajaxMessage").empty();

            $.ajax({
                url: form.attr("action"),
                type: "POST",
                data: form.serialize(),
                success: function (resp) {
                    if (resp.success) {
                        window.location.href = resp.redirectUrl;
                    } else {
                        showErrors(resp);
                    }
                },
                error: function () {
                    $("#ajaxMessage").text("Có lỗi xảy ra, vui lòng thử lại!");
                },
                complete: function () {
                    $("#btnRegister").prop("disabled", false).text("Đăng ký");
                }
            });
        });

        function clearFieldErrors() {
            $("span.field-validation-error, span.field-validation-valid").text("");
        }

        function showErrors(resp) {
            clearFieldErrors();
            $("#ajaxMessage").empty();

            if (resp.globalErrors && resp.globalErrors.length > 0) {
                $("#ajaxMessage").html(resp.globalErrors.join("<br/>"));
            }

            if (resp.fieldErrors) {
                for (var key in resp.fieldErrors) {
                    if (!resp.fieldErrors.hasOwnProperty(key)) continue;

                    var msg = resp.fieldErrors[key];
                    var span = $("span[data-valmsg-for='" + key + "']");
                    if (span.length) {
                        span.text(msg);
                    }
                }
            }
        }
    });
</script>
