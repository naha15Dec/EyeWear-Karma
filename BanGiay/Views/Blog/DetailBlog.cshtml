@using BanGiay.Models;
@model BanGiay.Models.baiViet
@{
    ViewBag.Title = "Chi tiết bài viết";
    List<baiViet> listPopular = (ViewData["listPostPopular"] as List<baiViet>);
}
<section class="banner-area organic-breadcrumb">
    <div class="container">
        <div class="breadcrumb-banner d-flex flex-wrap align-items-center justify-content-end">
            <div class="col-first">
                <h1>Chi tiết bài viết</h1>
                <nav class="d-flex align-items-center">
                    <a href='@Url.Action("Index","Home")'>Trang chủ<span class="lnr lnr-arrow-right"></span></a>
                    <a href='@Url.Action("Index","Blog")'>Bài viết<span class="lnr lnr-arrow-right"></span></a>
                    <a href="category.html">Chi tiết bài viết</a>
                </nav>
            </div>
        </div>
    </div>
</section>
<section class="blog_area single-post-area section_gap">
    <div class="container">
        <div class="row">
            <div class="col-lg-8 posts-list">
                <div class="single-post row">
                    <div class="col-lg-3  col-md-3">
                        <div class="blog_info text-right">
                            <ul class="blog_meta list">
                                <li><a href="#">@Model.taiKhoanThanhVien.tenTV<i class="lnr lnr-user"></i></a></li>
                                <li><a href="#">@string.Format("{0: dd/MM/yyyy}", Model.ngayDang)<i class="lnr lnr-calendar-full"></i></a></li>
                                <li><a href="#">@Model.luotXem<i class="lnr lnr-eye"></i></a></li>
                            </ul>

                        </div>
                    </div>
                    <div class="col-lg-9 col-md-9 blog_details">
                        <h2>@Model.tenBV</h2>
                        <p class="excert">
                            @Model.ndTomTat
                        </p>
                    </div>
                    <div class="col-lg-12">
                        <div class="row">
                            <div class="col-lg-12 mt-25">
                                <p>
                                    @Html.Raw(Model.noiDung)
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="navigation-area">
                    <a href='@Url.Action("Index","Blog")'>Quay về</a>
                </div>
            </div>
            <div class="col-lg-4">
                <div class="blog_right_sidebar">
                    <aside class="single_sidebar_widget search_widget">
                        @using (Html.BeginForm("FindBlogByName", "Blog", FormMethod.Post))
                        {
                            <div class="input-group">
                                <input type="text" class="form-control" placeholder="Tìm kiếm bài viết" name="namePost" onfocus="this.placeholder = ''" onblur="this.placeholder = 'Search Posts'">
                                <span class="input-group-btn">
                                    <button class="btn btn-default" type="submit"><i class="lnr lnr-magnifier"></i></button>
                                </span>
                            </div>
                            <div class="br"></div>
                        }
                    </aside>
                    <aside class="single_sidebar_widget popular_post_widget">
                        <h3 class="widget_title">Bài viết phổ biến</h3>
                        @foreach (var postPopular in listPopular)
                        {
                            <div class="media post_item">
                                <img src="@postPopular.hinhDD" width="85px" height="85px" alt="post" />
                                <div class="media-body">
                                    <a href="@Url.Action("DetailBlog","Blog",new {idBlog=postPopular.maBV})">
                                        <h3>
                                            @if (postPopular.tenBV.Length >= 15)
                                            {
                                                @(postPopular.tenBV.Substring(0, 15) + "...")
                                            }
                                            else
                                            {
                                                @postPopular
                                            }
                                        </h3>
                                        <p>@string.Format("{0: dd/MM/yyyy}", postPopular.ngayDang)</p>
                                    </a>
                                </div>
                            </div>
                        }
                        <div class="br"></div>
                    </aside>
                </div>
            </div>
        </div>
    </div>
</section>
