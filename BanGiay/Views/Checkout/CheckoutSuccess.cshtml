@using BanGiay.Models
@using System.Globalization
@{
    ViewBag.Title = "Thanh toán thành công";
    var vi = CultureInfo.GetCultureInfo("vi-VN");

    var Customer = ViewData["CustomerOrder"] as khachHang;
    var Order = ViewData["Order"] as donHang;

    var cart = Session["ShoppingCart"] as List<BanGiay.ViewModel.Cart> ?? new List<BanGiay.ViewModel.Cart>();
    int TotalOrder = cart.Sum(x => x.Total);
}

<section class="banner-area organic-breadcrumb">
    <div class="container">
        <div class="breadcrumb-banner d-flex flex-wrap align-items-center justify-content-end">
            <div class="col-first">
                <h1>Xác nhận đơn hàng</h1>
                <nav class="d-flex align-items-center">
                    <a href="@Url.Action("Index","Home")">Trang chủ<span class="lnr lnr-arrow-right"></span></a>
                    <a href="javascript:void(0)">Xác nhận</a>
                </nav>
            </div>
        </div>
    </div>
</section>

<section class="order_details section_gap">
    <div class="container">
        <h3 class="title_confirmation">Cảm ơn bạn! Chúng tôi đã nhận được đơn hàng.</h3>

        <div class="row order_d_inner">
            <div class="col-lg-6">
                <div class="details_item">
                    <h4>Thông tin đơn hàng</h4>
                    <ul class="list">
                        <li><a><span>Mã đơn hàng</span> : @(Order?.soDH ?? "—")</a></li>
                        <li><a><span>Tài khoản</span> : @(Order?.taiKhoan ?? "Khách vãng lai")</a></li>
                        <li><a><span>Ngày</span> : @((Order?.ngayDat ?? DateTime.Now).ToString("dd/MM/yyyy HH:mm"))</a></li>
                        <li><a><span>Loại thanh toán</span> : @(Order?.loaiThanhToan ?? "—")</a></li>
                    </ul>
                </div>
            </div>
            <div class="col-lg-6">
                <div class="details_item">
                    <h4>Thông tin giao hàng</h4>
                    <ul class="list">
                        <li><a><span>Mã khách hàng</span> : @(Customer?.maKH ?? "—")</a></li>
                        <li><a><span>Số điện thoại</span> : @(Customer?.soDT ?? "—")</a></li>
                        <li><a><span>Tên</span> : @(Customer?.tenKH ?? "—")</a></li>
                        <li><a><span>Địa chỉ</span> : @(Customer?.diaChi ?? "—")</a></li>
                    </ul>
                </div>
            </div>
        </div>

        <div class="order_details_table">
            <h2>Chi tiết đơn hàng</h2>
            <div class="table-responsive">
                <table class="table">
                    <thead>
                        <tr>
                            <th>Sản phẩm</th>
                            <th>Số lượng</th>
                            <th>Giá</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (cart.Any())
                        {
                            foreach (var item in cart)
                            {
                                <tr>
                                    <td><p>@item.NameProduct</p></td>
                                    <td><h5>x @item.Quantity</h5></td>
                                    <td><p>@item.Total.ToString("N0", vi) ₫</p></td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr><td colspan="3">Giỏ hàng trống.</td></tr>
                        }

                        <tr>
                            <td><h4>Phí giao hàng</h4></td>
                            <td></td>
                            <td><p>FREE</p></td>
                        </tr>
                        <tr>
                            <td><h4>Tổng tiền</h4></td>
                            <td></td>
                            <td><p>@TotalOrder.ToString("N0", vi) ₫</p></td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
        <div class="text-center mt-4">
            <a href="@Url.Action("Index","Home")"
               class="primary-btn"
               style="background: linear-gradient(90deg,#ffba00 0%,#ff6c00 100%);
              color:#fff; padding:10px 25px; border-radius:8px;">
                ← Quay lại trang chủ
            </a>
        </div>

    </div>
</section>
