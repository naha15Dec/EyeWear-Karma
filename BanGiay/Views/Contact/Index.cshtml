@model BanGiay.Models.thongTinCuaHang
@{
    ViewBag.Title = "Liên hệ";
}
<section class="banner-area organic-breadcrumb">
    <div class="container">
        <div class="breadcrumb-banner d-flex flex-wrap align-items-center justify-content-end">
            <div class="col-first">
                <h1>Liên hệ</h1>
                <nav class="d-flex align-items-center">
                    <a href='@Url.Action("Index","Home")'>Trang chủ<span class="lnr lnr-arrow-right"></span></a>
                    <a href='@Url.Action("Index","Contact")'>Liên hệ</a>
                </nav>
            </div>
        </div>
    </div>
</section>
<section class="contact_area section_gap_bottom">
    <div class="container">
        <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3919.530887794886!2d106.66690787590598!3d10.77059135929964!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x31752edddb818ebf%3A0xfc8c05045f47a3d8!2zVuG6oW4gSOG6oW5oIE1hbGw!5e0!3m2!1svi!2s!4v1700546104358!5m2!1svi!2s" width="100%" height="600" style="border:0;justify-items:center center;margin-top:20px;  " allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
        <div class="row">
            <div class="col-lg-12">
                <div class="contact_info">
                    <div class="info_item mt-3">
                        <i class="lnr lnr-home"></i>
                        <h6>@Model.diaChiLayHang</h6>
                    </div>
                    <div class="info_item mt-3">
                        <i class="lnr lnr-phone-handset"></i>
                        <h6><a href="tel:@Model.soDTLienHe">@Model.soDTLienHe</a></h6>
                    </div>
                    <div class="info_item mt-3">
                        <i class="lnr lnr-envelope"></i>
                        <h6><a href="#">@Model.emailLienHe</a></h6>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
