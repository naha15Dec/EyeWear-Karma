@using BanGiay.Models; 
@{
    ViewBag.Title = "Trang chủ";
    List<sanPham> discountProduct = ViewData["listDiscountProduct"] as List<sanPham>;
    List<sanPham> newProduct = ViewData["listNewProduct"] as List<sanPham>;
    List<sanPham> dealHot = ViewData["listDealHot"] as List<sanPham>;
}
<section class="banner-area ">
    <div class="container">
        <div class="row fullscreen align-items-center justify-content-start">
            <div class="col-lg-12">
                <div class="active-banner-slider owl-carousel">
                    <div class="row single-slide align-items-center d-flex">
                        <div class="col-lg-5 col-md-6">
                            <div class="banner-content">
                                <h1>Karma Eyewear </h1>
                                <p>
                                    Tìm kiếm mắt kính yêu thích của bạn tại Karma Eyewear, cửa hàng mắt kính và phụ kiện thời trang hàng đầu Việt Nam.
                                </p>
                                <div class="add-bag d-flex align-items-center">
                                    <a href="@Url.Action("Index","Product")" class="primary-btn">Mua ngay</a>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-7">
                            <div class="banner-img">
                                <img class="img-fluid" src="~/Asset/img/banner/gong-kinh-cat-icon.png" alt="">
                            </div>
                        </div>
                    </div>


                    <div class="row single-slide">
                        <div class="col-lg-5">
                            <div class="banner-content">
                                <h1>Karma Eyewear </h1>
                                <p>
                                    Tìm kiếm mắt kính yêu thích của bạn tại Karma Eyewear, cửa hàng mắt kính và phụ kiện thời trang hàng đầu Việt Nam.
                                </p>
                                <div class="add-bag d-flex align-items-center">
                                    <a href="@Url.Action("Index","Product")" class="primary-btn">Mua ngay</a>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-7">
                            <div class="banner-img">
                                <img class="img-fluid" src="~/Asset/img/banner/gong-kinh-cat-icon.png" alt="">
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<div class="content">
    <section class="features-area section_gap">
        <div class="container">
            <div class="row features-inner">
                <div class="col-lg-3 col-md-6 col-sm-6">
                    <div class="single-features">
                        <div class="f-icon">
                            <img src="~/Asset/img/features/f-icon1.png" alt="">
                        </div>
                        <h6>Giao hàng miễn phí</h6>
                    </div>
                </div>
                <div class="col-lg-3 col-md-6 col-sm-6">
                    <div class="single-features">
                        <div class="f-icon">
                            <img src="~/Asset/img/features/f-icon2.png" alt="">
                        </div>
                        <h6>Chính sách hoàn trả</h6>
                    </div>
                </div>
                <div class="col-lg-3 col-md-6 col-sm-6">
                    <div class="single-features">
                        <div class="f-icon">
                            <img src="~/Asset/img/features/f-icon3.png" alt="">
                        </div>
                        <h6>Hỗ trợ 24/7</h6>
                    </div>
                </div>
                <div class="col-lg-3 col-md-6 col-sm-6">
                    <div class="single-features">
                        <div class="f-icon">
                            <img src="~/Asset/img/features/f-icon4.png" alt="">
                        </div>
                        <h6>Thanh toán an toàn</h6>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <section class="category-area">
        <div class="container">
            <div class="row justify-content-center">
                <div class="col-lg-8 col-md-12">
                    <div class="row">
                        <div class="col-lg-8 col-md-8">
                            <div class="single-deal">
                                <div class="overlay"></div>
                                <img class="img-fluid w-100" src="~/Asset/img/category/xuhuongmatkinh20191.jpg" style="height:191px;" alt="">
                                <a href="~/Asset/img/category/xuhuongmatkinh20191.jpg" class="img-pop-up" target="_blank">
                                    <div class="deal-details">
                                        <h6 class="deal-title">Karma Eyewear</h6>
                                    </div>
                                </a>
                            </div>
                        </div>
                        <div class="col-lg-4 col-md-4">
                            <div class="single-deal">
                                <div class="overlay"></div>
                                <img class="img-fluid w-100" src="~/Asset/img/category/s-l1600.jpg" style="height:191px;" alt="">
                                <a href="~/Asset/img/category/s-l1600.jpg" class="img-pop-up" target="_blank">
                                    <div class="deal-details">
                                        <h6 class="deal-title">Karma Eyewear</h6>
                                    </div>
                                </a>
                            </div>
                        </div>
                        <div class="col-lg-4 col-md-4">
                            <div class="single-deal">
                                <div class="overlay"></div>
                                <img class="img-fluid w-100" src="~/Asset/img/category/1.1200.1647589845-8ec.png" style="height:191px;" alt="">
                                <a href="~/Asset/img/category/xuhuongmatkinh20191.jpg" class="img-pop-up" target="_blank">
                                    <div class="deal-details">
                                        <h6 class="deal-title">Karma Eyewear</h6>
                                    </div>
                                </a>
                            </div>
                        </div>
                        <div class="col-lg-8 col-md-8">
                            <div class="single-deal">
                                <div class="overlay"></div>
                                <img class="img-fluid w-100" src="~/Asset/img/category/xuhuongmatkinh20191.jpg" style="height:191px;" alt="">
                                <a href="~/Asset/img/category/deo-kinh-can-thuong-xuyen-tot-cho-mat-hay-nguoc-lai-tim-1-800x450 (1).jpg" class="img-pop-up" target="_blank">
                                    <div class="deal-details">
                                        <h6 class="deal-title">Karma Eyewear</h6>
                                    </div>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-lg-4 col-md-6">
                    <div class="single-deal">
                        <div class="overlay"></div>
                        <img class="img-fluid w-100" src="~/Asset/img/category/c5.jpg" alt="">
                        <a href="~/Asset/img/category/c5.jpg" class="img-pop-up" target="_blank">
                            <div class="deal-details">
                                <h6 class="deal-title">Sneaker for Sports</h6>
                            </div>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <section class="owl-carousel active-product-area section_gap">
        <div class="single-product-slider">
            <div class="container">
                <div class="row justify-content-center">
                    <div class="col-lg-6 text-center">
                        <div class="section-title">
                            <h1>Giảm giá</h1>
                        </div>
                    </div>
                </div>
                <div class="row">
                    @foreach (var discountItem in discountProduct)
                    {
                        <div class="col-lg-3 col-md-6">
                            <div class="single-product">
                                <img class="img-fluid" src=@discountItem.hinhDD alt="">
                                <div class="product-details">
                                    <h6>
                                        @discountItem.tenSP
                                    </h6>
                                    <div class="price">
                                        <h6>@(string.Format("{0:N0}", (discountItem.giaBan - discountItem.giamGia)))</h6>
                                        <h6 class="l-through">@(string.Format("{0:N0}",discountItem.giaBan))</h6>
                                    </div>
                                    <div class="prd-bottom">
                                        <a href="@Url.Action("AddItemToCart","ShoppingCart",new {idProduct=discountItem.maSP})" class="social-info">
                                            <span class="ti-bag"></span>
                                            <p class="hover-text">Thêm giỏ</p>
                                        </a>
                                        <a href="@Url.Action("DetailProduct","Product",new {idProduct = discountItem.maSP })" class="social-info">
                                            <span class="lnr lnr-move"></span>
                                            <p class="hover-text">Chi tiết</p>
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
        <div class="single-product-slider">
            <div class="container">
                <div class="row justify-content-center">
                    <div class="col-lg-6 text-center">
                        <div class="section-title">
                            <h1>Sản phẩm mới</h1>
                        </div>
                    </div>
                </div>
                <div class="row">
                    @foreach (var newItem in newProduct)
                    {
                        <div class="col-lg-3 col-md-6">
                            <div class="single-product">
                                <img class="img-fluid" src=@newItem.hinhDD alt="">
                                <div class="product-details">
                                    <h6>
                                        @newItem.tenSP
                                    </h6>
                                    <div class="price">
                                        <h6>@(string.Format("{0:N0}", newItem.giaBan))</h6>
                                    </div>
                                    <div class="prd-bottom">
                                        <a href="@Url.Action("AddItemToCart","ShoppingCart",new {idProduct=newItem.maSP})" class="social-info">
                                            <span class="ti-bag"></span>
                                            <p class="hover-text">Thêm giỏ</p>
                                        </a>
                                        <a href="@Url.Action("DetailProduct","Product",new {idProduct = newItem.maSP })" class="social-info">
                                            <span class="lnr lnr-move"></span>
                                            <p class="hover-text">Chi tiết</p>
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }

                </div>
            </div>
        </div>
    </section>
    <section class="exclusive-deal-area">
        <div class="container-fluid">
            <div class="row justify-content-center align-items-center">
                <div class="col-lg-6 no-padding exclusive-left">
                    <div class="row clock_sec clockdiv" id="clockdiv">
                        <div class="col-lg-12">
                            <h1>Ưu đãi hấp dẫn độc quyền sắp kết thúc</h1>
                        </div>
                        <div class="col-lg-12">
                            <div class="row clock-wrap">
                                <div class="col clockinner1 clockinner">
                                    <h1 class="days">150</h1>
                                    <span class="smalltext">Days</span>
                                </div>
                                <div class="col clockinner clockinner1">
                                    <h1 class="hours">23</h1>
                                    <span class="smalltext">Hours</span>
                                </div>
                                <div class="col clockinner clockinner1">
                                    <h1 class="minutes">47</h1>
                                    <span class="smalltext">Mins</span>
                                </div>
                                <div class="col clockinner clockinner1">
                                    <h1 class="seconds">59</h1>
                                    <span class="smalltext">Secs</span>
                                </div>
                            </div>
                        </div>
                    </div>
                    <a href="@Url.Action("Index","Product")" class="primary-btn">Mua ngay</a>
                </div>

                <div class="col-lg-6 no-padding exclusive-right">
                    <div class="active-exclusive-product-slider">
                        @foreach (var dealHotItem in dealHot)
                        {
                            <div class="single-exclusive-slider">
                                <img class="img-fluid" src=@dealHotItem.hinhDD alt="">
                                <div class="product-details">
                                    <div class="price">
                                        <h6> @(string.Format("{0:N0}", (dealHotItem.giaBan - dealHotItem.giamGia)))</h6>
                                        <h6 class="l-through">@(string.Format("{0:N0}", dealHotItem.giaBan))</h6>
                                    </div>
                                    <h4>
                                        @dealHotItem.tenSP
                                    </h4>
                                    <div class="add-bag d-flex align-items-center justify-content-center">
                                        <a class="add-btn" href="@Url.Action("AddItemToCart","ShoppingCart",new {idProduct=dealHotItem.maSP})"><span class="ti-bag"></span></a>
                                        <span class="add-text text-uppercase">Thêm vào giỏ</span>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </section>
    <section class="brand-area section_gap">
        <div class="container">
            <div class="row">
                <a class="col single-img" href="#">
                    <img class="img-fluid d-block mx-auto" src="~/Asset/img/brand/481_rayban.jpg" alt="">
                </a>
                <a class="col single-img" href="#">
                    <img class="img-fluid d-block mx-auto" src="~/Asset/img/brand/1050-7.png" alt="">
                </a>
                <a class="col single-img" href="#">
                    <img class="img-fluid d-block mx-auto" src="~/Asset/img/brand/20200908_DOzjTsNv4HN3KVD8gGyBDhuL.jpg" alt="">
                </a>
                <a class="col single-img" href="#">
                    <img class="img-fluid d-block mx-auto" src="~/Asset/img/brand/images.png" alt="">
                </a>
                <a class="col single-img" href="#">
                    <img class="img-fluid d-block mx-auto" src="~/Asset/img/brand/persol_career_tech_studio_vietnam_logo.jpg" alt="">
                </a>
            </div>
        </div>
    </section>
</div>


