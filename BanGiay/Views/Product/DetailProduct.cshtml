@model BanGiay.Models.sanPham
@using System.Globalization
@{
    ViewBag.Title = "Chi tiết sản phẩm";
    var vi = CultureInfo.GetCultureInfo("vi-VN");

    // ---- GIÁ / GIẢM GIÁ (dùng decimal để format an toàn) ----
    decimal giaBan = Convert.ToDecimal(Model.giaBan);
    decimal giamGia = Convert.ToDecimal(Model.giamGia ?? 0);
    decimal giaSauGiam = giaBan - giamGia;
    if (giaSauGiam < 0M)
    {
        giaSauGiam = 0M;
    }

    // ---- ẢNH ----
    var dsAnh = (Model != null && Model.danhSachHinhs != null)
        ? Model.danhSachHinhs
            .Where(h => h.maSP == Model.maSP && !string.IsNullOrWhiteSpace(h.hinhSP))
            .Select(h =>
            {
                var p = h.hinhSP.Trim();
                if (p.StartsWith("http", System.StringComparison.OrdinalIgnoreCase)) return p;
                if (p.StartsWith("~/")) return Url.Content(p);
                if (p.StartsWith("/")) return Url.Content("~" + p);
                return Url.Content("~/" + p);
            })
            .Distinct()
            .ToList()
        : new List<string>();

    string fallbackImg = Url.Content("~/Asset/img/no-image.png");
    string mainImg = dsAnh.Any() ? dsAnh[0] : fallbackImg;

    // ---- THÔNG TIN CƠ BẢN ----
    string tenSP = (Model != null ? Model.tenSP : "Sản phẩm");
    string maSP = (Model != null ? Model.maSP : "");
    string tenLoai = (Model != null && Model.loaiSP != null ? Model.loaiSP.tenLoai : "—");
    bool conHang = (Model != null && Model.trangThai == true);
    string moTaTomTat = (Model != null ? Model.moTaTomTat : null);
}

<section class="banner-area organic-breadcrumb">
    <div class="container">
        <div class="breadcrumb-banner d-flex flex-wrap align-items-center justify-content-end">
            <div class="col-first">
                <h1>Chi tiết sản phẩm</h1>
                <nav class="d-flex align-items-center">
                    <a href="@Url.Action("Index","Home")">Trang chủ<span class="lnr lnr-arrow-right"></span></a>
                    <a href="@Url.Action("Index","Product")">Sản phẩm<span class="lnr lnr-arrow-right"></span></a>
                    <a href="javascript:void(0)">Chi tiết sản phẩm</a>
                </nav>
            </div>
        </div>
    </div>
</section>

<div class="product_image_area">
    <div class="container">
        <div class="row s_product_inner">

            <!-- ===== ẢNH SẢN PHẨM ===== -->
            <div class="col-lg-6">
                <div class="product-gallery">
                    <div class="product-gallery__main">
                        <img id="mainImage" class="img-fluid"
                             src="@mainImg" alt="@tenSP"
                             onerror="this.onerror=null;this.src='@fallbackImg';" />
                    </div>

                    <div class="product-gallery__thumbs">
                        @if (dsAnh.Any())
                        {
                            for (int i = 0; i < dsAnh.Count; i++)
                            {
                                <img class="thumb@(i == 0 ? " active" : "")"
                                     src="@dsAnh[i]"
                                     data-src="@dsAnh[i]"
                                     alt="thumb-@i"
                                     onclick="swapImage(this)"
                                     onerror="this.onerror=null;this.src='@fallbackImg';" />
                            }
                        }
                        else
                        {
                            <img class="thumb active" src="@fallbackImg" alt="no-image" />
                        }
                    </div>
                </div>
            </div>

            <!-- ===== THÔNG TIN SẢN PHẨM ===== -->
            <div class="col-lg-5 offset-lg-1">
                <div class="s_product_text">
                    <h3>@tenSP</h3>

                    @if (giamGia > 0M)
                    {
                        <h2>@string.Format(vi, "{0:N0}", giaSauGiam) ₫</h2>
                        <h6 class="l-through" style="text-decoration:line-through;">
                            @string.Format(vi, "{0:N0}", giaBan) ₫
                        </h6>
                    }
                    else
                    {
                        <h2>@string.Format(vi, "{0:N0}", giaBan) ₫</h2>
                    }


                    <ul class="list">
                        <li><a><span>Mã:</span> @maSP</a></li>
                        <li><a><span>Loại:</span> @tenLoai</a></li>
                        <li><a><span>Tình trạng:</span> @(conHang ? "Còn hàng" : "Hết hàng")</a></li>
                    </ul>

                    <p>@(string.IsNullOrWhiteSpace(moTaTomTat) ? "Không có mô tả ngắn." : moTaTomTat)</p>

                    <div class="card_area d-flex align-items-center gap-2">
                        @if (conHang && Model != null)
                        {
                            <a class="primary-btn"
                               href='@Url.Action("AddItemToCart","ShoppingCart", new { idProduct = Model.maSP })'>
                                Thêm vào giỏ
                            </a>
                        }
                        else
                        {
                            <button class="primary-btn" disabled>Hết hàng</button>
                        }
                        <a class="primary-btn" href='@Url.Action("Index","Product")'>Tiếp tục mua sắm</a>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

<!-- ===== MÔ TẢ & THÔNG TIN ===== -->
<section class="product_description_area">
    <div class="container">
        <ul class="nav nav-tabs" id="myTab" role="tablist">
            <li class="nav-item">
                <a class="nav-link active" id="home-tab" data-toggle="tab" href="#home"
                   role="tab" aria-controls="home" aria-selected="true">Mô tả</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" id="profile-tab" data-toggle="tab" href="#profile"
                   role="tab" aria-controls="profile" aria-selected="false">Thông tin</a>
            </li>
        </ul>

        <div class="tab-content" id="myTabContent">
            <div class="tab-pane fade show active" id="home" role="tabpanel" aria-labelledby="home-tab">
                <p>
                    @if (Model != null && !string.IsNullOrWhiteSpace(Model.moTa))
                    {
                        @Html.Raw(Model.moTa)
                    }
                    else
                    {
                        @:Chưa có mô tả chi tiết cho sản phẩm này.
                    }
                </p>
            </div>

            <div class="tab-pane fade" id="profile" role="tabpanel" aria-labelledby="profile-tab">
                <div class="table-responsive">
                    <table class="table">
                        <tbody>
                            <tr>
                                <td><h5>Giới tính</h5></td>
                                <td>
                                    <h5>
                                        @(
                                            Model == null ? "Unisex" :
                                            (Model.gioiTinh == true ? "Nam" :
                                             (Model.gioiTinh == false ? "Nữ" : "Unisex"))
                                         )
                                    </h5>
                                </td>
                            </tr>
                            <tr>
                                <td><h5>Thương hiệu</h5></td>
                                <td><h5>@(Model != null && Model.thuongHieu != null ? Model.thuongHieu.tenThuongHieu : "—")</h5></td>
                            </tr>
                            <tr>
                                <td><h5>Xuất xứ</h5></td>
                                <td><h5>@(Model != null && Model.thuongHieu != null ? Model.thuongHieu.xuatXu : "—")</h5></td>
                            </tr>
                            <tr>
                                <td><h5>Size</h5></td>
                                <td><h5>@(Model != null && !string.IsNullOrWhiteSpace(Model.kichThuoc) ? Model.kichThuoc : "—")</h5></td>
                            </tr>
                            <tr>
                                <td><h5>Loại sản phẩm</h5></td>
                                <td><h5>@tenLoai</h5></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ===== JS + CSS CHO GALLERY ===== -->
<script>
    function swapImage(el) {
        var main = document.getElementById('mainImage');
        if (!main || !el) return;
        main.src = el.getAttribute('data-src');
        var thumbs = document.querySelectorAll('.product-gallery__thumbs .thumb');
        for (var i = 0; i < thumbs.length; i++) thumbs[i].classList.remove('active');
        el.classList.add('active');
    }
</script>

<style>
    .product-gallery__main {
        border: 1px solid #eee;
        border-radius: 8px;
        padding: 8px;
    }

    .product-gallery__thumbs {
        display: flex;
        gap: 8px;
        margin-top: 12px;
        flex-wrap: wrap;
    }

        .product-gallery__thumbs .thumb {
            width: 72px;
            height: 72px;
            object-fit: cover;
            border: 1px solid #ddd;
            border-radius: 6px;
            cursor: pointer;
            transition: transform .15s ease;
        }

            .product-gallery__thumbs .thumb.active {
                outline: 2px solid #ff9a00;
                transform: scale(1.03);
            }
</style>
