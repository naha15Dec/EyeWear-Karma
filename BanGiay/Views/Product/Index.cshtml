@using BanGiay.Models
@model BanGiay.ViewModel.FiltersProduct
@using System.Globalization
@{
    ViewBag.Title = "Sản phẩm";

    // Dữ liệu từ controller
    List<sanPham> products = ViewData["listProduct"] as List<sanPham> ?? new List<sanPham>();
    List<loaiSP> Categories = ViewData["typeProductList"] as List<loaiSP> ?? new List<loaiSP>();
    List<thuongHieu> Brands = ViewData["brandList"] as List<thuongHieu> ?? new List<thuongHieu>();

    // Giá trị đã chọn (để pre-select)
    string selectedBrand = ViewData["selectedBrand"] as string;
    string selectedTypeProduct = ViewData["selectedTypeProduct"] as string;
    string selectedPrice = ViewData["selectedPrice"] as string;

    // Culture cho định dạng tiền
    var vi = CultureInfo.GetCultureInfo("vi-VN");

    // Phân trang (tách if ra dòng riêng để tránh Parser Error)
    int page = (ViewBag.Page != null) ? (int)ViewBag.Page : 1;

    int prevPage = page - 1;
    if (prevPage <= 0)
    {
        prevPage = 1;
    }

    int noOfPages = (ViewBag.NoOfPages != null) ? (int)ViewBag.NoOfPages : 1;

    int nextPage = page + 1;
    if (nextPage > noOfPages)
    {
        nextPage = noOfPages;
    }

    int displayFrom = (ViewBag.DisplayPage != null) ? (int)ViewBag.DisplayPage : 0;
}

<section class="banner-area organic-breadcrumb">
    <div class="container">
        <div class="breadcrumb-banner d-flex flex-wrap align-items-center justify-content-end">
            <div class="col-first">
                <h1>Sản phẩm</h1>
                <nav class="d-flex align-items-center">
                    <a href="@Url.Action("Index","Home")">Trang chủ<span class="lnr lnr-arrow-right"></span></a>
                    <a href="@Url.Action("Index","Product")">Sản phẩm</a>
                </nav>
            </div>
        </div>
    </div>
</section>

<div class="container">
    <div class="row">

        <!-- Sidebar -->
        <div class="col-xl-3 col-lg-4 col-md-5">
            <div class="sidebar-categories">
                <div class="head">Loại sản phẩm</div>
                <ul class="main-categories">
                    @foreach (var category in Categories)
                    {
                        bool isActive = !string.IsNullOrEmpty(selectedTypeProduct) && category.tenLoai == selectedTypeProduct;
                        <li class="main-nav-list">
                            <a class="@(isActive ? "font-weight-bold" : "")"
                               href="@Url.Action("CheckFilters","Product", new { SelectedTypeProduct = category.tenLoai, SelectedBrand = selectedBrand, SelectedPrice = selectedPrice, page = 1 })">
                                @category.tenLoai
                            </a>
                        </li>
                    }
                </ul>
            </div>

            <div class="sidebar-filter mt-50">
                <div class="top-filter-head">Lọc sản phẩm</div>

                @using (Html.BeginForm("CheckFilters", "Product", FormMethod.Post))
                {
                    <!-- Thương hiệu -->
                    <div class="common-filter">
                        <div class="head">Thương hiệu</div>
                        <ul>
                            @foreach (var brand in Brands)
                            {
                                var inputId = "brand-" + brand.maThuongHieu;
                                bool isChecked = !string.IsNullOrEmpty(selectedBrand) && selectedBrand == brand.tenThuongHieu;
                                <li class="filter-list">
                                    <input class="pixel-radio" type="radio" id="@inputId" name="SelectedBrand" value="@brand.tenThuongHieu" @(isChecked ? "checked" : "") />
                                    <label for="@inputId">@brand.tenThuongHieu</label>
                                </li>
                            }
                        </ul>
                    </div>

                    <!-- Giá -->
                    <div class="common-filter">
                        <div class="head">Giá</div>
                        <ul>
                            <li class="filter-list">
                                <input class="pixel-radio" id="price_1" type="radio" name="SelectedPrice" value="500000" @(selectedPrice == "500000" ? "checked" : "") />
                                <label for="price_1">0 - 500.000</label>
                            </li>
                            <li class="filter-list">
                                <input class="pixel-radio" id="price_2" type="radio" name="SelectedPrice" value="3000000" @(selectedPrice == "3000000" ? "checked" : "") />
                                <label for="price_2">500.000 - 3.000.000</label>
                            </li>
                            <li class="filter-list">
                                <input class="pixel-radio" id="price_3" type="radio" name="SelectedPrice" value="5000000" @(selectedPrice == "5000000" ? "checked" : "") />
                                <label for="price_3">3.000.000 - 5.000.000</label>
                            </li>
                            <li class="filter-list">
                                <input class="pixel-radio" id="price_4" type="radio" name="SelectedPrice" value="10000000" @(selectedPrice == "10000000" ? "checked" : "") />
                                <label for="price_4">Trên 10.000.000</label>
                            </li>
                        </ul>
                    </div>

                    <!-- Bảo toàn loại sản phẩm đã chọn khi submit -->
                    <input type="hidden" name="SelectedTypeProduct" value="@selectedTypeProduct" />

                    <div class="d-inline mt-3 mb-3 w-100">
                        <button type="submit" class="btn btn-success w-100" style="color:#fff;">
                            <i class="fas fa-search"></i> Áp dụng bộ lọc
                        </button>
                    </div>
                }
            </div>
        </div>
        <!-- /Sidebar -->
        <!-- Main content -->
        <div class="col-xl-9 col-lg-8 col-md-7">

            @if (products.Count > 0)
            {
                <div class="filter-bar d-flex flex-wrap align-items-center">
                    <div class="sorting">
                        @using (Html.BeginForm("CheckFilters", "Product", FormMethod.Post, new { id = "searchForm", @class = "d-flex justify-content-between" }))
                        {
                            <input type="text" class="form-control" id="search_input" name="NameProduct" placeholder="Tìm kiếm..." />
                            <input type="hidden" name="SelectedBrand" value="@selectedBrand" />
                            <input type="hidden" name="SelectedTypeProduct" value="@selectedTypeProduct" />
                            <input type="hidden" name="SelectedPrice" value="@selectedPrice" />
                            <button type="submit" class="btn ml-2">Tìm</button>
                        }
                    </div>

                    <div class="sorting mr-auto"></div>

                    <div class="pagination">
                        <a href="@Url.Action("Index","Product", new { page = prevPage })" class="prev-arrow"><span class="lnr lnr-chevron-left"></span></a>
                        @for (int i = displayFrom; i < noOfPages; i++)
                        {
                            if (i + 1 == page)
                            {
                                <a href="@Url.Action("Index","Product", new { page = i + 1 })" class="active">@(i + 1)</a>
                            }
                            else
                            {
                                <a href="@Url.Action("Index","Product", new { page = i + 1 })">@(i + 1)</a>
                            }
                        }
                        <a href="@Url.Action("Index","Product", new { page = nextPage })" class="next-arrow"><span class="lnr lnr-chevron-right"></span></a>
                    </div>
                </div>
            }
            else
            {
        <h3 class="text-center my-4">
            Oops! Không có sản phẩm nào khớp với tìm kiếm của bạn.
        </h3>
            }

            <section class="lattest-product-area pb-40 category-list">
                <div class="row">
                    @foreach (var item in products)
                    {
                        <div class="col-lg-4 col-md-6">
                            <div class="single-product position-relative">
                                @if (item.trangThai == false)
                                {
                                    <span class="badge badge-danger position-absolute" style="top:8px;left:8px;">Hết hàng</span>
                                }

                                <img src="@item.hinhDD" height="230" width="230" alt="Ảnh @item.tenSP" />

                                <div class="product-details">
                                    <h6 class="mb-2">@item.tenSP</h6>

                                    <div class="price">
                                        @if ((item.giamGia ?? 0) > 0)
                                        {
                                            <h6>@((item.giaBan - item.giamGia).GetValueOrDefault().ToString("N0", vi)) ₫</h6>
                                            <h6 class="l-through">@item.giaBan.GetValueOrDefault().ToString("N0", vi) ₫</h6>
                                        }
                                        else
                                        {
                                            <h6>@item.giaBan.GetValueOrDefault().ToString("N0", vi) ₫</h6>
                                        }
                                    </div>

                                    <div class="prd-bottom">
                                        @if (item.trangThai == true)
                                        {
                                            <a href="@Url.Action("AddItemToCart","ShoppingCart", new { idProduct = item.maSP })" class="social-info">
                                                <span class="ti-bag"></span>
                                                <p class="hover-text">Thêm giỏ</p>
                                            </a>
                                        }
                                        else
                                        {
                                            <a class="social-info disabled" style="pointer-events:none;opacity:.5;">
                                                <span class="ti-na"></span>
                                                <p class="hover-text">Hết hàng</p>
                                            </a>
                                        }

                                        <a href="@Url.Action("DetailProduct","Product", new { idProduct = item.maSP })" class="social-info">
                                            <span class="lnr lnr-move"></span>
                                            <p class="hover-text">Chi tiết</p>
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </section>

            @if (products.Count > 0)
            {
                <div class="filter-bar d-flex flex-wrap align-items-center">
                    <div class="sorting"></div>
                    <div class="sorting mr-auto"></div>
                    <div class="pagination">
                        <a href="@Url.Action("Index","Product", new { page = prevPage })" class="prev-arrow"><span class="lnr lnr-chevron-left"></span></a>
                        @for (int i = displayFrom; i < noOfPages; i++)
                        {
                            if (i + 1 == page)
                            {
                                <a href="@Url.Action("Index","Product", new { page = i + 1 })" class="active">@(i + 1)</a>
                            }
                            else
                            {
                                <a href="@Url.Action("Index","Product", new { page = i + 1 })">@(i + 1)</a>
                            }
                        }
                        <a href="@Url.Action("Index","Product", new { page = nextPage })" class="next-arrow"><span class="lnr lnr-chevron-right"></span></a>
                    </div>
                </div>
            }
        </div>
        <!-- /Main content -->

    </div>
</div>
