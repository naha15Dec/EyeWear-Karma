@using BanGiay.Models;
@model BanGiay.Models.taiKhoanThanhVien
@{

    ViewBag.Title = "Thông tin tài khoản";
    List<donHang> Orders = ViewData["listOrderUser"] as List<donHang>;
}
<style>
    .nav-link.active, .nav-pills .show > .nav-link {
        color:white !important;
        background-color: #db9744 !important;
    }
   
</style>
<section class="banner-area organic-breadcrumb">
    <div class="container">
        <div class="breadcrumb-banner d-flex flex-wrap align-items-center justify-content-end">
            <div class="col-first">
                <h1>Thông tin tài khoản</h1>
                <nav class="d-flex align-items-center">
                    <a href="index.html">Trang chủ<span class="lnr lnr-arrow-right"></span></a>
                    <a href="category.html">Thông tin</a>
                </nav>
            </div>
        </div>
    </div>
</section>

<div class="content-wrapper">
    <section class="content">
        <div class="container-fluid">
            <div class="row">
                <div class="col-md-12">
                    <div class="card">
                        <div class="card-header p-2">
                            <ul class="nav nav-pills">
                                <li class="nav-item"><a class="nav-link active" style="" href="#profileInformationAccount" data-toggle="tab">Thông tin tài khoản</a></li>
                                <li class="nav-item"><a class="nav-link" href="#changePassword" data-toggle="tab">Đổi mật khẩu</a></li>
                            </ul>
                        </div>
                        <div class="card-body">
                            <div class="tab-content">
                                <div class="tab-pane active" id="profileInformationAccount">
                                    @using (Html.BeginForm("UpdateInformationAccount", "ProfileUser", FormMethod.Post))
                                    {
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="idAccount" value="@Model.taiKhoan" />
                                        <div class="form-group row">
                                            <label for="UserName" class="col-sm-2 col-form-label">Tài khoản</label>
                                            <div class="col-sm-10">
                                                <input type="text" class="form-control" id="UserName" name="UserName" value="@Model.taiKhoan" disabled>
                                            </div>
                                        </div>
                                        <div class="form-group row">
                                            <label for="Email" class="col-sm-2 col-form-label">Email</label>
                                            <div class="col-sm-10">
                                                <input type="email" class="form-control" id="Email" name="Email" value="@Model.email" disabled>
                                            </div>
                                        </div>
                                        <div class="form-group row">
                                            <label class="col-sm-2 col-form-label">Số dư</label>
                                            <div class="col-sm-10">
                                                <input type="text" class="form-control" i value="@Model.soTien" disabled>
                                            </div>
                                        </div>
                                        <div class="form-group row">
                                            <label for="Mobile" class="col-sm-2 col-form-label">Số điện thoại</label>
                                            <div class="col-sm-10">
                                                <input type="text" class="form-control" id="Mobile" name="Mobile" value="@Model.soDT">
                                            </div>
                                        </div>
                                        <div class="form-group row">
                                            <label for="LastName" class="col-sm-2 col-form-label">Họ</label>
                                            <div class="col-sm-10">
                                                <input type="text" class="form-control" id="LastName" name="LastName" value="@Model.hoDem">
                                            </div>
                                        </div>
                                        <div class="form-group row">
                                            <label for="FirstName" class="col-sm-2 col-form-label">Tên</label>
                                            <div class="col-sm-10">
                                                <input type="text" class="form-control" id="FirstName" name="FirstName" value="@Model.tenTV">
                                            </div>
                                        </div>
                                        <div class="form-group row">
                                            <label class="col-sm-2 col-form-label">Giới tính</label>
                                            <div class="col-sm-10">
                                                <select name="Sex" class="form-control">
                                                    <option value="Nam" @(Model.gioiTinh == true ? "selected" : "")>Nam</option>
                                                    <option value="Nữ" @(Model.gioiTinh == false ? "selected" : "")>Nữ</option>
                                                </select>
                                            </div>
                                        </div>
                                        <div class="form-group row">
                                            <label class="col-sm-2 col-form-label">Địa chỉ</label>
                                            <div class="col-sm-10">
                                                <input type="text" class="form-control" id="Address" name="Address" value="@Model.diaChi">
                                            </div>
                                        </div>
                                        <div class="form-group row">
                                            <label class="col-sm-2 col-form-label">Trạng thái tài khoản</label>
                                            <div class="col-sm-10">
                                                <input type="text" class="form-control" id="StatusAccount" name="StatusAccount" value="@(Model.trangThai == true ? "Hoạt động" : "Cấm")" disabled>
                                            </div>
                                        </div>
                                        <div class="form-group row">
                                            <div class="offset-sm-2 col-sm-10">
                                                <button type="submit" class="btn btn-success">Lưu</button>
                                            </div>
                                        </div>
                                    }
                                        <section class="content">
                                            <div class="container-fluid">
                                                <div class="row">
                                                    <div class="col-md-12">
                                                        <div class="card-body">
                                                            <table class="table table-bordered">
                                                                <thead>
                                                                    <tr>
                                                                        <th>Số đơn hàng</th>
                                                                        <th>Mã khách hàng</th>
                                                                        <th>Ngày đặt</th>
                                                                        <th>Lệnh</th>
                                                                        <th>Trạng thái</th>
                                                                    </tr>
                                                                </thead>
                                                                <tbody>
                                                                    @foreach (var item in Orders)
                                                                    {
                                                                        <tr>
                                                                            <td>@item.soDH</td>
                                                                            <td>@item.maKH</td>
                                                                            <td>@item.ngayDat</td>
                                                                            <td>
                                                                                <a href='@Url.Action("DetailPurchaseOrder","ProfileUser",new {numberOfOrder = item.soDH })' class="btn btn-primary">Chi tiết</a>
                                                                            </td>
                                                                            <td>
                                                                                @if (item.trangThai == true)
                                                                                {
                                                                                    <span class="badge bg-success">Thành công</span>
                                                                                }
                                                                                else
                                                                                {
                                                                                    <span class="badge bg-danger">Đang xử lí</span>
                                                                                }

                                                                            </td>
                                                                        </tr>
                                                                    }

                                                                </tbody>
                                                            </table>
                                                        </div>
                                                        <div class="card-footer clearfix">
                                                            <ul class="pagination pagination-sm m-0 float-right">
                                                                @{
                                                                    int prevPage = ViewBag.Page - 1;
                                                                    if (prevPage <= 0)
                                                                    {
                                                                        prevPage = 1;
                                                                    }
                                                                    int nextPage = ViewBag.Page + 1;
                                                                    if (nextPage > ViewBag.NoOfPages)
                                                                    {
                                                                        nextPage = ViewBag.NoOfPages;
                                                                    }
                                                                }
                                                                <li class="page-item"><a class="page-link" href='@Url.Action("Profile","ProfileUser",new {page=prevPage})'>&laquo;</a></li>
                                                                @for (int i = ViewBag.DisplayPage; i < ViewBag.NoOfPages; i++)
                                                                {
                                                                    if (i + 1 == ViewBag.Page)
                                                                    {
                                                                        // đây là trang mình đang xem
                                                                        <li class="page-item"><a class="page-link active" href="@Url.Action("Profile","ProfileUser",new {page = i+1 })">@(i+1)</a></li>
                                                                    }
                                                                    else
                                                                    {
                                                                        <li class="page-item"><a class="page-link" href="@Url.Action("Profile","ProfileUser",new {page = i+1 })">@(i+1)</a></li>
                                                                    }
                                                                }
                                                                <li class="page-item"><a class="page-link" href='@Url.Action("Profile","ProfileUser",new {page=nextPage})'>&raquo;</a></li>
                                                            </ul>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </section>
                                </div>
                                <div class="tab-pane" id="changePassword">
                                    @using (Html.BeginForm("ChangePasswordAccount", "ProfileUser", FormMethod.Post))
                                    {
                                        @Html.AntiForgeryToken()
                                        <div class="form-group row">
                                            <input type="hidden" name="idAccount" value="@Model.taiKhoan" />
                                            <label for="inputName" class="col-sm-2 col-form-label">Tài khoản</label>
                                            <div class="col-sm-10">
                                                <input type="text" class="form-control" id="inputName" name="UserName" value="@Model.taiKhoan" disabled>
                                            </div>
                                        </div>
                                        <div class="form-group row">
                                            <label for="inputPassCurrent" class="col-sm-2 col-form-label">Mật khẩu cũ</label>
                                            <div class="col-sm-10">
                                                <input type="password" class="form-control" id="inputPassCurrent" name="passwdCurrent">
                                            </div>
                                        </div>
                                        <div class="form-group row">
                                            <label for="Password" class="col-sm-2 col-form-label">Mật khẩu mới</label>
                                            <div class="col-sm-10">
                                                <input type="password" class="form-control" id="Password" name="Password">
                                            </div>
                                        </div>
                                        <div class="form-group row">
                                            <label for="ComfirmPassword" class="col-sm-2 col-form-label">Nhập lại mật khẩu mới</label>
                                            <div class="col-sm-10">
                                                <input type="password" class="form-control" id="ComfirmPassword" name="ComfirmPassword">
                                            </div>
                                        </div>
                                        <div class="form-group row">
                                            <div class="offset-sm-2 col-sm-10">
                                                <button type="submit" class="btn btn-success">Lưu</button>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>
