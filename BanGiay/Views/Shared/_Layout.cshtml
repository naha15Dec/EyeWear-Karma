@using BanGiay.Models;
@{
    taiKhoanThanhVien account = (Session["LoginInformation"] as taiKhoanThanhVien);
    thongTinCuaHang inf = new DoAnLTW2Entities().thongTinCuaHangs.OrderByDescending(m => m.thoiGian).FirstOrDefault();
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title</title>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Source+Sans+Pro:300,400,400i,700&display=fallback">
    <link href="~/Content/linearicons.css" rel="stylesheet" />
    <link href="~/Content/fontawesome-free/css/all.min.css" rel="stylesheet" />
    <link href="~/Content/font-awesome.min.css" rel="stylesheet" />
    <link href="~/Content/themify-icons.css" rel="stylesheet" />
    <link href="~/Content/bootstrap.css" rel="stylesheet" />
    <link href="~/Content/owl.carousel.css" rel="stylesheet" />
    <link href="~/Content/nice-select.css" rel="stylesheet" />
    <link href="~/Content/nouislider.min.css" rel="stylesheet" />
    <link href="~/Content/ion.rangeSlider.css" rel="stylesheet" />
    <link href="~/Content/ion.rangeSlider.skinFlat.css" rel="stylesheet" />
    <link href="~/Content/magnific-popup.css" rel="stylesheet" />
    <link href="~/Content/main.css" rel="stylesheet" />
    <link href="~/Content/bootstrap.css" rel="stylesheet" />
</head>
<body>
    <header class="header_area sticky-header">
        <div class="main_menu">
            <nav class="navbar navbar-expand-lg navbar-light main_box">
                <div class="container">
                    <a href='@Url.Action("Index","Home")'><img src="~/Asset/img/logo.png" alt=""></a>
                    <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navbarSupportedContent"
                            aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                        <span class="icon-bar"></span>
                        <span class="icon-bar"></span>
                        <span class="icon-bar"></span>
                    </button>
                    <div class="collapse navbar-collapse offset" id="navbarSupportedContent">
                        <ul class="nav navbar-nav menu_nav ml-auto">
                            <li class="nav-item"><a class="nav-link" href='@Url.Action("Index","Home")'>Trang chủ</a></li>
                            <li class="nav-item"><a class="nav-link" href="@Url.Action("Index","Product")">Sản phẩm</a></li>
                            <li class="nav-item"><a class="nav-link" href="@Url.Action("Index","Blog")">Bài viết</a></li>
                            <li class="nav-item"><a class="nav-link" href="@Url.Action("Index","Contact")">Liên hệ</a></li>
                            <li class="nav-item submenu dropdown">
                                <a href="#" class="nav-link dropdown-toggle" data-toggle="dropdown" role="button" aria-haspopup="true"
                                   aria-expanded="false">@(account!=null ? account.taiKhoan : "Tài khoản")</a>
                                <ul class="dropdown-menu">
                                    @if ((Session["LoginInformation"] as taiKhoanThanhVien) != null)
                                    {
                                        <li class="nav-item"><a class="nav-link" href='@(account.maNhom == 3 ? Url.Action("Profile","ProfileUser") : Url.Action("Index","Dashboard",new {area="AdminPage" } ))'>@(account.maNhom == 3 ? "Thông tin" : "Trang quản trị")</a></li>
                                        <li class="nav-item"><a class="nav-link" href='@Url.Action("LogoutAccount","Account")'>Đăng xuất</a></li>
                                    }
                                    else
                                    {
                                        <li class="nav-item"><a class="nav-link" href='@Url.Action("LoginAccount","Account")'>Đăng nhập</a></li>
                                        <li class="nav-item"><a class="nav-link" href='@Url.Action("RegisterAccount","Account")'>Đăng ký</a></li>
                                    }

                                </ul>
                            </li>
                        </ul>
                        <ul class="nav navbar-nav navbar-right">
                            <li class="nav-item"></li>
                            <li class="nav-item"><a href='@Url.Action("Cart","ShoppingCart")' class="cart"><span class="lnr lnr-cart"></span></a></li>
                            <li class="nav-item"><button class="search"><span class="lnr lnr-magnifier" id="search"></span></button></li>
                        </ul>
                    </div>
                </div>
            </nav>
        </div>
        <div class="search_input" id="search_input_box">
            <div class="container">
                @using (Html.BeginForm("CheckFilters", "Product", FormMethod.Post, new { id = "searchForm", @class = "d-flex justify-content-between" }))
                {
                    <input type="text" class="form-control" id="search_input" name="NameProduct" placeholder="Nhập tên sản phẩm cần tìm kiếm">
                    <button type="submit" class="btn"></button>
                    <span class="lnr lnr-cross" id="close_search" title="Close Search"></span>
                }
            </div>
        </div>
    </header>
    @RenderBody()
    <footer class="footer-area section_gap">
        <div class="container">
            <div class="row">
                <div class="col-lg-3  col-md-6 col-sm-6">
                    <div class="single-footer-widget">
                        <h6>Về chúng tôi</h6>
                        <p class="text-light">@inf.veCuaHang</p>
                    </div>
                </div>
                <div class="col-lg-3  col-md-6 col-sm-6">
                    <div class="single-footer-widget">
                        <h6>Danh mục</h6>
                        <ul>
                            <li class="nav-item mt-3"><a href='@Url.Action("Index","Home")' class="text-light">Trang chủ</a></li>
                            <li class="nav-item mt-3"><a href='@Url.Action("Index","Product")' class="text-light">Sản phẩm</a></li>
                            <li class="nav-item mt-3"><a href='@Url.Action("Index","Blog")' class="text-light">Bài viết</a></li>
                            <li class="nav-item mt-3"><a href='@Url.Action("Index","Contact")' class="text-light">Liên hệ</a></li>

                        </ul>
                    </div>
                </div>
                <div class="col-lg-3  col-md-6 col-sm-6">
                    <div class="single-footer-widget mail-chimp">
                        <h6 class="mb-20">Hệ thống cửa hàng</h6>
                        <ul class="text-light"><li><u>Showroom HCM</u>: @inf.diaChiLayHang - @inf.soDTLienHe</li></ul>
                    </div>
                </div>
                <div class="col-lg-3 col-md-6 col-sm-6">
                    <div class="single-footer-widget">
                        <h6>Liên hệ với chúng tôi</h6>
                        <p class="text-light"><i class="fa fa-phone"><a href="tel:@inf.soDTLienHe" class="text-light"> Phone: @inf.soDTLienHe</a></i></p>
                        <p class="text-light"><i class="fa fa-envelope"></i> Email: @inf.emailLienHe</p>
                        <div class="footer-social d-flex align-items-center text-light">
                            <a href="https://www.facebook.com/hoangnhat888/"><i class="fa fa-facebook "></i></a>
                            <a href="#"><i class="fa fa-twitter"></i></a>
                            <a href="#"><i class="fa fa-dribbble"></i></a>
                            <a href="#"><i class="fa fa-behance"></i></a>
                        </div>
                    </div>
                </div>
            </div>
            <div class="footer-bottom d-flex justify-content-center align-items-center flex-wrap">
                <p class="footer-text m-0 text-light">Copyright &copy;
                <script>document.write(new Date().getFullYear());</script> KarmaEyewear.site — Tự hào đồng hành cùng phong cách của bạn.</p>
            </div>
        </div>
    </footer>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/popper.js/1.11.0/umd/popper.min.js" integrity="sha384-b/U6ypiBEHpOf/4+1nzFpr53nxSS+GLCkfwBdFNTxtclqqenISfwAzpKaMNFNmj4" crossorigin="anonymous"></script>
    <script src="https://maps.googleapis.com/maps/api/js?key=AIzaSyCjCGmQ0Uq4exrzdcL6rvxywDDOvfAu6eE"></script>
    <script src="~/Scripts/vendor/jquery-2.2.4.min.js"></script>
    <script src="~/Scripts/vendor/bootstrap.min.js"></script>
    <script src="~/Scripts/jquery.ajaxchimp.min.js"></script>
    <script src="~/Scripts/jquery.nice-select.min.js"></script>
    <script src="~/Scripts/jquery.sticky.js"></script>
    <script src="~/Scripts/nouislider.min.js"></script>
    <script src="~/Scripts/countdown.js"></script>
    <script src="~/Scripts/jquery.magnific-popup.min.js"></script>
    <script src="~/Scripts/owl.carousel.min.js"></script>
    <script src="~/Scripts/gmaps.min.js"></script>
    <script src="~/Scripts/main.js"></script>
</body>
</html>