@{
    ViewBag.Title = "AI tư vấn chọn kính";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var mediaPipeUrl = "https://cdn.jsdelivr.net/npm/@mediapipe/face_mesh/face_mesh.js";
}

<script>
    var getProductsUrl = '@Url.Action("GetRecommendedProducts", "FaceAI")';
</script>

<style>
    .ai-face-page {
        padding: 150px 0 90px;
        background: linear-gradient(180deg, #fff 0%, #f6f7fb 100%);
    }

    .ai-title {
        text-align: center;
        margin-bottom: 45px;
    }

    .badge-ai {
        display: inline-block;
        background: #fff3d8;
        color: #f5a400;
        font-weight: 700;
        padding: 8px 18px;
        border-radius: 30px;
        margin-bottom: 16px;
        font-size: 14px;
    }

    .ai-title h1 {
        font-size: 42px;
        font-weight: 800;
        color: #181818;
        margin-bottom: 14px;
    }

    .ai-title p {
        font-size: 17px;
        color: #666;
    }

    .ai-box {
        background: #fff;
        border-radius: 22px;
        padding: 34px;
        box-shadow: 0 18px 45px rgba(0,0,0,0.08);
        margin-bottom: 30px;
    }

    .ai-upload {
        border: 2px dashed #fbb72c;
        border-radius: 20px;
        padding: 36px;
        text-align: center;
        background: linear-gradient(135deg, #fffaf0, #ffffff);
    }

        .ai-upload h3 {
            font-size: 24px;
            font-weight: 800;
            color: #222;
        }

    #imageUpload {
        max-width: 430px;
        margin: 20px auto 0;
        height: 44px;
        border-radius: 10px;
    }

    #previewImage {
        max-width: 330px;
        width: 100%;
        display: none;
        border-radius: 20px;
        margin: 28px auto 0;
        box-shadow: 0 15px 35px rgba(0,0,0,0.18);
    }

    .ai-result {
        text-align: center;
        padding: 30px;
        border-radius: 20px;
        background: linear-gradient(135deg, #f7f7f7, #ffffff);
        border: 1px solid #eee;
    }

        .ai-result h3 {
            font-size: 28px;
            font-weight: 800;
            color: #222;
            margin-bottom: 12px;
        }

    .ai-guide h3 {
        font-size: 24px;
        font-weight: 800;
        color: #222;
        margin-bottom: 22px;
    }

    .ai-guide-item {
        display: flex;
        gap: 12px;
        margin-bottom: 18px;
        color: #555;
        line-height: 1.6;
    }

    .ai-guide-icon {
        width: 34px;
        height: 34px;
        min-width: 34px;
        border-radius: 50%;
        background: #fff3d8;
        color: #f5a400;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 800;
    }

    .ai-products-title {
        text-align: center;
        font-size: 30px;
        font-weight: 800;
        margin: 45px 0 12px;
        color: #222;
    }

    .ai-products-subtitle {
        text-align: center;
        color: #666;
        margin-bottom: 30px;
    }

    #recommendedProducts {
        max-width: 1180px;
        margin: 0 auto;
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 28px;
        align-items: stretch;
    }

        #recommendedProducts > div:first-child {
            grid-column: 1 / -1;
        }

    @@media (max-width: 992px) {
        #recommendedProducts {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @@media (max-width: 576px) {
        #recommendedProducts {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 768px) {
        .ai-face-page {
            padding: 120px 0 60px;
        }

        .ai-title h1 {
            font-size: 30px;
        }
    }
</style>

<section class="ai-face-page">
    <div class="container">

        <div class="ai-title">
            <span class="badge-ai">AI FACE RECOMMENDATION</span>
            <h1>AI tư vấn gọng kính phù hợp với khuôn mặt</h1>
            <p>Phân tích dáng mặt và đề xuất sản phẩm thật từ cơ sở dữ liệu cửa hàng.</p>
        </div>

        <div class="row">
            <div class="col-lg-8">
                <div class="ai-box">
                    <div class="ai-upload">
                        <h3>Tải ảnh khuôn mặt</h3>
                        <p>Vui lòng chọn ảnh nhìn thẳng, rõ mặt, đủ sáng để AI phân tích chính xác hơn.</p>

                        <input type="file" id="imageUpload" accept="image/*" class="form-control" />

                        <img id="previewImage" />
                    </div>
                </div>

                <div class="ai-box">
                    <div class="ai-result">
                        <h3 id="result">Chưa có kết quả phân tích</h3>
                        <p id="suggestion">Hãy tải ảnh khuôn mặt để AI bắt đầu tư vấn.</p>
                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="ai-box ai-guide">
                    <h3>Hướng dẫn sử dụng</h3>

                    <div class="ai-guide-item">
                        <div class="ai-guide-icon">1</div>
                        <div>Chọn ảnh khuôn mặt nhìn thẳng, rõ mặt và đủ sáng.</div>
                    </div>

                    <div class="ai-guide-item">
                        <div class="ai-guide-icon">2</div>
                        <div>AI phân tích các điểm đặc trưng trên khuôn mặt.</div>
                    </div>

                    <div class="ai-guide-item">
                        <div class="ai-guide-icon">3</div>
                        <div>Hệ thống xác định dáng mặt: tròn, vuông, dài hoặc oval.</div>
                    </div>

                    <div class="ai-guide-item">
                        <div class="ai-guide-icon">4</div>
                        <div>Sản phẩm phù hợp sẽ được gợi ý trực tiếp từ database.</div>
                    </div>
                </div>
            </div>
        </div>

        <h2 class="ai-products-title">Sản phẩm gợi ý cho bạn</h2>
        <p class="ai-products-subtitle">Danh sách sản phẩm sẽ hiển thị sau khi phân tích khuôn mặt.</p>

        <div id="recommendedProducts"></div>

    </div>
</section>

<script src="@mediaPipeUrl"></script>
<script src="@Url.Content("~/Scripts/face-ai.js")"></script>