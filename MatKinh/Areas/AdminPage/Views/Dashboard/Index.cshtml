@model MatKinh.ViewModel.AdminDashboardVm
@using MatKinh.Models

@{
    ViewBag.Title = "Dashboard";

    bool isAdmin = string.Equals(Model.RoleCode, RoleConstants.ADMIN, StringComparison.OrdinalIgnoreCase);
    bool isStaff = string.Equals(Model.RoleCode, RoleConstants.STAFF, StringComparison.OrdinalIgnoreCase);
    bool isShipper = string.Equals(Model.RoleCode, RoleConstants.SHIPPER, StringComparison.OrdinalIgnoreCase);

    Func<decimal, string> money = value =>
    {
        return string.Format(System.Globalization.CultureInfo.GetCultureInfo("vi-VN"), "{0:c0}", value);
    };
}

<div class="admin-page-header">
    <div>
        <h1 class="admin-page-title">Dashboard</h1>
        <p class="admin-page-subtitle">
            Xin chào @Model.DisplayName, tổng quan hoạt động quản trị cửa hàng mắt kính.
        </p>
    </div>

    <ol class="breadcrumb admin-breadcrumb">
        <li class="breadcrumb-item active">Dashboard</li>
    </ol>
</div>

<section class="content">
    <div class="container-fluid p-0">

        @if (isAdmin)
        {
            <div class="row">
                <div class="col-xl-3 col-lg-6 col-md-6 col-sm-6">
                    <div class="dashboard-stat-card dashboard-stat-card--primary">
                        <div class="dashboard-stat-top">
                            <div>
                                <div class="dashboard-stat-label">Doanh thu đã ghi nhận</div>
                                <div class="dashboard-stat-value">@money(Model.TotalRevenue)</div>
                            </div>

                            <div class="dashboard-stat-icon icon-revenue">
                                <i class="fas fa-wallet"></i>
                            </div>
                        </div>

                        <p class="dashboard-stat-desc">
                            Tính từ các đơn hàng đã giao thành công và đã thanh toán.
                        </p>

                        <a href="@Url.Action("Revenue", "ManagerRevenue")" class="dashboard-stat-link">
                            Xem doanh thu <i class="fas fa-arrow-right ml-1"></i>
                        </a>
                    </div>
                </div>

                <div class="col-xl-3 col-lg-6 col-md-6 col-sm-6">
                    <div class="dashboard-stat-card">
                        <div class="dashboard-stat-top">
                            <div>
                                <div class="dashboard-stat-label">Doanh thu tháng</div>
                                <div class="dashboard-stat-value">@money(Model.MonthRevenue)</div>
                            </div>

                            <div class="dashboard-stat-icon icon-revenue">
                                <i class="fas fa-chart-line"></i>
                            </div>
                        </div>

                        <p class="dashboard-stat-desc">
                            Doanh thu hoàn tất trong tháng hiện tại của cửa hàng.
                        </p>

                        <a href="@Url.Action("Revenue", "ManagerRevenue")" class="dashboard-stat-link">
                            Xem báo cáo <i class="fas fa-arrow-right ml-1"></i>
                        </a>
                    </div>
                </div>

                <div class="col-xl-3 col-lg-6 col-md-6 col-sm-6">
                    <div class="dashboard-stat-card">
                        <div class="dashboard-stat-top">
                            <div>
                                <div class="dashboard-stat-label">Đơn chờ xác nhận</div>
                                <div class="dashboard-stat-value">@Model.PendingOrders</div>
                            </div>

                            <div class="dashboard-stat-icon icon-orders">
                                <i class="fas fa-shopping-bag"></i>
                            </div>
                        </div>

                        <p class="dashboard-stat-desc">
                            Đơn mới cần được kiểm tra thông tin và xác nhận.
                        </p>

                        <a href="@Url.Action("Index", "ManagerOrder", new { status = OrderStatusConstants.PENDING })" class="dashboard-stat-link">
                            Xử lý đơn <i class="fas fa-arrow-right ml-1"></i>
                        </a>
                    </div>
                </div>

                <div class="col-xl-3 col-lg-6 col-md-6 col-sm-6">
                    <div class="dashboard-stat-card">
                        <div class="dashboard-stat-top">
                            <div>
                                <div class="dashboard-stat-label">Bài chờ duyệt</div>
                                <div class="dashboard-stat-value">@Model.PendingBlogs</div>
                            </div>

                            <div class="dashboard-stat-icon icon-content">
                                <i class="fas fa-newspaper"></i>
                            </div>
                        </div>

                        <p class="dashboard-stat-desc">
                            Bài viết nhân viên gửi đang chờ quản trị viên kiểm duyệt.
                        </p>

                        <a href="@Url.Action("ManagerBlog", "ManagerBlog", new { status = "draft" })" class="dashboard-stat-link">
                            Duyệt bài <i class="fas fa-arrow-right ml-1"></i>
                        </a>
                    </div>
                </div>
            </div>
        }

        @if (isStaff)
        {
            <div class="row">
                <div class="col-xl-3 col-lg-6 col-md-6 col-sm-6">
                    <div class="dashboard-stat-card dashboard-stat-card--primary">
                        <div class="dashboard-stat-top">
                            <div>
                                <div class="dashboard-stat-label">Đơn chờ xác nhận</div>
                                <div class="dashboard-stat-value">@Model.PendingOrders</div>
                            </div>

                            <div class="dashboard-stat-icon icon-orders">
                                <i class="fas fa-shopping-bag"></i>
                            </div>
                        </div>

                        <p class="dashboard-stat-desc">
                            Đơn hàng mới cần xác nhận trước khi chuẩn bị sản phẩm.
                        </p>

                        <a href="@Url.Action("Index", "ManagerOrder", new { status = OrderStatusConstants.PENDING })" class="dashboard-stat-link">
                            Xem đơn <i class="fas fa-arrow-right ml-1"></i>
                        </a>
                    </div>
                </div>

                <div class="col-xl-3 col-lg-6 col-md-6 col-sm-6">
                    <div class="dashboard-stat-card">
                        <div class="dashboard-stat-top">
                            <div>
                                <div class="dashboard-stat-label">Đang chuẩn bị</div>
                                <div class="dashboard-stat-value">@Model.PreparingOrders</div>
                            </div>

                            <div class="dashboard-stat-icon icon-orders">
                                <i class="fas fa-box"></i>
                            </div>
                        </div>

                        <p class="dashboard-stat-desc">
                            Đơn đã xác nhận, đang chờ chuẩn bị hoặc gán shipper.
                        </p>

                        <a href="@Url.Action("Index", "ManagerOrder", new { status = OrderStatusConstants.PREPARING })" class="dashboard-stat-link">
                            Chuẩn bị hàng <i class="fas fa-arrow-right ml-1"></i>
                        </a>
                    </div>
                </div>

                <div class="col-xl-3 col-lg-6 col-md-6 col-sm-6">
                    <div class="dashboard-stat-card">
                        <div class="dashboard-stat-top">
                            <div>
                                <div class="dashboard-stat-label">Sản phẩm của tôi</div>
                                <div class="dashboard-stat-value">@Model.MyProducts</div>
                            </div>

                            <div class="dashboard-stat-icon icon-products">
                                <i class="fas fa-glasses"></i>
                            </div>
                        </div>

                        <p class="dashboard-stat-desc">
                            Các sản phẩm do bạn tạo và đang trực tiếp quản lý.
                        </p>

                        <a href="@Url.Action("ProductsList", "ListProduct")" class="dashboard-stat-link">
                            Xem sản phẩm <i class="fas fa-arrow-right ml-1"></i>
                        </a>
                    </div>
                </div>

                <div class="col-xl-3 col-lg-6 col-md-6 col-sm-6">
                    <div class="dashboard-stat-card">
                        <div class="dashboard-stat-top">
                            <div>
                                <div class="dashboard-stat-label">Sản phẩm hết hàng</div>
                                <div class="dashboard-stat-value">@Model.OutOfStockProducts</div>
                            </div>

                            <div class="dashboard-stat-icon icon-warning">
                                <i class="fas fa-exclamation-circle"></i>
                            </div>
                        </div>

                        <p class="dashboard-stat-desc">
                            Sản phẩm đang bán nhưng số lượng tồn kho hiện bằng 0.
                        </p>

                        <a href="@Url.Action("Index", "ManagerProduct", new { statusProduct = "outofstock" })" class="dashboard-stat-link">
                            Kiểm tra kho <i class="fas fa-arrow-right ml-1"></i>
                        </a>
                    </div>
                </div>
            </div>
        }

        @if (isShipper)
        {
            <div class="row">
                <div class="col-xl-3 col-lg-6 col-md-6 col-sm-6">
                    <div class="dashboard-stat-card dashboard-stat-card--primary">
                        <div class="dashboard-stat-top">
                            <div>
                                <div class="dashboard-stat-label">Đơn được giao</div>
                                <div class="dashboard-stat-value">@Model.MyAssignedOrders</div>
                            </div>

                            <div class="dashboard-stat-icon icon-orders">
                                <i class="fas fa-truck-loading"></i>
                            </div>
                        </div>

                        <p class="dashboard-stat-desc">
                            Đơn đã được phân công và đang chờ bắt đầu giao hàng.
                        </p>

                        <a href="@Url.Action("Index", "ManagerOrder", new { status = OrderStatusConstants.ASSIGNED_TO_SHIPPER })" class="dashboard-stat-link">
                            Nhận giao <i class="fas fa-arrow-right ml-1"></i>
                        </a>
                    </div>
                </div>

                <div class="col-xl-3 col-lg-6 col-md-6 col-sm-6">
                    <div class="dashboard-stat-card">
                        <div class="dashboard-stat-top">
                            <div>
                                <div class="dashboard-stat-label">Đang giao</div>
                                <div class="dashboard-stat-value">@Model.MyDeliveringOrders</div>
                            </div>

                            <div class="dashboard-stat-icon icon-orders">
                                <i class="fas fa-truck"></i>
                            </div>
                        </div>

                        <p class="dashboard-stat-desc">
                            Các đơn đang trên đường giao tới khách hàng.
                        </p>

                        <a href="@Url.Action("Index", "ManagerOrder", new { status = OrderStatusConstants.DELIVERING })" class="dashboard-stat-link">
                            Cập nhật giao <i class="fas fa-arrow-right ml-1"></i>
                        </a>
                    </div>
                </div>

                <div class="col-xl-3 col-lg-6 col-md-6 col-sm-6">
                    <div class="dashboard-stat-card">
                        <div class="dashboard-stat-top">
                            <div>
                                <div class="dashboard-stat-label">Giao thành công</div>
                                <div class="dashboard-stat-value">@Model.MyDeliveredOrders</div>
                            </div>

                            <div class="dashboard-stat-icon icon-success">
                                <i class="fas fa-check"></i>
                            </div>
                        </div>

                        <p class="dashboard-stat-desc">
                            Tổng số đơn bạn đã cập nhật giao thành công.
                        </p>

                        <a href="@Url.Action("Index", "ManagerOrder", new { status = OrderStatusConstants.DELIVERED })" class="dashboard-stat-link">
                            Xem lịch sử <i class="fas fa-arrow-right ml-1"></i>
                        </a>
                    </div>
                </div>

                <div class="col-xl-3 col-lg-6 col-md-6 col-sm-6">
                    <div class="dashboard-stat-card">
                        <div class="dashboard-stat-top">
                            <div>
                                <div class="dashboard-stat-label">Giao thất bại</div>
                                <div class="dashboard-stat-value">@Model.MyFailedOrders</div>
                            </div>

                            <div class="dashboard-stat-icon icon-danger">
                                <i class="fas fa-times"></i>
                            </div>
                        </div>

                        <p class="dashboard-stat-desc">
                            Các đơn đã được cập nhật trạng thái giao thất bại.
                        </p>

                        <a href="@Url.Action("Index", "ManagerOrder", new { status = OrderStatusConstants.DELIVERY_FAILED })" class="dashboard-stat-link">
                            Xem đơn <i class="fas fa-arrow-right ml-1"></i>
                        </a>
                    </div>
                </div>
            </div>
        }

        <div class="row mt-2">
            <div class="col-lg-8">
                <div class="card dashboard-panel">
                    <div class="card-header border-0">
                        <h3 class="card-title dashboard-panel-title">Tổng quan vận hành</h3>
                    </div>

                    <div class="card-body">
                        <div class="dashboard-overview-grid">

                            @if (isAdmin || isStaff)
                            {
                                <div class="dashboard-overview-item">
                                    <span class="overview-dot"></span>

                                    <div>
                                        <h4>Đơn hàng</h4>
                                        <p>
                                            Chờ xác nhận: <b>@Model.PendingOrders</b>,
                                            đang chuẩn bị: <b>@Model.PreparingOrders</b>,
                                            đang giao: <b>@Model.DeliveringOrders</b>.
                                        </p>
                                    </div>
                                </div>

                                <div class="dashboard-overview-item">
                                    <span class="overview-dot"></span>

                                    <div>
                                        <h4>Sản phẩm</h4>
                                        <p>
                                            Đang bán: <b>@Model.ActiveProducts</b>,
                                            hết hàng: <b>@Model.OutOfStockProducts</b>,
                                            ngừng bán: <b>@Model.InactiveProducts</b>.
                                        </p>
                                    </div>
                                </div>

                                <div class="dashboard-overview-item">
                                    <span class="overview-dot"></span>

                                    <div>
                                        <h4>Nội dung của tôi</h4>
                                        <p>
                                            Bạn đang có <b>@Model.MyBlogs</b> bài viết trong khu vực bài viết của tôi.
                                        </p>
                                    </div>
                                </div>
                            }

                            @if (isAdmin)
                            {
                                <div class="dashboard-overview-item">
                                    <span class="overview-dot"></span>

                                    <div>
                                        <h4>Hệ thống</h4>
                                        <p>
                                            Tài khoản hoạt động: <b>@Model.ActiveAccounts</b>,
                                            nhân viên: <b>@Model.StaffAccounts</b>,
                                            shipper: <b>@Model.ShipperAccounts</b>.
                                        </p>
                                    </div>
                                </div>
                            }

                            @if (isShipper)
                            {
                                <div class="dashboard-overview-item">
                                    <span class="overview-dot"></span>

                                    <div>
                                        <h4>Giao hàng</h4>
                                        <p>
                                            Được giao: <b>@Model.MyAssignedOrders</b>,
                                            đang giao: <b>@Model.MyDeliveringOrders</b>.
                                        </p>
                                    </div>
                                </div>

                                <div class="dashboard-overview-item">
                                    <span class="overview-dot"></span>

                                    <div>
                                        <h4>Kết quả giao</h4>
                                        <p>
                                            Thành công: <b>@Model.MyDeliveredOrders</b>,
                                            thất bại: <b>@Model.MyFailedOrders</b>.
                                        </p>
                                    </div>
                                </div>
                            }

                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="card dashboard-panel">
                    <div class="card-header border-0">
                        <h3 class="card-title dashboard-panel-title">Truy cập nhanh</h3>
                    </div>

                    <div class="card-body">
                        <div class="dashboard-quick-links">

                            @if (isAdmin || isStaff)
                            {
                                <a href="@Url.Action("AddProduct", "ListProduct")" class="dashboard-quick-link">
                                    <i class="fas fa-plus-circle"></i>
                                    <span>Thêm sản phẩm</span>
                                </a>

                                <a href="@Url.Action("Index", "ManagerOrder")" class="dashboard-quick-link">
                                    <i class="fas fa-receipt"></i>
                                    <span>Đơn hàng vận hành</span>
                                </a>

                                <a href="@Url.Action("BlogList", "ListBlog")" class="dashboard-quick-link">
                                    <i class="fas fa-edit"></i>
                                    <span>Bài viết của tôi</span>
                                </a>
                            }

                            @if (isAdmin)
                            {
                                <a href="@Url.Action("ManagerBlog", "ManagerBlog", new { status = "draft" })" class="dashboard-quick-link">
                                    <i class="fas fa-check-circle"></i>
                                    <span>Kiểm duyệt bài viết</span>
                                </a>

                                <a href="@Url.Action("AccountManager", "ManagerAccount")" class="dashboard-quick-link">
                                    <i class="fas fa-users-cog"></i>
                                    <span>Quản lý tài khoản</span>
                                </a>

                                <a href="@Url.Action("Index", "SettingInformationWebsite")" class="dashboard-quick-link">
                                    <i class="fas fa-store"></i>
                                    <span>Thông tin cửa hàng</span>
                                </a>
                            }

                            @if (isShipper)
                            {
                                <a href="@Url.Action("Index", "ManagerOrder")" class="dashboard-quick-link">
                                    <i class="fas fa-truck"></i>
                                    <span>Đơn được giao cho tôi</span>
                                </a>

                                <a href="@Url.Action("Index", "Profile")" class="dashboard-quick-link">
                                    <i class="fas fa-user-circle"></i>
                                    <span>Hồ sơ cá nhân</span>
                                </a>
                            }

                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>
</section>