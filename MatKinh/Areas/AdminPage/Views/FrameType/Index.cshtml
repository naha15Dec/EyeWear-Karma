
@model MatKinh.ViewModel.AdminFrameTypeIndexVm

@{
    ViewBag.Title = "Kiểu gọng";
    bool isEdit = Model != null && Model.Form != null && Model.Form.KieuGongId.HasValue;

    int startPage = Math.Max(1, Model.CurrentPage - 2);
    int endPage = Math.Min(Model.TotalPages, Model.CurrentPage + 2);
}

<div class="admin-page-header">
    <div>
        <h1 class="admin-page-title">Kiểu gọng</h1>
        <p class="admin-page-subtitle">
            Quản lý các kiểu gọng kính dùng cho sản phẩm và AI tư vấn chọn kính.
        </p>
    </div>

    <ol class="breadcrumb admin-breadcrumb">
        <li class="breadcrumb-item">
            <a href='@Url.Action("Index","Dashboard")'>Dashboard</a>
        </li>
        <li class="breadcrumb-item active">Kiểu gọng</li>
    </ol>
</div>

<section class="content admin-system-page">
    <div class="container-fluid p-0">

        <div class="row">
            <div class="col-lg-8">
                <div class="card admin-system-card">
                    <div class="card-header border-0">
                        <div class="admin-system-card-heading">
                            <div class="admin-system-card-icon">
                                <i class="fas fa-glasses"></i>
                            </div>

                            <div>
                                <h3 class="admin-system-card-title">Danh sách kiểu gọng</h3>
                                <p class="admin-system-card-subtitle">
                                    Có <b>@((Model.FrameTypes != null) ? Model.FrameTypes.Count : 0)</b> kiểu gọng trong hệ thống.
                                </p>
                            </div>
                        </div>
                    </div>

                    <div class="card-body">
                        @if (Model.FrameTypes != null && Model.FrameTypes.Count > 0)
                        {
                            <div class="admin-system-table-wrap">
                                <table class="table admin-system-table">
                                    <thead>
                                        <tr>
                                            <th>Mã kiểu gọng</th>
                                            <th>Tên</th>
                                            <th>Mô tả</th>
                                            <th>Trạng thái</th>
                                            <th>Sản phẩm</th>
                                            <th>Rule AI</th>
                                            <th class="text-center">Thao tác</th>
                                        </tr>
                                    </thead>

                                    <tbody>
                                        @foreach (var item in Model.FrameTypes)
                                        {
                                            <tr>
                                                <td data-label="Mã kiểu gọng">
                                                    <span class="admin-system-code">#@item.MaKieuGong</span>
                                                </td>

                                                <td data-label="Tên">
                                                    <div class="admin-system-name">@item.TenKieuGong</div>
                                                </td>

                                                <td data-label="Mô tả">
                                                    <span class="admin-system-desc">
                                                        @(string.IsNullOrWhiteSpace(item.MoTa)
                                                            ? "Chưa có mô tả"
                                                            : (item.MoTa.Length > 60 ? item.MoTa.Substring(0, 60) + "..." : item.MoTa))
                                                    </span>
                                                </td>

                                                <td data-label="Trạng thái">
                                                    @if (item.IsActive)
                                                    {
                                                        <span class="admin-system-badge active">
                                                            <span></span>
                                                            Đang sử dụng
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        <span class="admin-system-badge inactive">
                                                            <span></span>
                                                            Ngừng sử dụng
                                                        </span>
                                                    }
                                                </td>

                                                <td data-label="Sản phẩm">
                                                    <span class="admin-system-count">@item.SoSanPham</span>
                                                </td>

                                                <td data-label="Rule AI">
                                                    <span class="admin-system-count">@item.SoRule</span>
                                                </td>

                                                <td data-label="Thao tác" class="text-center">
                                                    <div class="admin-system-actions">
                                                        @using (Html.BeginForm("Edit", "FrameType", FormMethod.Post, new { @class = "d-inline admin-system-inline-form", autocomplete = "off" }))
                                                        {
                                                            @Html.AntiForgeryToken()
                                                            <input type="hidden" name="id" value="@item.KieuGongId" />

                                                            <button type="submit" class="btn admin-system-action edit">
                                                                <i class="fas fa-pen"></i>
                                                                <span>Sửa</span>
                                                            </button>
                                                        }

                                                        @using (Html.BeginForm("ToggleStatus", "FrameType", FormMethod.Post, new { @class = "d-inline admin-system-inline-form", autocomplete = "off" }))
                                                        {
                                                            @Html.AntiForgeryToken()
                                                            <input type="hidden" name="id" value="@item.KieuGongId" />

                                                            if (item.IsActive)
                                                            {
                                                                <button type="submit"
                                                                        class="btn admin-system-action disable"
                                                                        data-confirm-title="Ngừng sử dụng kiểu gọng?"
                                                                        data-confirm="Kiểu gọng này sẽ được chuyển sang trạng thái ngừng sử dụng. Các sản phẩm và rule AI liên quan có thể bị ảnh hưởng."
                                                                        data-confirm-ok="Ngừng sử dụng">
                                                                    <i class="fas fa-ban"></i>
                                                                    <span>Ngừng sử dụng</span>
                                                                </button>
                                                            }
                                                            else
                                                            {
                                                                <button type="submit"
                                                                        class="btn admin-system-action activate"
                                                                        data-confirm-title="Kích hoạt lại kiểu gọng?"
                                                                        data-confirm="Kiểu gọng này sẽ được kích hoạt lại và có thể tiếp tục sử dụng trong sản phẩm và AI tư vấn."
                                                                        data-confirm-ok="Kích hoạt lại">
                                                                    <i class="fas fa-check"></i>
                                                                    <span>Kích hoạt lại</span>
                                                                </button>
                                                            }
                                                        }
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>

                                    <tfoot>
                                        <tr>
                                            <th>Mã kiểu gọng</th>
                                            <th>Tên</th>
                                            <th>Mô tả</th>
                                            <th>Trạng thái</th>
                                            <th>Sản phẩm</th>
                                            <th>Rule AI</th>
                                            <th class="text-center">Thao tác</th>
                                        </tr>
                                    </tfoot>
                                </table>
                            </div>
                        }
                        else
                        {
                            <div class="admin-system-empty">
                                <div class="admin-system-empty-icon">
                                    <i class="fas fa-glasses"></i>
                                </div>
                                <h3>Chưa có kiểu gọng</h3>
                                <p>Hãy thêm kiểu gọng đầu tiên cho hệ thống AI tư vấn kính.</p>
                            </div>
                        }

                        @if (Model.TotalPages > 1)
                        {
                            <div class="admin-system-pagination">
                                <div class="admin-system-pagination-info">
                                    Trang @Model.CurrentPage / @Model.TotalPages —
                                    hiển thị @Model.FrameTypes.Count trên tổng @Model.TotalItems kiểu gọng
                                </div>

                                <div class="admin-system-pagination-links">
                                    <a class="admin-system-page-link @(Model.HasPreviousPage ? "" : "disabled")"
                                       href="@(Model.HasPreviousPage ? Url.Action("Index", new { page = Model.CurrentPage - 1 }) : "javascript:void(0)")">
                                        <i class="fas fa-chevron-left"></i>
                                    </a>

                                    @if (startPage > 1)
                                    {
                                        <a class="admin-system-page-link"
                                           href="@Url.Action("Index", new { page = 1 })">
                                            1
                                        </a>

                                        if (startPage > 2)
                                        {
                                            <span class="admin-system-page-dots">...</span>
                                        }
                                    }

                                    @for (int i = startPage; i <= endPage; i++)
                                    {
                                        <a class="admin-system-page-link @(i == Model.CurrentPage ? "active" : "")"
                                           href="@Url.Action("Index", new { page = i })">
                                            @i
                                        </a>
                                    }

                                    @if (endPage < Model.TotalPages)
                                    {
                                        if (endPage < Model.TotalPages - 1)
                                        {
                                            <span class="admin-system-page-dots">...</span>
                                        }

                                        <a class="admin-system-page-link"
                                           href="@Url.Action("Index", new { page = Model.TotalPages })">
                                            @Model.TotalPages
                                        </a>
                                    }

                                    <a class="admin-system-page-link @(Model.HasNextPage ? "" : "disabled")"
                                       href="@(Model.HasNextPage ? Url.Action("Index", new { page = Model.CurrentPage + 1 }) : "javascript:void(0)")">
                                        <i class="fas fa-chevron-right"></i>
                                    </a>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                @using (Html.BeginForm("Save", "FrameType", FormMethod.Post, new { autocomplete = "off" }))
                {
                    @Html.AntiForgeryToken()

                    <input type="hidden"
                           name="KieuGongId"
                           value="@(Model.Form.KieuGongId.HasValue ? Model.Form.KieuGongId.Value.ToString() : "")" />

                    <div class="card admin-system-form-card">
                        <div class="card-header border-0">
                            <div class="admin-system-form-heading">
                                <div class="admin-system-card-icon">
                                    <i class="fas fa-edit"></i>
                                </div>

                                <div>
                                    <h3>@(isEdit ? "Cập nhật kiểu gọng" : "Thêm kiểu gọng")</h3>
                                    <p>
                                        @(isEdit
                                            ? "Chỉnh sửa thông tin kiểu gọng hiện có."
                                            : "Tạo kiểu gọng mới để phân loại sản phẩm và phục vụ AI tư vấn.")
                                    </p>
                                </div>
                            </div>

                            @if (isEdit)
                            {
                                <a href="@Url.Action("Index", "FrameType")" class="btn admin-system-btn admin-system-btn-light">
                                    Hủy sửa
                                </a>
                            }
                        </div>

                        <div class="card-body">
                            <div class="form-group admin-system-form-group">
                                <label>Mã kiểu gọng</label>
                                <input type="text"
                                       name="MaKieuGong"
                                       class="form-control admin-system-input"
                                       placeholder="Ví dụ: SQUARE"
                                       value="@Model.Form.MaKieuGong"
                                       autocomplete="off" />
                                @Html.ValidationMessage("MaKieuGong", "", new { @class = "text-danger admin-system-validation" })
                            </div>

                            <div class="form-group admin-system-form-group">
                                <label>Tên kiểu gọng</label>
                                <input type="text"
                                       name="TenKieuGong"
                                       class="form-control admin-system-input"
                                       placeholder="Ví dụ: Gọng vuông"
                                       value="@Model.Form.TenKieuGong"
                                       autocomplete="off" />
                                @Html.ValidationMessage("TenKieuGong", "", new { @class = "text-danger admin-system-validation" })
                            </div>

                            <div class="form-group admin-system-form-group">
                                <label>Mô tả</label>
                                <textarea name="MoTa"
                                          class="form-control admin-system-input admin-system-note"
                                          placeholder="Mô tả kiểu gọng..."
                                          autocomplete="off">@Model.Form.MoTa</textarea>
                                @Html.ValidationMessage("MoTa", "", new { @class = "text-danger admin-system-validation" })
                            </div>

                            <div class="form-group admin-system-form-group">
                                <label>Trạng thái</label>
                                <select name="IsActive" class="form-control admin-system-input" autocomplete="off">
                                    <option value="true" @(Model.Form.IsActive ? "selected" : "")>Đang sử dụng</option>
                                    <option value="false" @(!Model.Form.IsActive ? "selected" : "")>Ngừng sử dụng</option>
                                </select>
                            </div>

                            <div class="admin-system-form-actions">
                                <button type="submit" class="btn admin-system-btn admin-system-btn-save">
                                    <i class="fas fa-save mr-1"></i>
                                    @(isEdit ? "Cập nhật kiểu gọng" : "Lưu kiểu gọng")
                                </button>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>

    </div>
</section>