@model MatKinh.ViewModel.AdminBrandIndexVm

@{
    ViewBag.Title = "Thương hiệu";
    bool isEdit = Model != null && Model.Form != null && Model.Form.ThuongHieuId.HasValue;
}

<div class="admin-page-header">
    <div>
        <h1 class="admin-page-title">Thương hiệu</h1>
        <p class="admin-page-subtitle">Quản lý danh sách thương hiệu kính mắt trong hệ thống.</p>
    </div>

    <ol class="breadcrumb admin-breadcrumb">
        <li class="breadcrumb-item">
            <a href='@Url.Action("Index","Dashboard")'>Dashboard</a>
        </li>
        <li class="breadcrumb-item active">Thương hiệu</li>
    </ol>
</div>

<section class="content admin-system-page">
    <div class="container-fluid p-0">

        <div class="row">
            <div class="col-lg-7">
                <div class="card admin-card">
                    <div class="card-header admin-card-header border-0">
                        <div class="admin-card-title-wrap">
                            <h3 class="admin-card-title">Danh sách thương hiệu</h3>
                            <span class="admin-card-count">@((Model.Brands != null) ? Model.Brands.Count : 0) thương hiệu</span>
                        </div>
                    </div>

                    <div class="card-body">
                        <div class="table-responsive admin-system-table-wrap">
                            <table class="table admin-system-table align-middle">
                                <thead>
                                    <tr>
                                        <th>Mã thương hiệu</th>
                                        <th>Tên</th>
                                        <th>Mô tả</th>
                                        <th>Trạng thái</th>
                                        <th>Sản phẩm</th>
                                        <th class="text-center">Thao tác</th>
                                    </tr>
                                </thead>

                                <tbody>
                                    @if (Model.Brands != null && Model.Brands.Count > 0)
                                    {
                                        foreach (var item in Model.Brands)
                                        {
                                            <tr>
                                                <td>
                                                    <span class="admin-system-code">#@item.MaThuongHieu</span>
                                                </td>

                                                <td>
                                                    <div class="admin-system-name">@item.TenThuongHieu</div>
                                                </td>

                                                <td>
                                                    <span class="admin-system-desc">
                                                        @(string.IsNullOrWhiteSpace(item.MoTa)
                                                            ? "Chưa có mô tả"
                                                            : (item.MoTa.Length > 60 ? item.MoTa.Substring(0, 60) + "..." : item.MoTa))
                                                    </span>
                                                </td>

                                                <td>
                                                    @if (item.IsActive)
                                                    {
                                                        <span class="admin-system-badge active">Đang sử dụng</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="admin-system-badge inactive">Ngừng sử dụng</span>
                                                    }
                                                </td>

                                                <td>
                                                    <span class="admin-system-count">@item.SoSanPham</span>
                                                </td>

                                                <td class="text-center">
                                                    <div class="admin-system-actions">
                                                        @using (Html.BeginForm("Update", "ListBrand", FormMethod.Post, new { @class = "d-inline" }))
                                                        {
                                                            @Html.AntiForgeryToken()
                                                            <input type="hidden" name="id" value="@item.ThuongHieuId" />

                                                            <button type="submit" class="btn admin-system-action edit">
                                                                <i class="fas fa-pen"></i> Sửa
                                                            </button>
                                                        }

                                                        @using (Html.BeginForm("Delete", "ListBrand", FormMethod.Post, new { @class = "d-inline" }))
                                                        {
                                                            @Html.AntiForgeryToken()
                                                            <input type="hidden" name="id" value="@item.ThuongHieuId" />

                                                            if (item.IsActive)
                                                            {
                                                                <button type="submit"
                                                                        class="btn admin-system-action disable"
                                                                        onclick="return confirm('Bạn có chắc muốn ngừng sử dụng thương hiệu này?')">
                                                                    <i class="fas fa-ban"></i> Ngừng sử dụng
                                                                </button>
                                                            }
                                                            else
                                                            {
                                                                <button type="submit"
                                                                        class="btn admin-system-action activate"
                                                                        onclick="return confirm('Bạn có chắc muốn kích hoạt lại thương hiệu này?')">
                                                                    <i class="fas fa-check"></i> Kích hoạt lại
                                                                </button>
                                                            }
                                                        }
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr>
                                            <td colspan="6" class="admin-system-empty">
                                                <strong>Chưa có thương hiệu</strong>
                                                <span>Hãy thêm thương hiệu đầu tiên cho hệ thống.</span>
                                            </td>
                                        </tr>
                                    }
                                </tbody>

                                <tfoot>
                                    <tr>
                                        <th>Mã thương hiệu</th>
                                        <th>Tên</th>
                                        <th>Mô tả</th>
                                        <th>Trạng thái</th>
                                        <th>Sản phẩm</th>
                                        <th class="text-center">Thao tác</th>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-5">
                @using (Html.BeginForm("AddBrand", "ListBrand", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()

                    <input type="hidden"
                           name="ThuongHieuId"
                           value="@(Model.Form.ThuongHieuId.HasValue ? Model.Form.ThuongHieuId.Value.ToString() : "")" />

                    <div class="card admin-form-card admin-system-form-card">
                        <div class="card-header border-0 d-flex justify-content-between align-items-center">
                            <h3 class="card-title mb-0">@(isEdit ? "Cập nhật thương hiệu" : "Thêm thương hiệu")</h3>

                            @if (isEdit)
                            {
                                <a href="@Url.Action("Brand", "ListBrand")" class="btn admin-btn admin-btn-light">
                                    Hủy sửa
                                </a>
                            }
                        </div>

                        <div class="card-body">
                            <div class="form-group">
                                <label>Mã thương hiệu</label>
                                <input type="text"
                                       name="MaThuongHieu"
                                       class="form-control admin-input"
                                       placeholder="Ví dụ: RAYBAN"
                                       value="@Model.Form.MaThuongHieu" />
                                @Html.ValidationMessage("MaThuongHieu", "", new { @class = "text-danger" })
                            </div>

                            <div class="form-group">
                                <label>Tên thương hiệu</label>
                                <input type="text"
                                       name="TenThuongHieu"
                                       class="form-control admin-input"
                                       placeholder="Tên thương hiệu"
                                       value="@Model.Form.TenThuongHieu" />
                                @Html.ValidationMessage("TenThuongHieu", "", new { @class = "text-danger" })
                            </div>

                            <div class="form-group">
                                <label>Mô tả</label>
                                <textarea name="MoTa"
                                          class="form-control admin-input admin-system-note"
                                          placeholder="Mô tả thương hiệu...">@Model.Form.MoTa</textarea>
                                @Html.ValidationMessage("MoTa", "", new { @class = "text-danger" })
                            </div>

                            <div class="form-group">
                                <label>Trạng thái</label>
                                <select name="IsActive" class="form-control admin-input">
                                    <option value="true" @(Model.Form.IsActive ? "selected" : "")>Đang sử dụng</option>
                                    <option value="false" @(!Model.Form.IsActive ? "selected" : "")>Ngừng sử dụng</option>
                                </select>
                            </div>

                            <div class="admin-system-form-actions">
                                <button type="submit" class="btn admin-btn admin-btn-save">
                                    <i class="fas fa-save mr-1"></i>
                                    @(isEdit ? "Cập nhật thương hiệu" : "Lưu thương hiệu")
                                </button>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>

    </div>
</section>