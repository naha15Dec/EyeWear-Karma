@model MatKinh.ViewModel.AdminBrandIndexVm

@{
    ViewBag.Title = "Thương hiệu";
    bool isEdit = Model != null && Model.Form != null && Model.Form.ThuongHieuId.HasValue;
}

<div class="admin-page-header">
    <div>
        <h1 class="admin-page-title">Thương hiệu</h1>
        <p class="admin-page-subtitle">
            Quản lý danh sách thương hiệu kính mắt trong hệ thống.
        </p>
    </div>

    <ol class="breadcrumb admin-breadcrumb">
        <li class="breadcrumb-item">
            <a href='@Url.Action("Index","Dashboard")'>Dashboard</a>
        </li>
        <li class="breadcrumb-item active">Thương hiệu</li>
    </ol>
</div>

<section class="content admin-system-page">
    <div class="container-fluid p-0">

        <div class="row">
            <div class="col-lg-7">
                <div class="card admin-system-card">
                    <div class="card-header border-0">
                        <div class="admin-system-card-heading">
                            <div class="admin-system-card-icon">
                                <i class="fas fa-copyright"></i>
                            </div>

                            <div>
                                <h3 class="admin-system-card-title">Danh sách thương hiệu</h3>
                                <p class="admin-system-card-subtitle">
                                    Có <b>@((Model.Brands != null) ? Model.Brands.Count : 0)</b> thương hiệu trong hệ thống.
                                </p>
                            </div>
                        </div>
                    </div>

                    <div class="card-body">
                        @if (Model.Brands != null && Model.Brands.Count > 0)
                        {
                            <div class="admin-system-table-wrap">
                                <table class="table admin-system-table">
                                    <thead>
                                        <tr>
                                            <th>Mã thương hiệu</th>
                                            <th>Tên</th>
                                            <th>Mô tả</th>
                                            <th>Trạng thái</th>
                                            <th>Sản phẩm</th>
                                            <th class="text-center">Thao tác</th>
                                        </tr>
                                    </thead>

                                    <tbody>
                                        @foreach (var item in Model.Brands)
                                        {
                                            <tr>
                                                <td data-label="Mã thương hiệu">
                                                    <span class="admin-system-code">#@item.MaThuongHieu</span>
                                                </td>

                                                <td data-label="Tên">
                                                    <div class="admin-system-name">@item.TenThuongHieu</div>
                                                </td>

                                                <td data-label="Mô tả">
                                                    <span class="admin-system-desc">
                                                        @(string.IsNullOrWhiteSpace(item.MoTa)
                                                            ? "Chưa có mô tả"
                                                            : (item.MoTa.Length > 60 ? item.MoTa.Substring(0, 60) + "..." : item.MoTa))
                                                    </span>
                                                </td>

                                                <td data-label="Trạng thái">
                                                    @if (item.IsActive)
                                                    {
                                                        <span class="admin-system-badge active">
                                                            <span></span>
                                                            Đang sử dụng
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        <span class="admin-system-badge inactive">
                                                            <span></span>
                                                            Ngừng sử dụng
                                                        </span>
                                                    }
                                                </td>

                                                <td data-label="Sản phẩm">
                                                    <span class="admin-system-count">@item.SoSanPham</span>
                                                </td>

                                                <td data-label="Thao tác" class="text-center">
                                                    <div class="admin-system-actions">
                                                        @using (Html.BeginForm("Update", "ListBrand", FormMethod.Post, new { @class = "d-inline admin-system-inline-form", autocomplete = "off" }))
                                                        {
                                                            @Html.AntiForgeryToken()
                                                            <input type="hidden" name="id" value="@item.ThuongHieuId" />

                                                            <button type="submit" class="btn admin-system-action edit">
                                                                <i class="fas fa-pen"></i>
                                                                <span>Sửa</span>
                                                            </button>
                                                        }

                                                        @using (Html.BeginForm("Delete", "ListBrand", FormMethod.Post, new { @class = "d-inline admin-system-inline-form", autocomplete = "off" }))
                                                        {
                                                            @Html.AntiForgeryToken()
                                                            <input type="hidden" name="id" value="@item.ThuongHieuId" />

                                                            if (item.IsActive)
                                                            {
                                                                <button type="submit"
                                                                        class="btn admin-system-action disable"
                                                                        data-confirm-title="Ngừng sử dụng thương hiệu?"
                                                                        data-confirm="Thương hiệu này sẽ được chuyển sang trạng thái ngừng sử dụng. Các sản phẩm liên quan có thể bị ảnh hưởng khi hiển thị hoặc phân loại."
                                                                        data-confirm-ok="Ngừng sử dụng">
                                                                    <i class="fas fa-ban"></i>
                                                                    <span>Ngừng sử dụng</span>
                                                                </button>
                                                            }
                                                            else
                                                            {
                                                                <button type="submit"
                                                                        class="btn admin-system-action activate"
                                                                        data-confirm-title="Kích hoạt lại thương hiệu?"
                                                                        data-confirm="Thương hiệu này sẽ được kích hoạt lại và có thể tiếp tục sử dụng trong hệ thống."
                                                                        data-confirm-ok="Kích hoạt lại">
                                                                    <i class="fas fa-check"></i>
                                                                    <span>Kích hoạt lại</span>
                                                                </button>
                                                            }
                                                        }
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>

                                    <tfoot>
                                        <tr>
                                            <th>Mã thương hiệu</th>
                                            <th>Tên</th>
                                            <th>Mô tả</th>
                                            <th>Trạng thái</th>
                                            <th>Sản phẩm</th>
                                            <th class="text-center">Thao tác</th>
                                        </tr>
                                    </tfoot>
                                </table>
                            </div>
                        }
                        else
                        {
                            <div class="admin-system-empty">
                                <div class="admin-system-empty-icon">
                                    <i class="fas fa-copyright"></i>
                                </div>
                                <h3>Chưa có thương hiệu</h3>
                                <p>Hãy thêm thương hiệu đầu tiên cho hệ thống.</p>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <div class="col-lg-5">
                @using (Html.BeginForm("AddBrand", "ListBrand", FormMethod.Post, new { autocomplete = "off" }))
                {
                    @Html.AntiForgeryToken()

                    <input type="hidden"
                           name="ThuongHieuId"
                           value="@(Model.Form.ThuongHieuId.HasValue ? Model.Form.ThuongHieuId.Value.ToString() : "")" />

                    <div class="card admin-system-form-card">
                        <div class="card-header border-0">
                            <div class="admin-system-form-heading">
                                <div class="admin-system-card-icon">
                                    <i class="fas fa-edit"></i>
                                </div>

                                <div>
                                    <h3>@(isEdit ? "Cập nhật thương hiệu" : "Thêm thương hiệu")</h3>
                                    <p>
                                        @(isEdit ? "Chỉnh sửa thông tin thương hiệu hiện có." : "Tạo thương hiệu mới cho hệ thống sản phẩm.")
                                    </p>
                                </div>
                            </div>

                            @if (isEdit)
                            {
                                <a href="@Url.Action("Brand", "ListBrand")" class="btn admin-system-btn admin-system-btn-light">
                                    Hủy sửa
                                </a>
                            }
                        </div>

                        <div class="card-body">
                            <div class="form-group admin-system-form-group">
                                <label>Mã thương hiệu</label>
                                <input type="text"
                                       name="MaThuongHieu"
                                       class="form-control admin-system-input"
                                       placeholder="Ví dụ: RAYBAN"
                                       value="@Model.Form.MaThuongHieu"
                                       autocomplete="off" />
                                @Html.ValidationMessage("MaThuongHieu", "", new { @class = "text-danger admin-system-validation" })
                            </div>

                            <div class="form-group admin-system-form-group">
                                <label>Tên thương hiệu</label>
                                <input type="text"
                                       name="TenThuongHieu"
                                       class="form-control admin-system-input"
                                       placeholder="Tên thương hiệu"
                                       value="@Model.Form.TenThuongHieu"
                                       autocomplete="off" />
                                @Html.ValidationMessage("TenThuongHieu", "", new { @class = "text-danger admin-system-validation" })
                            </div>

                            <div class="form-group admin-system-form-group">
                                <label>Mô tả</label>
                                <textarea name="MoTa"
                                          class="form-control admin-system-input admin-system-note"
                                          placeholder="Mô tả thương hiệu..."
                                          autocomplete="off">@Model.Form.MoTa</textarea>
                                @Html.ValidationMessage("MoTa", "", new { @class = "text-danger admin-system-validation" })
                            </div>

                            <div class="form-group admin-system-form-group">
                                <label>Trạng thái</label>
                                <select name="IsActive" class="form-control admin-system-input" autocomplete="off">
                                    <option value="true" @(Model.Form.IsActive ? "selected" : "")>Đang sử dụng</option>
                                    <option value="false" @(!Model.Form.IsActive ? "selected" : "")>Ngừng sử dụng</option>
                                </select>
                            </div>

                            <div class="admin-system-form-actions">
                                <button type="submit" class="btn admin-system-btn admin-system-btn-save">
                                    <i class="fas fa-save mr-1"></i>
                                    @(isEdit ? "Cập nhật thương hiệu" : "Lưu thương hiệu")
                                </button>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>

    </div>
</section>