@model MatKinh.ViewModel.AdminProductCreateVm

@{
    ViewBag.Title = "Thêm sản phẩm";
}

<div class="admin-page-header">
    <div>
        <h1 class="admin-page-title">Thêm sản phẩm</h1>
        <p class="admin-page-subtitle">
            Tạo sản phẩm mới cho hệ thống bán mắt kính, bao gồm thông tin sản phẩm, giá bán, tồn kho và ảnh đại diện.
        </p>
    </div>

    <ol class="breadcrumb admin-breadcrumb">
        <li class="breadcrumb-item">
            <a href='@Url.Action("Index","Dashboard")'>Dashboard</a>
        </li>
        <li class="breadcrumb-item">
            <a href='@Url.Action("ProductsList","ListProduct")'>Sản phẩm của tôi</a>
        </li>
        <li class="breadcrumb-item active">Thêm sản phẩm</li>
    </ol>
</div>

<section class="content admin-product-create-page">
    <div class="container-fluid p-0">

        @using (Html.BeginForm("AddProduct", "ListProduct", FormMethod.Post, new { enctype = "multipart/form-data", @class = "admin-product-create-form", autocomplete = "off" }))
        {
            @Html.AntiForgeryToken()

            <div class="row">
                <div class="col-xl-8 col-lg-7">

                    <div class="card admin-product-create-card">
                        <div class="card-header border-0">
                            <div class="admin-product-card-heading">
                                <div class="admin-product-card-icon">
                                    <i class="fas fa-glasses"></i>
                                </div>
                                <div>
                                    <h3 class="admin-product-card-title">Thông tin cơ bản</h3>
                                    <p class="admin-product-card-subtitle">
                                        Nhập tên sản phẩm và mô tả ngắn hiển thị ở danh sách sản phẩm.
                                    </p>
                                </div>
                            </div>
                        </div>

                        <div class="card-body">
                            @Html.ValidationSummary(true, "", new { @class = "text-danger admin-product-validation-summary" })

                            <div class="form-group admin-product-form-group">
                                <label>Tên sản phẩm</label>
                                @Html.TextBoxFor(m => m.TenSanPham, new
                                {
                                    @class = "form-control admin-product-input",
                                    placeholder = "Ví dụ: Gọng kính Gentle Monster South Side",
                                    autocomplete = "off"
                                })
                                @Html.ValidationMessageFor(m => m.TenSanPham, "", new { @class = "text-danger admin-product-validation" })
                            </div>

                            <div class="form-group admin-product-form-group mb-0">
                                <label>Mô tả tóm tắt</label>
                                @Html.TextAreaFor(m => m.MoTaNgan, new
                                {
                                    @class = "form-control admin-product-input admin-product-summary-input",
                                    rows = 3,
                                    placeholder = "Nhập mô tả ngắn hiển thị ở danh sách sản phẩm...",
                                    autocomplete = "off"
                                })
                                @Html.ValidationMessageFor(m => m.MoTaNgan, "", new { @class = "text-danger admin-product-validation" })
                            </div>
                        </div>
                    </div>

                    <div class="card admin-product-create-card">
                        <div class="card-header border-0">
                            <div class="admin-product-card-heading">
                                <div class="admin-product-card-icon">
                                    <i class="fas fa-align-left"></i>
                                </div>
                                <div>
                                    <h3 class="admin-product-card-title">Chi tiết sản phẩm</h3>
                                    <p class="admin-product-card-subtitle">
                                        Mô tả chất liệu, kiểu dáng, thông số, hướng dẫn sử dụng và chính sách liên quan.
                                    </p>
                                </div>
                            </div>
                        </div>

                        <div class="card-body">
                            <div class="admin-product-editor-wrap">
                                @Html.TextAreaFor(m => m.MoTaChiTiet, new
                                {
                                    @class = "admin-product-textarea tinymce-editor",
                                    id = "moTaChiTiet",
                                    placeholder = "Nhập chi tiết sản phẩm...",
                                    autocomplete = "off"
                                })
                            </div>
                            @Html.ValidationMessageFor(m => m.MoTaChiTiet, "", new { @class = "text-danger admin-product-validation" })
                        </div>
                    </div>

                    <div class="card admin-product-create-card mb-lg-0">
                        <div class="card-header border-0">
                            <div class="admin-product-card-heading">
                                <div class="admin-product-card-icon">
                                    <i class="fas fa-tags"></i>
                                </div>
                                <div>
                                    <h3 class="admin-product-card-title">Giá bán và tồn kho</h3>
                                    <p class="admin-product-card-subtitle">
                                        Nhập giá theo VNĐ và số lượng sản phẩm hiện có trong kho.
                                    </p>
                                </div>
                            </div>
                        </div>

                        <div class="card-body">
                            <div class="row">
                                <div class="col-md-4">
                                    <div class="form-group admin-product-form-group">
                                        <label>Giá gốc</label>
                                        @Html.TextBoxFor(m => m.GiaGoc, new
                                        {
                                            @class = "form-control admin-product-input currency-input text-right",
                                            autocomplete = "off",
                                            placeholder = "0"
                                        })
                                        @Html.ValidationMessageFor(m => m.GiaGoc, "", new { @class = "text-danger admin-product-validation" })
                                    </div>
                                </div>

                                <div class="col-md-4">
                                    <div class="form-group admin-product-form-group">
                                        <label>Giá bán</label>
                                        @Html.TextBoxFor(m => m.GiaBan, new
                                        {
                                            @class = "form-control admin-product-input currency-input text-right",
                                            autocomplete = "off",
                                            placeholder = "0"
                                        })
                                        @Html.ValidationMessageFor(m => m.GiaBan, "", new { @class = "text-danger admin-product-validation" })
                                    </div>
                                </div>

                                <div class="col-md-4">
                                    <div class="form-group admin-product-form-group">
                                        <label>Số lượng tồn</label>
                                        @Html.TextBoxFor(m => m.SoLuongTon, new
                                        {
                                            @class = "form-control admin-product-input text-right",
                                            type = "number",
                                            min = "0",
                                            autocomplete = "off",
                                            placeholder = "0"
                                        })
                                        @Html.ValidationMessageFor(m => m.SoLuongTon, "", new { @class = "text-danger admin-product-validation" })
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>

                <div class="col-xl-4 col-lg-5">
                    <div class="admin-product-side-sticky">

                        <div class="card admin-product-create-card">
                            <div class="card-header border-0">
                                <div class="admin-product-card-heading">
                                    <div class="admin-product-card-icon">
                                        <i class="fas fa-image"></i>
                                    </div>
                                    <div>
                                        <h3 class="admin-product-card-title">Ảnh đại diện</h3>
                                        <p class="admin-product-card-subtitle">
                                            Ảnh chính dùng để hiển thị ngoài trang sản phẩm.
                                        </p>
                                    </div>
                                </div>
                            </div>

                            <div class="card-body">
                                <div id="imagePreviewSingle" class="admin-product-image-preview">
                                    <div class="admin-product-image-placeholder">
                                        <i class="fas fa-cloud-upload-alt"></i>
                                        <strong>Xem trước ảnh đại diện</strong>
                                        <span>Hỗ trợ JPG, JPEG, PNG, GIF, WEBP</span>
                                    </div>
                                </div>

                                <div class="admin-product-file-box">
                                    <div class="custom-file">
                                        <input type="file"
                                               class="custom-file-input admin-product-file-input"
                                               id="inputSingleFile"
                                               name="imageAvatar"
                                               accept=".jpg,.jpeg,.png,.gif,.webp" />
                                        <label class="custom-file-label admin-product-file-label" for="inputSingleFile">
                                            Chọn ảnh
                                        </label>
                                    </div>
                                </div>

                                <div class="admin-product-upload-note">
                                    <i class="fas fa-info-circle"></i>
                                    <span>Nên dùng ảnh vuông hoặc ảnh ngang rõ sản phẩm để giao diện ngoài website đẹp hơn.</span>
                                </div>
                            </div>
                        </div>

                        <div class="card admin-product-create-card mb-0">
                            <div class="card-header border-0">
                                <div class="admin-product-card-heading">
                                    <div class="admin-product-card-icon">
                                        <i class="fas fa-sliders-h"></i>
                                    </div>
                                    <div>
                                        <h3 class="admin-product-card-title">Phân loại và hiển thị</h3>
                                        <p class="admin-product-card-subtitle">
                                            Chọn thương hiệu, loại sản phẩm và thiết lập hiển thị ban đầu.
                                        </p>
                                    </div>
                                </div>
                            </div>

                            <div class="card-body">
                                <div class="form-group admin-product-form-group">
                                    <label>Thương hiệu</label>
                                    @Html.DropDownListFor(
                                        m => m.ThuongHieuId,
                                        Model.Brands,
                                        "-- Chọn thương hiệu --",
                                        new { @class = "form-control admin-product-input", autocomplete = "off" })
                                    @Html.ValidationMessageFor(m => m.ThuongHieuId, "", new { @class = "text-danger admin-product-validation" })
                                </div>

                                <div class="form-group admin-product-form-group">
                                    <label>Loại sản phẩm</label>
                                    @Html.DropDownListFor(
                                        m => m.LoaiSanPhamId,
                                        Model.Categories,
                                        "-- Chọn loại sản phẩm --",
                                        new { @class = "form-control admin-product-input", autocomplete = "off" })
                                    @Html.ValidationMessageFor(m => m.LoaiSanPhamId, "", new { @class = "text-danger admin-product-validation" })
                                </div>

                                <div class="form-group admin-product-form-group">
                                    <label>Trạng thái</label>
                                    <select name="TrangThai" class="form-control admin-product-input" autocomplete="off">
                                        <option value="1" @(Model.TrangThai == 1 ? "selected" : "")>Đang bán</option>
                                        <option value="2" @(Model.TrangThai == 2 ? "selected" : "")>Ngừng bán</option>
                                    </select>
                                </div>

                                <div class="form-group admin-product-form-group">
                                    <label>Sản phẩm nổi bật</label>
                                    <select name="IsFeatured" class="form-control admin-product-input" autocomplete="off">
                                        <option value="false" @(!Model.IsFeatured ? "selected" : "")>Không</option>
                                        <option value="true" @(Model.IsFeatured ? "selected" : "")>Có</option>
                                    </select>
                                </div>

                                <div class="admin-product-publish-note">
                                    <i class="fas fa-store"></i>
                                    <div>
                                        <strong>Sản phẩm mới</strong>
                                        <span>Sản phẩm sau khi tạo sẽ thuộc danh sách sản phẩm do bạn quản lý.</span>
                                    </div>
                                </div>

                                <div class="admin-product-form-actions">
                                    <button type="submit" class="btn admin-product-btn admin-product-btn-save">
                                        <i class="fas fa-plus mr-1"></i>
                                        Thêm sản phẩm
                                    </button>

                                    <a href="@Url.Action("ProductsList", "ListProduct")"
                                       class="btn admin-product-btn admin-product-btn-light">
                                        Quay lại
                                    </a>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        }
    </div>
</section>

<script src="https://cdn.tiny.cloud/1/mjx5bcjxjzsekqcvy1ai2z4fspdr4j94doloncihjvicobhw/tinymce/6/tinymce.min.js" referrerpolicy="origin"></script>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        if (typeof tinymce !== 'undefined') {
            tinymce.init({
                selector: 'textarea.tinymce-editor',
                plugins: 'anchor autolink charmap codesample emoticons image link lists media searchreplace table visualblocks wordcount code',
                toolbar: 'undo redo | blocks fontfamily fontsize | bold italic underline strikethrough | alignleft aligncenter alignright alignjustify | link image media table | numlist bullist indent outdent | emoticons charmap | code | removeformat',
                height: 420,
                menubar: false,
                branding: false
            });
        }

        var form = document.querySelector('.admin-product-create-form');

        if (form) {
            form.addEventListener('submit', function () {
                if (typeof tinymce !== 'undefined') {
                    tinymce.triggerSave();
                }

                var inputs = form.querySelectorAll('.currency-input');
                inputs.forEach(function (input) {
                    input.value = input.value.replace(/[^\d]/g, '');
                });
            });
        }

        var inputFile = document.getElementById('inputSingleFile');

        if (inputFile) {
            inputFile.addEventListener('change', function () {
                var file = this.files[0];
                var label = this.parentElement.querySelector('.custom-file-label');

                if (label) {
                    label.textContent = file ? file.name : 'Chọn ảnh';
                }

                if (file) {
                    var reader = new FileReader();

                    reader.onload = function (e) {
                        document.getElementById('imagePreviewSingle').innerHTML =
                            '<img src="' + e.target.result + '" alt="Ảnh đại diện sản phẩm" />';
                    };

                    reader.readAsDataURL(file);
                }
            });
        }

        function formatVndValue(value) {
            var numeric = value.replace(/[^\d]/g, '');
            if (!numeric) return '';
            var number = parseInt(numeric, 10);
            if (isNaN(number)) return '';
            return number.toLocaleString('vi-VN');
        }

        var currencyInputs = document.querySelectorAll('.currency-input');

        currencyInputs.forEach(function (input) {
            input.addEventListener('focus', function () {
                this.value = this.value.replace(/[^\d]/g, '');
            });

            input.addEventListener('blur', function () {
                this.value = formatVndValue(this.value);
            });

            if (input.value) {
                input.value = formatVndValue(input.value);
            }
        });
    });
</script>