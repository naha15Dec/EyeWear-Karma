@model MatKinh.ViewModel.AdminProductCreateVm

@{
    ViewBag.Title = "Thêm sản phẩm";
}

<div class="admin-page-header">
    <div>
        <h1 class="admin-page-title">Thêm sản phẩm</h1>
        <p class="admin-page-subtitle">Tạo sản phẩm mới cho hệ thống.</p>
    </div>

    <ol class="breadcrumb admin-breadcrumb">
        <li class="breadcrumb-item">
            <a href='@Url.Action("Index","Dashboard")'>Dashboard</a>
        </li>
        <li class="breadcrumb-item active">Thêm sản phẩm</li>
    </ol>
</div>

<section class="content">
    <div class="container-fluid p-0">

        @using (Html.BeginForm("AddProduct", "ListProduct", FormMethod.Post, new { enctype = "multipart/form-data" }))
        {
            @Html.AntiForgeryToken()

            <div class="row">

                <div class="col-lg-8">
                    <div class="card admin-form-card mb-4">
                        <div class="card-header border-0">
                            <h3 class="card-title">Thông tin sản phẩm</h3>
                        </div>

                        <div class="card-body">
                            @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                            <div class="form-group">
                                <label>Tên sản phẩm</label>
                                @Html.TextBoxFor(m => m.TenSanPham, new { @class = "form-control admin-input" })
                                @Html.ValidationMessageFor(m => m.TenSanPham, "", new { @class = "text-danger" })
                            </div>

                            <div class="form-group">
                                <label>Mô tả tóm tắt</label>
                                @Html.TextAreaFor(m => m.MoTaNgan, new { @class = "form-control admin-input", rows = 3 })
                                @Html.ValidationMessageFor(m => m.MoTaNgan, "", new { @class = "text-danger" })
                            </div>

                            <div class="form-group">
                                <label>Chi tiết sản phẩm</label>
                                @Html.TextAreaFor(m => m.MoTaChiTiet, new { @class = "admin-textarea", id = "moTaChiTiet" })
                                @Html.ValidationMessageFor(m => m.MoTaChiTiet, "", new { @class = "text-danger" })
                            </div>

                            <div class="row">
                                <div class="col-md-4">
                                    <label>Giá gốc</label>
                                    @Html.TextBoxFor(m => m.GiaGoc, new { @class = "form-control admin-input currency-input text-right", autocomplete = "off" })
                                    @Html.ValidationMessageFor(m => m.GiaGoc, "", new { @class = "text-danger" })
                                </div>

                                <div class="col-md-4">
                                    <label>Giá bán</label>
                                    @Html.TextBoxFor(m => m.GiaBan, new { @class = "form-control admin-input currency-input text-right", autocomplete = "off" })
                                    @Html.ValidationMessageFor(m => m.GiaBan, "", new { @class = "text-danger" })
                                </div>

                                <div class="col-md-4">
                                    <label>Số lượng tồn</label>
                                    @Html.TextBoxFor(m => m.SoLuongTon, new { @class = "form-control admin-input text-right", type = "number", min = "0" })
                                    @Html.ValidationMessageFor(m => m.SoLuongTon, "", new { @class = "text-danger" })
                                </div>
                            </div>

                            <div class="row mt-3">
                                <div class="col-md-4">
                                    <label>Thương hiệu</label>
                                    @Html.DropDownListFor(
                                        m => m.ThuongHieuId,
                                        Model.Brands,
                                        "-- Chọn --",
                                        new { @class = "form-control admin-input" })
                                    @Html.ValidationMessageFor(m => m.ThuongHieuId, "", new { @class = "text-danger" })
                                </div>

                                <div class="col-md-4">
                                    <label>Loại sản phẩm</label>
                                    @Html.DropDownListFor(
                                        m => m.LoaiSanPhamId,
                                        Model.Categories,
                                        "-- Chọn --",
                                        new { @class = "form-control admin-input" })
                                    @Html.ValidationMessageFor(m => m.LoaiSanPhamId, "", new { @class = "text-danger" })
                                </div>

                                <div class="col-md-4">
                                    <label>Trạng thái</label>
                                    <select name="TrangThai" class="form-control admin-input">
                                        <option value="1" @(Model.TrangThai == 1 ? "selected" : "")>Đang bán</option>
                                        <option value="2" @(Model.TrangThai == 2 ? "selected" : "")>Ngừng bán</option>
                                    </select>
                                </div>
                            </div>

                            <div class="row mt-3">
                                <div class="col-md-4">
                                    <label>Sản phẩm nổi bật</label>
                                    <select name="IsFeatured" class="form-control admin-input">
                                        <option value="false" @(!Model.IsFeatured ? "selected" : "")>Không</option>
                                        <option value="true" @(Model.IsFeatured ? "selected" : "")>Có</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-lg-4">
                    <div class="card admin-form-card mb-4">
                        <div class="card-header border-0">
                            <h3 class="card-title">Ảnh đại diện</h3>
                        </div>

                        <div class="card-body">
                            <div id="imagePreviewSingle" class="admin-image-preview-single">
                                <span class="admin-image-placeholder">Xem trước ảnh đại diện</span>
                            </div>

                            <input type="file"
                                   class="form-control mt-3"
                                   id="inputSingleFile"
                                   name="imageAvatar"
                                   accept=".jpg,.jpeg,.png,.gif,.webp">
                        </div>
                    </div>
                </div>

            </div>

            <div class="text-center mt-3">
                <button type="submit" class="btn admin-btn admin-btn-save px-4">
                    <i class="fas fa-plus mr-1"></i> Thêm sản phẩm
                </button>
            </div>
        }
    </div>
</section>

<script src="https://cdn.tiny.cloud/1/mjx5bcjxjzsekqcvy1ai2z4fspdr4j94doloncihjvicobhw/tinymce/6/tinymce.min.js" referrerpolicy="origin"></script>

<script>
    tinymce.init({
        selector: '.admin-textarea',
        plugins: 'anchor autolink charmap codesample emoticons image link lists media searchreplace table visualblocks wordcount',
        toolbar: 'undo redo | blocks fontfamily fontsize | bold italic underline strikethrough | link image media table | align lineheight | numlist bullist indent outdent | emoticons charmap | removeformat',
        height: 380
    });

    document.getElementById('inputSingleFile').addEventListener('change', function () {
        var file = this.files[0];
        if (file) {
            var reader = new FileReader();
            reader.onload = function (e) {
                document.getElementById('imagePreviewSingle').innerHTML =
                    '<img src="' + e.target.result + '" alt="Ảnh đại diện" />';
            };
            reader.readAsDataURL(file);
        }
    });

    function formatVndValue(value) {
        var numeric = value.replace(/[^\d]/g, "");
        if (!numeric) return "";
        var number = parseInt(numeric, 10);
        if (isNaN(number)) return "";
        return number.toLocaleString("vi-VN");
    }

    (function () {
        var currencyInputs = document.querySelectorAll(".currency-input");

        currencyInputs.forEach(function (input) {
            input.addEventListener("focus", function () {
                var numeric = this.value.replace(/[^\d]/g, "");
                this.value = numeric;
            });

            input.addEventListener("blur", function () {
                this.value = formatVndValue(this.value);
            });

            if (input.value) {
                input.value = formatVndValue(input.value);
            }
        });

        var forms = document.querySelectorAll("form");
        forms.forEach(function (form) {
            form.addEventListener("submit", function () {
                var inputs = form.querySelectorAll(".currency-input");
                inputs.forEach(function (input) {
                    input.value = input.value.replace(/[^\d]/g, "");
                });
            });
        });
    })();
</script>