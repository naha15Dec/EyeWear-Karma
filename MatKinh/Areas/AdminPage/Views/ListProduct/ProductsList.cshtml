@model MatKinh.ViewModel.AdminProductListPageVm
@using MatKinh.Models

@{
    ViewBag.Title = "Sản phẩm của tôi";

    int currentPage = Model.CurrentPage <= 0 ? 1 : Model.CurrentPage;
    int totalPages = Model.TotalPages <= 0 ? 1 : Model.TotalPages;
    int startPage = Math.Max(1, currentPage - 2);
    int endPage = Math.Min(totalPages, currentPage + 2);
}

<div class="admin-page-header">
    <div>
        <h1 class="admin-page-title">Sản phẩm của tôi</h1>
        <p class="admin-page-subtitle">Quản lý các sản phẩm do bạn tạo trong hệ thống.</p>
    </div>

    <ol class="breadcrumb admin-breadcrumb">
        <li class="breadcrumb-item">
            <a href='@Url.Action("Index","Dashboard")'>Dashboard</a>
        </li>
        <li class="breadcrumb-item active">Sản phẩm của tôi</li>
    </ol>
</div>

<section class="content">
    <div class="container-fluid p-0">

        <div class="card admin-card my-product-card">
            <div class="card-header admin-card-header border-0 my-product-header">
                <div class="admin-card-title-wrap">
                    <h3 class="admin-card-title">Danh sách sản phẩm của tôi</h3>
                    <span class="admin-card-count">
                        Hiển thị @(Model.Products != null ? Model.Products.Count : 0) / @Model.TotalItems sản phẩm
                    </span>
                </div>

                <div class="my-product-header-actions">
                    @using (Html.BeginForm("ProductsList", "ListProduct", FormMethod.Get, new { @class = "my-product-search-form" }))
                    {
                        <input type="hidden" name="page" value="1" />

                        <div class="my-product-search">
                            <i class="fas fa-search"></i>
                            <input class="form-control"
                                   type="search"
                                   name="keyword"
                                   value="@Model.Keyword"
                                   placeholder="Tìm theo tên hoặc mã sản phẩm..." />
                            <button class="btn my-product-search-btn" type="submit">Tìm</button>
                        </div>
                    }
                </div>
            </div>

            <div class="card-body">
                <div class="my-product-toolbar">
                    <a href="@Url.Action("AddProduct", "ListProduct")" class="btn admin-btn admin-btn-save">
                        <i class="fas fa-plus mr-1"></i> Thêm sản phẩm
                    </a>

                    @if (!string.IsNullOrWhiteSpace(Model.Keyword))
                    {
                        <a href="@Url.Action("ProductsList", "ListProduct")" class="btn admin-btn admin-btn-light">
                            <i class="fas fa-times mr-1"></i> Xóa bộ lọc
                        </a>
                    }
                </div>

                <div class="table-responsive my-product-table-wrap">
                    <table class="table my-product-table align-middle">
                        <thead>
                            <tr>
                                <th>Mã</th>
                                <th>Sản phẩm</th>
                                <th>Ngày tạo / cập nhật</th>
                                <th class="text-right">Giá</th>
                                <th class="text-center">Tồn</th>
                                <th>Trạng thái</th>
                                <th class="text-right">Thao tác</th>
                            </tr>
                        </thead>

                        <tbody>
                            @if (Model.Products != null && Model.Products.Count > 0)
                            {
                                foreach (var item in Model.Products)
                                {
                                    string imageUrl = string.IsNullOrWhiteSpace(item.HinhAnhChinh)
                                        ? "/Asset/img/no-image.png"
                                        : item.HinhAnhChinh;

                                    <tr>
                                        <td>
                                            @if (item.TrangThai == 1)
                                            {
                                                <a target="_blank"
                                                   class="my-product-code"
                                                   href='@Url.Action("DetailProduct", "Product", new { area = "", idProduct = item.MaSanPham })'>
                                                    #@item.MaSanPham
                                                </a>
                                            }
                                            else
                                            {
                                                <span class="my-product-code muted">#@item.MaSanPham</span>
                                            }
                                        </td>

                                        <td>
                                            <div class="my-product-info">
                                                <div class="my-product-thumb">
                                                    <img src="@imageUrl" alt="@item.TenSanPham" />
                                                </div>

                                                <div class="my-product-main">
                                                    <div class="my-product-name">@item.TenSanPham</div>
                                                    <div class="my-product-desc">
                                                        @(string.IsNullOrWhiteSpace(item.MoTaNgan)
                                                            ? "Chưa có mô tả ngắn"
                                                            : (item.MoTaNgan.Length > 90 ? item.MoTaNgan.Substring(0, 90) + "..." : item.MoTaNgan))
                                                    </div>
                                                </div>
                                            </div>
                                        </td>

                                        <td>
                                            <div class="my-product-date">
                                                <strong>@item.CreatedAt.ToString("dd/MM/yyyy HH:mm")</strong>
                                                <span>
                                                    @(item.UpdatedAt.HasValue
                                                        ? "Cập nhật: " + item.UpdatedAt.Value.ToString("dd/MM/yyyy HH:mm")
                                                        : "Chưa cập nhật")
                                                </span>
                                            </div>
                                        </td>

                                        <td class="text-right">
                                            <div class="my-product-price">
                                                <strong>@String.Format(System.Globalization.CultureInfo.GetCultureInfo("vi-VN"), "{0:c0}", item.GiaBan)</strong>
                                                <span>Gốc: @String.Format(System.Globalization.CultureInfo.GetCultureInfo("vi-VN"), "{0:c0}", item.GiaGoc)</span>
                                            </div>
                                        </td>

                                        <td class="text-center">
                                            <span class="my-product-stock">@item.SoLuongTon</span>
                                        </td>

                                        <td>
                                            @if (item.TrangThai == 1)
                                            {
                                                if (item.SoLuongTon > 0)
                                                {
                                                    <span class="my-product-badge success">Đang bán</span>
                                                }
                                                else
                                                {
                                                    <span class="my-product-badge warning">Hết hàng</span>
                                                }
                                            }
                                            else
                                            {
                                                <span class="my-product-badge danger">Ngừng bán</span>
                                            }

                                            @if (item.IsFeatured)
                                            {
                                                <div class="mt-1">
                                                    <span class="my-product-badge featured">Nổi bật</span>
                                                </div>
                                            }
                                        </td>

                                        <td class="text-right">
                                            <div class="my-product-actions">
                                                @using (Html.BeginForm("Update", "ListProduct", FormMethod.Post, new { enctype = "multipart/form-data", @class = "d-inline" }))
                                                {
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@item.SanPhamId" />

                                                    <button type="button"
                                                            class="btn my-product-action edit"
                                                            data-toggle="modal"
                                                            data-target="#customModal@(item.SanPhamId)">
                                                        <i class="fas fa-pen"></i>
                                                        <span>Sửa</span>
                                                    </button>

                                                    <div class="modal fade admin-modal" id="customModal@(item.SanPhamId)" tabindex="-1" role="dialog" aria-hidden="true">
                                                        <div class="modal-dialog modal-dialog-centered modal-xl admin-modal-dialog" role="document">
                                                            <div class="modal-content admin-modal-content">
                                                                <div class="modal-header admin-modal-header">
                                                                    <div>
                                                                        <h5 class="modal-title">Chỉnh sửa sản phẩm</h5>
                                                                        <p class="admin-modal-subtitle mb-0">@item.TenSanPham</p>
                                                                    </div>

                                                                    <button type="button" class="close admin-modal-close" data-dismiss="modal" aria-label="Close">
                                                                        <span aria-hidden="true">&times;</span>
                                                                    </button>
                                                                </div>

                                                                <div class="modal-body admin-modal-body">
                                                                    <div class="row">
                                                                        <div class="col-lg-8">
                                                                            <div class="card admin-form-card">
                                                                                <div class="card-header border-0">
                                                                                    <h3 class="card-title">Thông tin sản phẩm</h3>
                                                                                </div>

                                                                                <div class="card-body">
                                                                                    <div class="form-group">
                                                                                        <label>Tên sản phẩm</label>
                                                                                        <input type="text"
                                                                                               name="TenSanPham"
                                                                                               class="form-control admin-input"
                                                                                               value="@item.TenSanPham" />
                                                                                    </div>

                                                                                    <div class="form-group">
                                                                                        <label>Mô tả tóm tắt</label>
                                                                                        <input type="text"
                                                                                               name="MoTaNgan"
                                                                                               class="form-control admin-input"
                                                                                               value="@item.MoTaNgan" />
                                                                                    </div>

                                                                                    <div class="form-group">
                                                                                        <label>Giới thiệu chi tiết sản phẩm</label>
                                                                                        <textarea class="textarea admin-textarea"
                                                                                                  name="MoTaChiTiet"
                                                                                                  rows="12">@item.MoTaChiTiet</textarea>
                                                                                    </div>

                                                                                    <div class="row">
                                                                                        <div class="col-md-4">
                                                                                            <div class="form-group">
                                                                                                <label>Thương hiệu</label>
                                                                                                <select class="form-control admin-input" name="ThuongHieuId">
                                                                                                    @foreach (var thuonghieu in Model.Brands)
                                                                                                    {
                                                                                                        <option value="@thuonghieu.Value" @(item.ThuongHieuId.ToString() == thuonghieu.Value ? "selected" : "")>
                                                                                                            @thuonghieu.Text
                                                                                                        </option>
                                                                                                    }
                                                                                                </select>
                                                                                            </div>
                                                                                        </div>

                                                                                        <div class="col-md-4">
                                                                                            <div class="form-group">
                                                                                                <label>Loại sản phẩm</label>
                                                                                                <select class="form-control admin-input" name="LoaiSanPhamId">
                                                                                                    @foreach (var loai in Model.Categories)
                                                                                                    {
                                                                                                        <option value="@loai.Value" @(item.LoaiSanPhamId.ToString() == loai.Value ? "selected" : "")>
                                                                                                            @loai.Text
                                                                                                        </option>
                                                                                                    }
                                                                                                </select>
                                                                                            </div>
                                                                                        </div>

                                                                                        <div class="col-md-4">
                                                                                            <div class="form-group">
                                                                                                <label>Trạng thái</label>
                                                                                                <select name="TrangThai" class="form-control admin-input">
                                                                                                    <option value="1" @(item.TrangThai == 1 ? "selected" : "")>Đang bán</option>
                                                                                                    <option value="2" @(item.TrangThai == 2 ? "selected" : "")>Ngừng bán</option>
                                                                                                </select>
                                                                                            </div>
                                                                                        </div>
                                                                                    </div>

                                                                                    <div class="row">
                                                                                        <div class="col-md-3">
                                                                                            <div class="form-group">
                                                                                                <label>Nổi bật</label>
                                                                                                <select name="IsFeatured" class="form-control admin-input">
                                                                                                    <option value="false" @(!item.IsFeatured ? "selected" : "")>Không</option>
                                                                                                    <option value="true" @(item.IsFeatured ? "selected" : "")>Có</option>
                                                                                                </select>
                                                                                            </div>
                                                                                        </div>

                                                                                        <div class="col-md-3">
                                                                                            <div class="form-group">
                                                                                                <label>Tồn kho</label>
                                                                                                <input type="number"
                                                                                                       min="0"
                                                                                                       name="SoLuongTon"
                                                                                                       value="@item.SoLuongTon"
                                                                                                       class="form-control admin-input text-right" />
                                                                                            </div>
                                                                                        </div>

                                                                                        <div class="col-md-3">
                                                                                            <div class="form-group">
                                                                                                <label>Giá gốc (VND)</label>
                                                                                                <div class="input-group">
                                                                                                    <input name="GiaGoc"
                                                                                                           class="form-control admin-input text-right currency-input"
                                                                                                           value="@item.GiaGoc"
                                                                                                           autocomplete="off" />
                                                                                                    <div class="input-group-append">
                                                                                                        <span class="input-group-text admin-input-addon">₫</span>
                                                                                                    </div>
                                                                                                </div>
                                                                                            </div>
                                                                                        </div>

                                                                                        <div class="col-md-3">
                                                                                            <div class="form-group">
                                                                                                <label>Giá bán (VND)</label>
                                                                                                <div class="input-group">
                                                                                                    <input name="GiaBan"
                                                                                                           class="form-control admin-input text-right currency-input"
                                                                                                           value="@item.GiaBan"
                                                                                                           autocomplete="off" />
                                                                                                    <div class="input-group-append">
                                                                                                        <span class="input-group-text admin-input-addon">₫</span>
                                                                                                    </div>
                                                                                                </div>
                                                                                            </div>
                                                                                        </div>
                                                                                    </div>
                                                                                </div>
                                                                            </div>
                                                                        </div>

                                                                        <div class="col-lg-4">
                                                                            <div class="card admin-form-card mb-4">
                                                                                <div class="card-header border-0">
                                                                                    <h3 class="card-title">Ảnh đại diện</h3>
                                                                                </div>

                                                                                <div class="card-body">
                                                                                    <div id="imagePreviewSingle-@item.SanPhamId" class="admin-image-preview-single">
                                                                                        <img src="@imageUrl" alt="@item.TenSanPham" />
                                                                                    </div>

                                                                                    <div class="input-group mt-3">
                                                                                        <div class="custom-file">
                                                                                            <input type="file"
                                                                                                   class="custom-file-input single-image-input"
                                                                                                   id="inputSingleFile-@item.SanPhamId"
                                                                                                   data-productid="@item.SanPhamId"
                                                                                                   name="imageAvatar"
                                                                                                   accept=".jpg,.jpeg,.png,.gif,.webp" />
                                                                                            <label class="custom-file-label" for="inputSingleFile-@item.SanPhamId">Chọn ảnh đại diện</label>
                                                                                        </div>
                                                                                    </div>
                                                                                </div>
                                                                            </div>
                                                                        </div>
                                                                    </div>
                                                                </div>

                                                                <div class="modal-footer admin-modal-footer">
                                                                    <button type="button" class="btn admin-btn admin-btn-light" data-dismiss="modal">
                                                                        Đóng
                                                                    </button>

                                                                    <button type="submit" class="btn admin-btn admin-btn-save">
                                                                        <i class="fas fa-save mr-1"></i> Lưu thay đổi
                                                                    </button>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                }

                                                @using (Html.BeginForm("Delete", "ListProduct", FormMethod.Post, new { @class = "d-inline" }))
                                                {
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@item.SanPhamId" />

                                                    <button class="btn my-product-action delete"
                                                            onclick="return confirm('Chuyển sản phẩm này sang trạng thái ngừng bán?')">
                                                        <i class="fas fa-ban"></i>
                                                        <span>Ngừng bán</span>
                                                    </button>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="7" class="text-center py-4">Không có sản phẩm nào.</td>
                                </tr>
                            }
                        </tbody>

                        <tfoot>
                            <tr>
                                <th>Mã</th>
                                <th>Sản phẩm</th>
                                <th>Ngày tạo / cập nhật</th>
                                <th class="text-right">Giá</th>
                                <th class="text-center">Tồn</th>
                                <th>Trạng thái</th>
                                <th class="text-right">Thao tác</th>
                            </tr>
                        </tfoot>
                    </table>
                </div>

                @if (Model.TotalPages > 1)
                {
                    <div class="admin-product-pagination">
                        <div class="admin-product-pagination__info">
                            Trang @Model.CurrentPage / @Model.TotalPages —
                            hiển thị @Model.Products.Count trên tổng @Model.TotalItems sản phẩm
                        </div>

                        <div class="admin-product-pagination__links">
                            <a class="admin-product-page-link @(Model.HasPreviousPage ? "" : "disabled")"
                               href="@(Model.HasPreviousPage ? Url.Action("ProductsList", new { keyword = Model.Keyword, page = Model.CurrentPage - 1 }) : "javascript:void(0)")">
                                <i class="fas fa-chevron-left"></i>
                            </a>

                            @if (startPage > 1)
                            {
                                <a class="admin-product-page-link"
                                   href="@Url.Action("ProductsList", new { keyword = Model.Keyword, page = 1 })">
                                    1
                                </a>

                                if (startPage > 2)
                                {
                                    <span class="admin-product-page-dots">...</span>
                                }
                            }

                            @for (int i = startPage; i <= endPage; i++)
                            {
                                <a class="admin-product-page-link @(i == Model.CurrentPage ? "active" : "")"
                                   href="@Url.Action("ProductsList", new { keyword = Model.Keyword, page = i })">
                                    @i
                                </a>
                            }

                            @if (endPage < Model.TotalPages)
                            {
                                if (endPage < Model.TotalPages - 1)
                                {
                                    <span class="admin-product-page-dots">...</span>
                                }

                                <a class="admin-product-page-link"
                                   href="@Url.Action("ProductsList", new { keyword = Model.Keyword, page = Model.TotalPages })">
                                    @Model.TotalPages
                                </a>
                            }

                            <a class="admin-product-page-link @(Model.HasNextPage ? "" : "disabled")"
                               href="@(Model.HasNextPage ? Url.Action("ProductsList", new { keyword = Model.Keyword, page = Model.CurrentPage + 1 }) : "javascript:void(0)")">
                                <i class="fas fa-chevron-right"></i>
                            </a>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.tiny.cloud/1/mjx5bcjxjzsekqcvy1ai2z4fspdr4j94doloncihjvicobhw/tinymce/6/tinymce.min.js" referrerpolicy="origin"></script>

<script>
    $(document).ready(function () {
        $(document).on('change', '.single-image-input', function () {
            var productId = $(this).data('productid');
            var input = this;

            if (input.files && input.files[0]) {
                var reader = new FileReader();

                reader.onload = function (e) {
                    $("#imagePreviewSingle-" + productId).html('<img src="' + e.target.result + '" alt="Ảnh đại diện" />');
                };

                reader.readAsDataURL(input.files[0]);
            }
        });
    });

    if (typeof tinymce !== 'undefined') {
        tinymce.init({
            selector: '.admin-textarea',
            plugins: 'anchor autolink charmap codesample emoticons image link lists media searchreplace table visualblocks wordcount',
            toolbar: 'undo redo | blocks fontfamily fontsize | bold italic underline strikethrough | link image media table | align lineheight | numlist bullist indent outdent | emoticons charmap | removeformat',
            height: 380
        });
    }

    function formatVndValue(value) {
        var numeric = value.replace(/[^\d]/g, "");
        if (!numeric) return "";
        var number = parseInt(numeric, 10);
        if (isNaN(number)) return "";
        return number.toLocaleString("vi-VN");
    }

    (function () {
        var currencyInputs = document.querySelectorAll(".currency-input");

        currencyInputs.forEach(function (input) {
            input.addEventListener("focus", function () {
                var numeric = this.value.replace(/[^\d]/g, "");
                this.value = numeric;
            });

            input.addEventListener("blur", function () {
                this.value = formatVndValue(this.value);
            });

            if (input.value) {
                input.value = formatVndValue(input.value);
            }
        });

        var forms = document.querySelectorAll("form");

        forms.forEach(function (form) {
            form.addEventListener("submit", function () {
                var inputs = form.querySelectorAll(".currency-input");

                inputs.forEach(function (input) {
                    input.value = input.value.replace(/[^\d]/g, "");
                });
            });
        });
    })();
</script>