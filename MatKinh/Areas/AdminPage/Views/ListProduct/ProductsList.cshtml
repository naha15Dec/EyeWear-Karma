@model MatKinh.ViewModel.AdminProductListPageVm
@using MatKinh.Models

@{
    ViewBag.Title = "Sản phẩm của tôi";

    int currentPage = Model.CurrentPage <= 0 ? 1 : Model.CurrentPage;
    int totalPages = Model.TotalPages <= 0 ? 1 : Model.TotalPages;
    int startPage = Math.Max(1, currentPage - 2);
    int endPage = Math.Min(totalPages, currentPage + 2);
}

<div class="admin-page-header">
    <div>
        <h1 class="admin-page-title">Sản phẩm của tôi</h1>
        <p class="admin-page-subtitle">
            Quản lý các sản phẩm do bạn tạo trong hệ thống. Nhân viên chỉ chỉnh sửa thông tin sản phẩm, không đổi trạng thái bán.
        </p>
    </div>

    <ol class="breadcrumb admin-breadcrumb">
        <li class="breadcrumb-item">
            <a href='@Url.Action("Index","Dashboard")'>Dashboard</a>
        </li>
        <li class="breadcrumb-item active">Sản phẩm của tôi</li>
    </ol>
</div>

<section class="content admin-product-list-page">
    <div class="container-fluid p-0">

        <div class="card admin-product-list-card">
            <div class="card-header border-0">
                <div class="admin-product-list-header">
                    <div class="admin-product-title-wrap">
                        <div class="admin-product-title-icon">
                            <i class="fas fa-glasses"></i>
                        </div>

                        <div>
                            <h3 class="admin-product-list-title">Danh sách sản phẩm của tôi</h3>
                            <p class="admin-product-list-subtitle">
                                Hiển thị <b>@(Model.Products != null ? Model.Products.Count : 0)</b> / <b>@Model.TotalItems</b> sản phẩm.
                            </p>
                        </div>
                    </div>

                    <div class="admin-product-list-actions">
                        @using (Html.BeginForm("ProductsList", "ListProduct", FormMethod.Get, new { @class = "admin-product-search-form", autocomplete = "off" }))
                        {
                            <input type="hidden" name="page" value="1" />

                            <div class="admin-product-search-box">
                                <i class="fas fa-search"></i>
                                <input class="form-control"
                                       type="search"
                                       name="keyword"
                                       value="@Model.Keyword"
                                       placeholder="Tìm theo tên hoặc mã sản phẩm..."
                                       autocomplete="off" />

                                <button class="btn admin-product-search-btn" type="submit">
                                    Tìm
                                </button>
                            </div>
                        }

                        <a href="@Url.Action("AddProduct", "ListProduct")"
                           class="btn admin-product-btn admin-product-btn-save">
                            <i class="fas fa-plus mr-1"></i>
                            Thêm sản phẩm
                        </a>

                        @if (!string.IsNullOrWhiteSpace(Model.Keyword))
                        {
                            <a href="@Url.Action("ProductsList", "ListProduct")"
                               class="btn admin-product-btn admin-product-btn-light">
                                <i class="fas fa-times mr-1"></i>
                                Xóa lọc
                            </a>
                        }
                    </div>
                </div>
            </div>

            <div class="card-body">
                @if (Model.Products != null && Model.Products.Count > 0)
                {
                    <div class="table-responsive admin-product-table-wrap">
                        <table class="table admin-product-table">
                            <thead>
                                <tr>
                                    <th>Mã</th>
                                    <th>Sản phẩm</th>
                                    <th>Phân loại</th>
                                    <th>Ngày tạo / cập nhật</th>
                                    <th class="text-right">Giá</th>
                                    <th class="text-center">Tồn</th>
                                    <th>Trạng thái</th>
                                    <th class="text-right">Thao tác</th>
                                </tr>
                            </thead>

                            <tbody>
                                @foreach (var item in Model.Products)
                                {
                                    string imageUrl = string.IsNullOrWhiteSpace(item.HinhAnhChinh)
                                        ? "/Asset/img/no-image.png"
                                        : item.HinhAnhChinh;

                                    string statusText = "Ngừng bán";
                                    string statusCss = "admin-product-status--inactive";

                                    if (item.TrangThai == 1)
                                    {
                                        if (item.SoLuongTon > 0)
                                        {
                                            statusText = "Đang bán";
                                            statusCss = "admin-product-status--active";
                                        }
                                        else
                                        {
                                            statusText = "Hết hàng";
                                            statusCss = "admin-product-status--out";
                                        }
                                    }

                                    string frameText = string.IsNullOrWhiteSpace(item.TenKieuGong)
                                        ? "Chưa chọn kiểu gọng"
                                        : item.TenKieuGong;

                                    <tr>
                                        <td data-label="Mã">
                                            @if (item.TrangThai == 1)
                                            {
                                                <a target="_blank"
                                                   class="admin-product-code-link"
                                                   href='@Url.Action("DetailProduct", "Product", new { area = "", idProduct = item.MaSanPham })'>
                                                    #@item.MaSanPham
                                                </a>
                                            }
                                            else
                                            {
                                                <span class="admin-product-code-text">#@item.MaSanPham</span>
                                            }
                                        </td>

                                        <td data-label="Sản phẩm">
                                            <div class="admin-product-info">
                                                <div class="admin-product-thumb">
                                                    <img src="@imageUrl" alt="@item.TenSanPham" />
                                                </div>

                                                <div class="admin-product-main">
                                                    <div class="admin-product-name">@item.TenSanPham</div>
                                                    <div class="admin-product-desc">
                                                        @(string.IsNullOrWhiteSpace(item.MoTaNgan)
                                                            ? "Chưa có mô tả ngắn"
                                                            : (item.MoTaNgan.Length > 90 ? item.MoTaNgan.Substring(0, 90) + "..." : item.MoTaNgan))
                                                    </div>
                                                </div>
                                            </div>
                                        </td>

                                        <td data-label="Phân loại">
                                            <div class="admin-product-date">
                                                <i class="fas fa-layer-group"></i>
                                                <span>@item.LoaiSanPhamTen</span>
                                            </div>

                                            <div class="admin-product-date admin-product-date--muted">
                                                <i class="fas fa-copyright"></i>
                                                <span>@item.ThuongHieuTen</span>
                                            </div>

                                            <div class="admin-product-date admin-product-date--muted">
                                                <i class="fas fa-glasses"></i>
                                                <span>@frameText</span>
                                            </div>
                                        </td>

                                        <td data-label="Ngày tạo / cập nhật">
                                            <div class="admin-product-date">
                                                <i class="fas fa-calendar-plus"></i>
                                                <span>Tạo: @item.CreatedAt.ToString("dd/MM/yyyy HH:mm")</span>
                                            </div>

                                            <div class="admin-product-date admin-product-date--muted">
                                                <i class="fas fa-sync-alt"></i>
                                                <span>
                                                    @(item.UpdatedAt.HasValue
                                                        ? "Cập nhật: " + item.UpdatedAt.Value.ToString("dd/MM/yyyy HH:mm")
                                                        : "Chưa cập nhật")
                                                </span>
                                            </div>
                                        </td>

                                        <td data-label="Giá" class="text-right">
                                            <div class="admin-product-price">
                                                <strong>@String.Format(System.Globalization.CultureInfo.GetCultureInfo("vi-VN"), "{0:c0}", item.GiaBan)</strong>
                                                <span>Gốc: @String.Format(System.Globalization.CultureInfo.GetCultureInfo("vi-VN"), "{0:c0}", item.GiaGoc)</span>
                                            </div>
                                        </td>

                                        <td data-label="Tồn" class="text-center">
                                            <span class="admin-product-stock">@item.SoLuongTon</span>
                                        </td>

                                        <td data-label="Trạng thái">
                                            <span class="admin-product-status @statusCss">
                                                <span></span>
                                                @statusText
                                            </span>

                                            @if (item.IsFeatured)
                                            {
                                                <div class="mt-1">
                                                    <span class="admin-product-status admin-product-status--featured">
                                                        <span></span>
                                                        Nổi bật
                                                    </span>
                                                </div>
                                            }
                                        </td>

                                        <td data-label="Thao tác" class="text-right">
                                            <div class="admin-product-action-group">
                                                @using (Html.BeginForm("Update", "ListProduct", FormMethod.Post, new { enctype = "multipart/form-data", @class = "d-inline admin-product-inline-form", autocomplete = "off" }))
                                                {
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@item.SanPhamId" />
                                                    <input type="hidden" name="TrangThai" value="@item.TrangThai" />

                                                    <button type="button"
                                                            class="admin-product-action admin-product-action--edit"
                                                            title="Sửa sản phẩm"
                                                            data-toggle="modal"
                                                            data-target="#customModal@(item.SanPhamId)">
                                                        <i class="fas fa-pen"></i>
                                                        <span>Sửa</span>
                                                    </button>

                                                    <div class="modal fade admin-product-edit-modal" id="customModal@(item.SanPhamId)" tabindex="-1" role="dialog" aria-hidden="true">
                                                        <div class="modal-dialog modal-dialog-centered modal-xl admin-product-edit-dialog" role="document">
                                                            <div class="modal-content admin-product-edit-content">

                                                                <div class="modal-header admin-product-edit-header">
                                                                    <div class="admin-product-edit-heading">
                                                                        <div class="admin-product-edit-icon">
                                                                            <i class="fas fa-edit"></i>
                                                                        </div>

                                                                        <div>
                                                                            <h5 class="modal-title">Chỉnh sửa sản phẩm</h5>
                                                                            <p class="admin-product-edit-subtitle mb-0">@item.TenSanPham</p>
                                                                        </div>
                                                                    </div>

                                                                    <button type="button" class="close admin-product-edit-close" data-dismiss="modal" aria-label="Close">
                                                                        <span aria-hidden="true">&times;</span>
                                                                    </button>
                                                                </div>

                                                                <div class="modal-body admin-product-edit-body">
                                                                    <div class="row">
                                                                        <div class="col-lg-8">
                                                                            <div class="card admin-product-edit-card">
                                                                                <div class="card-header border-0">
                                                                                    <div class="admin-product-edit-card-title">
                                                                                        <i class="fas fa-glasses"></i>
                                                                                        <span>Thông tin sản phẩm</span>
                                                                                    </div>
                                                                                </div>

                                                                                <div class="card-body">
                                                                                    <div class="form-group admin-product-form-group">
                                                                                        <label>Tên sản phẩm</label>
                                                                                        <input type="text"
                                                                                               name="TenSanPham"
                                                                                               class="form-control admin-product-input"
                                                                                               value="@item.TenSanPham"
                                                                                               autocomplete="off" />
                                                                                    </div>

                                                                                    <div class="form-group admin-product-form-group">
                                                                                        <label>Mô tả tóm tắt</label>
                                                                                        <textarea name="MoTaNgan"
                                                                                                  class="form-control admin-product-input admin-product-summary-input"
                                                                                                  rows="3"
                                                                                                  autocomplete="off">@item.MoTaNgan</textarea>
                                                                                    </div>

                                                                                    <div class="form-group admin-product-form-group mb-0">
                                                                                        <label>Giới thiệu chi tiết sản phẩm</label>
                                                                                        <div class="admin-product-editor-wrap">
                                                                                            <textarea class="admin-product-textarea tinymce-editor"
                                                                                                      name="MoTaChiTiet"
                                                                                                      rows="12"
                                                                                                      autocomplete="off">@item.MoTaChiTiet</textarea>
                                                                                        </div>
                                                                                    </div>
                                                                                </div>
                                                                            </div>

                                                                            <div class="card admin-product-edit-card mb-lg-0">
                                                                                <div class="card-header border-0">
                                                                                    <div class="admin-product-edit-card-title">
                                                                                        <i class="fas fa-tags"></i>
                                                                                        <span>Giá, tồn kho và phân loại</span>
                                                                                    </div>
                                                                                </div>

                                                                                <div class="card-body">
                                                                                    <div class="row">
                                                                                        <div class="col-md-4">
                                                                                            <div class="form-group admin-product-form-group">
                                                                                                <label>Thương hiệu</label>
                                                                                                <select class="form-control admin-product-input" name="ThuongHieuId" autocomplete="off">
                                                                                                    @foreach (var thuonghieu in Model.Brands)
                                                                                                    {
                                                                                                        <option value="@thuonghieu.Value" @(item.ThuongHieuId.ToString() == thuonghieu.Value ? "selected" : "")>
                                                                                                            @thuonghieu.Text
                                                                                                        </option>
                                                                                                    }
                                                                                                </select>
                                                                                            </div>
                                                                                        </div>

                                                                                        <div class="col-md-4">
                                                                                            <div class="form-group admin-product-form-group">
                                                                                                <label>Loại sản phẩm</label>
                                                                                                <select class="form-control admin-product-input" name="LoaiSanPhamId" autocomplete="off">
                                                                                                    @foreach (var loai in Model.Categories)
                                                                                                    {
                                                                                                        <option value="@loai.Value" @(item.LoaiSanPhamId.ToString() == loai.Value ? "selected" : "")>
                                                                                                            @loai.Text
                                                                                                        </option>
                                                                                                    }
                                                                                                </select>
                                                                                            </div>
                                                                                        </div>

                                                                                        <div class="col-md-4">
                                                                                            <div class="form-group admin-product-form-group">
                                                                                                <label>Kiểu gọng</label>
                                                                                                <select class="form-control admin-product-input" name="KieuGongId" autocomplete="off">
                                                                                                    <option value="">-- Chọn kiểu gọng --</option>
                                                                                                    @foreach (var frame in Model.FrameTypes)
                                                                                                    {
                                                                                                        <option value="@frame.Value" @(item.KieuGongId.HasValue && item.KieuGongId.Value.ToString() == frame.Value ? "selected" : "")>
                                                                                                            @frame.Text
                                                                                                        </option>
                                                                                                    }
                                                                                                </select>
                                                                                            </div>
                                                                                        </div>
                                                                                    </div>

                                                                                    <div class="row">
                                                                                        <div class="col-md-3">
                                                                                            <div class="form-group admin-product-form-group">
                                                                                                <label>Nổi bật</label>
                                                                                                <select name="IsFeatured" class="form-control admin-product-input" autocomplete="off">
                                                                                                    <option value="false" @(!item.IsFeatured ? "selected" : "")>Không</option>
                                                                                                    <option value="true" @(item.IsFeatured ? "selected" : "")>Có</option>
                                                                                                </select>
                                                                                            </div>
                                                                                        </div>

                                                                                        <div class="col-md-3">
                                                                                            <div class="form-group admin-product-form-group">
                                                                                                <label>Tồn kho</label>
                                                                                                <input type="number"
                                                                                                       min="0"
                                                                                                       name="SoLuongTon"
                                                                                                       value="@item.SoLuongTon"
                                                                                                       class="form-control admin-product-input text-right"
                                                                                                       autocomplete="off" />
                                                                                            </div>
                                                                                        </div>

                                                                                        <div class="col-md-3">
                                                                                            <div class="form-group admin-product-form-group">
                                                                                                <label>Giá gốc</label>
                                                                                                <input name="GiaGoc"
                                                                                                       class="form-control admin-product-input text-right currency-input"
                                                                                                       value="@item.GiaGoc"
                                                                                                       autocomplete="off" />
                                                                                            </div>
                                                                                        </div>

                                                                                        <div class="col-md-3">
                                                                                            <div class="form-group admin-product-form-group">
                                                                                                <label>Giá bán</label>
                                                                                                <input name="GiaBan"
                                                                                                       class="form-control admin-product-input text-right currency-input"
                                                                                                       value="@item.GiaBan"
                                                                                                       autocomplete="off" />
                                                                                            </div>
                                                                                        </div>
                                                                                    </div>

                                                                                    <div class="row">
                                                                                        <div class="col-md-12">
                                                                                            <div class="form-group admin-product-form-group mb-0">
                                                                                                <label>Trạng thái</label>
                                                                                                <input type="text"
                                                                                                       class="form-control admin-product-input"
                                                                                                       value="@statusText"
                                                                                                       disabled="disabled"
                                                                                                       autocomplete="off" />
                                                                                            </div>
                                                                                        </div>
                                                                                    </div>
                                                                                </div>
                                                                            </div>
                                                                        </div>

                                                                        <div class="col-lg-4">
                                                                            <div class="card admin-product-edit-card mb-0">
                                                                                <div class="card-header border-0">
                                                                                    <div class="admin-product-edit-card-title">
                                                                                        <i class="fas fa-image"></i>
                                                                                        <span>Ảnh đại diện</span>
                                                                                    </div>
                                                                                </div>

                                                                                <div class="card-body">
                                                                                    <div id="imagePreviewSingle-@item.SanPhamId" class="admin-product-image-preview">
                                                                                        <img src="@imageUrl" alt="@item.TenSanPham" />
                                                                                    </div>

                                                                                    <div class="admin-product-file-box">
                                                                                        <div class="custom-file">
                                                                                            <input type="file"
                                                                                                   class="custom-file-input admin-product-file-input single-image-input"
                                                                                                   id="inputSingleFile-@item.SanPhamId"
                                                                                                   data-productid="@item.SanPhamId"
                                                                                                   name="imageAvatar"
                                                                                                   accept=".jpg,.jpeg,.png,.gif,.webp" />
                                                                                            <label class="custom-file-label admin-product-file-label" for="inputSingleFile-@item.SanPhamId">
                                                                                                Chọn ảnh đại diện
                                                                                            </label>
                                                                                        </div>
                                                                                    </div>

                                                                                    <div class="admin-product-upload-note">
                                                                                        <i class="fas fa-info-circle"></i>
                                                                                        <span>Nếu không chọn ảnh mới, hệ thống sẽ giữ ảnh đại diện hiện tại.</span>
                                                                                    </div>
                                                                                </div>
                                                                            </div>
                                                                        </div>
                                                                    </div>
                                                                </div>

                                                                <div class="modal-footer admin-product-edit-footer">
                                                                    <button type="button" class="btn admin-product-btn admin-product-btn-light" data-dismiss="modal">
                                                                        Đóng
                                                                    </button>

                                                                    <button type="submit" class="btn admin-product-btn admin-product-btn-save">
                                                                        <i class="fas fa-save mr-1"></i>
                                                                        Lưu thay đổi
                                                                    </button>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>

                            <tfoot>
                                <tr>
                                    <th>Mã</th>
                                    <th>Sản phẩm</th>
                                    <th>Phân loại</th>
                                    <th>Ngày tạo / cập nhật</th>
                                    <th class="text-right">Giá</th>
                                    <th class="text-center">Tồn</th>
                                    <th>Trạng thái</th>
                                    <th class="text-right">Thao tác</th>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                }
                else
                {
                    <div class="admin-product-empty">
                        <div class="admin-product-empty-icon">
                            <i class="fas fa-glasses"></i>
                        </div>

                        <h3>Chưa có sản phẩm nào</h3>

                        @if (!string.IsNullOrWhiteSpace(Model.Keyword))
                        {
                            <p>
                                Không tìm thấy sản phẩm phù hợp với từ khóa <b>@Model.Keyword</b>.
                            </p>
                        }
                        else
                        {
                            <p>
                                Bạn chưa tạo sản phẩm nào. Hãy bắt đầu bằng cách thêm sản phẩm mới cho cửa hàng.
                            </p>
                        }

                        <a href="@Url.Action("AddProduct", "ListProduct")"
                           class="btn admin-product-btn admin-product-btn-save">
                            <i class="fas fa-plus mr-1"></i>
                            Thêm sản phẩm
                        </a>
                    </div>
                }

                @if (Model.TotalPages > 1)
                {
                    <div class="admin-product-pagination">
                        <div class="admin-product-pagination-info">
                            Trang @Model.CurrentPage / @Model.TotalPages —
                            hiển thị @Model.Products.Count trên tổng @Model.TotalItems sản phẩm
                        </div>

                        <div class="admin-product-pagination-links">
                            <a class="admin-product-page-link @(Model.HasPreviousPage ? "" : "disabled")"
                               href="@(Model.HasPreviousPage ? Url.Action("ProductsList", new { keyword = Model.Keyword, page = Model.CurrentPage - 1 }) : "javascript:void(0)")">
                                <i class="fas fa-chevron-left"></i>
                            </a>

                            @if (startPage > 1)
                            {
                                <a class="admin-product-page-link"
                                   href="@Url.Action("ProductsList", new { keyword = Model.Keyword, page = 1 })">
                                    1
                                </a>

                                if (startPage > 2)
                                {
                                    <span class="admin-product-page-dots">...</span>
                                }
                            }

                            @for (int i = startPage; i <= endPage; i++)
                            {
                                <a class="admin-product-page-link @(i == Model.CurrentPage ? "active" : "")"
                                   href="@Url.Action("ProductsList", new { keyword = Model.Keyword, page = i })">
                                    @i
                                </a>
                            }

                            @if (endPage < Model.TotalPages)
                            {
                                if (endPage < Model.TotalPages - 1)
                                {
                                    <span class="admin-product-page-dots">...</span>
                                }

                                <a class="admin-product-page-link"
                                   href="@Url.Action("ProductsList", new { keyword = Model.Keyword, page = Model.TotalPages })">
                                    @Model.TotalPages
                                </a>
                            }

                            <a class="admin-product-page-link @(Model.HasNextPage ? "" : "disabled")"
                               href="@(Model.HasNextPage ? Url.Action("ProductsList", new { keyword = Model.Keyword, page = Model.CurrentPage + 1 }) : "javascript:void(0)")">
                                <i class="fas fa-chevron-right"></i>
                            </a>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

<script src="https://cdn.tiny.cloud/1/mjx5bcjxjzsekqcvy1ai2z4fspdr4j94doloncihjvicobhw/tinymce/6/tinymce.min.js" referrerpolicy="origin"></script>

<script>
    $(document).ready(function () {
        $(document).on('change', '.single-image-input', function () {
            var productId = $(this).data('productid');
            var input = this;
            var file = input.files && input.files[0] ? input.files[0] : null;

            if (file) {
                if (file.size > 3 * 1024 * 1024) {
                    alert('Ảnh đại diện không được vượt quá 3MB.');
                    input.value = '';
                    $(this).next('.custom-file-label').text('Chọn ảnh đại diện');
                    return;
                }

                $(this).next('.custom-file-label').text(file.name);

                var reader = new FileReader();

                reader.onload = function (e) {
                    $('#imagePreviewSingle-' + productId).html(
                        '<img src="' + e.target.result + '" alt="Ảnh đại diện sản phẩm" />'
                    );
                };

                reader.readAsDataURL(file);
            }
        });

        if (typeof tinymce !== 'undefined') {
            tinymce.init({
                selector: 'textarea.tinymce-editor',
                plugins: 'anchor autolink charmap codesample emoticons image link lists media searchreplace table visualblocks wordcount code',
                toolbar: 'undo redo | blocks fontfamily fontsize | bold italic underline strikethrough | alignleft aligncenter alignright alignjustify | link image media table | numlist bullist indent outdent | emoticons charmap | code | removeformat',
                height: 380,
                menubar: false,
                branding: false
            });
        }

        function formatVndValue(value) {
            var numeric = String(value || '').replace(/[^\d]/g, '');

            if (!numeric) {
                return '';
            }

            numeric = numeric.replace(/^0+(?=\d)/, '');

            return numeric.replace(/\B(?=(\d{3})+(?!\d))/g, '.');
        }

        function getCaretDigitPosition(input) {
            var valueBeforeCaret = input.value.slice(0, input.selectionStart);
            return valueBeforeCaret.replace(/[^\d]/g, '').length;
        }

        function setCaretByDigitPosition(input, digitPosition) {
            var count = 0;
            var pos = input.value.length;

            if (digitPosition <= 0) {
                input.setSelectionRange(0, 0);
                return;
            }

            for (var i = 0; i < input.value.length; i++) {
                if (/\d/.test(input.value[i])) {
                    count++;
                }

                if (count >= digitPosition) {
                    pos = i + 1;
                    break;
                }
            }

            input.setSelectionRange(pos, pos);
        }

        $('.currency-input').each(function () {
            if (this.value) {
                this.value = formatVndValue(this.value);
            }

            $(this).attr('inputmode', 'numeric');
        });

        $(document).on('input', '.currency-input', function () {
            var digitPosition = getCaretDigitPosition(this);
            this.value = formatVndValue(this.value);
            setCaretByDigitPosition(this, digitPosition);
        });

        $(document).on('submit', 'form', function () {
            if (typeof tinymce !== 'undefined') {
                tinymce.triggerSave();
            }

            $(this).find('.currency-input').each(function () {
                this.value = this.value.replace(/[^\d]/g, '');
            });
        });
    });
</script>