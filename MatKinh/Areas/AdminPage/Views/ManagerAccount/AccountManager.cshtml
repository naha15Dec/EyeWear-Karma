@model MatKinh.ViewModel.AdminAccountIndexVm
@{
    ViewBag.Title = "Quản lý tài khoản";
}

<div class="admin-page-header">
    <div>
        <h1 class="admin-page-title">Quản lý tài khoản</h1>
        <p class="admin-page-subtitle">Theo dõi tài khoản người dùng, trạng thái và quyền truy cập.</p>
    </div>

    <ol class="breadcrumb admin-breadcrumb">
        <li class="breadcrumb-item">
            <a href='@Url.Action("Index","Dashboard")'>Dashboard</a>
        </li>
        <li class="breadcrumb-item active">Quản lý tài khoản</li>
    </ol>
</div>

<section class="content">
    <div class="container-fluid p-0">
        <div class="card admin-card">
            <div class="card-header admin-card-header border-0">
                <div class="admin-card-title-wrap">
                    <h3 class="admin-card-title">Danh sách tài khoản</h3>
                    <span class="admin-card-count">@Model.Accounts.Count tài khoản</span>
                </div>

                <div class="admin-card-tools">
                    @using (Html.BeginForm("FindAccountByUsername", "ManagerAccount", FormMethod.Get, new { @class = "admin-search-form" }))
                    {
                        <div class="admin-search-box">
                            <i class="fas fa-search"></i>
                            <input class="form-control"
                                   type="search"
                                   name="username"
                                   value="@Model.Keyword"
                                   placeholder="Nhập tên tài khoản..."
                                   aria-label="Search" />
                            <button class="btn admin-search-btn" type="submit">Tìm</button>
                        </div>
                    }
                </div>
            </div>

            <div class="card-body">
                <div class="table-responsive">
                    <table class="table admin-table align-middle">
                        <thead>
                            <tr>
                                <th>Tài khoản</th>
                                <th>Vai trò</th>
                                <th>Trạng thái</th>
                                <th class="text-center">Thao tác</th>
                            </tr>
                        </thead>

                        <tbody>
                            @if (Model.Accounts != null && Model.Accounts.Count > 0)
                            {
                                foreach (var item in Model.Accounts)
                                {
                                    <tr>
                                        <td>
                                            <div class="admin-account-cell">
                                                <div class="admin-account-avatar">
                                                    <i class="fas fa-user"></i>
                                                </div>
                                                <div>
                                                    <div class="admin-account-name">@item.TenDangNhap</div>
                                                    <div class="admin-account-sub">
                                                        @(string.IsNullOrEmpty(item.Email) ? "Chưa có email" : item.Email)
                                                    </div>
                                                </div>
                                            </div>
                                        </td>

                                        <td>
                                            <span class="admin-role-badge">
                                                @item.TenVaiTro
                                            </span>
                                        </td>

                                        <td>
                                            @if (item.IsActive)
                                            {
                                                <span class="admin-status-badge success">Hoạt động</span>
                                            }
                                            else
                                            {
                                                <span class="admin-status-badge out-stock">Đã khóa</span>
                                            }
                                        </td>

                                        <td class="text-center">
                                            <div class="admin-action-group">

                                                <!-- DETAIL -->
                                                <a href="@Url.Action("DetailAccountUser", "ManagerAccount", new { id = item.TaiKhoanId })"
                                                   class="btn admin-btn admin-btn-detail">
                                                    <i class="fas fa-eye mr-1"></i> Chi tiết
                                                </a>

                                                <!-- LOCK / UNLOCK -->
                                                @using (Html.BeginForm("DisableAccount", "ManagerAccount", FormMethod.Post, new { @class = "d-inline" }))
                                                {
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@item.TaiKhoanId" />

                                                    if (item.IsActive)
                                                    {
                                                        <button type="submit" class="btn admin-btn admin-btn-cancel">
                                                            <i class="fas fa-ban mr-1"></i> Vô hiệu
                                                        </button>
                                                    }
                                                    else
                                                    {
                                                        <button type="submit" class="btn admin-btn admin-btn-save">
                                                            <i class="fas fa-unlock mr-1"></i> Mở khóa
                                                        </button>
                                                    }
                                                }

                                                <!-- DELETE (thực tế là disable) -->
                                                @using (Html.BeginForm("DeleteAccount", "ManagerAccount", FormMethod.Post, new { @class = "d-inline" }))
                                                {
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@item.TaiKhoanId" />

                                                    <button type="submit"
                                                            class="btn admin-btn admin-btn-delete"
                                                            onclick="return confirm('Bạn có chắc muốn vô hiệu hóa tài khoản này?')">
                                                        <i class="fas fa-trash-alt mr-1"></i> Xóa
                                                    </button>
                                                }

                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="4" class="text-center py-4">
                                        Không có tài khoản nào.
                                    </td>
                                </tr>
                            }
                        </tbody>

                        <tfoot>
                            <tr>
                                <th>Tài khoản</th>
                                <th>Vai trò</th>
                                <th>Trạng thái</th>
                                <th class="text-center">Thao tác</th>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>
    </div>
</section>