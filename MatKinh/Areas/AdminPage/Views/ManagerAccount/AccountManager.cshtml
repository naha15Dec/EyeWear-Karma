@model MatKinh.ViewModel.AdminAccountIndexVm
@{
    ViewBag.Title = "Quản lý tài khoản";

    int currentPage = Model.CurrentPage <= 0 ? 1 : Model.CurrentPage;
    int totalPages = Model.TotalPages <= 0 ? 1 : Model.TotalPages;
    int startPage = Math.Max(1, currentPage - 2);
    int endPage = Math.Min(totalPages, currentPage + 2);
}

<div class="admin-page-header">
    <div>
        <h1 class="admin-page-title">Quản lý tài khoản</h1>
        <p class="admin-page-subtitle">
            Theo dõi tài khoản người dùng, trạng thái hoạt động và quyền truy cập trong hệ thống.
        </p>
    </div>

    <ol class="breadcrumb admin-breadcrumb">
        <li class="breadcrumb-item">
            <a href='@Url.Action("Index","Dashboard")'>Dashboard</a>
        </li>
        <li class="breadcrumb-item active">Quản lý tài khoản</li>
    </ol>
</div>

<section class="content admin-account-list-page">
    <div class="container-fluid p-0">
        <div class="card admin-account-list-card">
            <div class="card-header border-0">
                <div class="admin-account-list-header">
                    <div class="admin-account-title-wrap">
                        <div class="admin-account-title-icon">
                            <i class="fas fa-users-cog"></i>
                        </div>

                        <div>
                            <h3 class="admin-account-list-title">Danh sách tài khoản</h3>
                            <p class="admin-account-list-subtitle">
                                Hiển thị <b>@Model.Accounts.Count</b> / <b>@Model.TotalItems</b> tài khoản.
                            </p>
                        </div>
                    </div>

                    <div class="admin-account-list-actions">
                        @using (Html.BeginForm("AccountManager", "ManagerAccount", FormMethod.Get, new { @class = "admin-account-filter-form", autocomplete = "off" }))
                        {
                            <input type="hidden" name="page" value="1" />

                            <div class="admin-account-filter">
                                <div class="admin-account-search-box">
                                    <i class="fas fa-search"></i>
                                    <input class="form-control"
                                           type="search"
                                           name="keyword"
                                           value="@Model.Keyword"
                                           placeholder="Tên đăng nhập, họ tên, email, SĐT..."
                                           autocomplete="off" />
                                </div>

                                <select name="role" class="form-control admin-account-role-filter" autocomplete="off">
                                    <option value="">Tất cả vai trò</option>
                                    @foreach (var role in Model.Roles)
                                    {
                                        <option value="@role.Value" @(role.Value == Model.RoleFilter ? "selected" : "")>
                                            @role.Text
                                        </option>
                                    }
                                </select>

                                <button class="btn admin-account-btn admin-account-btn-save" type="submit">
                                    <i class="fas fa-filter mr-1"></i>
                                    Lọc
                                </button>
                            </div>
                        }

                        @if (!string.IsNullOrWhiteSpace(Model.Keyword) || !string.IsNullOrWhiteSpace(Model.RoleFilter))
                        {
                            <a href="@Url.Action("AccountManager", "ManagerAccount")"
                               class="btn admin-account-btn admin-account-btn-light">
                                <i class="fas fa-times mr-1"></i>
                                Xóa lọc
                            </a>
                        }
                    </div>
                </div>
            </div>

            <div class="card-body">
                @if (Model.Accounts != null && Model.Accounts.Count > 0)
                {
                    <div class="admin-account-table-wrap">
                        <table class="table admin-account-table">
                            <thead>
                                <tr>
                                    <th>Tài khoản</th>
                                    <th>Vai trò</th>
                                    <th>Trạng thái</th>
                                    <th>Ngày tạo</th>
                                    <th class="text-center">Thao tác</th>
                                </tr>
                            </thead>

                            <tbody>
                                @foreach (var item in Model.Accounts)
                                {
                                    <tr>
                                        <td data-label="Tài khoản">
                                            <div class="admin-account-cell">
                                                <div class="admin-account-avatar">
                                                    <i class="fas fa-user"></i>
                                                </div>

                                                <div>
                                                    <div class="admin-account-name">@item.TenDangNhap</div>

                                                    <div class="admin-account-sub">
                                                        @(string.IsNullOrWhiteSpace(item.Email) ? "Chưa có email" : item.Email)
                                                    </div>

                                                    <div class="admin-account-sub muted">
                                                        @(string.IsNullOrWhiteSpace(item.SoDienThoai) ? "Chưa có số điện thoại" : item.SoDienThoai)
                                                    </div>
                                                </div>
                                            </div>
                                        </td>

                                        <td data-label="Vai trò">
                                            <span class="admin-account-role-badge">
                                                @item.TenVaiTro
                                            </span>
                                        </td>

                                        <td data-label="Trạng thái">
                                            @if (item.IsActive)
                                            {
                                                <span class="admin-account-status admin-account-status--active">
                                                    <span></span>
                                                    Hoạt động
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="admin-account-status admin-account-status--locked">
                                                    <span></span>
                                                    Đã khóa
                                                </span>
                                            }
                                        </td>

                                        <td data-label="Ngày tạo">
                                            <div class="admin-account-date">
                                                <i class="fas fa-calendar-plus"></i>
                                                <span>@item.CreatedAt.ToString("dd/MM/yyyy HH:mm")</span>
                                            </div>

                                            @if (item.UpdatedAt.HasValue)
                                            {
                                                <div class="admin-account-date muted">
                                                    <i class="fas fa-sync-alt"></i>
                                                    <span>Cập nhật: @item.UpdatedAt.Value.ToString("dd/MM/yyyy HH:mm")</span>
                                                </div>
                                            }
                                        </td>

                                        <td data-label="Thao tác" class="text-center">
                                            <div class="admin-account-actions">

                                                <a href="@Url.Action("DetailAccountUser", "ManagerAccount", new { id = item.TaiKhoanId })"
                                                   class="btn admin-account-action admin-account-action--detail"
                                                   title="Chi tiết tài khoản">
                                                    <i class="fas fa-eye"></i>
                                                    <span>Chi tiết</span>
                                                </a>

                                                @using (Html.BeginForm("DisableAccount", "ManagerAccount", FormMethod.Post, new { @class = "d-inline admin-account-inline-form", autocomplete = "off" }))
                                                {
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@item.TaiKhoanId" />
                                                    <input type="hidden" name="keyword" value="@Model.Keyword" />
                                                    <input type="hidden" name="role" value="@Model.RoleFilter" />
                                                    <input type="hidden" name="page" value="@Model.CurrentPage" />

                                                    if (item.IsActive)
                                                    {
                                                        <button type="submit"
                                                                class="btn admin-account-action admin-account-action--lock"
                                                                title="Khóa tài khoản"
                                                                data-confirm-title="Khóa tài khoản?"
                                                                data-confirm="Tài khoản này sẽ không thể đăng nhập sau khi bị khóa. Bạn chắc chắn muốn tiếp tục?"
                                                                data-confirm-ok="Khóa tài khoản">
                                                            <i class="fas fa-ban"></i>
                                                            <span>Khóa</span>
                                                        </button>
                                                    }
                                                    else
                                                    {
                                                        <button type="submit"
                                                                class="btn admin-account-action admin-account-action--unlock"
                                                                title="Mở khóa tài khoản"
                                                                data-confirm-title="Mở khóa tài khoản?"
                                                                data-confirm="Tài khoản này sẽ được kích hoạt lại và có thể đăng nhập vào hệ thống. Bạn chắc chắn muốn tiếp tục?"
                                                                data-confirm-ok="Mở khóa">
                                                            <i class="fas fa-unlock"></i>
                                                            <span>Mở khóa</span>
                                                        </button>
                                                    }
                                                }

                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>

                            <tfoot>
                                <tr>
                                    <th>Tài khoản</th>
                                    <th>Vai trò</th>
                                    <th>Trạng thái</th>
                                    <th>Ngày tạo</th>
                                    <th class="text-center">Thao tác</th>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                }
                else
                {
                    <div class="admin-account-empty">
                        <div class="admin-account-empty-icon">
                            <i class="fas fa-users"></i>
                        </div>
                        <h3>Không có tài khoản nào</h3>
                        <p>Không tìm thấy tài khoản phù hợp với điều kiện lọc hiện tại.</p>
                    </div>
                }

                @if (Model.TotalPages > 1)
                {
                    <div class="admin-account-pagination">
                        <div class="admin-account-pagination-info">
                            Trang @Model.CurrentPage / @Model.TotalPages —
                            hiển thị @Model.Accounts.Count trên tổng @Model.TotalItems tài khoản
                        </div>

                        <div class="admin-account-pagination-links">
                            <a class="admin-account-page-link @(Model.HasPreviousPage ? "" : "disabled")"
                               href="@(Model.HasPreviousPage ? Url.Action("AccountManager", new { keyword = Model.Keyword, role = Model.RoleFilter, page = Model.CurrentPage - 1 }) : "javascript:void(0)")">
                                <i class="fas fa-chevron-left"></i>
                            </a>

                            @if (startPage > 1)
                            {
                                <a class="admin-account-page-link"
                                   href="@Url.Action("AccountManager", new { keyword = Model.Keyword, role = Model.RoleFilter, page = 1 })">
                                    1
                                </a>

                                if (startPage > 2)
                                {
                                    <span class="admin-account-page-dots">...</span>
                                }
                            }

                            @for (int i = startPage; i <= endPage; i++)
                            {
                                <a class="admin-account-page-link @(i == Model.CurrentPage ? "active" : "")"
                                   href="@Url.Action("AccountManager", new { keyword = Model.Keyword, role = Model.RoleFilter, page = i })">
                                    @i
                                </a>
                            }

                            @if (endPage < Model.TotalPages)
                            {
                                if (endPage < Model.TotalPages - 1)
                                {
                                    <span class="admin-account-page-dots">...</span>
                                }

                                <a class="admin-account-page-link"
                                   href="@Url.Action("AccountManager", new { keyword = Model.Keyword, role = Model.RoleFilter, page = Model.TotalPages })">
                                    @Model.TotalPages
                                </a>
                            }

                            <a class="admin-account-page-link @(Model.HasNextPage ? "" : "disabled")"
                               href="@(Model.HasNextPage ? Url.Action("AccountManager", new { keyword = Model.Keyword, role = Model.RoleFilter, page = Model.CurrentPage + 1 }) : "javascript:void(0)")">
                                <i class="fas fa-chevron-right"></i>
                            </a>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</section>