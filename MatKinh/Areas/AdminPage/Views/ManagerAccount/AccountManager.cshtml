@model MatKinh.ViewModel.AdminAccountIndexVm
@{
    ViewBag.Title = "Quản lý tài khoản";

    int currentPage = Model.CurrentPage <= 0 ? 1 : Model.CurrentPage;
    int totalPages = Model.TotalPages <= 0 ? 1 : Model.TotalPages;
    int startPage = Math.Max(1, currentPage - 2);
    int endPage = Math.Min(totalPages, currentPage + 2);
}

<div class="admin-page-header">
    <div>
        <h1 class="admin-page-title">Quản lý tài khoản</h1>
        <p class="admin-page-subtitle">Theo dõi tài khoản người dùng, trạng thái và quyền truy cập.</p>
    </div>

    <ol class="breadcrumb admin-breadcrumb">
        <li class="breadcrumb-item">
            <a href='@Url.Action("Index","Dashboard")'>Dashboard</a>
        </li>
        <li class="breadcrumb-item active">Quản lý tài khoản</li>
    </ol>
</div>

<section class="content">
    <div class="container-fluid p-0">
        <div class="card admin-card">
            <div class="card-header admin-card-header border-0">
                <div class="admin-card-title-wrap">
                    <h3 class="admin-card-title">Danh sách tài khoản</h3>
                    <span class="admin-card-count">
                        Hiển thị @Model.Accounts.Count / @Model.TotalItems tài khoản
                    </span>
                </div>

                <div class="admin-card-tools">
                    @using (Html.BeginForm("AccountManager", "ManagerAccount", FormMethod.Get, new { @class = "admin-account-filter-form" }))
                    {
                        <input type="hidden" name="page" value="1" />

                        <div class="admin-account-filter">
                            <div class="admin-search-box">
                                <i class="fas fa-search"></i>
                                <input class="form-control"
                                       type="search"
                                       name="keyword"
                                       value="@Model.Keyword"
                                       placeholder="Tên đăng nhập, họ tên, email, SĐT..." />
                            </div>

                            <select name="role" class="form-control admin-input admin-account-role-filter">
                                <option value="">Tất cả vai trò</option>
                                @foreach (var role in Model.Roles)
                                {
                                    <option value="@role.Value" @(role.Value == Model.RoleFilter ? "selected" : "")>
                                        @role.Text
                                    </option>
                                }
                            </select>

                            <button class="btn admin-search-btn" type="submit">
                                Lọc
                            </button>
                        </div>
                    }
                </div>
            </div>

            <div class="card-body">
                @if (!string.IsNullOrWhiteSpace(Model.Keyword) || !string.IsNullOrWhiteSpace(Model.RoleFilter))
                {
                    <div class="mb-3">
                        <a href="@Url.Action("AccountManager", "ManagerAccount")" class="btn admin-btn admin-btn-light">
                            <i class="fas fa-times mr-1"></i> Xóa bộ lọc
                        </a>
                    </div>
                }

                <div class="table-responsive">
                    <table class="table admin-table align-middle">
                        <thead>
                            <tr>
                                <th>Tài khoản</th>
                                <th>Vai trò</th>
                                <th>Trạng thái</th>
                                <th>Ngày tạo</th>
                                <th class="text-center">Thao tác</th>
                            </tr>
                        </thead>

                        <tbody>
                            @if (Model.Accounts != null && Model.Accounts.Count > 0)
                            {
                                foreach (var item in Model.Accounts)
                                {
                                    <tr>
                                        <td>
                                            <div class="admin-account-cell">
                                                <div class="admin-account-avatar">
                                                    <i class="fas fa-user"></i>
                                                </div>
                                                <div>
                                                    <div class="admin-account-name">@item.TenDangNhap</div>
                                                    <div class="admin-account-sub">
                                                        @(string.IsNullOrWhiteSpace(item.Email) ? "Chưa có email" : item.Email)
                                                    </div>
                                                    <div class="admin-order-subtext">
                                                        @(string.IsNullOrWhiteSpace(item.SoDienThoai) ? "Chưa có số điện thoại" : item.SoDienThoai)
                                                    </div>
                                                </div>
                                            </div>
                                        </td>

                                        <td>
                                            <span class="admin-role-badge">
                                                @item.TenVaiTro
                                            </span>
                                        </td>

                                        <td>
                                            @if (item.IsActive)
                                            {
                                                <span class="admin-status-badge success">Hoạt động</span>
                                            }
                                            else
                                            {
                                                <span class="admin-status-badge out-stock">Đã khóa</span>
                                            }
                                        </td>

                                        <td>
                                            <div class="admin-order-subtext">
                                                @item.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                                            </div>

                                            @if (item.UpdatedAt.HasValue)
                                            {
                                                <div class="admin-order-subtext">
                                                    Cập nhật: @item.UpdatedAt.Value.ToString("dd/MM/yyyy HH:mm")
                                                </div>
                                            }
                                        </td>

                                        <td class="text-center">
                                            <div class="admin-action-group">

                                                <a href="@Url.Action("DetailAccountUser", "ManagerAccount", new { id = item.TaiKhoanId })"
                                                   class="btn admin-btn admin-btn-detail">
                                                    <i class="fas fa-eye mr-1"></i> Chi tiết
                                                </a>

                                                @using (Html.BeginForm("DisableAccount", "ManagerAccount", FormMethod.Post, new { @class = "d-inline" }))
                                                {
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@item.TaiKhoanId" />
                                                    <input type="hidden" name="keyword" value="@Model.Keyword" />
                                                    <input type="hidden" name="role" value="@Model.RoleFilter" />
                                                    <input type="hidden" name="page" value="@Model.CurrentPage" />

                                                    if (item.IsActive)
                                                    {
                                                        <button type="submit"
                                                                class="btn admin-btn admin-btn-cancel"
                                                                onclick="return confirm('Bạn có chắc muốn khóa tài khoản này?')">
                                                            <i class="fas fa-ban mr-1"></i> Khóa
                                                        </button>
                                                    }
                                                    else
                                                    {
                                                        <button type="submit"
                                                                class="btn admin-btn admin-btn-save"
                                                                onclick="return confirm('Bạn có chắc muốn mở khóa tài khoản này?')">
                                                            <i class="fas fa-unlock mr-1"></i> Mở khóa
                                                        </button>
                                                    }
                                                }

                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="5" class="text-center py-4">
                                        Không có tài khoản nào.
                                    </td>
                                </tr>
                            }
                        </tbody>

                        <tfoot>
                            <tr>
                                <th>Tài khoản</th>
                                <th>Vai trò</th>
                                <th>Trạng thái</th>
                                <th>Ngày tạo</th>
                                <th class="text-center">Thao tác</th>
                            </tr>
                        </tfoot>
                    </table>
                </div>

                @if (Model.TotalPages > 1)
                {
                    <div class="admin-product-pagination">
                        <div class="admin-product-pagination__info">
                            Trang @Model.CurrentPage / @Model.TotalPages —
                            hiển thị @Model.Accounts.Count trên tổng @Model.TotalItems tài khoản
                        </div>

                        <div class="admin-product-pagination__links">
                            <a class="admin-product-page-link @(Model.HasPreviousPage ? "" : "disabled")"
                               href="@(Model.HasPreviousPage ? Url.Action("AccountManager", new { keyword = Model.Keyword, role = Model.RoleFilter, page = Model.CurrentPage - 1 }) : "javascript:void(0)")">
                                <i class="fas fa-chevron-left"></i>
                            </a>

                            @if (startPage > 1)
                            {
                                <a class="admin-product-page-link"
                                   href="@Url.Action("AccountManager", new { keyword = Model.Keyword, role = Model.RoleFilter, page = 1 })">
                                    1
                                </a>

                                if (startPage > 2)
                                {
                                    <span class="admin-product-page-dots">...</span>
                                }
                            }

                            @for (int i = startPage; i <= endPage; i++)
                            {
                                <a class="admin-product-page-link @(i == Model.CurrentPage ? "active" : "")"
                                   href="@Url.Action("AccountManager", new { keyword = Model.Keyword, role = Model.RoleFilter, page = i })">
                                    @i
                                </a>
                            }

                            @if (endPage < Model.TotalPages)
                            {
                                if (endPage < Model.TotalPages - 1)
                                {
                                    <span class="admin-product-page-dots">...</span>
                                }

                                <a class="admin-product-page-link"
                                   href="@Url.Action("AccountManager", new { keyword = Model.Keyword, role = Model.RoleFilter, page = Model.TotalPages })">
                                    @Model.TotalPages
                                </a>
                            }

                            <a class="admin-product-page-link @(Model.HasNextPage ? "" : "disabled")"
                               href="@(Model.HasNextPage ? Url.Action("AccountManager", new { keyword = Model.Keyword, role = Model.RoleFilter, page = Model.CurrentPage + 1 }) : "javascript:void(0)")">
                                <i class="fas fa-chevron-right"></i>
                            </a>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

<style>
    .admin-account-filter-form {
        width: 100%;
    }

    .admin-account-filter {
        display: flex;
        gap: 10px;
        align-items: center;
    }

    .admin-account-role-filter {
        min-width: 180px;
    }

    @@media (max-width: 767.98px) {
        .admin-account-filter {
            flex-direction: column;
            align-items: stretch;
        }

            .admin-account-role-filter,
            .admin-account-filter .admin-search-btn {
                width: 100%;
            }
    }
</style>