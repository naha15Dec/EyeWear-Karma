@model MatKinh.ViewModel.AdminBlogIndexVm
@using MatKinh.Models

@{
    ViewBag.Title = "Quản lý bài viết";

    int startPage = Math.Max(1, Model.CurrentPage - 2);
    int endPage = Math.Min(Model.TotalPages, Model.CurrentPage + 2);

    Func<int, string> actionText = status =>
    {
        if (status == BlogStatusConstants.DRAFT) return "Duyệt đăng";
        if (status == BlogStatusConstants.PUBLISHED) return "Ẩn bài";
        if (status == BlogStatusConstants.HIDDEN) return "Đăng lại";
        return "Cập nhật";
    };
}

<div class="admin-page-header">
    <div>
        <h1 class="admin-page-title">@Model.HeaderTitle</h1>
        <p class="admin-page-subtitle">Quản lý, kiểm duyệt và ẩn bài viết.</p>
    </div>

    <ol class="breadcrumb admin-breadcrumb">
        <li class="breadcrumb-item">
            <a href='@Url.Action("Index","Dashboard")'>Dashboard</a>
        </li>
        <li class="breadcrumb-item active">@Model.HeaderTitle</li>
    </ol>
</div>

<section class="content">
    <div class="container-fluid p-0">

        <div class="card admin-card">
            <div class="card-header admin-card-header border-0">
                <div class="admin-blog-toolbar">
                    <div class="admin-card-title-wrap">
                        <h3 class="admin-card-title">Danh sách bài viết</h3>
                        <span class="admin-card-count">
                            Hiển thị @Model.Posts.Count / @Model.TotalItems bài viết
                        </span>
                    </div>

                    @using (Html.BeginForm("ManagerBlog", "ManagerBlog", FormMethod.Get, new { @class = "admin-blog-filter-form" }))
                    {
                        <input type="hidden" name="page" value="1" />

                        <select name="status"
                                class="form-control admin-blog-filter-select"
                                onchange="this.form.submit()">
                            @foreach (var option in Model.StatusOptions)
                            {
                                <option value="@option.Value" @(option.Selected ? "selected" : "")>
                                    @option.Text
                                </option>
                            }
                        </select>

                        <div class="admin-blog-search-box">
                            <i class="fas fa-search"></i>
                            <input type="text"
                                   name="keyword"
                                   value="@Model.Keyword"
                                   placeholder="Mã hoặc tiêu đề..."
                                   class="form-control" />
                        </div>

                        <button class="btn admin-blog-btn-filter" type="submit">
                            Lọc
                        </button>
                    }
                </div>
            </div>

            <div class="card-body">
                <div class="table-responsive">
                    <table class="table admin-table align-middle">
                        <thead>
                            <tr>
                                <th>Mã</th>
                                <th>Tiêu đề</th>
                                <th>Người tạo</th>
                                <th>Ngày đăng</th>
                                <th>Trạng thái</th>
                                <th class="text-center">Thao tác</th>
                            </tr>
                        </thead>

                        <tbody>
                            @if (Model.Posts != null && Model.Posts.Count > 0)
                            {
                                foreach (var item in Model.Posts)
                                {
                                    <tr>
                                        <td>
                                            <span class="admin-blog-code">#@item.MaBaiViet</span>
                                        </td>

                                        <td>
                                            <div class="admin-blog-title">@item.TieuDe</div>
                                            <div class="admin-blog-summary">
                                                @(string.IsNullOrWhiteSpace(item.TomTat)
                                                    ? "Không có mô tả"
                                                    : (item.TomTat.Length > 90 ? item.TomTat.Substring(0, 90) + "..." : item.TomTat))
                                            </div>
                                        </td>

                                        <td>
                                            <span class="admin-blog-author">
                                                @(string.IsNullOrWhiteSpace(item.NguoiTao) ? "—" : item.NguoiTao)
                                            </span>
                                        </td>

                                        <td>
                                            <span class="admin-blog-date @(item.NgayDang.HasValue ? "" : "muted")">
                                                @(item.NgayDang.HasValue
                                                    ? item.NgayDang.Value.ToString("dd/MM/yyyy HH:mm")
                                                    : "Chưa đăng")
                                            </span>
                                        </td>

                                        <td>
                                            <span class="admin-blog-status
                                                @(item.TrangThai == BlogStatusConstants.PUBLISHED ? "admin-blog-status--published" :
                                                  item.TrangThai == BlogStatusConstants.DRAFT ? "admin-blog-status--draft" : "admin-blog-status--hidden")">
                                                @item.TrangThaiText
                                            </span>
                                        </td>

                                        <td class="text-center">
                                            <div class="admin-blog-actions">

                                                <button type="button"
                                                        class="btn admin-blog-action admin-blog-action--view"
                                                        data-toggle="modal"
                                                        data-target="#blogModal-@item.BaiVietId"
                                                        title="Xem bài viết">
                                                    <i class="fas fa-eye"></i>
                                                </button>

                                                @using (Html.BeginForm("ActivateBlog", "ManagerBlog", FormMethod.Post, new { @class = "d-inline" }))
                                                {
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@item.BaiVietId" />
                                                    <input type="hidden" name="status" value="@Model.StatusFilter" />
                                                    <input type="hidden" name="keyword" value="@Model.Keyword" />
                                                    <input type="hidden" name="page" value="@Model.CurrentPage" />

                                                    if (item.TrangThai == BlogStatusConstants.DRAFT)
                                                    {
                                                        <button type="submit"
                                                                class="btn admin-blog-action admin-blog-action--publish"
                                                                title="Duyệt đăng bài viết"
                                                                onclick="return confirm('Duyệt đăng bài viết này?')">
                                                            <i class="fas fa-check"></i>
                                                        </button>
                                                    }
                                                    else if (item.TrangThai == BlogStatusConstants.PUBLISHED)
                                                    {
                                                        <button type="submit"
                                                                class="btn admin-blog-action admin-blog-action--hide"
                                                                title="Ẩn bài viết"
                                                                onclick="return confirm('Ẩn bài viết này?')">
                                                            <i class="fas fa-eye-slash"></i>
                                                        </button>
                                                    }
                                                    else if (item.TrangThai == BlogStatusConstants.HIDDEN)
                                                    {
                                                        <button type="submit"
                                                                class="btn admin-blog-action admin-blog-action--republish"
                                                                title="Đăng lại bài viết"
                                                                onclick="return confirm('Đăng lại bài viết này?')">
                                                            <i class="fas fa-redo"></i>
                                                        </button>
                                                    }
                                                }

                                                @if (item.TrangThai == BlogStatusConstants.DRAFT)
                                                {
                                                    using (Html.BeginForm("Delete", "ManagerBlog", FormMethod.Post, new { @class = "d-inline" }))
                                                    {
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="id" value="@item.BaiVietId" />
                                                        <input type="hidden" name="status" value="@Model.StatusFilter" />
                                                        <input type="hidden" name="keyword" value="@Model.Keyword" />
                                                        <input type="hidden" name="page" value="@Model.CurrentPage" />

                                                        <button type="submit"
                                                                class="btn admin-blog-action admin-blog-action--hide"
                                                                title="Ẩn bài chờ duyệt"
                                                                onclick="return confirm('Ẩn bài viết này?')">
                                                            <i class="fas fa-ban"></i>
                                                        </button>
                                                    }
                                                }
                                            </div>

                                            <div class="modal fade admin-modal admin-blog-modal"
                                                 id="blogModal-@item.BaiVietId"
                                                 tabindex="-1"
                                                 role="dialog"
                                                 aria-hidden="true">
                                                <div class="modal-dialog modal-lg modal-dialog-centered" role="document">
                                                    <div class="modal-content admin-modal-content">

                                                        <div class="modal-header">
                                                            <div>
                                                                <h5 class="modal-title">@item.TieuDe</h5>
                                                                <div class="admin-blog-modal-subtitle">
                                                                    #@item.MaBaiViet
                                                                    · @item.TrangThaiText
                                                                    · @(string.IsNullOrWhiteSpace(item.NguoiTao) ? "Không rõ người tạo" : item.NguoiTao)
                                                                </div>
                                                            </div>

                                                            <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                                                                <span aria-hidden="true">&times;</span>
                                                            </button>
                                                        </div>

                                                        <div class="modal-body">
                                                            @if (!string.IsNullOrWhiteSpace(item.AnhDaiDien))
                                                            {
                                                                <img src="@item.AnhDaiDien"
                                                                     class="admin-blog-preview-image"
                                                                     alt="@item.TieuDe" />
                                                            }

                                                            <div class="admin-blog-preview-summary">
                                                                <b>Tóm tắt:</b>
                                                                @(string.IsNullOrWhiteSpace(item.TomTat) ? "Không có mô tả." : item.TomTat)
                                                            </div>

                                                            <hr />

                                                            <div class="admin-blog-preview-content">
                                                                @Html.Raw(item.NoiDung)
                                                            </div>
                                                        </div>

                                                        <div class="modal-footer">
                                                            <button type="button"
                                                                    class="btn admin-btn admin-btn-light"
                                                                    data-dismiss="modal">
                                                                Đóng
                                                            </button>
                                                        </div>

                                                    </div>
                                                </div>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="6" class="text-center py-4">
                                        Không có bài viết phù hợp.
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                @if (Model.TotalPages > 1)
                {
                    <div class="admin-blog-pagination">
                        <div class="admin-blog-pagination__info">
                            Trang @Model.CurrentPage / @Model.TotalPages —
                            hiển thị @Model.Posts.Count trên tổng @Model.TotalItems bài viết
                        </div>

                        <div class="admin-blog-pagination__links">
                            <a class="admin-blog-page-link @(Model.HasPreviousPage ? "" : "disabled")"
                               href="@(Model.HasPreviousPage ? Url.Action("ManagerBlog", new { status = Model.StatusFilter, keyword = Model.Keyword, page = Model.CurrentPage - 1 }) : "javascript:void(0)")">
                                <i class="fas fa-chevron-left"></i>
                            </a>

                            @if (startPage > 1)
                            {
                                <a class="admin-blog-page-link"
                                   href="@Url.Action("ManagerBlog", new { status = Model.StatusFilter, keyword = Model.Keyword, page = 1 })">
                                    1
                                </a>

                                if (startPage > 2)
                                {
                                    <span class="admin-blog-page-dots">...</span>
                                }
                            }

                            @for (int i = startPage; i <= endPage; i++)
                            {
                                <a class="admin-blog-page-link @(i == Model.CurrentPage ? "active" : "")"
                                   href="@Url.Action("ManagerBlog", new { status = Model.StatusFilter, keyword = Model.Keyword, page = i })">
                                    @i
                                </a>
                            }

                            @if (endPage < Model.TotalPages)
                            {
                                if (endPage < Model.TotalPages - 1)
                                {
                                    <span class="admin-blog-page-dots">...</span>
                                }

                                <a class="admin-blog-page-link"
                                   href="@Url.Action("ManagerBlog", new { status = Model.StatusFilter, keyword = Model.Keyword, page = Model.TotalPages })">
                                    @Model.TotalPages
                                </a>
                            }

                            <a class="admin-blog-page-link @(Model.HasNextPage ? "" : "disabled")"
                               href="@(Model.HasNextPage ? Url.Action("ManagerBlog", new { status = Model.StatusFilter, keyword = Model.Keyword, page = Model.CurrentPage + 1 }) : "javascript:void(0)")">
                                <i class="fas fa-chevron-right"></i>
                            </a>
                        </div>
                    </div>
                }
            </div>
        </div>

    </div>
</section>