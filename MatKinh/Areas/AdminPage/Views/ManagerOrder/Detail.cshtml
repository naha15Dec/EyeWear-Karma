@model MatKinh.ViewModel.AdminOrderDetailVm
@using MatKinh.Models

@{
    ViewBag.Title = "Chi tiết đơn hàng";

    var login = Session["LoginInformation"] as TaiKhoan;
    var roleCode = login != null && login.VaiTro != null ? login.VaiTro.MaVaiTro : string.Empty;

    bool isAdmin = string.Equals(roleCode, RoleConstants.ADMIN, StringComparison.OrdinalIgnoreCase);
    bool isStaff = string.Equals(roleCode, RoleConstants.STAFF, StringComparison.OrdinalIgnoreCase);
    bool isShipper = string.Equals(roleCode, RoleConstants.SHIPPER, StringComparison.OrdinalIgnoreCase);

    bool isFinalStatus =
        Model.TrangThai == OrderStatusConstants.DELIVERED ||
        Model.TrangThai == OrderStatusConstants.DELIVERY_FAILED ||
        Model.TrangThai == OrderStatusConstants.CANCELLED;

    bool canAssignShipper =
        (isAdmin || isStaff) &&
        !isFinalStatus &&
        (Model.TrangThai == OrderStatusConstants.PREPARING ||
         Model.TrangThai == OrderStatusConstants.ASSIGNED_TO_SHIPPER);

    bool canUpdateStatus =
        (isAdmin || isStaff || isShipper) &&
        !isFinalStatus;

    bool hasStatusAction = false;

    if (canUpdateStatus)
    {
        if (isAdmin)
        {
            hasStatusAction =
                Model.TrangThai == OrderStatusConstants.PENDING ||
                Model.TrangThai == OrderStatusConstants.CONFIRMED ||
                Model.TrangThai == OrderStatusConstants.PREPARING ||
                Model.TrangThai == OrderStatusConstants.ASSIGNED_TO_SHIPPER ||
                Model.TrangThai == OrderStatusConstants.DELIVERING;
        }
        else if (isStaff)
        {
            hasStatusAction =
                Model.TrangThai == OrderStatusConstants.PENDING ||
                Model.TrangThai == OrderStatusConstants.CONFIRMED;
        }
        else if (isShipper)
        {
            hasStatusAction =
                Model.TrangThai == OrderStatusConstants.ASSIGNED_TO_SHIPPER ||
                Model.TrangThai == OrderStatusConstants.DELIVERING;
        }
    }

    string fallbackImg = Url.Content("~/Asset/img/no-image.png");

    Func<string, string> normalizeImage = path =>
    {
        if (string.IsNullOrWhiteSpace(path))
        {
            return fallbackImg;
        }

        path = path.Trim();

        if (path.StartsWith("http", StringComparison.OrdinalIgnoreCase))
        {
            return path;
        }

        if (path.StartsWith("~/"))
        {
            return Url.Content(path);
        }

        if (path.StartsWith("/"))
        {
            return Url.Content("~" + path);
        }

        return Url.Content("~/" + path);
    };

    Func<string, string> paymentMethodText = method =>
    {
        if (string.Equals(method, PaymentConstants.VNPAY, StringComparison.OrdinalIgnoreCase))
        {
            return "Thanh toán online qua VNPay";
        }

        if (string.Equals(method, PaymentConstants.COD, StringComparison.OrdinalIgnoreCase))
        {
            return "Thanh toán khi nhận hàng";
        }

        return "Không xác định";
    };

    Func<string, string> paymentStatusText = status =>
    {
        if (string.Equals(status, PaymentConstants.PAID, StringComparison.OrdinalIgnoreCase))
        {
            return "Đã thanh toán";
        }

        if (string.Equals(status, PaymentConstants.FAILED, StringComparison.OrdinalIgnoreCase))
        {
            return "Thanh toán thất bại";
        }

        if (string.Equals(status, PaymentConstants.REFUNDED, StringComparison.OrdinalIgnoreCase))
        {
            return "Đã hoàn tiền";
        }

        return "Chờ thanh toán";
    };

    Func<string, string> paymentStatusClass = status =>
    {
        if (string.Equals(status, PaymentConstants.PAID, StringComparison.OrdinalIgnoreCase))
        {
            return "success";
        }

        if (string.Equals(status, PaymentConstants.FAILED, StringComparison.OrdinalIgnoreCase))
        {
            return "danger";
        }

        if (string.Equals(status, PaymentConstants.REFUNDED, StringComparison.OrdinalIgnoreCase))
        {
            return "warning";
        }

        return "processing";
    };

    Func<int, string> orderStatusClass = status =>
    {
        switch (status)
        {
            case OrderStatusConstants.PENDING:
                return "warning";
            case OrderStatusConstants.CONFIRMED:
                return "info";
            case OrderStatusConstants.PREPARING:
                return "processing";
            case OrderStatusConstants.ASSIGNED_TO_SHIPPER:
                return "assigned";
            case OrderStatusConstants.DELIVERING:
                return "shipping";
            case OrderStatusConstants.DELIVERED:
                return "success";
            case OrderStatusConstants.DELIVERY_FAILED:
                return "danger";
            case OrderStatusConstants.CANCELLED:
                return "muted";
            default:
                return "default";
        }
    };
}

<div class="admin-page-header">
    <div>
        <h1 class="admin-page-title">Chi tiết đơn hàng #@Model.MaDonHang</h1>
        <p class="admin-page-subtitle">
            Theo dõi xử lý đơn, giao hàng, thanh toán và lịch sử trạng thái.
        </p>
    </div>

    <ol class="breadcrumb admin-breadcrumb">
        <li class="breadcrumb-item">
            <a href="@Url.Action("Index", "Dashboard")">Dashboard</a>
        </li>
        <li class="breadcrumb-item">
            <a href="@Url.Action("Index", "ManagerOrder")">Quản lý đơn hàng</a>
        </li>
        <li class="breadcrumb-item active">#@Model.MaDonHang</li>
    </ol>
</div>

<section class="content admin-order-detail-page">
    <div class="container-fluid p-0">

        @if (Model.CanRequireManualRefund)
        {
            <div class="admin-order-refund-alert">
                <div class="admin-order-refund-alert-icon">
                    <i class="fas fa-exclamation-triangle"></i>
                </div>

                <div>
                    <strong>Cần xử lý hoàn tiền</strong>
                    <p>
                        Đơn hàng đã thanh toán qua VNPay nhưng hiện ở trạng thái
                        <b>@Model.TrangThaiText</b>. Cửa hàng cần kiểm tra giao dịch và xử lý hoàn tiền
                        trong vòng 3–5 ngày làm việc. Không tự đánh dấu “Đã hoàn tiền” nếu chưa xử lý hoàn tiền thật.
                    </p>
                </div>
            </div>
        }

        <div class="row">
            <div class="col-lg-8">

                <div class="card admin-order-detail-card">
                    <div class="card-header border-0">
                        <div class="admin-order-detail-heading">
                            <div class="admin-order-detail-heading-icon">
                                <i class="fas fa-receipt"></i>
                            </div>

                            <div>
                                <h3 class="admin-order-detail-card-title">Tổng quan đơn hàng</h3>
                                <p class="admin-order-detail-card-subtitle">
                                    Thông tin xử lý chính của đơn hàng.
                                </p>
                            </div>

                            <span class="admin-order-status-badge @orderStatusClass(Model.TrangThai)">
                                @Model.TrangThaiText
                            </span>
                        </div>
                    </div>

                    <div class="card-body">
                        <div class="admin-order-detail-grid">
                            <div class="admin-order-detail-box">
                                <span>Mã đơn hàng</span>
                                <strong>#@Model.MaDonHang</strong>
                            </div>

                            <div class="admin-order-detail-box">
                                <span>Trạng thái hiện tại</span>
                                <strong>
                                    <span class="admin-order-status-badge @orderStatusClass(Model.TrangThai)">
                                        @Model.TrangThaiText
                                    </span>
                                </strong>
                            </div>

                            <div class="admin-order-detail-box">
                                <span>Khách hàng</span>
                                <strong>@(string.IsNullOrWhiteSpace(Model.TenKhachHang) ? "—" : Model.TenKhachHang)</strong>
                            </div>

                            <div class="admin-order-detail-box">
                                <span>Ngày đặt</span>
                                <strong>@Model.NgayDat.ToString("dd/MM/yyyy HH:mm")</strong>
                            </div>

                            <div class="admin-order-detail-box">
                                <span>Người tạo đơn</span>
                                <strong>@(string.IsNullOrWhiteSpace(Model.CreatedByName) ? "—" : Model.CreatedByName)</strong>
                            </div>

                            <div class="admin-order-detail-box">
                                <span>Người xác nhận</span>
                                <strong>@(string.IsNullOrWhiteSpace(Model.ConfirmedByName) ? "—" : Model.ConfirmedByName)</strong>
                            </div>

                            <div class="admin-order-detail-box">
                                <span>Shipper</span>
                                <strong>@(string.IsNullOrWhiteSpace(Model.ShipperName) ? "Chưa gán" : Model.ShipperName)</strong>
                            </div>

                            <div class="admin-order-detail-box">
                                <span>Ghi chú đơn</span>
                                <strong>@(string.IsNullOrWhiteSpace(Model.GhiChu) ? "Không có ghi chú" : Model.GhiChu)</strong>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card admin-order-detail-card">
                    <div class="card-header border-0">
                        <div class="admin-order-detail-heading">
                            <div class="admin-order-detail-heading-icon">
                                <i class="fas fa-map-marker-alt"></i>
                            </div>

                            <div>
                                <h3 class="admin-order-detail-card-title">Thông tin nhận hàng</h3>
                                <p class="admin-order-detail-card-subtitle">
                                    Thông tin người nhận và địa chỉ giao hàng.
                                </p>
                            </div>
                        </div>
                    </div>

                    <div class="card-body">
                        <div class="admin-order-detail-grid">
                            <div class="admin-order-detail-box">
                                <span>Người nhận</span>
                                <strong>@Model.HoTenNguoiNhan</strong>
                            </div>

                            <div class="admin-order-detail-box">
                                <span>Số điện thoại</span>
                                <strong>@Model.SoDienThoaiNguoiNhan</strong>
                            </div>

                            <div class="admin-order-detail-box admin-order-detail-box-full">
                                <span>Địa chỉ nhận hàng</span>
                                <strong>@Model.DiaChiNhanHang</strong>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card admin-order-detail-card">
                    <div class="card-header border-0">
                        <div class="admin-order-detail-heading">
                            <div class="admin-order-detail-heading-icon">
                                <i class="fas fa-glasses"></i>
                            </div>

                            <div>
                                <h3 class="admin-order-detail-card-title">Sản phẩm trong đơn</h3>
                                <p class="admin-order-detail-card-subtitle">
                                    @Model.Items.Count dòng sản phẩm trong đơn hàng.
                                </p>
                            </div>
                        </div>
                    </div>

                    <div class="card-body">
                        @if (Model.Items != null && Model.Items.Count > 0)
                        {
                            <div class="admin-order-items-wrap">
                                <table class="table admin-order-items-table">
                                    <thead>
                                        <tr>
                                            <th>Sản phẩm</th>
                                            <th class="text-right">Đơn giá</th>
                                            <th class="text-center">SL</th>
                                            <th class="text-right">Giảm giá</th>
                                            <th class="text-right">Thành tiền</th>
                                        </tr>
                                    </thead>

                                    <tbody>
                                        @foreach (var item in Model.Items)
                                        {
                                            string imageUrl = normalizeImage(item.HinhAnhChinh);

                                            <tr>
                                                <td data-label="Sản phẩm">
                                                    <div class="admin-order-product-cell">
                                                        <div class="admin-order-product-thumb">
                                                            <img src="@imageUrl"
                                                                 alt="@item.TenSanPhamSnapshot"
                                                                 onerror="this.onerror=null;this.src='@fallbackImg';" />
                                                        </div>

                                                        <div>
                                                            <div class="admin-order-product-name">@item.TenSanPhamSnapshot</div>
                                                            <div class="admin-order-product-sub">
                                                                @(string.IsNullOrWhiteSpace(item.MaSanPham) ? "#" + item.SanPhamId : "#" + item.MaSanPham)
                                                            </div>
                                                        </div>
                                                    </div>
                                                </td>

                                                <td data-label="Đơn giá" class="text-right">@item.DonGiaSnapshot.ToString("N0") đ</td>
                                                <td data-label="SL" class="text-center">@item.SoLuong</td>
                                                <td data-label="Giảm giá" class="text-right">@item.GiamGiaSnapshot.ToString("N0") đ</td>
                                                <td data-label="Thành tiền" class="text-right admin-order-price-strong">@item.ThanhTien.ToString("N0") đ</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <div class="admin-order-empty-mini">
                                Không có sản phẩm trong đơn.
                            </div>
                        }
                    </div>
                </div>

                <div class="card admin-order-detail-card">
                    <div class="card-header border-0">
                        <div class="admin-order-detail-heading">
                            <div class="admin-order-detail-heading-icon">
                                <i class="fas fa-history"></i>
                            </div>

                            <div>
                                <h3 class="admin-order-detail-card-title">Lịch sử trạng thái</h3>
                                <p class="admin-order-detail-card-subtitle">
                                    @Model.Histories.Count lần cập nhật trạng thái.
                                </p>
                            </div>
                        </div>
                    </div>

                    <div class="card-body">
                        @if (Model.Histories != null && Model.Histories.Count > 0)
                        {
                            <div class="admin-order-timeline">
                                @foreach (var item in Model.Histories)
                                {
                                    bool isRefundHistory =
                                        !string.IsNullOrWhiteSpace(item.GhiChu) &&
                                        item.GhiChu.ToLower().Contains("hoàn tiền");

                                    <div class="admin-order-timeline-item @(isRefundHistory ? "refund" : "")">
                                        <div class="admin-order-timeline-dot"></div>

                                        <div class="admin-order-timeline-content">
                                            <div class="admin-order-timeline-title">
                                                @item.TrangThaiCuText → @item.TrangThaiMoiText
                                            </div>

                                            <div class="admin-order-timeline-meta">
                                                @item.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                                                @if (!string.IsNullOrWhiteSpace(item.NguoiCapNhat))
                                                {
                                                    <span>• @item.NguoiCapNhat</span>
                                                }
                                            </div>

                                            @if (!string.IsNullOrWhiteSpace(item.GhiChu))
                                            {
                                                <div class="admin-order-timeline-note">@item.GhiChu</div>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="admin-order-empty-mini">
                                Chưa có lịch sử cập nhật trạng thái.
                            </div>
                        }
                    </div>
                </div>

            </div>

            <div class="col-lg-4">

                <div class="card admin-order-side-card">
                    <div class="card-header border-0">
                        <h3 class="admin-order-side-title">Thanh toán</h3>
                    </div>

                    <div class="card-body">
                        <div class="admin-order-payment-summary">
                            <div class="admin-order-payment-row">
                                <span>Phương thức</span>
                                <strong>@paymentMethodText(Model.PhuongThucThanhToan)</strong>
                            </div>

                            <div class="admin-order-payment-row">
                                <span>Trạng thái</span>
                                <span class="admin-order-status-badge @paymentStatusClass(Model.TrangThaiThanhToan)">
                                    @paymentStatusText(Model.TrangThaiThanhToan)
                                </span>
                            </div>

                            <div class="admin-order-payment-row">
                                <span>Mã giao dịch</span>
                                <strong>@(string.IsNullOrWhiteSpace(Model.MaGiaoDichThanhToan) ? "—" : Model.MaGiaoDichThanhToan)</strong>
                            </div>

                            <div class="admin-order-payment-row">
                                <span>Ngày thanh toán</span>
                                <strong>@(Model.NgayThanhToan.HasValue ? Model.NgayThanhToan.Value.ToString("dd/MM/yyyy HH:mm") : "—")</strong>
                            </div>
                        </div>

                        @if (Model.CanRequireManualRefund)
                        {
                            <div class="admin-order-refund-note">
                                <strong>Cần xử lý hoàn tiền</strong>
                                <p>
                                    VNPay đã thanh toán nhưng đơn đã bị hủy/giao thất bại.
                                    Vui lòng kiểm tra giao dịch và xử lý hoàn tiền trong 3–5 ngày làm việc.
                                </p>
                            </div>
                        }

                        <div class="admin-order-summary-row">
                            <span>Tiền hàng</span>
                            <strong>@Model.TongTienHang.ToString("N0") đ</strong>
                        </div>

                        @if (Model.GiamGia > 0)
                        {
                            <div class="admin-order-summary-row">
                                <span>Giảm giá</span>
                                <strong>-@Model.GiamGia.ToString("N0") đ</strong>
                            </div>
                        }

                        <div class="admin-order-summary-row">
                            <span>Phí vận chuyển</span>
                            <strong>@Model.PhiVanChuyen.ToString("N0") đ</strong>
                        </div>

                        <div class="admin-order-summary-row total">
                            <span>Tổng thanh toán</span>
                            <strong>@Model.TongThanhToan.ToString("N0") đ</strong>
                        </div>
                    </div>
                </div>

                @if (canUpdateStatus)
                {
                    <div class="card admin-order-side-card">
                        <div class="card-header border-0">
                            <h3 class="admin-order-side-title">Cập nhật trạng thái</h3>
                        </div>

                        <div class="card-body">
                            @if (hasStatusAction)
                            {
                                using (Html.BeginForm("UpdateStatus", "ManagerOrder", FormMethod.Post, new { autocomplete = "off" }))
                                {
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="DonHangId" value="@Model.DonHangId" />

                                    <div class="form-group admin-order-form-group">
                                        <label>Trạng thái mới</label>
                                        <select name="TrangThaiMoi" class="form-control admin-order-input" required autocomplete="off">
                                            @if (isAdmin)
                                            {
                                                if (Model.TrangThai == OrderStatusConstants.PENDING)
                                                {
                                                    <option value="@OrderStatusConstants.CONFIRMED">Đã xác nhận</option>
                                                    <option value="@OrderStatusConstants.CANCELLED">Đã hủy</option>
                                                }
                                                else if (Model.TrangThai == OrderStatusConstants.CONFIRMED)
                                                {
                                                    <option value="@OrderStatusConstants.PREPARING">Đang chuẩn bị</option>
                                                    <option value="@OrderStatusConstants.CANCELLED">Đã hủy</option>
                                                }
                                                else if (Model.TrangThai == OrderStatusConstants.PREPARING)
                                                {
                                                    <option value="@OrderStatusConstants.CANCELLED">Đã hủy</option>
                                                }
                                                else if (Model.TrangThai == OrderStatusConstants.ASSIGNED_TO_SHIPPER)
                                                {
                                                    <option value="@OrderStatusConstants.DELIVERING">Đang giao</option>
                                                }
                                                else if (Model.TrangThai == OrderStatusConstants.DELIVERING)
                                                {
                                                    <option value="@OrderStatusConstants.DELIVERED">Giao thành công</option>
                                                    <option value="@OrderStatusConstants.DELIVERY_FAILED">Giao thất bại</option>
                                                }
                                            }
                                            else if (isStaff)
                                            {
                                                if (Model.TrangThai == OrderStatusConstants.PENDING)
                                                {
                                                    <option value="@OrderStatusConstants.CONFIRMED">Đã xác nhận</option>
                                                }
                                                else if (Model.TrangThai == OrderStatusConstants.CONFIRMED)
                                                {
                                                    <option value="@OrderStatusConstants.PREPARING">Đang chuẩn bị</option>
                                                }
                                            }
                                            else if (isShipper)
                                            {
                                                if (Model.TrangThai == OrderStatusConstants.ASSIGNED_TO_SHIPPER)
                                                {
                                                    <option value="@OrderStatusConstants.DELIVERING">Đang giao</option>
                                                }
                                                else if (Model.TrangThai == OrderStatusConstants.DELIVERING)
                                                {
                                                    <option value="@OrderStatusConstants.DELIVERED">Giao thành công</option>
                                                    <option value="@OrderStatusConstants.DELIVERY_FAILED">Giao thất bại</option>
                                                }
                                            }
                                        </select>
                                    </div>

                                    if (string.Equals(Model.PhuongThucThanhToan, PaymentConstants.VNPAY, StringComparison.OrdinalIgnoreCase) &&
                                        string.Equals(Model.TrangThaiThanhToan, PaymentConstants.PAID, StringComparison.OrdinalIgnoreCase))
                                    {
                                        <div class="admin-order-note-box">
                                            <strong>Lưu ý đơn VNPay</strong>
                                            <p>
                                                Nếu chuyển đơn sang <b>Đã hủy</b> hoặc <b>Giao thất bại</b>,
                                                hệ thống sẽ giữ trạng thái thanh toán là <b>Đã thanh toán</b>
                                                và ghi nhận yêu cầu xử lý hoàn tiền trong 3–5 ngày làm việc.
                                            </p>
                                        </div>
                                    }

                                    <div class="form-group admin-order-form-group">
                                        <label>Ghi chú</label>
                                        <textarea name="GhiChu"
                                                  rows="3"
                                                  class="form-control admin-order-input"
                                                  autocomplete="off"
                                                  placeholder="Nhập ghi chú khi cập nhật trạng thái..."></textarea>
                                    </div>

                                    <button type="submit"
                                            class="btn admin-order-btn admin-order-btn-save w-100"
                                            data-confirm-title="Cập nhật trạng thái đơn hàng?"
                                            data-confirm="Trạng thái đơn hàng sẽ được thay đổi theo lựa chọn hiện tại. Vui lòng kiểm tra kỹ trước khi tiếp tục."
                                            data-confirm-ok="Cập nhật">
                                        <i class="fas fa-sync-alt mr-1"></i>
                                        Cập nhật trạng thái
                                    </button>
                                }
                            }
                            else
                            {
                                <div class="admin-order-note-box">
                                    <strong>Không có thao tác trạng thái phù hợp</strong>
                                    <p>
                                        Đơn hàng hiện đang ở trạng thái
                                        <b>@Model.TrangThaiText</b>.
                                        Vui lòng kiểm tra luồng xử lý hoặc sử dụng chức năng phù hợp bên dưới nếu có.
                                    </p>
                                </div>
                            }

                            @if (Model.TrangThai == OrderStatusConstants.PREPARING && (isAdmin || isStaff))
                            {
                                <div class="admin-order-note-box">
                                    <strong>Cần chọn shipper giao hàng</strong>
                                    <p>
                                        Để chuyển đơn sang trạng thái <b>Đã giao shipper</b>,
                                        vui lòng chọn shipper ở khung <b>Chọn shipper giao hàng</b>.
                                    </p>
                                </div>
                            }
                        </div>
                    </div>
                }

                @if (canAssignShipper)
                {
                    <div class="card admin-order-side-card">
                        <div class="card-header border-0">
                            <h3 class="admin-order-side-title">
                                @(Model.TrangThai == OrderStatusConstants.ASSIGNED_TO_SHIPPER ? "Đổi shipper" : "Chọn shipper giao hàng")
                            </h3>
                        </div>

                        <div class="card-body">
                            @using (Html.BeginForm("AssignShipper", "ManagerOrder", FormMethod.Post, new { autocomplete = "off" }))
                            {
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="DonHangId" value="@Model.DonHangId" />

                                <div class="form-group admin-order-form-group">
                                    <label>Shipper phụ trách</label>
                                    <select name="ShipperId" class="form-control admin-order-input" required autocomplete="off">
                                        <option value="">-- Chọn shipper --</option>
                                        @foreach (var shipper in Model.Shippers)
                                        {
                                            <option value="@shipper.Value" @(Model.ShipperId.HasValue && Model.ShipperId.Value.ToString() == shipper.Value ? "selected" : "")>
                                                @shipper.Text
                                            </option>
                                        }
                                    </select>
                                </div>

                                <div class="form-group admin-order-form-group">
                                    <label>Ghi chú</label>
                                    <textarea name="GhiChu"
                                              rows="3"
                                              class="form-control admin-order-input"
                                              autocomplete="off"
                                              placeholder="Ví dụ: Giao ưu tiên trong ngày"></textarea>
                                </div>

                                <button type="submit"
                                        class="btn admin-order-btn admin-order-btn-detail w-100"
                                        data-confirm-title="Gán shipper cho đơn hàng?"
                                        data-confirm="Đơn hàng sẽ được phân công cho shipper đã chọn. Vui lòng kiểm tra kỹ trước khi tiếp tục."
                                        data-confirm-ok="Gán shipper">
                                    <i class="fas fa-truck mr-1"></i>
                                    @(Model.TrangThai == OrderStatusConstants.ASSIGNED_TO_SHIPPER ? "Cập nhật shipper" : "Gán shipper và chuyển trạng thái")
                                </button>
                            }
                        </div>
                    </div>
                }
                else if ((isAdmin || isStaff) && Model.TrangThai == OrderStatusConstants.PREPARING && Model.Shippers.Count == 0)
                {
                    <div class="card admin-order-side-card">
                        <div class="card-header border-0">
                            <h3 class="admin-order-side-title">Chọn shipper giao hàng</h3>
                        </div>

                        <div class="card-body">
                            <div class="admin-order-note-box">
                                <strong>Chưa có shipper khả dụng</strong>
                                <p>
                                    Hiện chưa có tài khoản shipper đang hoạt động.
                                    Vui lòng tạo hoặc kích hoạt tài khoản shipper trước khi giao đơn.
                                </p>
                            </div>
                        </div>
                    </div>
                }

                <div class="card admin-order-side-card">
                    <div class="card-header border-0">
                        <h3 class="admin-order-side-title">Mốc thời gian</h3>
                    </div>

                    <div class="card-body">
                        <div class="admin-order-summary-row">
                            <span>Ngày đặt</span>
                            <strong>@Model.NgayDat.ToString("dd/MM/yyyy HH:mm")</strong>
                        </div>
                        <div class="admin-order-summary-row">
                            <span>Ngày xác nhận</span>
                            <strong>@(Model.NgayXacNhan.HasValue ? Model.NgayXacNhan.Value.ToString("dd/MM/yyyy HH:mm") : "—")</strong>
                        </div>
                        <div class="admin-order-summary-row">
                            <span>Ngày giao</span>
                            <strong>@(Model.NgayGiao.HasValue ? Model.NgayGiao.Value.ToString("dd/MM/yyyy HH:mm") : "—")</strong>
                        </div>
                        <div class="admin-order-summary-row">
                            <span>Ngày hoàn tất</span>
                            <strong>@(Model.NgayHoanTat.HasValue ? Model.NgayHoanTat.Value.ToString("dd/MM/yyyy HH:mm") : "—")</strong>
                        </div>
                        <div class="admin-order-summary-row">
                            <span>Ngày hủy</span>
                            <strong>@(Model.NgayHuy.HasValue ? Model.NgayHuy.Value.ToString("dd/MM/yyyy HH:mm") : "—")</strong>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
</section>