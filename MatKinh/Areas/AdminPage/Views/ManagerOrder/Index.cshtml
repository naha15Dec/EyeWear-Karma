@model MatKinh.ViewModel.AdminOrderIndexVm
@using MatKinh.Models

@{
    ViewBag.Title = "Quản lý đơn hàng";

    int startPage = Math.Max(1, Model.CurrentPage - 2);
    int endPage = Math.Min(Model.TotalPages, Model.CurrentPage + 2);

    Func<string, string> paymentMethodText = method =>
    {
        if (string.Equals(method, PaymentConstants.VNPAY, StringComparison.OrdinalIgnoreCase))
        {
            return "VNPay";
        }

        if (string.Equals(method, PaymentConstants.COD, StringComparison.OrdinalIgnoreCase))
        {
            return "COD";
        }

        return "Không xác định";
    };

    Func<string, string> paymentStatusText = status =>
    {
        if (string.Equals(status, PaymentConstants.PAID, StringComparison.OrdinalIgnoreCase))
        {
            return "Đã thanh toán";
        }

        if (string.Equals(status, PaymentConstants.FAILED, StringComparison.OrdinalIgnoreCase))
        {
            return "Thất bại";
        }

        if (string.Equals(status, PaymentConstants.REFUNDED, StringComparison.OrdinalIgnoreCase))
        {
            return "Đã hoàn tiền";
        }

        return "Chờ thanh toán";
    };

    Func<string, string> paymentStatusClass = status =>
    {
        if (string.Equals(status, PaymentConstants.PAID, StringComparison.OrdinalIgnoreCase))
        {
            return "success";
        }

        if (string.Equals(status, PaymentConstants.FAILED, StringComparison.OrdinalIgnoreCase))
        {
            return "danger";
        }

        if (string.Equals(status, PaymentConstants.REFUNDED, StringComparison.OrdinalIgnoreCase))
        {
            return "warning";
        }

        return "processing";
    };

    Func<int, string> orderStatusClass = status =>
    {
        switch (status)
        {
            case OrderStatusConstants.PENDING:
                return "warning";
            case OrderStatusConstants.CONFIRMED:
                return "info";
            case OrderStatusConstants.PREPARING:
                return "processing";
            case OrderStatusConstants.ASSIGNED_TO_SHIPPER:
                return "assigned";
            case OrderStatusConstants.DELIVERING:
                return "shipping";
            case OrderStatusConstants.DELIVERED:
                return "success";
            case OrderStatusConstants.DELIVERY_FAILED:
                return "danger";
            case OrderStatusConstants.CANCELLED:
                return "muted";
            default:
                return "default";
        }
    };
}

<div class="admin-page-header">
    <div>
        <h1 class="admin-page-title">@Model.HeaderTitle</h1>
        <p class="admin-page-subtitle">
            Theo dõi trạng thái đơn hàng, xử lý vận hành, giao hàng và thanh toán.
        </p>
    </div>

    <ol class="breadcrumb admin-breadcrumb">
        <li class="breadcrumb-item">
            <a href="@Url.Action("Index", "Dashboard")">Dashboard</a>
        </li>
        <li class="breadcrumb-item active">Quản lý đơn hàng</li>
    </ol>
</div>

<section class="content admin-order-list-page">
    <div class="container-fluid p-0">

        <div class="card admin-order-filter-card">
            <div class="card-header border-0">
                <div class="admin-order-card-heading">
                    <div class="admin-order-heading-icon">
                        <i class="fas fa-filter"></i>
                    </div>

                    <div>
                        <h3 class="admin-order-card-title">Bộ lọc đơn hàng</h3>
                        <p class="admin-order-card-subtitle">
                            Có <b>@Model.TotalItems</b> đơn hàng phù hợp với điều kiện hiện tại.
                        </p>
                    </div>
                </div>
            </div>

            <div class="card-body">
                @using (Html.BeginForm("Index", "ManagerOrder", FormMethod.Get, new { @class = "admin-order-filter-form", autocomplete = "off" }))
                {
                    <input type="hidden" name="page" value="1" />

                    <div class="row">
                        <div class="col-lg-5 col-md-6">
                            <div class="form-group admin-order-form-group">
                                <label>Tìm kiếm</label>
                                <div class="admin-order-search-box">
                                    <i class="fas fa-search"></i>
                                    <input type="text"
                                           name="keyword"
                                           value="@Model.Keyword"
                                           class="form-control admin-order-input"
                                           autocomplete="off"
                                           placeholder="Mã đơn / người nhận / số điện thoại" />
                                </div>
                            </div>
                        </div>

                        <div class="col-lg-4 col-md-6">
                            <div class="form-group admin-order-form-group">
                                <label>Trạng thái đơn hàng</label>
                                <select name="status" class="form-control admin-order-input" autocomplete="off">
                                    <option value="">Tất cả trạng thái</option>
                                    @foreach (var item in Model.StatusOptions)
                                    {
                                        <option value="@item.Value" @(item.Selected ? "selected" : "")>
                                            @item.Text
                                        </option>
                                    }
                                </select>
                            </div>
                        </div>

                        <div class="col-lg-3 col-md-12 d-flex align-items-end">
                            <div class="form-group admin-order-form-group w-100">
                                <button type="submit" class="btn admin-order-btn admin-order-btn-save w-100">
                                    <i class="fas fa-search mr-1"></i>
                                    Lọc đơn hàng
                                </button>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="card admin-order-list-card">
            <div class="card-header border-0">
                <div class="admin-order-list-header">
                    <div class="admin-order-card-heading">
                        <div class="admin-order-heading-icon">
                            <i class="fas fa-receipt"></i>
                        </div>

                        <div>
                            <h3 class="admin-order-card-title">Danh sách đơn hàng</h3>
                            <p class="admin-order-card-subtitle">
                                Hiển thị <b>@Model.Orders.Count</b> / <b>@Model.TotalItems</b> đơn.
                            </p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card-body">
                @if (Model.Orders != null && Model.Orders.Count > 0)
                {
                    <div class="admin-order-table-wrap">
                        <table class="table admin-order-table">
                            <thead>
                                <tr>
                                    <th>Mã đơn</th>
                                    <th>Khách / Người nhận</th>
                                    <th>Ngày đặt</th>
                                    <th class="text-right">Thanh toán</th>
                                    <th>Trạng thái</th>
                                    <th>Shipper</th>
                                    <th class="text-center">Thao tác</th>
                                </tr>
                            </thead>

                            <tbody>
                                @foreach (var item in Model.Orders)
                                {
                                    string orderClass = orderStatusClass(item.TrangThai);
                                    string payClass = paymentStatusClass(item.TrangThaiThanhToan);

                                    <tr class="@(item.CanRequireManualRefund ? "admin-order-row-refund" : "")">
                                        <td data-label="Mã đơn">
                                            <div class="admin-order-code">#@item.MaDonHang</div>
                                            <div class="admin-order-subtext">@item.SoLuongSanPham sản phẩm</div>

                                            @if (item.CanRequireManualRefund)
                                            {
                                                <div class="admin-refund-warning-mini">
                                                    Cần hoàn tiền
                                                </div>
                                            }
                                        </td>

                                        <td data-label="Khách / Người nhận">
                                            <div class="admin-order-account-cell">
                                                <div class="admin-order-account-avatar">
                                                    <i class="fas fa-user"></i>
                                                </div>

                                                <div>
                                                    <div class="admin-order-account-name">
                                                        @(string.IsNullOrWhiteSpace(item.HoTenNguoiNhan) ? item.TenKhachHang : item.HoTenNguoiNhan)
                                                    </div>

                                                    <div class="admin-order-account-sub">
                                                        @item.SoDienThoaiNguoiNhan
                                                    </div>

                                                    <div class="admin-order-subtext">
                                                        @item.DiaChiNhanHang
                                                    </div>
                                                </div>
                                            </div>
                                        </td>

                                        <td data-label="Ngày đặt">
                                            <div class="admin-order-date-main">
                                                @item.NgayDat.ToString("dd/MM/yyyy HH:mm")
                                            </div>

                                            @if (item.NgayXacNhan.HasValue)
                                            {
                                                <div class="admin-order-subtext">
                                                    XN: @item.NgayXacNhan.Value.ToString("dd/MM HH:mm")
                                                </div>
                                            }

                                            @if (item.NgayThanhToan.HasValue)
                                            {
                                                <div class="admin-order-subtext">
                                                    TT: @item.NgayThanhToan.Value.ToString("dd/MM HH:mm")
                                                </div>
                                            }
                                        </td>

                                        <td data-label="Thanh toán" class="text-right">
                                            <div class="admin-order-price-strong">
                                                @item.TongThanhToan.ToString("N0") đ
                                            </div>

                                            <div class="admin-order-subtext">
                                                Tiền hàng: @item.TongTienHang.ToString("N0") đ
                                            </div>

                                            @if (item.GiamGia > 0)
                                            {
                                                <div class="admin-order-subtext">
                                                    Giảm: -@item.GiamGia.ToString("N0") đ
                                                </div>
                                            }

                                            <div class="admin-payment-meta">
                                                <span class="admin-payment-method">
                                                    @paymentMethodText(item.PhuongThucThanhToan)
                                                </span>

                                                <span class="admin-order-status-badge admin-payment-badge @payClass">
                                                    @paymentStatusText(item.TrangThaiThanhToan)
                                                </span>
                                            </div>

                                            @if (!string.IsNullOrWhiteSpace(item.MaGiaoDichThanhToan))
                                            {
                                                <div class="admin-order-subtext">
                                                    GD: @item.MaGiaoDichThanhToan
                                                </div>
                                            }

                                            @if (item.CanRequireManualRefund)
                                            {
                                                <div class="admin-refund-warning">
                                                    <i class="fas fa-exclamation-circle mr-1"></i>
                                                    VNPay đã thanh toán, cần xử lý hoàn tiền.
                                                </div>
                                            }
                                        </td>

                                        <td data-label="Trạng thái">
                                            <span class="admin-order-status-badge @orderClass">
                                                @item.TrangThaiText
                                            </span>
                                        </td>

                                        <td data-label="Shipper">
                                            @if (!string.IsNullOrWhiteSpace(item.ShipperName))
                                            {
                                                <span class="admin-order-role-badge">@item.ShipperName</span>
                                            }
                                            else
                                            {
                                                <span class="admin-order-subtext">Chưa gán</span>
                                            }
                                        </td>

                                        <td data-label="Thao tác" class="text-center">
                                            <a href="@Url.Action("Detail", "ManagerOrder", new { id = item.DonHangId })"
                                               class="btn admin-order-btn admin-order-btn-detail">
                                                <i class="fas fa-eye mr-1"></i>
                                                Chi tiết
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>

                            <tfoot>
                                <tr>
                                    <th>Mã đơn</th>
                                    <th>Khách / Người nhận</th>
                                    <th>Ngày đặt</th>
                                    <th class="text-right">Thanh toán</th>
                                    <th>Trạng thái</th>
                                    <th>Shipper</th>
                                    <th class="text-center">Thao tác</th>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                }
                else
                {
                    <div class="admin-order-empty">
                        <div class="admin-order-empty-icon">
                            <i class="fas fa-receipt"></i>
                        </div>
                        <h3>Không có đơn hàng nào</h3>
                        <p>Không tìm thấy đơn hàng phù hợp với điều kiện lọc hiện tại.</p>
                    </div>
                }

                @if (Model.TotalPages > 1)
                {
                    <div class="admin-order-pagination">
                        <div class="admin-order-pagination-info">
                            Trang @Model.CurrentPage / @Model.TotalPages —
                            hiển thị @Model.Orders.Count trên tổng @Model.TotalItems đơn hàng
                        </div>

                        <div class="admin-order-pagination-links">
                            <a class="admin-order-page-link @(Model.HasPreviousPage ? "" : "disabled")"
                               href="@(Model.HasPreviousPage ? Url.Action("Index", new { keyword = Model.Keyword, status = Model.StatusFilter, page = Model.CurrentPage - 1 }) : "javascript:void(0)")">
                                <i class="fas fa-chevron-left"></i>
                            </a>

                            @if (startPage > 1)
                            {
                                <a class="admin-order-page-link"
                                   href="@Url.Action("Index", new { keyword = Model.Keyword, status = Model.StatusFilter, page = 1 })">
                                    1
                                </a>

                                if (startPage > 2)
                                {
                                    <span class="admin-order-page-dots">...</span>
                                }
                            }

                            @for (int i = startPage; i <= endPage; i++)
                            {
                                <a class="admin-order-page-link @(i == Model.CurrentPage ? "active" : "")"
                                   href="@Url.Action("Index", new { keyword = Model.Keyword, status = Model.StatusFilter, page = i })">
                                    @i
                                </a>
                            }

                            @if (endPage < Model.TotalPages)
                            {
                                if (endPage < Model.TotalPages - 1)
                                {
                                    <span class="admin-order-page-dots">...</span>
                                }

                                <a class="admin-order-page-link"
                                   href="@Url.Action("Index", new { keyword = Model.Keyword, status = Model.StatusFilter, page = Model.TotalPages })">
                                    @Model.TotalPages
                                </a>
                            }

                            <a class="admin-order-page-link @(Model.HasNextPage ? "" : "disabled")"
                               href="@(Model.HasNextPage ? Url.Action("Index", new { keyword = Model.Keyword, status = Model.StatusFilter, page = Model.CurrentPage + 1 }) : "javascript:void(0)")">
                                <i class="fas fa-chevron-right"></i>
                            </a>
                        </div>
                    </div>
                }
            </div>
        </div>

    </div>
</section>