@model MatKinh.ViewModel.AdminProductIndexVm

@{
    ViewBag.Title = "Quản lý sản phẩm";
}

<div class="admin-page-header">
    <div>
        <h1 class="admin-page-title">@Model.HeaderTitle</h1>
        <p class="admin-page-subtitle">Quản lý sản phẩm theo trạng thái và tồn kho.</p>
    </div>
</div>

<section class="content">
    <div class="container-fluid p-0">

        ```
        <!-- FILTER + SEARCH -->
        <div class="card admin-card mb-3">
            <div class="card-body d-flex justify-content-between align-items-center">

                <div>
                    <a class="btn @(Model.StatusFilter=="stock"?"btn-primary":"btn-outline-primary")"
                       href="@Url.Action("Index", new { statusProduct="stock"})">
                        Còn hàng
                    </a>

                    <a class="btn @(Model.StatusFilter=="outofstock"?"btn-warning":"btn-outline-warning")"
                       href="@Url.Action("Index", new { statusProduct="outofstock"})">
                        Hết hàng
                    </a>

                    <a class="btn @(Model.StatusFilter=="inactive"?"btn-danger":"btn-outline-danger")"
                       href="@Url.Action("Index", new { statusProduct="inactive"})">
                        Ngừng bán
                    </a>
                </div>

                @using (Html.BeginForm("Index", "ManagerProduct", FormMethod.Get))
                {
                    <input type="hidden" name="statusProduct" value="@Model.StatusFilter" />

                    <div class="d-flex">
                        <input type="text" name="keyword"
                               value="@Model.Keyword"
                               class="form-control"
                               placeholder="Tìm theo mã hoặc tên..." />

                        <button class="btn btn-primary ml-2">Tìm</button>
                    </div>
                }
            </div>
        </div>

        <!-- TABLE -->
        <div class="card admin-card">
            <div class="card-body">

                <table class="table table-bordered table-hover">
                    <thead>
                        <tr>
                            <th>Mã</th>
                            <th>Ảnh</th>
                            <th>Sản phẩm</th>
                            <th>Loại</th>
                            <th>Thương hiệu</th>
                            <th>Giá</th>
                            <th>Tồn</th>
                            <th>Trạng thái</th>
                            <th>Nổi bật</th>
                            <th>Thao tác</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var item in Model.Products)
                        {
                            <tr>
                                <td>#@item.MaSanPham</td>

                                <td>
                                    <img src="@item.HinhAnhChinh"
                                         style="width:60px;height:60px;object-fit:cover" />
                                </td>

                                <td>
                                    <b>@item.TenSanPham</b><br />
                                    <small>@item.MoTaNgan</small>
                                </td>

                                <td>@item.LoaiSanPhamTen</td>
                                <td>@item.ThuongHieuTen</td>

                                <td>
                                    @item.GiaBan.ToString("N0") đ
                                </td>

                                <td>
                                    @item.SoLuongTon
                                </td>

                                <td>
                                    @(item.TrangThai == 1 ? "Đang bán" : "Ngừng bán")
                                </td>

                                <td>
                                    @if (item.IsFeatured)
                                    {
                                        <span class="badge badge-success">Có</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-secondary">Không</span>
                                    }
                                </td>

                                <td>
                                    <!-- FEATURE -->
                                    @using (Html.BeginForm("ToggleFeatured", "ManagerProduct"))
                                    {
                                        @Html.Hidden("id", item.SanPhamId)
                                        <button class="btn btn-sm btn-info">Nổi bật</button>
                                    }

                                    <!-- DELETE -->
                                    @using (Html.BeginForm("Delete", "ManagerProduct"))
                                    {
                                        @Html.Hidden("id", item.SanPhamId)
                                        <button class="btn btn-sm btn-danger"
                                                onclick="return confirm('Ngừng bán sản phẩm này?')">
                                            Ngừng bán
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>

            </div>
        </div>

    </div>
    ```

</section>
