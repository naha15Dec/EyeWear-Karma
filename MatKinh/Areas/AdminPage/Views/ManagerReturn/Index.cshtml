@model MatKinh.ViewModel.AdminReturnIndexVm
@using MatKinh.Models

@{
    ViewBag.Title = "Quản lý trả hàng";

    Func<int, string> statusClass = s =>
    {
        switch (s)
        {
            case ReturnStatusConstants.PENDING: return "warning";
            case ReturnStatusConstants.APPROVED: return "info";
            case ReturnStatusConstants.SHIPPER_PICKING: return "shipping";
            case ReturnStatusConstants.RECEIVED: return "success";
            case ReturnStatusConstants.REJECTED: return "danger";
            default: return "default";
        }
    };

    var login = Session["LoginInformation"] as TaiKhoan;
    var roleCode = login != null && login.VaiTro != null ? login.VaiTro.MaVaiTro : string.Empty;
    bool isShipper = string.Equals(roleCode, RoleConstants.SHIPPER, StringComparison.OrdinalIgnoreCase);
}

<div class="admin-page-header">
    <div>
        <h1 class="admin-page-title">@(isShipper ? "Đơn trả hàng của tôi" : "Quản lý trả hàng")</h1>
        <p class="admin-page-subtitle">Xử lý yêu cầu trả hàng từ khách hàng.</p>
    </div>
    <ol class="breadcrumb admin-breadcrumb">
        <li class="breadcrumb-item"><a href="@Url.Action("Index","Dashboard")">Dashboard</a></li>
        <li class="breadcrumb-item active">Trả hàng</li>
    </ol>
</div>

<section class="content">
    <div class="container-fluid p-0">

        <div class="card admin-order-filter-card">
            <div class="card-body">
                @using (Html.BeginForm("Index", "ManagerReturn", FormMethod.Get, new { autocomplete = "off" }))
                {
                    <input type="hidden" name="page" value="1" />
                    <div class="row">
                        <div class="col-lg-5 col-md-6">
                            <div class="form-group admin-order-form-group">
                                <label>Tìm kiếm</label>
                                <input type="text" name="keyword" value="@Model.Keyword"
                                       class="form-control admin-order-input"
                                       placeholder="Mã yêu cầu / mã đơn / tên khách" />
                            </div>
                        </div>
                        <div class="col-lg-4 col-md-6">
                            <div class="form-group admin-order-form-group">
                                <label>Trạng thái</label>
                                <select name="status" class="form-control admin-order-input">
                                    <option value="">Tất cả</option>
                                    @foreach (var opt in Model.StatusOptions)
                                    {
                                        <option value="@opt.Value" @(opt.Selected ? "selected" : "")>@opt.Text</option>
                                    }
                                </select>
                            </div>
                        </div>
                        <div class="col-lg-3 d-flex align-items-end">
                            <div class="form-group w-100">
                                <button type="submit" class="btn admin-order-btn admin-order-btn-save w-100">
                                    <i class="fas fa-search mr-1"></i> Lọc
                                </button>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="card admin-order-list-card">
            <div class="card-header border-0">
                <h3 class="admin-order-card-title">
                    Danh sách yêu cầu trả hàng
                    <span class="badge badge-secondary ml-2">@Model.TotalItems</span>
                </h3>
            </div>
            <div class="card-body">
                @if (Model.Returns != null && Model.Returns.Count > 0)
                {
                    <div class="admin-order-table-wrap">
                        <table class="table admin-order-table">
                            <thead>
                                <tr>
                                    <th>Mã yêu cầu</th>
                                    <th>Mã đơn hàng</th>
                                    <th>Khách hàng</th>
                                    <th>Lý do</th>
                                    <th>Ngày yêu cầu</th>
                                    <th>Trạng thái</th>
                                    <th>Shipper</th>
                                    <th class="text-center">Thao tác</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.Returns)
                                {
                                    <tr>
                                        <td><strong>@item.MaYeuCau</strong></td>
                                        <td>@item.MaDonHang</td>
                                        <td>@item.TenKhachHang</td>
                                        <td>
                                            <span title="@item.LyDo">
                                                @(item.LyDo.Length > 40 ? item.LyDo.Substring(0, 40) + "..." : item.LyDo)
                                            </span>
                                        </td>
                                        <td>@item.NgayYeuCau.ToString("dd/MM/yyyy HH:mm")</td>
                                        <td>
                                            <span class="admin-order-status-badge @statusClass(item.TrangThai)">
                                                @item.TrangThaiText
                                            </span>
                                        </td>
                                        <td>@(string.IsNullOrWhiteSpace(item.ShipperName) ? "—" : item.ShipperName)</td>
                                        <td class="text-center">
                                            <a href="@Url.Action("Detail","ManagerReturn", new { id = item.YeuCauId })"
                                               class="btn admin-order-btn admin-order-btn-detail">
                                                <i class="fas fa-eye mr-1"></i> Chi tiết
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    @if (Model.TotalPages > 1)
                    {
                        <div class="admin-order-pagination">
                            <div class="admin-order-pagination-links">
                                <a class="admin-order-page-link @(Model.HasPreviousPage ? "" : "disabled")"
                                   href="@(Model.HasPreviousPage ? Url.Action("Index", new { keyword = Model.Keyword, status = Model.StatusFilter, page = Model.CurrentPage - 1 }) : "javascript:void(0)")">
                                    <i class="fas fa-chevron-left"></i>
                                </a>
                                @for (int i = Math.Max(1, Model.CurrentPage - 2); i <= Math.Min(Model.TotalPages, Model.CurrentPage + 2); i++)
                                {
                                    <a class="admin-order-page-link @(i == Model.CurrentPage ? "active" : "")"
                                       href="@Url.Action("Index", new { keyword = Model.Keyword, status = Model.StatusFilter, page = i })">@i</a>
                                }
                                <a class="admin-order-page-link @(Model.HasNextPage ? "" : "disabled")"
                                   href="@(Model.HasNextPage ? Url.Action("Index", new { keyword = Model.Keyword, status = Model.StatusFilter, page = Model.CurrentPage + 1 }) : "javascript:void(0)")">
                                    <i class="fas fa-chevron-right"></i>
                                </a>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="admin-order-empty">
                        <div class="admin-order-empty-icon"><i class="fas fa-undo"></i></div>
                        <h3>Không có yêu cầu trả hàng nào</h3>
                    </div>
                }
            </div>
        </div>

    </div>
</section>
