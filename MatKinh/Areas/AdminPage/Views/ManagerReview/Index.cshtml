@model MatKinh.ViewModel.AdminReviewIndexVm
@using MatKinh.Models

@{
    ViewBag.Title = "Kiểm duyệt đánh giá";

    string fallbackImg = Url.Content("~/Asset/img/no-image.png");

    Func<string, string> normalizeImage = path =>
    {
        if (string.IsNullOrWhiteSpace(path)) return fallbackImg;
        path = path.Trim();
        if (path.StartsWith("http", StringComparison.OrdinalIgnoreCase)) return path;
        if (path.StartsWith("~/")) return Url.Content(path);
        if (path.StartsWith("/")) return Url.Content("~" + path);
        return Url.Content("~/" + path);
    };

    Func<int, string> statusClass = s =>
    {
        switch (s)
        {
            case ReviewStatusConstants.PENDING: return "warning";
            case ReviewStatusConstants.APPROVED: return "success";
            case ReviewStatusConstants.REJECTED: return "danger";
            default: return "default";
        }
    };
}

<div class="admin-page-header">
    <div>
        <h1 class="admin-page-title">Kiểm duyệt đánh giá sản phẩm</h1>
        <p class="admin-page-subtitle">Duyệt hoặc từ chối đánh giá từ khách hàng trước khi hiển thị.</p>
    </div>
    <ol class="breadcrumb admin-breadcrumb">
        <li class="breadcrumb-item"><a href="@Url.Action("Index","Dashboard")">Dashboard</a></li>
        <li class="breadcrumb-item active">Đánh giá sản phẩm</li>
    </ol>
</div>

<section class="content">
    <div class="container-fluid p-0">

        @* Tab trạng thái *@
        <div class="card admin-order-filter-card">
            <div class="card-body">
                <div class="d-flex flex-wrap gap-2 mb-3">
                    <a href="@Url.Action("Index", new { statusFilter = ReviewStatusConstants.PENDING, keyword = Model.Keyword })"
                       class="btn @(Model.StatusFilter == ReviewStatusConstants.PENDING ? "btn-warning" : "btn-outline-warning") btn-sm">
                        Chờ duyệt
                    </a>
                    <a href="@Url.Action("Index", new { statusFilter = ReviewStatusConstants.APPROVED, keyword = Model.Keyword })"
                       class="btn @(Model.StatusFilter == ReviewStatusConstants.APPROVED ? "btn-success" : "btn-outline-success") btn-sm">
                        Đã duyệt
                    </a>
                    <a href="@Url.Action("Index", new { statusFilter = ReviewStatusConstants.REJECTED, keyword = Model.Keyword })"
                       class="btn @(Model.StatusFilter == ReviewStatusConstants.REJECTED ? "btn-danger" : "btn-outline-danger") btn-sm">
                        Từ chối
                    </a>
                </div>

                @using (Html.BeginForm("Index", "ManagerReview", FormMethod.Get, new { autocomplete = "off" }))
                {
                    <input type="hidden" name="statusFilter" value="@Model.StatusFilter" />
                    <input type="hidden" name="page" value="1" />
                    <div class="row">
                        <div class="col-lg-8">
                            <div class="form-group admin-order-form-group">
                                <input type="text" name="keyword" value="@Model.Keyword"
                                       class="form-control admin-order-input"
                                       placeholder="Tìm theo tên sản phẩm hoặc tên khách hàng..." />
                            </div>
                        </div>
                        <div class="col-lg-4">
                            <button type="submit" class="btn admin-order-btn admin-order-btn-save w-100">
                                <i class="fas fa-search mr-1"></i> Tìm kiếm
                            </button>
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="card admin-order-list-card">
            <div class="card-header border-0">
                <h3 class="admin-order-card-title">
                    @ReviewStatusConstants.GetName(Model.StatusFilter)
                    <span class="badge badge-secondary ml-2">@Model.TotalItems</span>
                </h3>
            </div>
            <div class="card-body">
                @if (Model.Reviews != null && Model.Reviews.Count > 0)
                {
                    <div class="admin-review-list">
                        @foreach (var item in Model.Reviews)
                        {
                            string imgUrl = normalizeImage(item.HinhAnhChinh);
                            <div class="admin-review-card">
                                <div class="admin-review-card__product">
                                    <img src="@imgUrl" alt="@item.TenSanPham"
                                         onerror="this.onerror=null;this.src='@fallbackImg';" />
                                    <div>
                                        <div class="admin-review-product-name">@item.TenSanPham</div>
                                        <div class="admin-review-customer">
                                            <i class="fas fa-user mr-1"></i> @item.TenKhachHang
                                        </div>
                                        <div class="admin-review-date">
                                            <i class="fas fa-clock mr-1"></i> @item.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                                        </div>
                                    </div>
                                </div>

                                <div class="admin-review-card__content">
                                    <div class="admin-review-stars">
                                        @for (int s = 1; s <= 5; s++)
                                        {
                                            <span class="@(s <= item.SoSao ? "star-filled" : "star-empty")">&#9733;</span>
                                        }
                                        <span class="ml-1">(@item.SoSao/5)</span>
                                    </div>
                                    <p class="admin-review-text">
                                        @(string.IsNullOrWhiteSpace(item.NoiDung) ? "(Không có nội dung)" : item.NoiDung)
                                    </p>
                                    @if (!string.IsNullOrWhiteSpace(item.LyDoTuChoi))
                                    {
                                        <div class="admin-review-reject-reason">
                                            <i class="fas fa-ban mr-1"></i> Lý do từ chối: @item.LyDoTuChoi
                                        </div>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(item.DuyetBoiName))
                                    {
                                        <small class="text-muted">
                                            Xử lý bởi: @item.DuyetBoiName
                                            @(item.NgayDuyet.HasValue ? "lúc " + item.NgayDuyet.Value.ToString("dd/MM/yyyy HH:mm") : "")
                                        </small>
                                    }
                                </div>

                                @if (Model.StatusFilter == ReviewStatusConstants.PENDING)
                                {
                                    <div class="admin-review-card__actions">
                                        @using (Html.BeginForm("Approve", "ManagerReview", FormMethod.Post, new { @class = "d-inline" }))
                                        {
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="DanhGiaId" value="@item.DanhGiaId" />
                                            <button type="submit" class="btn btn-success btn-sm"
                                                    data-confirm-title="Duyệt đánh giá?"
                                                    data-confirm-message="Đánh giá sẽ được hiển thị công khai trên trang sản phẩm.">
                                                <i class="fas fa-check mr-1"></i> Duyệt
                                            </button>
                                        }

                                        <button type="button" class="btn btn-danger btn-sm ml-1 btn-open-reject"
                                                data-id="@item.DanhGiaId"
                                                data-name="@item.TenSanPham">
                                            <i class="fas fa-times mr-1"></i> Từ chối
                                        </button>
                                    </div>
                                }
                            </div>
                        }
                    </div>

                    @if (Model.TotalPages > 1)
                    {
                        <div class="admin-order-pagination mt-3">
                            <div class="admin-order-pagination-links">
                                <a class="admin-order-page-link @(Model.HasPreviousPage ? "" : "disabled")"
                                   href="@(Model.HasPreviousPage ? Url.Action("Index", new { statusFilter = Model.StatusFilter, keyword = Model.Keyword, page = Model.CurrentPage - 1 }) : "javascript:void(0)")">
                                    <i class="fas fa-chevron-left"></i>
                                </a>
                                @for (int i = Math.Max(1, Model.CurrentPage - 2); i <= Math.Min(Model.TotalPages, Model.CurrentPage + 2); i++)
                                {
                                    <a class="admin-order-page-link @(i == Model.CurrentPage ? "active" : "")"
                                       href="@Url.Action("Index", new { statusFilter = Model.StatusFilter, keyword = Model.Keyword, page = i })">@i</a>
                                }
                                <a class="admin-order-page-link @(Model.HasNextPage ? "" : "disabled")"
                                   href="@(Model.HasNextPage ? Url.Action("Index", new { statusFilter = Model.StatusFilter, keyword = Model.Keyword, page = Model.CurrentPage + 1 }) : "javascript:void(0)")">
                                    <i class="fas fa-chevron-right"></i>
                                </a>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="admin-order-empty">
                        <div class="admin-order-empty-icon"><i class="fas fa-star"></i></div>
                        <h3>Không có đánh giá nào</h3>
                        <p>Không tìm thấy đánh giá phù hợp với điều kiện lọc.</p>
                    </div>
                }
            </div>
        </div>

    </div>
</section>

@* Modal từ chối *@
<div id="rejectModal" class="modal fade" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Từ chối đánh giá</h5>
                <button type="button" class="close" data-dismiss="modal">&times;</button>
            </div>
            @using (Html.BeginForm("Reject", "ManagerReview", FormMethod.Post, new { id = "rejectForm" }))
            {
                @Html.AntiForgeryToken()
                <input type="hidden" name="DanhGiaId" id="rejectDanhGiaId" value="" />
                <div class="modal-body">
                    <p id="rejectProductName" class="font-weight-bold mb-3"></p>
                    <div class="form-group">
                        <label>Lý do từ chối <span class="text-danger">*</span></label>
                        <textarea name="LyDoTuChoi" rows="3" class="form-control"
                                  placeholder="Nhập lý do từ chối đánh giá này..." required></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-danger">Xác nhận từ chối</button>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
<script>
    document.querySelectorAll('.btn-open-reject').forEach(function (btn) {
        btn.addEventListener('click', function () {
            document.getElementById('rejectDanhGiaId').value = this.dataset.id;
            document.getElementById('rejectProductName').textContent = 'Sản phẩm: ' + this.dataset.name;
            $('#rejectModal').modal('show');
        });
    });
</script>
}
