@model MatKinh.ViewModel.AdminProfileVm
@{
    ViewBag.Title = "Thông tin";
}

<div class="admin-page-header">
    <div>
        <h1 class="admin-page-title">Thông tin tài khoản</h1>
        <p class="admin-page-subtitle">Xem và cập nhật hồ sơ quản trị viên.</p>
    </div>

    <ol class="breadcrumb admin-breadcrumb">
        <li class="breadcrumb-item">
            <a href='@Url.Action("Index","Dashboard")'>Dashboard</a>
        </li>
        <li class="breadcrumb-item active">Thông tin</li>
    </ol>
</div>

<section class="content">
    <div class="container-fluid p-0">
        <div class="row">

            <!-- LEFT PROFILE -->
            <div class="col-lg-4 col-xl-3">
                <div class="card admin-profile-card">
                    <div class="card-body text-center">

                        <div class="admin-profile-avatar-wrap">
                            <img class="admin-profile-avatar"
                                 src="@(string.IsNullOrEmpty(Model.AnhDaiDien) ? "/Asset/img/image_Account.jpg" : Model.AnhDaiDien)"
                                 alt="User profile" />
                        </div>

                        <h3 class="admin-profile-name">@Model.HoTen</h3>
                        <div class="admin-profile-username">@Model.TenDangNhap</div>

                        <div class="admin-profile-meta-list">

                            <div class="admin-profile-meta-item">
                                <span class="admin-profile-meta-label">Vai trò</span>
                                <span class="admin-profile-meta-value">@Model.TenVaiTro</span>
                            </div>

                            <div class="admin-profile-meta-item">
                                <span class="admin-profile-meta-label">Trạng thái</span>
                                <span class="admin-profile-meta-value">
                                    @(Model.IsActive ? "Hoạt động" : "Khóa")
                                </span>
                            </div>

                        </div>
                    </div>
                </div>
            </div>

            <!-- RIGHT FORM -->
            <div class="col-lg-8 col-xl-9">
                <div class="card admin-form-card admin-tab-card">

                    <div class="card-header border-0 pb-0">
                        <ul class="nav nav-pills admin-tab-nav">
                            <li class="nav-item">
                                <a class="nav-link active" href="#profileInfo" data-toggle="tab">
                                    Thông tin
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="#changePassword" data-toggle="tab">
                                    Đổi mật khẩu
                                </a>
                            </li>
                        </ul>
                    </div>

                    <div class="card-body">
                        <div class="tab-content">

                            <!-- UPDATE INFO -->
                            <div class="tab-pane active" id="profileInfo">

                                @using (Html.BeginForm("UpdateInformationAccount", "Profile", FormMethod.Post))
                                {
                                    @Html.AntiForgeryToken()

                                    <div class="row">
                                        <div class="col-md-6">
                                            <div class="form-group">
                                                <label>Tài khoản</label>
                                                <input type="text"
                                                       class="form-control admin-input"
                                                       value="@Model.TenDangNhap"
                                                       disabled />
                                            </div>
                                        </div>

                                        <div class="col-md-6">
                                            <div class="form-group">
                                                <label>Email</label>
                                                <input type="email"
                                                       class="form-control admin-input"
                                                       name="Email"
                                                       value="@Model.Email" />
                                            </div>
                                        </div>
                                    </div>

                                    <div class="form-group">
                                        <label>Họ và tên</label>
                                        <input type="text"
                                               class="form-control admin-input"
                                               name="HoTen"
                                               value="@Model.HoTen" />
                                    </div>

                                    <div class="row">
                                        <div class="col-md-6">
                                            <div class="form-group">
                                                <label>Số điện thoại</label>
                                                <input type="text"
                                                       class="form-control admin-input"
                                                       name="SoDienThoai"
                                                       value="@Model.SoDienThoai" />
                                            </div>
                                        </div>

                                        <div class="col-md-6">
                                            <div class="form-group">
                                                <label>Giới tính</label>
                                                <select name="GioiTinh" class="form-control admin-input">
                                                    <option value="">-- Chọn --</option>
                                                    <option value="true" @(Model.GioiTinh == true ? "selected" : "")>Nam</option>
                                                    <option value="false" @(Model.GioiTinh == false ? "selected" : "")>Nữ</option>
                                                </select>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="form-group">
                                        <label>Ngày sinh</label>
                                        <input type="date"
                                               class="form-control admin-input"
                                               name="NgaySinh"
                                               value="@(Model.NgaySinh.HasValue ? Model.NgaySinh.Value.ToString("yyyy-MM-dd") : "")" />
                                    </div>

                                    <div class="form-group">
                                        <label>Địa chỉ</label>
                                        <input type="text"
                                               class="form-control admin-input"
                                               name="DiaChi"
                                               value="@Model.DiaChi" />
                                    </div>

                                    <div class="admin-form-actions">
                                        <button type="submit" class="btn admin-btn admin-btn-save">
                                            <i class="fas fa-save mr-1"></i> Lưu thông tin
                                        </button>
                                    </div>
                                }

                            </div>

                            <!-- CHANGE PASSWORD -->
                            <div class="tab-pane" id="changePassword">

                                @using (Html.BeginForm("ChangePasswordAccount", "Profile", FormMethod.Post))
                                {
                                    @Html.AntiForgeryToken()

                                    <div class="form-group">
                                        <label>Mật khẩu hiện tại</label>
                                        <input type="password"
                                               class="form-control admin-input"
                                               name="CurrentPassword" />
                                    </div>

                                    <div class="form-group">
                                        <label>Mật khẩu mới</label>
                                        <input type="password"
                                               class="form-control admin-input"
                                               name="NewPassword" />
                                    </div>

                                    <div class="form-group">
                                        <label>Xác nhận mật khẩu</label>
                                        <input type="password"
                                               class="form-control admin-input"
                                               name="ConfirmPassword" />
                                    </div>

                                    <div class="admin-form-actions">
                                        <button type="submit" class="btn admin-btn admin-btn-save">
                                            <i class="fas fa-key mr-1"></i> Đổi mật khẩu
                                        </button>
                                    </div>
                                }

                            </div>

                        </div>
                    </div>

                </div>
            </div>

        </div>
    </div>
</section>