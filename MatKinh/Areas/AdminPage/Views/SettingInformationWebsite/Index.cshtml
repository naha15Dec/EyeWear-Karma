@model MatKinh.ViewModel.AdminWebsiteSettingVm
@using MatKinh.Models

@{
    ViewBag.Title = "Thông tin cửa hàng";
    var login = Session["LoginInformation"] as TaiKhoan;
    var acc = login != null ? login.TenDangNhap : "";
}

<div class="admin-page-header">
    <div>
        <h1 class="admin-page-title">Thông tin cửa hàng</h1>
        <p class="admin-page-subtitle">Cập nhật thông tin liên hệ và theo dõi lịch sử thay đổi.</p>
    </div>

    <ol class="breadcrumb admin-breadcrumb">
        <li class="breadcrumb-item">
            <a href='@Url.Action("Index","Dashboard")'>Dashboard</a>
        </li>
        <li class="breadcrumb-item active">Thông tin cửa hàng</li>
    </ol>
</div>

<section class="content">
    <div class="container-fluid p-0">

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success">
                @TempData["SuccessMessage"]
            </div>
        }

        <div class="row">
            <div class="col-lg-7">
                <div class="card admin-card">
                    <div class="card-header admin-card-header border-0">
                        <div class="admin-card-title-wrap">
                            <h3 class="admin-card-title">Lịch sử thay đổi</h3>
                            <span class="admin-card-count">@((Model.History != null) ? Model.History.Count : 0) lần cập nhật</span>
                        </div>
                    </div>

                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table admin-table align-middle">
                                <thead>
                                    <tr>
                                        <th>Mã</th>
                                        <th>Người cập nhật</th>
                                        <th>Thời gian</th>
                                        <th class="text-center">Thao tác</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (Model.History != null && Model.History.Count > 0)
                                    {
                                        foreach (var item in Model.History)
                                        {
                                            <tr>
                                                <td>
                                                    <span class="admin-code-text">#@item.ThongTinCuaHangId</span>
                                                </td>
                                                <td>
                                                    <div class="admin-order-user">
                                                        <div class="admin-order-user-icon">
                                                            <i class="fas fa-user"></i>
                                                        </div>
                                                        <span>@(item.TaiKhoan != null ? item.TaiKhoan.TenDangNhap : "Không xác định")</span>
                                                    </div>
                                                </td>
                                                <td>
                                                    <span class="admin-date-text">@item.UpdatedAt.ToString("dd/MM/yyyy HH:mm")</span>
                                                </td>
                                                <td class="text-center">
                                                    <div class="admin-action-group">
                                                        <button type="button"
                                                                class="btn admin-btn admin-btn-detail"
                                                                data-toggle="modal"
                                                                data-target="#historyModal@(item.ThongTinCuaHangId)">
                                                            <i class="fas fa-eye mr-1"></i> Chi tiết
                                                        </button>

                                                        @using (Html.BeginForm("DeleteHistoryChange", "SettingInformationWebsite", FormMethod.Post, new { @class = "d-inline" }))
                                                        {
                                                            @Html.AntiForgeryToken()
                                                            <input type="hidden" name="id" value="@item.ThongTinCuaHangId" />
                                                            <button type="submit"
                                                                    class="btn admin-btn admin-btn-delete"
                                                                    onclick="return confirm('Bạn có chắc muốn xóa lịch sử thay đổi này?')">
                                                                <i class="fas fa-trash-alt mr-1"></i> Xóa
                                                            </button>
                                                        }
                                                    </div>

                                                    <div class="modal fade admin-modal"
                                                         id="historyModal@(item.ThongTinCuaHangId)"
                                                         tabindex="-1"
                                                         role="dialog"
                                                         aria-hidden="true">
                                                        <div class="modal-dialog modal-dialog-centered admin-confirm-dialog admin-store-modal-dialog" role="document">
                                                            <div class="modal-content admin-modal-content">
                                                                <div class="modal-header admin-modal-header">
                                                                    <div>
                                                                        <h5 class="modal-title">Chi tiết lịch sử thay đổi</h5>
                                                                        <p class="admin-modal-subtitle mb-0">Bản ghi #@item.ThongTinCuaHangId</p>
                                                                    </div>
                                                                    <button type="button" class="close admin-modal-close" data-dismiss="modal" aria-label="Close">
                                                                        <span aria-hidden="true">&times;</span>
                                                                    </button>
                                                                </div>

                                                                <div class="modal-body admin-modal-body">
                                                                    <div class="card admin-form-card">
                                                                        <div class="card-body">
                                                                            <div class="form-group">
                                                                                <label>Tên cửa hàng</label>
                                                                                <input type="text" class="form-control admin-input" value="@item.TenCuaHang" disabled />
                                                                            </div>

                                                                            <div class="form-group">
                                                                                <label>Hotline</label>
                                                                                <input type="text" class="form-control admin-input" value="@item.Hotline" disabled />
                                                                            </div>

                                                                            <div class="form-group">
                                                                                <label>Email</label>
                                                                                <input type="text" class="form-control admin-input" value="@item.Email" disabled />
                                                                            </div>

                                                                            <div class="form-group">
                                                                                <label>Địa chỉ</label>
                                                                                <input type="text" class="form-control admin-input" value="@item.DiaChi" disabled />
                                                                            </div>

                                                                            <div class="form-group">
                                                                                <label>Mô tả ngắn</label>
                                                                                <textarea class="form-control admin-input admin-store-textarea" disabled>@item.MoTaNgan</textarea>
                                                                            </div>

                                                                            <div class="form-group">
                                                                                <label>Giới thiệu</label>
                                                                                <textarea class="form-control admin-input admin-store-textarea" disabled>@item.GioiThieu</textarea>
                                                                            </div>

                                                                            <div class="form-group">
                                                                                <label>Facebook</label>
                                                                                <input type="text" class="form-control admin-input" value="@item.FacebookUrl" disabled />
                                                                            </div>

                                                                            <div class="form-group">
                                                                                <label>Instagram</label>
                                                                                <input type="text" class="form-control admin-input" value="@item.InstagramUrl" disabled />
                                                                            </div>

                                                                            <div class="form-group mb-0">
                                                                                <label>Zalo</label>
                                                                                <input type="text" class="form-control admin-input" value="@item.ZaloUrl" disabled />
                                                                            </div>
                                                                        </div>
                                                                    </div>
                                                                </div>

                                                                <div class="modal-footer admin-modal-footer">
                                                                    <button type="button" class="btn admin-btn admin-btn-light" data-dismiss="modal">Đóng</button>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr>
                                            <td colspan="4" class="text-center py-4">Chưa có lịch sử thay đổi nào.</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-5">
                @using (Html.BeginForm("ChangeInformation", "SettingInformationWebsite", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()

                    <div class="card admin-form-card">
                        <div class="card-header border-0">
                            <h3 class="card-title">Cập nhật thông tin hiện tại</h3>
                        </div>

                        <div class="card-body">
                            <div class="admin-store-meta-box">
                                <div class="admin-store-meta-item">
                                    <span class="admin-store-meta-label">Tài khoản cập nhật</span>
                                    <span class="admin-store-meta-value">@acc</span>
                                </div>
                            </div>

                            <div class="form-group mt-3">
                                <label>Tên cửa hàng</label>
                                <input type="text"
                                       class="form-control admin-input"
                                       name="TenCuaHang"
                                       value="@Model.TenCuaHang" />
                            </div>

                            <div class="form-group">
                                <label>Hotline</label>
                                <input type="text"
                                       class="form-control admin-input"
                                       name="Hotline"
                                       value="@Model.Hotline" />
                            </div>

                            <div class="form-group">
                                <label>Email liên hệ</label>
                                <input type="text"
                                       class="form-control admin-input"
                                       name="Email"
                                       value="@Model.Email" />
                            </div>

                            <div class="form-group">
                                <label>Địa chỉ</label>
                                <input type="text"
                                       class="form-control admin-input"
                                       name="DiaChi"
                                       value="@Model.DiaChi" />
                            </div>

                            <div class="form-group">
                                <label>Mô tả ngắn</label>
                                <textarea class="form-control admin-input admin-store-textarea"
                                          name="MoTaNgan">@Model.MoTaNgan</textarea>
                            </div>

                            <div class="form-group">
                                <label>Giới thiệu</label>
                                <textarea class="form-control admin-input admin-store-textarea"
                                          name="GioiThieu">@Model.GioiThieu</textarea>
                            </div>

                            <div class="form-group">
                                <label>Logo</label>
                                <input type="text"
                                       class="form-control admin-input"
                                       name="Logo"
                                       value="@Model.Logo" />
                            </div>

                            <div class="form-group">
                                <label>Banner</label>
                                <input type="text"
                                       class="form-control admin-input"
                                       name="Banner"
                                       value="@Model.Banner" />
                            </div>

                            <div class="form-group">
                                <label>Facebook URL</label>
                                <input type="text"
                                       class="form-control admin-input"
                                       name="FacebookUrl"
                                       value="@Model.FacebookUrl" />
                            </div>

                            <div class="form-group">
                                <label>Instagram URL</label>
                                <input type="text"
                                       class="form-control admin-input"
                                       name="InstagramUrl"
                                       value="@Model.InstagramUrl" />
                            </div>

                            <div class="form-group">
                                <label>Zalo URL</label>
                                <input type="text"
                                       class="form-control admin-input"
                                       name="ZaloUrl"
                                       value="@Model.ZaloUrl" />
                            </div>

                            <div class="form-group">
                                <label>Trạng thái hiển thị</label>
                                <select name="IsActive" class="form-control admin-input">
                                    <option value="true" @(Model.IsActive ? "selected" : "")>Đang sử dụng</option>
                                    <option value="false" @(!Model.IsActive ? "selected" : "")>Ngừng sử dụng</option>
                                </select>
                            </div>

                            <div class="admin-form-actions">
                                <button type="submit" class="btn admin-btn admin-btn-save">
                                    <i class="fas fa-save mr-1"></i> Lưu thay đổi
                                </button>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</section>