@using System.Linq
@using System.Data.Entity
@using MatKinh.Models

@{
    Layout = null;

    var sessionAccount = Session["LoginInformation"] as TaiKhoan;
    var db = new BanMatKinhEntities();

    TaiKhoan account = null;
    string roleCode = string.Empty;
    string roleName = string.Empty;

    int numberOfBlogWaitingApproval = 0;
    int numberOfOrderProcessing = 0;
    int numberOfAssignedOrders = 0;

    if (sessionAccount != null)
    {
        account = db.TaiKhoans
            .Include(x => x.VaiTro)
            .FirstOrDefault(x => x.TaiKhoanId == sessionAccount.TaiKhoanId);

        if (account != null && account.VaiTro != null)
        {
            roleCode = (account.VaiTro.MaVaiTro ?? string.Empty).Trim().ToUpper();
            roleName = account.VaiTro.TenVaiTro ?? string.Empty;
        }

        // Bài viết đang chờ admin duyệt = trạng thái nháp
        if (roleCode == RoleConstants.ADMIN)
        {
            numberOfBlogWaitingApproval = db.BaiViets.Count(x => x.TrangThai == BlogStatusConstants.DRAFT);
        }

        // Đơn đang xử lý = chưa hoàn tất và chưa hủy
        if (roleCode == RoleConstants.ADMIN || roleCode == RoleConstants.STAFF)
        {
            numberOfOrderProcessing = db.DonHangs.Count(x =>
                x.TrangThai != OrderStatusConstants.DELIVERED &&
                x.TrangThai != OrderStatusConstants.CANCELLED);
        }

        if (roleCode == RoleConstants.SHIPPER)
        {
            numberOfAssignedOrders = db.DonHangs.Count(x =>
                x.ShipperId == account.TaiKhoanId &&
                x.TrangThai != OrderStatusConstants.DELIVERED &&
                x.TrangThai != OrderStatusConstants.CANCELLED);
        }
    }

    bool isAdmin = roleCode == RoleConstants.ADMIN;
    bool isStaff = roleCode == RoleConstants.STAFF;
    bool isShipper = roleCode == RoleConstants.SHIPPER;

    string displayName = account != null && !string.IsNullOrWhiteSpace(account.HoTen)
        ? account.HoTen
        : "Tài khoản";

    string displayUsername = account != null ? account.TenDangNhap : string.Empty;
    string avatar = (account != null && !string.IsNullOrWhiteSpace(account.AnhDaiDien))
        ? account.AnhDaiDien
        : Url.Content("~/Asset/img/image_Account.jpg");
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - Admin | KarmaEyewear</title>

    <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Source+Sans+Pro:300,400,500,600,700&display=fallback">
    <link rel="stylesheet" href="https://code.ionicframework.com/ionicons/2.0.1/css/ionicons.min.css">

    <link href="/Content/fontawesome-free/css/all.min.css" rel="stylesheet" />
    <link href="/Content/adminlte.min.css" rel="stylesheet" />
    <link href="/Content/dataTables.bootstrap4.min.css" rel="stylesheet" />
    <link href="/Content/responsive.bootstrap4.min.css" rel="stylesheet" />
    <link href="/Content/buttons.bootstrap4.min.css" rel="stylesheet" />
    <link href="/Content/ekko-lightbox.css" rel="stylesheet" />
    <link href="~/Content/tempusdominus-bootstrap-4.min.css" rel="stylesheet" />
    <link href="~/Content/icheck-bootstrap.min.css" rel="stylesheet" />
    <link href="~/Content/jqvmap.min.css" rel="stylesheet" />
    <link href="~/Content/OverlayScrollbars.min.css" rel="stylesheet" />
    <link href="~/Content/daterangepicker.css" rel="stylesheet" />
    <link href="~/Content/summernote-bs4.min.css" rel="stylesheet" />

    <link href="~/Content/css/admin-layout.css" rel="stylesheet" />
    <link href="~/Content/css/admin-table.css" rel="stylesheet" />
    <link href="~/Content/css/admin-form.css" rel="stylesheet" />
    <link href="~/Content/css/admin-dashboard.css" rel="stylesheet" />
    <link href="~/Content/css/admin-order.css" rel="stylesheet" />
    <link href="~/Content/css/admin-post.css" rel="stylesheet" />
    <link href="~/Content/css/admin-revenue.css" rel="stylesheet" />
    <link href="~/Content/css/admin-profile.css" rel="stylesheet" />
    <link href="~/Content/css/admin-product.css" rel="stylesheet" />
    <link href="~/Content/css/admin-blog.css" rel="stylesheet" />
    <link href="~/Content/css/admin-system-category.css" rel="stylesheet" />
    <link href="~/Content/css/admin-setting.css" rel="stylesheet" />
    <link href="~/Content/css/premium-toast.css" rel="stylesheet" />
</head>
<body class="hold-transition sidebar-mini layout-fixed admin-modern">
    <div class="wrapper">

        <!-- Topbar -->
        <nav class="main-header navbar navbar-expand navbar-white navbar-light admin-topbar">
            <ul class="navbar-nav">
                <li class="nav-item">
                    <a class="nav-link admin-icon-btn" data-widget="pushmenu" href="#" role="button">
                        <i class="fas fa-bars"></i>
                    </a>
                </li>
                <li class="nav-item d-none d-sm-inline-block">
                    <a href="@Url.Action("Index","Home",new { area="" })" class="nav-link admin-home-link">
                        <i class="fas fa-globe-asia mr-1"></i> Trang chủ website
                    </a>
                </li>
            </ul>

            <ul class="navbar-nav ml-auto align-items-center">
                <li class="nav-item mr-2 d-none d-md-block">
                    <span class="admin-page-label">KarmaEyewear Admin</span>
                </li>

                <li class="nav-item dropdown user-menu">
                    <a href="#" class="nav-link dropdown-toggle admin-user-toggle" data-toggle="dropdown">
                        <img src="@avatar" class="user-image img-circle elevation-2" alt="User Image">
                        <span class="d-none d-md-inline">@displayName</span>
                    </a>
                    <ul class="dropdown-menu dropdown-menu-lg dropdown-menu-right admin-user-dropdown">
                        <li class="user-header">
                            <img src="@avatar" class="img-circle elevation-2" alt="User Image">
                            <p>
                                @displayName
                                <small>@displayUsername</small>
                                <small>@roleName</small>
                            </p>
                        </li>
                        <li class="user-footer">
                            <a href="@Url.Action("Index","Profile")" class="btn btn-outline-secondary btn-sm">Thông tin</a>
                            <a href="@Url.Action("LogoutAccount","Account",new { area="" })" class="btn btn-dark btn-sm float-right">Đăng xuất</a>
                        </li>
                    </ul>
                </li>

                <li class="nav-item">
                    <a class="nav-link admin-icon-btn" data-widget="fullscreen" href="#" role="button">
                        <i class="fas fa-expand-arrows-alt"></i>
                    </a>
                </li>
            </ul>
        </nav>

        <!-- Sidebar -->
        <aside class="main-sidebar elevation-4 admin-sidebar">
            <a href="@Url.Action("Index","Dashboard")" class="brand-link admin-brand">
                <span class="brand-mark">K</span>
                <span class="brand-text">KarmaEyewear</span>
            </a>

            <div class="sidebar">
                <div class="admin-sidebar-user">
                    <img src="@avatar" alt="avatar" class="admin-sidebar-avatar" />
                    <div class="admin-sidebar-user-info">
                        <div class="admin-sidebar-name">@displayName</div>
                        <div class="admin-sidebar-role">@roleName</div>
                    </div>
                </div>

                <nav class="mt-2">
                    <ul class="nav nav-pills nav-sidebar flex-column admin-menu" data-widget="treeview" role="menu" data-accordion="false">

                        <!-- CHUNG -->
                        <li class="nav-item">
                            <a href="@Url.Action("Index","Dashboard")" class="nav-link">
                                <i class="nav-icon fas fa-th-large"></i>
                                <p>Dashboard</p>
                            </a>
                        </li>

                        <li class="nav-item">
                            <a href="@Url.Action("Index","Profile")" class="nav-link">
                                <i class="nav-icon fas fa-user-circle"></i>
                                <p>Hồ sơ cá nhân</p>
                            </a>
                        </li>

                        @if (isAdmin || isStaff)
                        {
                            <li class="nav-header">TÁC NGHIỆP</li>

                            <li class="nav-item">
                                <a href="#" class="nav-link">
                                    <i class="nav-icon fas fa-newspaper"></i>
                                    <p>Bài viết của tôi <i class="fas fa-angle-left right"></i></p>
                                </a>
                                <ul class="nav nav-treeview">
                                    <li class="nav-item">
                                        <a href="@Url.Action("AddBlog","ListBlog")" class="nav-link">
                                            <i class="far fa-circle nav-icon"></i>
                                            <p>Thêm bài viết</p>
                                        </a>
                                    </li>
                                    <li class="nav-item">
                                        <a href="@Url.Action("BlogList","ListBlog")" class="nav-link">
                                            <i class="far fa-circle nav-icon"></i>
                                            <p>Danh sách bài viết</p>
                                        </a>
                                    </li>
                                </ul>
                            </li>

                            <li class="nav-item">
                                <a href="#" class="nav-link">
                                    <i class="nav-icon fas fa-glasses"></i>
                                    <p>Sản phẩm của tôi <i class="right fas fa-angle-left"></i></p>
                                </a>
                                <ul class="nav nav-treeview">
                                    <li class="nav-item">
                                        <a href="@Url.Action("AddProduct","ListProduct")" class="nav-link">
                                            <i class="far fa-circle nav-icon"></i>
                                            <p>Thêm sản phẩm</p>
                                        </a>
                                    </li>
                                    <li class="nav-item">
                                        <a href="@Url.Action("ProductsList","ListProduct")" class="nav-link">
                                            <i class="far fa-circle nav-icon"></i>
                                            <p>Danh sách sản phẩm</p>
                                        </a>
                                    </li>
                                </ul>
                            </li>
                        }

                        @if (isAdmin || isStaff)
                        {
                            <li class="nav-item">
                                <a href="@Url.Action("Index","ManagerOrder")" class="nav-link">
                                    <i class="nav-icon fas fa-shopping-bag"></i>
                                    <p>
                                        Đơn hàng vận hành
                                        @if (numberOfOrderProcessing > 0)
                                        {
                                            <span class="badge badge-danger right">@numberOfOrderProcessing</span>
                                        }
                                    </p>
                                </a>
                            </li>
                        }

                        @if (isShipper)
                        {
                            <li class="nav-header">GIAO HÀNG</li>

                            <li class="nav-item">
                                <a href="@Url.Action("Index","ManagerOrder")" class="nav-link">
                                    <i class="nav-icon fas fa-truck"></i>
                                    <p>
                                        Đơn được giao cho tôi
                                        @if (numberOfAssignedOrders > 0)
                                        {
                                            <span class="badge badge-danger right">@numberOfAssignedOrders</span>
                                        }
                                    </p>
                                </a>
                            </li>
                        }

                        @if (isAdmin)
                        {
                            <li class="nav-header">QUẢN TRỊ HỆ THỐNG</li>

                            <li class="nav-item">
                                <a href="@Url.Action("ManagerBlog","ManagerBlog", new { status = "draft" })" class="nav-link">
                                    <i class="nav-icon fas fa-check-circle"></i>
                                    <p>
                                        Kiểm duyệt bài viết
                                        @if (numberOfBlogWaitingApproval > 0)
                                        {
                                            <span class="badge badge-danger right">@numberOfBlogWaitingApproval</span>
                                        }
                                    </p>
                                </a>
                            </li>

                            <li class="nav-item">
                                <a href="#" class="nav-link">
                                    <i class="nav-icon fas fa-box-open"></i>
                                    <p>Quản lý sản phẩm <i class="fas fa-angle-left right"></i></p>
                                </a>
                                <ul class="nav nav-treeview">
                                    <li class="nav-item">
                                        <a href="@Url.Action("Index","ManagerProduct", new { statusProduct = "stock" })" class="nav-link">
                                            <i class="far fa-circle nav-icon"></i>
                                            <p>Còn hàng</p>
                                        </a>
                                    </li>
                                    <li class="nav-item">
                                        <a href="@Url.Action("Index","ManagerProduct", new { statusProduct = "outofstock" })" class="nav-link">
                                            <i class="far fa-circle nav-icon"></i>
                                            <p>Hết hàng</p>
                                        </a>
                                    </li>
                                    <li class="nav-item">
                                        <a href="@Url.Action("Index","ManagerProduct", new { statusProduct = "inactive" })" class="nav-link">
                                            <i class="far fa-circle nav-icon"></i>
                                            <p>Ngừng bán</p>
                                        </a>
                                    </li>
                                </ul>
                            </li>

                            <li class="nav-item">
                                <a href="#" class="nav-link">
                                    <i class="nav-icon fas fa-tags"></i>
                                    <p>Danh mục hệ thống <i class="fas fa-angle-left right"></i></p>
                                </a>
                                <ul class="nav nav-treeview">
                                    <li class="nav-item">
                                        <a href="@Url.Action("ProductType","ListTypeProduct")" class="nav-link">
                                            <i class="far fa-circle nav-icon"></i>
                                            <p>Loại sản phẩm</p>
                                        </a>
                                    </li>
                                    <li class="nav-item">
                                        <a href="@Url.Action("Brand","ListBrand")" class="nav-link">
                                            <i class="far fa-circle nav-icon"></i>
                                            <p>Thương hiệu</p>
                                        </a>
                                    </li>
                                </ul>
                            </li>

                            <li class="nav-item">
                                <a href="@Url.Action("AccountManager","ManagerAccount")" class="nav-link">
                                    <i class="nav-icon fas fa-users-cog"></i>
                                    <p>Quản lý tài khoản</p>
                                </a>
                            </li>

                            <li class="nav-item">
                                <a href="@Url.Action("Revenue","ManagerRevenue")" class="nav-link">
                                    <i class="nav-icon fas fa-chart-line"></i>
                                    <p>Doanh thu</p>
                                </a>
                            </li>

                            <li class="nav-item">
                                <a href="@Url.Action("Index","SettingInformationWebsite")" class="nav-link">
                                    <i class="nav-icon fas fa-store"></i>
                                    <p>Thông tin cửa hàng</p>
                                </a>
                            </li>
                        }
                    </ul>
                </nav>
            </div>
        </aside>

        <!-- Content -->
        <div class="content-wrapper admin-content-wrapper">
            <section class="content pt-3">
                <div class="container-fluid">

                    <div class="premium-toast-container">
                        @Html.Partial("~/Views/Shared/_FlashMessage.cshtml")

                    </div>
                    @RenderBody()
                </div>
            </section>
        </div>

        <footer class="main-footer admin-footer">
            <div class="float-right d-none d-sm-inline-block">
                Eyewear Admin Panel
            </div>
            <strong>Copyright &copy; @DateTime.Now.Year KarmaEyewear.</strong>
        </footer>
    </div>

    <script src="~/Scripts/jquery.min.js"></script>
    <script src="~/Scripts/bootstrap.bundle.min.js"></script>
    <script src="~/Scripts/adminlte.min.js"></script>
    <script src="~/Scripts/demo.js"></script>
    <script src="~/Scripts/jquery.dataTables.min.js"></script>
    <script src="~/Scripts/dataTables.bootstrap4.min.js"></script>
    <script src="~/Scripts/dataTables.responsive.min.js"></script>
    <script src="~/Scripts/responsive.bootstrap4.min.js"></script>
    <script src="~/Scripts/dataTables.buttons.min.js"></script>
    <script src="~/Scripts/buttons.bootstrap4.min.js"></script>
    <script src="~/Scripts/jszip.min.js"></script>
    <script src="~/Scripts/pdfmake.min.js"></script>
    <script src="~/Scripts/vfs_fonts.js"></script>
    <script src="~/Scripts/buttons.html5.min.js"></script>
    <script src="~/Scripts/buttons.print.min.js"></script>
    <script src="~/Scripts/buttons.colVis.min.js"></script>
    <script src="~/Scripts/ekko-lightbox.min.js"></script>
    <script src="~/Scripts/jquery.filterizr.min.js"></script>
    <script src="~/Scripts/jquery-ui.min.js"></script>
    <script src="~/Scripts/Chart.min.js"></script>
    <script src="~/Scripts/sparkline.js"></script>
    <script src="~/Scripts/jquery.vmap.min.js"></script>
    <script src="~/Scripts/jquery.vmap.usa.js"></script>
    <script src="~/Scripts/jquery.knob.min.js"></script>
    <script src="~/Scripts/moment.min.js"></script>
    <script src="~/Scripts/daterangepicker.js"></script>
    <script src="~/Scripts/tempusdominus-bootstrap-4.min.js"></script>
    <script src="~/Scripts/jquery.overlayScrollbars.min.js"></script>
    <script src="~/Scripts/dashboard.js"></script>

    <script>
        $.widget.bridge('uibutton', $.ui.button);

        $(function () {
            if ($("#example1").length) {
                $("#example1").DataTable({
                    responsive: true,
                    lengthChange: false,
                    autoWidth: false,
                    buttons: ["copy", "csv", "excel", "pdf", "print", "colvis"],
                    language: {
                        search: "Tìm kiếm:",
                        paginate: {
                            first: "Đầu",
                            last: "Cuối",
                            next: "Sau",
                            previous: "Trước"
                        },
                        zeroRecords: "Không có dữ liệu phù hợp",
                        info: "Hiển thị _START_ đến _END_ của _TOTAL_ dòng",
                        infoEmpty: "Không có dữ liệu",
                        infoFiltered: "(lọc từ _MAX_ dòng)"
                    }
                }).buttons().container().appendTo('#example1_wrapper .col-md-6:eq(0)');
            }

            if ($("#example2").length) {
                $("#example2").DataTable({
                    paging: true,
                    lengthChange: false,
                    searching: false,
                    ordering: true,
                    info: true,
                    autoWidth: false,
                    responsive: true,
                    language: {
                        paginate: {
                            first: "Đầu",
                            last: "Cuối",
                            next: "Sau",
                            previous: "Trước"
                        },
                        zeroRecords: "Không có dữ liệu phù hợp",
                        info: "Hiển thị _START_ đến _END_ của _TOTAL_ dòng",
                        infoEmpty: "Không có dữ liệu",
                        infoFiltered: "(lọc từ _MAX_ dòng)"
                    }
                });
            }
        });
    </script>
</body>
</html>