@model MatKinh.ViewModel.AdminOrderIndexVm
@using MatKinh.Models

@{
    ViewBag.Title = "Đơn hàng được giao cho tôi";

    int startPage = Math.Max(1, Model.CurrentPage - 2);
    int endPage = Math.Min(Model.TotalPages, Model.CurrentPage + 2);

    Func<string, string> paymentMethodText = method =>
    {
        if (string.Equals(method, PaymentConstants.VNPAY, StringComparison.OrdinalIgnoreCase))
        {
            return "VNPay";
        }

        if (string.Equals(method, PaymentConstants.COD, StringComparison.OrdinalIgnoreCase))
        {
            return "COD";
        }

        return "Không xác định";
    };

    Func<string, string> paymentStatusText = status =>
    {
        if (string.Equals(status, PaymentConstants.PAID, StringComparison.OrdinalIgnoreCase))
        {
            return "Đã thanh toán";
        }

        if (string.Equals(status, PaymentConstants.FAILED, StringComparison.OrdinalIgnoreCase))
        {
            return "Thất bại";
        }

        if (string.Equals(status, PaymentConstants.REFUNDED, StringComparison.OrdinalIgnoreCase))
        {
            return "Đã hoàn tiền";
        }

        return "Chờ thanh toán";
    };

    Func<string, string> paymentStatusClass = status =>
    {
        if (string.Equals(status, PaymentConstants.PAID, StringComparison.OrdinalIgnoreCase))
        {
            return "success";
        }

        if (string.Equals(status, PaymentConstants.FAILED, StringComparison.OrdinalIgnoreCase))
        {
            return "danger";
        }

        if (string.Equals(status, PaymentConstants.REFUNDED, StringComparison.OrdinalIgnoreCase))
        {
            return "warning";
        }

        return "processing";
    };

    Func<int, string> orderStatusClass = status =>
    {
        switch (status)
        {
            case OrderStatusConstants.ASSIGNED_TO_SHIPPER:
                return "warning";

            case OrderStatusConstants.DELIVERING:
                return "shipping";

            case OrderStatusConstants.DELIVERED:
                return "success";

            case OrderStatusConstants.DELIVERY_FAILED:
                return "danger";

            default:
                return "default";
        }
    };
}

<div class="admin-page-header">
    <div>
        <h1 class="admin-page-title">@Model.HeaderTitle</h1>
        <p class="admin-page-subtitle">
            Theo dõi các đơn hàng được giao cho bạn, cập nhật quá trình giao hàng và xác nhận kết quả giao.
        </p>
    </div>

    <ol class="breadcrumb admin-breadcrumb">
        <li class="breadcrumb-item">
            <a href="@Url.Action("Index", "Dashboard")">Dashboard</a>
        </li>
        <li class="breadcrumb-item active">Đơn được giao</li>
    </ol>
</div>

<section class="content shipper-order-page">
    <div class="container-fluid p-0">

        <div class="card shipper-order-filter-card">
            <div class="card-header border-0">
                <div class="shipper-order-card-heading">
                    <div class="shipper-order-heading-icon">
                        <i class="fas fa-filter"></i>
                    </div>

                    <div>
                        <h3 class="shipper-order-card-title">Bộ lọc đơn giao hàng</h3>
                        <p class="shipper-order-card-subtitle">
                            Có <b>@Model.TotalItems</b> đơn hàng phù hợp với điều kiện hiện tại.
                        </p>
                    </div>
                </div>
            </div>

            <div class="card-body">
                @using (Html.BeginForm("Index", "ShipperOrder", FormMethod.Get, new { @class = "shipper-order-filter-form", autocomplete = "off" }))
                {
                    <input type="hidden" name="page" value="1" />

                    <div class="row">
                        <div class="col-lg-5 col-md-6">
                            <div class="form-group shipper-order-form-group">
                                <label>Tìm kiếm</label>
                                <div class="shipper-order-search-box">
                                    <i class="fas fa-search"></i>
                                    <input type="text"
                                           name="keyword"
                                           value="@Model.Keyword"
                                           class="form-control shipper-order-input"
                                           autocomplete="off"
                                           placeholder="Mã đơn / người nhận / số điện thoại / địa chỉ" />
                                </div>
                            </div>
                        </div>

                        <div class="col-lg-4 col-md-6">
                            <div class="form-group shipper-order-form-group">
                                <label>Trạng thái giao hàng</label>
                                <select name="status" class="form-control shipper-order-input" autocomplete="off">
                                    <option value="">Tất cả trạng thái</option>
                                    @foreach (var item in Model.StatusOptions)
                                    {
                                        <option value="@item.Value" @(item.Selected ? "selected" : "")>
                                            @item.Text
                                        </option>
                                    }
                                </select>
                            </div>
                        </div>

                        <div class="col-lg-3 col-md-12 d-flex align-items-end">
                            <div class="form-group shipper-order-form-group w-100">
                                <button type="submit" class="btn shipper-order-btn shipper-order-btn-save w-100">
                                    <i class="fas fa-search mr-1"></i>
                                    Lọc đơn hàng
                                </button>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="card shipper-order-list-card">
            <div class="card-header border-0">
                <div class="shipper-order-card-heading">
                    <div class="shipper-order-heading-icon">
                        <i class="fas fa-truck"></i>
                    </div>

                    <div>
                        <h3 class="shipper-order-card-title">Danh sách đơn hàng được giao</h3>
                        <p class="shipper-order-card-subtitle">
                            Hiển thị <b>@Model.Orders.Count</b> / <b>@Model.TotalItems</b> đơn.
                        </p>
                    </div>
                </div>
            </div>

            <div class="card-body">
                @if (Model.Orders != null && Model.Orders.Count > 0)
                {
                    <div class="shipper-order-table-wrap">
                        <table class="table shipper-order-table">
                            <thead>
                                <tr>
                                    <th>Mã đơn</th>
                                    <th>Người nhận</th>
                                    <th>Địa chỉ giao</th>
                                    <th class="text-right">Thanh toán</th>
                                    <th>Trạng thái</th>
                                    <th class="text-center">Thao tác</th>
                                </tr>
                            </thead>

                            <tbody>
                                @foreach (var item in Model.Orders)
                                {
                                    string orderClass = orderStatusClass(item.TrangThai);
                                    string payClass = paymentStatusClass(item.TrangThaiThanhToan);

                                    <tr class="@(item.CanRequireManualRefund ? "shipper-order-row-refund" : "")">
                                        <td data-label="Mã đơn">
                                            <div class="shipper-order-code">#@item.MaDonHang</div>
                                            <div class="shipper-order-subtext">@item.SoLuongSanPham sản phẩm</div>
                                            <div class="shipper-order-subtext">@item.NgayDat.ToString("dd/MM/yyyy HH:mm")</div>

                                            @if (item.CanRequireManualRefund)
                                            {
                                                <div class="shipper-refund-warning-mini">
                                                    Cần shop hoàn tiền
                                                </div>
                                            }
                                        </td>

                                        <td data-label="Người nhận">
                                            <div class="shipper-order-customer">
                                                <div class="shipper-order-avatar">
                                                    <i class="fas fa-user"></i>
                                                </div>

                                                <div>
                                                    <div class="shipper-order-name">
                                                        @(string.IsNullOrWhiteSpace(item.HoTenNguoiNhan) ? item.TenKhachHang : item.HoTenNguoiNhan)
                                                    </div>

                                                    <div class="shipper-order-subtext">
                                                        @item.SoDienThoaiNguoiNhan
                                                    </div>
                                                </div>
                                            </div>
                                        </td>

                                        <td data-label="Địa chỉ giao">
                                            <div class="shipper-order-address">
                                                @(string.IsNullOrWhiteSpace(item.DiaChiNhanHang) ? "Chưa có địa chỉ giao hàng." : item.DiaChiNhanHang)
                                            </div>
                                        </td>

                                        <td data-label="Thanh toán" class="text-right">
                                            <div class="shipper-order-price-strong">
                                                @item.TongThanhToan.ToString("N0") đ
                                            </div>

                                            <div class="shipper-payment-meta">
                                                <span class="shipper-payment-method">
                                                    @paymentMethodText(item.PhuongThucThanhToan)
                                                </span>

                                                <span class="shipper-order-status-badge shipper-payment-badge @payClass">
                                                    @paymentStatusText(item.TrangThaiThanhToan)
                                                </span>
                                            </div>
                                        </td>

                                        <td data-label="Trạng thái">
                                            <span class="shipper-order-status-badge @orderClass">
                                                @item.TrangThaiText
                                            </span>
                                        </td>

                                        <td data-label="Thao tác" class="text-center">
                                            <div class="shipper-order-actions">
                                                <a href="@Url.Action("Detail", "ShipperOrder", new { id = item.DonHangId, keyword = Model.Keyword, status = Model.StatusFilter, page = Model.CurrentPage })"
                                                   class="btn shipper-order-action detail">
                                                    <i class="fas fa-eye"></i>
                                                    <span>Chi tiết</span>
                                                </a>

                                                @if (item.TrangThai == OrderStatusConstants.ASSIGNED_TO_SHIPPER)
                                                {
                                                    using (Html.BeginForm("StartDelivery", "ShipperOrder", FormMethod.Post, new { @class = "shipper-order-inline-form" }))
                                                    {
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="id" value="@item.DonHangId" />
                                                        <input type="hidden" name="keyword" value="@Model.Keyword" />
                                                        <input type="hidden" name="status" value="@Model.StatusFilter" />
                                                        <input type="hidden" name="page" value="@Model.CurrentPage" />

                                                        <button type="submit"
                                                                class="btn shipper-order-action start"
                                                                data-confirm-title="Bắt đầu giao hàng?"
                                                                data-confirm="Trạng thái đơn sẽ chuyển sang: Đang giao."
                                                                data-confirm-ok="Bắt đầu">
                                                            <i class="fas fa-route"></i>
                                                            <span>Bắt đầu giao</span>
                                                        </button>
                                                    }
                                                }

                                                @if (item.TrangThai == OrderStatusConstants.DELIVERING)
                                                {
                                                    using (Html.BeginForm("ConfirmDelivered", "ShipperOrder", FormMethod.Post, new { @class = "shipper-order-inline-form" }))
                                                    {
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="id" value="@item.DonHangId" />
                                                        <input type="hidden" name="keyword" value="@Model.Keyword" />
                                                        <input type="hidden" name="status" value="@Model.StatusFilter" />
                                                        <input type="hidden" name="page" value="@Model.CurrentPage" />

                                                        <button type="submit"
                                                                class="btn shipper-order-action delivered"
                                                                data-confirm-title="Xác nhận giao thành công?"
                                                                data-confirm="Đơn hàng sẽ chuyển sang giao thành công. Nếu là COD, trạng thái thanh toán sẽ được cập nhật đã thanh toán."
                                                                data-confirm-ok="Giao thành công">
                                                            <i class="fas fa-check"></i>
                                                            <span>Thành công</span>
                                                        </button>
                                                    }

                                                    using (Html.BeginForm("ConfirmDeliveryFailed", "ShipperOrder", FormMethod.Post, new { @class = "shipper-order-inline-form" }))
                                                    {
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="id" value="@item.DonHangId" />
                                                        <input type="hidden" name="keyword" value="@Model.Keyword" />
                                                        <input type="hidden" name="status" value="@Model.StatusFilter" />
                                                        <input type="hidden" name="page" value="@Model.CurrentPage" />

                                                        <button type="submit"
                                                                class="btn shipper-order-action failed"
                                                                data-confirm-title="Xác nhận giao thất bại?"
                                                                data-confirm="Đơn hàng sẽ chuyển sang giao thất bại và hệ thống hoàn lại tồn kho."
                                                                data-confirm-ok="Giao thất bại">
                                                            <i class="fas fa-times"></i>
                                                            <span>Thất bại</span>
                                                        </button>
                                                    }
                                                }

                                                @if (item.TrangThai == OrderStatusConstants.DELIVERED ||
                                                     item.TrangThai == OrderStatusConstants.DELIVERY_FAILED)
                                                {
                                                    <span class="shipper-order-locked">
                                                        <i class="fas fa-lock"></i>
                                                        Hoàn tất
                                                    </span>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>

                            <tfoot>
                                <tr>
                                    <th>Mã đơn</th>
                                    <th>Người nhận</th>
                                    <th>Địa chỉ giao</th>
                                    <th class="text-right">Thanh toán</th>
                                    <th>Trạng thái</th>
                                    <th class="text-center">Thao tác</th>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                }
                else
                {
                    <div class="shipper-order-empty">
                        <div class="shipper-order-empty-icon">
                            <i class="fas fa-truck"></i>
                        </div>
                        <h3>Chưa có đơn hàng được giao</h3>
                        <p>Hiện tại chưa có đơn hàng nào được giao cho bạn hoặc không có dữ liệu phù hợp với bộ lọc.</p>
                    </div>
                }

                @if (Model.TotalPages > 1)
                {
                    <div class="shipper-order-pagination">
                        <div class="shipper-order-pagination-info">
                            Trang @Model.CurrentPage / @Model.TotalPages —
                            hiển thị @Model.Orders.Count trên tổng @Model.TotalItems đơn hàng
                        </div>

                        <div class="shipper-order-pagination-links">
                            <a class="shipper-order-page-link @(Model.HasPreviousPage ? "" : "disabled")"
                               href="@(Model.HasPreviousPage ? Url.Action("Index", new { keyword = Model.Keyword, status = Model.StatusFilter, page = Model.CurrentPage - 1 }) : "javascript:void(0)")">
                                <i class="fas fa-chevron-left"></i>
                            </a>

                            @if (startPage > 1)
                            {
                                <a class="shipper-order-page-link"
                                   href="@Url.Action("Index", new { keyword = Model.Keyword, status = Model.StatusFilter, page = 1 })">
                                    1
                                </a>

                                if (startPage > 2)
                                {
                                    <span class="shipper-order-page-dots">...</span>
                                }
                            }

                            @for (int i = startPage; i <= endPage; i++)
                            {
                                <a class="shipper-order-page-link @(i == Model.CurrentPage ? "active" : "")"
                                   href="@Url.Action("Index", new { keyword = Model.Keyword, status = Model.StatusFilter, page = i })">
                                    @i
                                </a>
                            }

                            @if (endPage < Model.TotalPages)
                            {
                                if (endPage < Model.TotalPages - 1)
                                {
                                    <span class="shipper-order-page-dots">...</span>
                                }

                                <a class="shipper-order-page-link"
                                   href="@Url.Action("Index", new { keyword = Model.Keyword, status = Model.StatusFilter, page = Model.TotalPages })">
                                    @Model.TotalPages
                                </a>
                            }

                            <a class="shipper-order-page-link @(Model.HasNextPage ? "" : "disabled")"
                               href="@(Model.HasNextPage ? Url.Action("Index", new { keyword = Model.Keyword, status = Model.StatusFilter, page = Model.CurrentPage + 1 }) : "javascript:void(0)")">
                                <i class="fas fa-chevron-right"></i>
                            </a>
                        </div>
                    </div>
                }
            </div>
        </div>

    </div>
</section>