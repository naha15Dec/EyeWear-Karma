
@model MatKinh.ViewModel.ShipperReturnRequestIndexVm
@using MatKinh.Models

@{
    ViewBag.Title = "Hàng trả cần lấy";

    int startPage = Math.Max(1, Model.CurrentPage - 2);
    int endPage = Math.Min(Model.TotalPages, Model.CurrentPage + 2);

    Func<int, string> returnStatusClass = status =>
    {
        switch (status)
        {
            case ReturnRequestStatusConstants.ASSIGNED_TO_SHIPPER:
                return "warning";

            case ReturnRequestStatusConstants.PICKING_UP:
                return "processing";

            case ReturnRequestStatusConstants.PICKED_UP:
                return "info";

            case ReturnRequestStatusConstants.HANDED_OVER:
                return "success";

            default:
                return "default";
        }
    };
}

<div class="admin-page-header">
    <div>
        <h1 class="admin-page-title">Hàng trả cần lấy</h1>
        <p class="admin-page-subtitle">
            Danh sách yêu cầu trả hàng đã được admin giao cho bạn. Cập nhật đúng tiến trình lấy hàng và bàn giao về cửa hàng.
        </p>
    </div>

    <ol class="breadcrumb admin-breadcrumb">
        <li class="breadcrumb-item">
            <a href="@Url.Action("Index", "Dashboard")">Dashboard</a>
        </li>
        <li class="breadcrumb-item active">Hàng trả cần lấy</li>
    </ol>
</div>

<section class="content shipper-return-page">
    <div class="container-fluid p-0">

        <div class="shipper-return-kpi-grid">
            <div class="shipper-return-kpi-card warning">
                <span>Đã giao cho bạn</span>
                <strong>@Model.AssignedCount</strong>
            </div>

            <div class="shipper-return-kpi-card processing">
                <span>Đang lấy hàng</span>
                <strong>@Model.PickingUpCount</strong>
            </div>

            <div class="shipper-return-kpi-card info">
                <span>Đã lấy từ khách</span>
                <strong>@Model.PickedUpCount</strong>
            </div>

            <div class="shipper-return-kpi-card success">
                <span>Đã bàn giao</span>
                <strong>@Model.HandedOverCount</strong>
            </div>
        </div>

        <div class="card shipper-return-filter-card">
            <div class="card-header border-0">
                <div class="shipper-return-card-heading">
                    <div class="shipper-return-heading-icon">
                        <i class="fas fa-filter"></i>
                    </div>

                    <div>
                        <h3 class="shipper-return-card-title">Bộ lọc hàng trả</h3>
                        <p class="shipper-return-card-subtitle">
                            Có <b>@Model.TotalItems</b> yêu cầu phù hợp với điều kiện hiện tại.
                        </p>
                    </div>
                </div>
            </div>

            <div class="card-body">
                @using (Html.BeginForm("Index", "ShipperReturnRequest", FormMethod.Get, new { @class = "shipper-return-filter-form", autocomplete = "off" }))
                {
                    <input type="hidden" name="page" value="1" />

                    <div class="row">
                        <div class="col-lg-6 col-md-6">
                            <div class="form-group shipper-return-form-group">
                                <label>Tìm kiếm</label>
                                <div class="shipper-return-search-box">
                                    <i class="fas fa-search"></i>
                                    <input type="text"
                                           name="keyword"
                                           value="@Model.Keyword"
                                           class="form-control shipper-return-input"
                                           placeholder="Mã yêu cầu / mã đơn / khách hàng / địa chỉ / số điện thoại"
                                           autocomplete="off" />
                                </div>
                            </div>
                        </div>

                        <div class="col-lg-3 col-md-6">
                            <div class="form-group shipper-return-form-group">
                                <label>Trạng thái</label>
                                <select name="status" class="form-control shipper-return-input">
                                    <option value="">Tất cả trạng thái</option>
                                    <option value="@ReturnRequestStatusConstants.ASSIGNED_TO_SHIPPER" @(Model.Status == ReturnRequestStatusConstants.ASSIGNED_TO_SHIPPER ? "selected" : "")>Đã giao shipper</option>
                                    <option value="@ReturnRequestStatusConstants.PICKING_UP" @(Model.Status == ReturnRequestStatusConstants.PICKING_UP ? "selected" : "")>Shipper đang lấy hàng</option>
                                    <option value="@ReturnRequestStatusConstants.PICKED_UP" @(Model.Status == ReturnRequestStatusConstants.PICKED_UP ? "selected" : "")>Shipper đã lấy hàng</option>
                                    <option value="@ReturnRequestStatusConstants.HANDED_OVER" @(Model.Status == ReturnRequestStatusConstants.HANDED_OVER ? "selected" : "")>Đã bàn giao về cửa hàng</option>
                                </select>
                            </div>
                        </div>

                        <div class="col-lg-3 col-md-12 d-flex align-items-end">
                            <div class="form-group shipper-return-form-group w-100">
                                <button type="submit" class="btn shipper-return-btn shipper-return-btn-save w-100">
                                    <i class="fas fa-search mr-1"></i>
                                    Lọc yêu cầu
                                </button>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="card shipper-return-list-card">
            <div class="card-header border-0">
                <div class="shipper-return-card-heading">
                    <div class="shipper-return-heading-icon">
                        <i class="fas fa-truck-loading"></i>
                    </div>

                    <div>
                        <h3 class="shipper-return-card-title">Danh sách hàng trả được giao</h3>
                        <p class="shipper-return-card-subtitle">
                            Hiển thị <b>@Model.Requests.Count</b> / <b>@Model.TotalItems</b> yêu cầu.
                        </p>
                    </div>
                </div>
            </div>

            <div class="card-body">
                @if (Model.Requests != null && Model.Requests.Count > 0)
                {
                    <div class="shipper-return-table-wrap">
                        <table class="table shipper-return-table">
                            <thead>
                                <tr>
                                    <th>Yêu cầu</th>
                                    <th>Khách hàng</th>
                                    <th>Địa chỉ lấy hàng</th>
                                    <th>Sản phẩm cần lấy</th>
                                    <th>Trạng thái</th>
                                    <th class="text-center">Thao tác</th>
                                </tr>
                            </thead>

                            <tbody>
                                @foreach (var item in Model.Requests)
                                {
                                    string statusClass = returnStatusClass(item.TrangThai);

                                    <tr>
                                        <td data-label="Yêu cầu">
                                            <div class="shipper-return-code">#@item.MaYeuCau</div>
                                            <div class="shipper-return-subtext">Đơn: #@item.MaDonHang</div>

                                            @if (item.NgayGanShipper.HasValue)
                                            {
                                                <div class="shipper-return-subtext">
                                                    Giao lúc: @item.NgayGanShipper.Value.ToString("dd/MM/yyyy HH:mm")
                                                </div>
                                            }
                                        </td>

                                        <td data-label="Khách hàng">
                                            <div class="shipper-return-customer">
                                                <div class="shipper-return-avatar">
                                                    <i class="fas fa-user"></i>
                                                </div>

                                                <div>
                                                    <div class="shipper-return-name">@item.TenKhachHang</div>
                                                    <div class="shipper-return-subtext">@item.SoDienThoaiKhachHang</div>
                                                    <div class="shipper-return-subtext">@item.EmailKhachHang</div>
                                                </div>
                                            </div>
                                        </td>

                                        <td data-label="Địa chỉ lấy hàng">
                                            <div class="shipper-return-address">
                                                <strong>@(string.IsNullOrWhiteSpace(item.HoTenNguoiNhan) ? item.TenKhachHang : item.HoTenNguoiNhan)</strong>
                                                <span>@(string.IsNullOrWhiteSpace(item.SoDienThoaiNguoiNhan) ? item.SoDienThoaiKhachHang : item.SoDienThoaiNguoiNhan)</span>
                                                <p>@(string.IsNullOrWhiteSpace(item.DiaChiNhanHang) ? "Chưa có địa chỉ lấy hàng." : item.DiaChiNhanHang)</p>
                                            </div>
                                        </td>

                                        <td data-label="Sản phẩm cần lấy">
                                            <div class="shipper-return-product-summary">
                                                @item.ProductSummary
                                            </div>

                                            <div class="shipper-return-subtext">
                                                @item.TotalProductLines dòng sản phẩm · @item.TotalReturnQuantity sản phẩm
                                            </div>

                                            <div class="shipper-return-reason">
                                                Lý do: @item.LyDo
                                            </div>
                                        </td>

                                        <td data-label="Trạng thái">
                                            <span class="shipper-return-status-badge @statusClass">
                                                @ReturnRequestStatusConstants.GetName(item.TrangThai)
                                            </span>

                                            @if (!string.IsNullOrWhiteSpace(item.GhiChuShipper))
                                            {
                                                <div class="shipper-return-note">
                                                    @item.GhiChuShipper
                                                </div>
                                            }
                                        </td>

                                        <td data-label="Thao tác" class="text-center">
                                            <div class="shipper-return-actions">

                                                @if (item.CanStartPickup)
                                                {
                                                    using (Html.BeginForm("StartPickup", "ShipperReturnRequest", FormMethod.Post, new { @class = "shipper-return-inline-form" }))
                                                    {
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="id" value="@item.YeuCauTraHangId" />
                                                        <input type="hidden" name="keyword" value="@Model.Keyword" />
                                                        <input type="hidden" name="status" value="@Model.Status" />
                                                        <input type="hidden" name="page" value="@Model.CurrentPage" />

                                                        <button type="submit"
                                                                class="btn shipper-return-action start"
                                                                data-confirm-title="Bắt đầu lấy hàng?"
                                                                data-confirm="Trạng thái sẽ chuyển sang: Shipper đang lấy hàng."
                                                                data-confirm-ok="Bắt đầu">
                                                            <i class="fas fa-route"></i>
                                                            <span>Bắt đầu lấy</span>
                                                        </button>
                                                    }
                                                }

                                                @if (item.CanConfirmPickedUp)
                                                {
                                                    using (Html.BeginForm("ConfirmPickedUp", "ShipperReturnRequest", FormMethod.Post, new { @class = "shipper-return-inline-form" }))
                                                    {
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="id" value="@item.YeuCauTraHangId" />
                                                        <input type="hidden" name="keyword" value="@Model.Keyword" />
                                                        <input type="hidden" name="status" value="@Model.Status" />
                                                        <input type="hidden" name="page" value="@Model.CurrentPage" />

                                                        <button type="submit"
                                                                class="btn shipper-return-action picked"
                                                                data-confirm-title="Xác nhận đã lấy hàng?"
                                                                data-confirm="Bạn xác nhận đã lấy hàng trả từ khách."
                                                                data-confirm-ok="Đã lấy">
                                                            <i class="fas fa-box"></i>
                                                            <span>Đã lấy hàng</span>
                                                        </button>
                                                    }
                                                }

                                                @if (item.CanHandOver)
                                                {
                                                    using (Html.BeginForm("HandOverToStore", "ShipperReturnRequest", FormMethod.Post, new { @class = "shipper-return-inline-form" }))
                                                    {
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="id" value="@item.YeuCauTraHangId" />
                                                        <input type="hidden" name="keyword" value="@Model.Keyword" />
                                                        <input type="hidden" name="status" value="@Model.Status" />
                                                        <input type="hidden" name="page" value="@Model.CurrentPage" />

                                                        <button type="submit"
                                                                class="btn shipper-return-action handover"
                                                                data-confirm-title="Bàn giao về cửa hàng?"
                                                                data-confirm="Sau bước này admin sẽ kiểm tra và xác nhận nhận hàng trả."
                                                                data-confirm-ok="Bàn giao">
                                                            <i class="fas fa-store"></i>
                                                            <span>Bàn giao shop</span>
                                                        </button>
                                                    }
                                                }

                                                @if (!item.CanStartPickup && !item.CanConfirmPickedUp && !item.CanHandOver)
                                                {
                                                    <span class="shipper-return-locked">
                                                        <i class="fas fa-lock"></i>
                                                        Chờ admin xử lý
                                                    </span>
                                                }

                                                <a href="@Url.Action("Detail", "ShipperReturnRequest", new { id = item.YeuCauTraHangId, keyword = Model.Keyword, status = Model.Status, page = Model.CurrentPage })"
                                                   class="btn shipper-return-action detail">
                                                    <i class="fas fa-eye"></i>
                                                    <span>Chi tiết</span>
                                                </a>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>

                            <tfoot>
                                <tr>
                                    <th>Yêu cầu</th>
                                    <th>Khách hàng</th>
                                    <th>Địa chỉ lấy hàng</th>
                                    <th>Sản phẩm cần lấy</th>
                                    <th>Trạng thái</th>
                                    <th class="text-center">Thao tác</th>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                }
                else
                {
                    <div class="shipper-return-empty">
                        <div class="shipper-return-empty-icon">
                            <i class="fas fa-truck"></i>
                        </div>
                        <h3>Chưa có hàng trả cần lấy</h3>
                        <p>Hiện tại chưa có yêu cầu trả hàng nào được giao cho bạn hoặc không có dữ liệu phù hợp với bộ lọc.</p>
                    </div>
                }

                @if (Model.TotalPages > 1)
                {
                    <div class="shipper-return-pagination">
                        <div class="shipper-return-pagination-info">
                            Trang @Model.CurrentPage / @Model.TotalPages —
                            hiển thị @Model.Requests.Count trên tổng @Model.TotalItems yêu cầu
                        </div>

                        <div class="shipper-return-pagination-links">
                            <a class="shipper-return-page-link @(Model.HasPreviousPage ? "" : "disabled")"
                               href="@(Model.HasPreviousPage ? Url.Action("Index", new { keyword = Model.Keyword, status = Model.Status, page = Model.CurrentPage - 1 }) : "javascript:void(0)")">
                                <i class="fas fa-chevron-left"></i>
                            </a>

                            @if (startPage > 1)
                            {
                                <a class="shipper-return-page-link"
                                   href="@Url.Action("Index", new { keyword = Model.Keyword, status = Model.Status, page = 1 })">
                                    1
                                </a>

                                if (startPage > 2)
                                {
                                    <span class="shipper-return-page-dots">...</span>
                                }
                            }

                            @for (int i = startPage; i <= endPage; i++)
                            {
                                <a class="shipper-return-page-link @(i == Model.CurrentPage ? "active" : "")"
                                   href="@Url.Action("Index", new { keyword = Model.Keyword, status = Model.Status, page = i })">
                                    @i
                                </a>
                            }

                            @if (endPage < Model.TotalPages)
                            {
                                if (endPage < Model.TotalPages - 1)
                                {
                                    <span class="shipper-return-page-dots">...</span>
                                }

                                <a class="shipper-return-page-link"
                                   href="@Url.Action("Index", new { keyword = Model.Keyword, status = Model.Status, page = Model.TotalPages })">
                                    @Model.TotalPages
                                </a>
                            }

                            <a class="shipper-return-page-link @(Model.HasNextPage ? "" : "disabled")"
                               href="@(Model.HasNextPage ? Url.Action("Index", new { keyword = Model.Keyword, status = Model.Status, page = Model.CurrentPage + 1 }) : "javascript:void(0)")">
                                <i class="fas fa-chevron-right"></i>
                            </a>
                        </div>
                    </div>
                }
            </div>
        </div>

    </div>
</section>