@model MatKinh.ViewModel.Login

@{
    ViewBag.Title = "Đăng nhập";
}

<section class="auth-page">
    <section class="optical-breadcrumb">
        <div class="container">
            <div class="optical-breadcrumb__inner">
                <span class="optical-breadcrumb__eyebrow">Karma Eyewear Account</span>
                <h1>Đăng nhập tài khoản</h1>
                <nav aria-label="breadcrumb">
                    <a href="@Url.Action("Index", "Home")">Trang chủ</a>
                    <span>/</span>
                    <span>Đăng nhập</span>
                </nav>
            </div>
        </div>
    </section>

    <section class="auth-section">
        <div class="container">
            <div class="auth-shell">
                <div class="row no-gutters align-items-stretch">
                    <div class="col-lg-6 order-1 order-lg-2">
                        <div class="auth-form-wrap">
                            <div class="auth-form-head">
                                <span class="auth-form-head__eyebrow">Member access</span>
                                <h2>Đăng nhập</h2>
                                <p>Tiếp tục mua sắm, theo dõi đơn hàng và lưu lại những mẫu kính bạn yêu thích.</p>
                            </div>

                            @using (Html.BeginForm("LoginAccount", "Account", FormMethod.Post, new { @class = "auth-form", autocomplete = "off" }))
                            {
                                @Html.AntiForgeryToken()

                                <div class="auth-summary-box">
                                    @Html.ValidationSummary(true, "", new { @class = "auth-validation-summary" })
                                </div>

                                <div class="auth-form-group">
                                    <label class="auth-label" for="Username">Tên đăng nhập</label>
                                    @Html.TextBoxFor(m => m.Username, new
                                    {
                                        @class = "auth-input",
                                        placeholder = "Nhập tên đăng nhập",
                                        autocomplete = "off",
                                        id = "Username"
                                    })
                                    @Html.ValidationMessageFor(m => m.Username, "", new { @class = "auth-field-error" })
                                </div>

                                <div class="auth-form-group">
                                    <label class="auth-label" for="Password">Mật khẩu</label>
                                    @Html.PasswordFor(m => m.Password, new
                                    {
                                        @class = "auth-input",
                                        placeholder = "Nhập mật khẩu",
                                        autocomplete = "current-password",
                                        id = "Password"
                                    })
                                    @Html.ValidationMessageFor(m => m.Password, "", new { @class = "auth-field-error" })
                                </div>

                                <div class="auth-meta-row">
                                    <label class="auth-checkbox" for="RememberMe">
                                        @Html.CheckBoxFor(m => m.RememberMe, new { id = "RememberMe" })
                                        <span>Ghi nhớ đăng nhập</span>
                                    </label>

                                    <a href="javascript:void(0);"
                                       class="auth-forgot-link"
                                       data-toggle="modal"
                                       data-target="#customModal">
                                        Quên mật khẩu?
                                    </a>
                                </div>

                                <div class="auth-form-actions">
                                    <button type="submit" class="optical-btn optical-btn--dark auth-submit-btn">
                                        Đăng nhập
                                    </button>
                                </div>
                            }

                            <div class="auth-bottom-note">
                                Chưa có tài khoản?
                                <a href="@Url.Action("RegisterAccount", "Account")">Đăng ký ngay</a>
                            </div>
                        </div>
                    </div>

                    <div class="col-lg-6 order-2 order-lg-1">
                        <div class="auth-showcase">
                            <div class="auth-showcase__image">
                                <img src="@Url.Content("~/Asset/img/login.jpg")" alt="Karma Eyewear Login" />
                            </div>

                            <div class="auth-showcase__overlay"></div>

                            <div class="auth-showcase__content">
                                <span class="auth-showcase__eyebrow">New here?</span>
                                <h2>Chào mừng đến với Karma Eyewear</h2>
                                <p>
                                    Tạo tài khoản để theo dõi đơn hàng, lưu mẫu kính yêu thích
                                    và nhận gợi ý phù hợp với phong cách của bạn.
                                </p>
                                <a class="optical-btn optical-btn--light auth-showcase__btn"
                                   href="@Url.Action("RegisterAccount", "Account")">
                                    Tạo tài khoản
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</section>

<div class="modal fade" id="customModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog custom-modal-dialog modal-dialog-centered">
        <div class="modal-content auth-modal-content">
            <div class="modal-header auth-modal-header">
                <h5 class="modal-title">Hỗ trợ quên mật khẩu</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Đóng">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>

            <div class="modal-body auth-modal-body">
                <p>
                    Bạn hãy liên hệ qua thông tin bên dưới để được hỗ trợ cấp lại mật khẩu:
                </p>

                <div class="auth-support-list">
                    <a href="tel:0389998889">
                        <i class="fa fa-phone mr-2"></i>0389.998.889
                    </a>
                    <a href="mailto:contact@karmaeyewear.local">
                        <i class="fa fa-envelope mr-2"></i>contact@karmaeyewear.local
                    </a>
                </div>
            </div>

            <div class="modal-footer auth-modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Đóng</button>
            </div>
        </div>
    </div>
</div>