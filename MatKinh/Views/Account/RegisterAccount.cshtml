@model MatKinh.ViewModel.Register

@{
    ViewBag.Title = "Đăng ký";

    string authImage = Url.Content("~/Asset/img/login.jpg");
    string fallbackImage = Url.Content("~/Asset/img/banner/gong-kinh-cat-icon.png");
}

<section class="auth-page">
    <section class="optical-breadcrumb auth-breadcrumb">
        <div class="container">
            <div class="optical-breadcrumb__inner">
                <span class="optical-breadcrumb__eyebrow">Karma Eyewear Account</span>
                <h1>Tạo tài khoản mới</h1>
                <p class="auth-breadcrumb__desc">
                    Tạo tài khoản để lưu giỏ hàng, thanh toán nhanh hơn và theo dõi lịch sử đơn hàng của bạn.
                </p>
                <nav>
                    <a href="@Url.Action("Index","Home")">Trang chủ</a>
                    <span>/</span>
                    <span>Đăng ký</span>
                </nav>
            </div>
        </div>
    </section>

    <section class="auth-section">
        <div class="container">
            <div class="auth-shell auth-shell--register">
                <div class="row no-gutters align-items-stretch">
                    <div class="col-lg-5">
                        <div class="auth-showcase auth-showcase--register">
                            <div class="auth-showcase__image">
                                <img src="@authImage"
                                     alt="Đăng ký tài khoản"
                                     onerror="this.onerror=null;this.src='@fallbackImage';" />
                            </div>

                            <div class="auth-showcase__overlay"></div>

                            <div class="auth-showcase__content">
                                <span class="auth-showcase__eyebrow">Already a member?</span>
                                <h2>Đã có tài khoản?</h2>
                                <p>
                                    Đăng nhập để tiếp tục mua sắm, theo dõi đơn hàng và nhận những gợi ý
                                    mắt kính phù hợp với phong cách của bạn.
                                </p>

                                <a class="optical-btn optical-btn--light auth-showcase__btn"
                                   href="@Url.Action("LoginAccount","Account")">
                                    Đăng nhập ngay
                                </a>
                            </div>
                        </div>
                    </div>

                    <div class="col-lg-7">
                        <div class="auth-form-wrap auth-form-wrap--register">
                            <div class="auth-form-head">
                                <span class="auth-form-head__eyebrow">Create account</span>
                                <h2>Đăng ký</h2>
                                <p>
                                    Điền thông tin bên dưới để tạo tài khoản khách hàng tại Karma Eyewear.
                                </p>
                            </div>

                            @using (Html.BeginForm("RegisterAccount", "Account", FormMethod.Post, new { @class = "auth-form auth-form--register", id = "registerForm", autocomplete = "off" }))
                            {
                                @Html.AntiForgeryToken()

                                <div class="auth-summary-box">
                                    @Html.ValidationSummary(true, "", new { @class = "auth-validation-summary" })
                                    <div id="ajaxMessage" class="auth-ajax-message"></div>
                                </div>

                                <div class="auth-form-section">
                                    <div class="auth-form-section__title">
                                        <span>01</span>
                                        <h3>Thông tin đăng nhập</h3>
                                    </div>

                                    <div class="auth-grid-2">
                                        <div class="auth-form-group auth-grid-full">
                                            <label class="auth-label">Tên đăng nhập</label>
                                            <div class="auth-input-wrap">
                                                <span class="auth-input-icon">
                                                    <i class="fa fa-user"></i>
                                                </span>
                                                @Html.TextBoxFor(m => m.Username, new
                                                {
                                                    @class = "auth-input auth-input--with-icon",
                                                    placeholder = "Ví dụ: karma_user01",
                                                    autocomplete = "off"
                                                })
                                            </div>
                                            @Html.ValidationMessageFor(m => m.Username, "", new { @class = "auth-field-error" })
                                        </div>

                                        <div class="auth-form-group">
                                            <label class="auth-label">Mật khẩu</label>
                                            <div class="auth-input-wrap">
                                                <span class="auth-input-icon">
                                                    <i class="fa fa-lock"></i>
                                                </span>
                                                @Html.PasswordFor(m => m.Password, new
                                                {
                                                    @class = "auth-input auth-input--with-icon",
                                                    placeholder = "Nhập mật khẩu",
                                                    autocomplete = "off"
                                                })
                                            </div>
                                            <div class="auth-help-text">Tối thiểu 8 ký tự, nên gồm chữ và số.</div>
                                            @Html.ValidationMessageFor(m => m.Password, "", new { @class = "auth-field-error" })
                                        </div>

                                        <div class="auth-form-group">
                                            <label class="auth-label">Nhập lại mật khẩu</label>
                                            <div class="auth-input-wrap">
                                                <span class="auth-input-icon">
                                                    <i class="fa fa-shield"></i>
                                                </span>
                                                @Html.PasswordFor(m => m.ConfirmPassword, new
                                                {
                                                    @class = "auth-input auth-input--with-icon",
                                                    placeholder = "Nhập lại mật khẩu",
                                                    autocomplete = "off"
                                                })
                                            </div>
                                            @Html.ValidationMessageFor(m => m.ConfirmPassword, "", new { @class = "auth-field-error" })
                                        </div>
                                    </div>
                                </div>

                                <div class="auth-form-section">
                                    <div class="auth-form-section__title">
                                        <span>02</span>
                                        <h3>Thông tin cá nhân</h3>
                                    </div>

                                    <div class="auth-grid-2">
                                        <div class="auth-form-group">
                                            <label class="auth-label">Họ</label>
                                            <div class="auth-input-wrap">
                                                <span class="auth-input-icon">
                                                    <i class="fa fa-id-card-o"></i>
                                                </span>
                                                @Html.TextBoxFor(m => m.LastName, new
                                                {
                                                    @class = "auth-input auth-input--with-icon",
                                                    placeholder = "Nhập họ",
                                                    autocomplete = "off"
                                                })
                                            </div>
                                            @Html.ValidationMessageFor(m => m.LastName, "", new { @class = "auth-field-error" })
                                        </div>

                                        <div class="auth-form-group">
                                            <label class="auth-label">Tên</label>
                                            <div class="auth-input-wrap">
                                                <span class="auth-input-icon">
                                                    <i class="fa fa-id-card-o"></i>
                                                </span>
                                                @Html.TextBoxFor(m => m.FirstName, new
                                                {
                                                    @class = "auth-input auth-input--with-icon",
                                                    placeholder = "Nhập tên",
                                                    autocomplete = "off"
                                                })
                                            </div>
                                            @Html.ValidationMessageFor(m => m.FirstName, "", new { @class = "auth-field-error" })
                                        </div>

                                        <div class="auth-form-group">
                                            <label class="auth-label">Số điện thoại</label>
                                            <div class="auth-input-wrap">
                                                <span class="auth-input-icon">
                                                    <i class="fa fa-phone"></i>
                                                </span>
                                                @Html.TextBoxFor(m => m.Mobile, new
                                                {
                                                    @class = "auth-input auth-input--with-icon",
                                                    placeholder = "Ví dụ: 0901234567",
                                                    type = "tel",
                                                    autocomplete = "off"
                                                })
                                            </div>
                                            @Html.ValidationMessageFor(m => m.Mobile, "", new { @class = "auth-field-error" })
                                        </div>

                                        <div class="auth-form-group">
                                            <label class="auth-label">Email</label>
                                            <div class="auth-input-wrap">
                                                <span class="auth-input-icon">
                                                    <i class="fa fa-envelope"></i>
                                                </span>
                                                @Html.TextBoxFor(m => m.Email, new
                                                {
                                                    @class = "auth-input auth-input--with-icon",
                                                    placeholder = "Nhập email",
                                                    type = "email",
                                                    autocomplete = "off"
                                                })
                                            </div>
                                            @Html.ValidationMessageFor(m => m.Email, "", new { @class = "auth-field-error" })
                                        </div>

                                        <div class="auth-form-group">
                                            <label class="auth-label">Ngày sinh</label>
                                            <div class="auth-input-wrap">
                                                <span class="auth-input-icon">
                                                    <i class="fa fa-calendar"></i>
                                                </span>
                                                @Html.TextBoxFor(m => m.DateOfBirth, "{0:yyyy-MM-dd}", new
                                                {
                                                    @class = "auth-input auth-input--with-icon",
                                                    type = "date",
                                                    autocomplete = "off"
                                                })
                                            </div>
                                            @Html.ValidationMessageFor(m => m.DateOfBirth, "", new { @class = "auth-field-error" })
                                        </div>

                                        <div class="auth-form-group">
                                            <label class="auth-label">Giới tính</label>
                                            @{
                                                var sexList = new[]
                                                {
                                                    new { Value = "", Text = "Chọn giới tính" },
                                                    new { Value = "Nam", Text = "Nam" },
                                                    new { Value = "Nữ", Text = "Nữ" }
                                                };
                                            }

                                            <div class="auth-input-wrap">
                                                <span class="auth-input-icon">
                                                    <i class="fa fa-venus-mars"></i>
                                                </span>
                                                @Html.DropDownListFor(
                                                    m => m.Sex,
                                                    new SelectList(sexList, "Value", "Text"),
                                                    new { @class = "auth-input auth-input--with-icon auth-select" })
                                            </div>
                                            @Html.ValidationMessageFor(m => m.Sex, "", new { @class = "auth-field-error" })
                                        </div>
                                    </div>
                                </div>

                                <div class="auth-form-section">
                                    <div class="auth-form-section__title">
                                        <span>03</span>
                                        <h3>Thông tin giao hàng</h3>
                                    </div>

                                    <div class="auth-grid-2">
                                        <div class="auth-form-group auth-grid-full">
                                            <label class="auth-label">Địa chỉ giao hàng</label>
                                            <div class="auth-input-wrap">
                                                <span class="auth-input-icon">
                                                    <i class="fa fa-map-marker"></i>
                                                </span>
                                                @Html.TextBoxFor(m => m.Address, new
                                                {
                                                    @class = "auth-input auth-input--with-icon",
                                                    placeholder = "Nhập địa chỉ giao hàng",
                                                    autocomplete = "off"
                                                })
                                            </div>
                                            @Html.ValidationMessageFor(m => m.Address, "", new { @class = "auth-field-error" })
                                        </div>
                                    </div>
                                </div>

                                <div class="auth-form-row auth-form-row--register">
                                    <button type="submit" class="optical-btn optical-btn--dark auth-submit-btn" id="btnRegister">
                                        Đăng ký tài khoản
                                    </button>
                                </div>

                                <div class="auth-bottom-note">
                                    Đã có tài khoản?
                                    <a href="@Url.Action("LoginAccount","Account")">Đăng nhập ngay</a>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</section>

@section Scripts {
    <script>
        $(function () {
            $("#registerForm").on("submit", function (e) {
                e.preventDefault();

                var form = $(this);

                if (form.valid && !form.valid()) {
                    return;
                }

                clearFieldErrors();

                $("#btnRegister").prop("disabled", true).text("Đang xử lý...");
                $("#ajaxMessage").empty();

                $.ajax({
                    url: form.attr("action"),
                    type: "POST",
                    data: form.serialize(),
                    success: function (resp) {
                        if (resp && resp.success) {
                            window.location.href = resp.redirectUrl;
                        } else {
                            showErrors(resp);
                        }
                    },
                    error: function () {
                        $("#ajaxMessage").text("Có lỗi xảy ra, vui lòng thử lại!");
                    },
                    complete: function () {
                        $("#btnRegister").prop("disabled", false).text("Đăng ký tài khoản");
                    }
                });
            });

            function clearFieldErrors() {
                $("span[data-valmsg-for]").text("");
                $("#ajaxMessage").empty();
            }

            function showErrors(resp) {
                clearFieldErrors();

                if (!resp) {
                    $("#ajaxMessage").text("Đăng ký thất bại, vui lòng kiểm tra lại thông tin.");
                    return;
                }

                if (resp.globalErrors && resp.globalErrors.length > 0) {
                    $("#ajaxMessage").html(resp.globalErrors.join("<br/>"));
                }

                if (resp.fieldErrors) {
                    for (var key in resp.fieldErrors) {
                        if (!resp.fieldErrors.hasOwnProperty(key)) continue;

                        var msg = resp.fieldErrors[key];
                        var span = $("span[data-valmsg-for='" + key + "']");
                        if (span.length) {
                            span.text(msg);
                        }
                    }
                }

                if (resp.errors && resp.errors.length > 0) {
                    var globalMessages = [];

                    for (var i = 0; i < resp.errors.length; i++) {
                        var item = resp.errors[i];
                        var key = item.key || "";
                        var messages = item.messages || [];

                        if (key) {
                            var spanByKey = $("span[data-valmsg-for='" + key + "']");
                            if (spanByKey.length && messages.length > 0) {
                                spanByKey.text(messages[0]);
                            } else {
                                globalMessages = globalMessages.concat(messages);
                            }
                        } else {
                            globalMessages = globalMessages.concat(messages);
                        }
                    }

                    if (globalMessages.length > 0) {
                        $("#ajaxMessage").html(globalMessages.join("<br/>"));
                    }
                }
            }
        });
    </script>
}