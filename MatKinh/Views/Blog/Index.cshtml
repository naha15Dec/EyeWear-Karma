@using MatKinh.Models
@using System.Globalization
@using System.Collections.Generic
@using System.Linq

@{
    ViewBag.Title = "Xu hướng & Blog";

    List<BaiViet> blogs =
    ViewData["listPost"] as List<BaiViet>
    ?? new List<BaiViet>();

    List<BaiViet> latestBlogs =
        ViewData["listPostPopular"] as List<BaiViet>
        ?? new List<BaiViet>();

    string keyword = ViewData["Keyword"] as string ?? string.Empty;

    int page = ViewBag.Page ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
    int displayFrom = ViewBag.DisplayPage ?? 0;
    int noOfPages = ViewBag.NoOfPages ?? totalPages;

    if (totalPages < 1)
    {
        totalPages = 1;
    }

    int prevPage = page > 1 ? page - 1 : 1;
    int nextPage = page < totalPages ? page + 1 : totalPages;

    Func<string, string> normalizeImage = (path) =>
    {
        if (string.IsNullOrWhiteSpace(path))
        {
            return Url.Content("~/Asset/img/no-image.png");
        }

        path = path.Trim();

        if (path.StartsWith("http", StringComparison.OrdinalIgnoreCase))
        {
            return path;
        }

        if (path.StartsWith("~/"))
        {
            return Url.Content(path);
        }

        if (path.StartsWith("/"))
        {
            return Url.Content("~" + path);
        }

        return Url.Content("~/" + path);
    };

    Func<string, int, string> excerpt = (text, length) =>
    {
        if (string.IsNullOrWhiteSpace(text))
        {
            return "Khám phá thêm những nội dung mới từ Karma Eyewear.";
        }

        text = System.Text.RegularExpressions.Regex.Replace(text, "<.*?>", string.Empty).Trim();

        if (text.Length <= length)
        {
            return text;
        }

        return text.Substring(0, length) + "...";
    };

    Func<int, object> BuildRoute = pageNumber =>
    {
        return new
        {
            keyword = keyword,
            page = pageNumber
        };
    };

    string pagingAction = string.IsNullOrWhiteSpace(keyword) ? "Index" : "FindBlogByName";
    string fallbackImg = Url.Content("~/Asset/img/no-image.png");
}

<section class="blog-page">
    <section class="optical-breadcrumb blog-breadcrumb">
        <div class="container">
            <div class="optical-breadcrumb__inner">
                <span class="optical-breadcrumb__eyebrow">Karma Eyewear Journal</span>
                <h1>Xu hướng & Blog</h1>
                <p class="blog-breadcrumb__desc">
                    Cập nhật xu hướng mắt kính, mẹo chọn gọng phù hợp khuôn mặt và cảm hứng phối đồ hằng ngày.
                </p>
                <nav>
                    <a href="@Url.Action("Index", "Home")">Trang chủ</a>
                    <span>/</span>
                    <span>Xu hướng & Blog</span>
                </nav>
            </div>
        </div>
    </section>

    <section class="blog-section">
        <div class="container">
            <div class="row">
                <div class="col-lg-8">
                    <div class="blog-main">
                        <div class="section-heading section-heading--left blog-list-heading">
                            <span class="eyebrow">Eyewear Stories</span>

                            @if (!string.IsNullOrWhiteSpace(keyword))
                            {
                                <h2>Kết quả tìm kiếm</h2>
                                <p>
                                    Các bài viết phù hợp với từ khóa
                                    <strong>“@keyword”</strong>.
                                </p>
                            }
                            else
                            {
                                <h2>Bài viết mới nhất</h2>
                                <p>
                                    Những nội dung mới về xu hướng kính mắt, phong cách thời trang và cách lựa chọn sản phẩm phù hợp.
                                </p>
                            }
                        </div>

                        @if (!string.IsNullOrWhiteSpace(keyword))
                        {
                            <div class="blog-filter-summary">
                                <span>Đang tìm kiếm: <strong>@keyword</strong></span>
                                <a href="@Url.Action("Index", "Blog")">Xóa tìm kiếm</a>
                            </div>
                        }

                        @if (!blogs.Any())
                        {
                            <div class="blog-empty-state">
                                <div class="blog-empty-icon">
                                    <i class="fa fa-newspaper-o"></i>
                                </div>
                                <h3>Chưa có bài viết phù hợp</h3>
                                <p>
                                    Hãy thử tìm kiếm bằng từ khóa khác hoặc quay lại danh sách bài viết mới nhất.
                                </p>
                                <a href="@Url.Action("Index", "Blog")" class="optical-btn optical-btn--dark">
                                    Xem tất cả bài viết
                                </a>
                            </div>
                        }
                        else
                        {
                            foreach (var item in blogs)
                            {
                                string imageUrl = normalizeImage(item.AnhDaiDien);
                                DateTime? publishDate = item.NgayDang ?? item.CreatedAt;

                                <article class="blog-card-modern">
                                    <div class="row no-gutters align-items-stretch">
                                        <div class="col-md-5">
                                            <a href="@Url.Action("DetailBlog", "Blog", new { id = item.BaiVietId })"
                                               class="blog-card-modern__image">
                                                <img src="@imageUrl"
                                                     alt="@item.TieuDe"
                                                     onerror="this.onerror=null;this.src='@fallbackImg';" />
                                            </a>
                                        </div>

                                        <div class="col-md-7">
                                            <div class="blog-card-modern__content">
                                                <div class="blog-card-modern__meta">
                                                    <span>
                                                        <i class="lnr lnr-calendar-full"></i>
                                                        @string.Format("{0:dd/MM/yyyy}", publishDate)
                                                    </span>
                                                    <span>
                                                        <i class="lnr lnr-user"></i>
                                                        Karma Eyewear
                                                    </span>
                                                </div>

                                                <h3 class="blog-card-modern__title">
                                                    <a href="@Url.Action("DetailBlog", "Blog", new { id = item.BaiVietId })">
                                                        @item.TieuDe
                                                    </a>
                                                </h3>

                                                <p class="blog-card-modern__excerpt">
                                                    @excerpt(item.TomTat, 165)
                                                </p>

                                                <div class="blog-card-modern__footer">
                                                    <a href="@Url.Action("DetailBlog", "Blog", new { id = item.BaiVietId })"
                                                       class="blog-read-more">
                                                        Đọc bài viết
                                                        <i class="fa fa-long-arrow-right"></i>
                                                    </a>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </article>
                            }

                            if (totalPages > 1)
                            {
                                <div class="catalog-pagination blog-pagination">
                                    <a href="@Url.Action(pagingAction, "Blog", BuildRoute(prevPage))"
                                       class="page-arrow @(page == 1 ? "disabled" : "")">
                                        <span class="lnr lnr-chevron-left"></span>
                                    </a>

                                    @for (int i = displayFrom; i < noOfPages; i++)
                                    {
                                        int pageNumber = i + 1;
                                        <a href="@Url.Action(pagingAction, "Blog", BuildRoute(pageNumber))"
                                           class="@(pageNumber == page ? "active" : "")">
                                            @pageNumber
                                        </a>
                                    }

                                    <a href="@Url.Action(pagingAction, "Blog", BuildRoute(nextPage))"
                                       class="page-arrow @(page == totalPages ? "disabled" : "")">
                                        <span class="lnr lnr-chevron-right"></span>
                                    </a>
                                </div>
                            }
                        }
                    </div>
                </div>

                <div class="col-lg-4">
                    <aside class="blog-sidebar">
                        <div class="blog-sidebar-card">
                            <div class="blog-sidebar-card__title">Tìm kiếm bài viết</div>

                            @using (Html.BeginForm("FindBlogByName", "Blog", FormMethod.Get, new { @class = "blog-search-form" }))
                            {
                                <input type="text"
                                       name="keyword"
                                       value="@keyword"
                                       class="blog-search-input"
                                       placeholder="Tìm xu hướng, gọng kính..." />

                                <button type="submit" class="blog-search-btn" aria-label="Tìm kiếm">
                                    <i class="fa fa-search"></i>
                                </button>
                            }

                            @if (!string.IsNullOrWhiteSpace(keyword))
                            {
                                <a href="@Url.Action("Index", "Blog")" class="blog-clear-search">
                                    Xóa tìm kiếm hiện tại
                                </a>
                            }
                        </div>

                        <div class="blog-sidebar-card">
                            <div class="blog-sidebar-card__title">Bài viết mới nhất</div>

                            @if (latestBlogs.Any())
                            {
                                foreach (var item in latestBlogs.Take(4))
                                {
                                    string imageUrl = normalizeImage(item.AnhDaiDien);
                                    DateTime? publishDate = item.NgayDang ?? item.CreatedAt;

                                    <a href="@Url.Action("DetailBlog", "Blog", new { id = item.BaiVietId })"
                                       class="popular-post-item">
                                        <span class="popular-post-item__thumb">
                                            <img src="@imageUrl"
                                                 alt="@item.TieuDe"
                                                 onerror="this.onerror=null;this.src='@fallbackImg';" />
                                        </span>

                                        <span class="popular-post-item__body">
                                            <h4>@item.TieuDe</h4>
                                            <p>@string.Format("{0:dd/MM/yyyy}", publishDate)</p>
                                        </span>
                                    </a>
                                }
                            }
                            else
                            {
                                <p class="blog-sidebar-empty">Chưa có bài viết mới.</p>
                            }
                        </div>

                        <div class="blog-sidebar-card blog-sidebar-card--promo">
                            <span class="blog-promo-eyebrow">Karma Eyewear</span>
                            <h3>Tìm mẫu kính phù hợp phong cách của bạn</h3>
                            <p>
                                Khám phá các thiết kế mắt kính thanh lịch, hiện đại và dễ phối đồ cho nhiều dịp khác nhau.
                            </p>
                            <a href="@Url.Action("Index", "Product")" class="optical-btn optical-btn--light">
                                Xem sản phẩm
                            </a>
                        </div>
                    </aside>
                </div>
            </div>
        </div>
    </section>
</section>