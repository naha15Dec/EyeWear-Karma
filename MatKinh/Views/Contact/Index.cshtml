@model MatKinh.Models.ThongTinCuaHang

@{
    ViewBag.Title = "Liên hệ";

    string storeName = Model != null && !string.IsNullOrWhiteSpace(Model.TenCuaHang)
        ? Model.TenCuaHang.Trim()
        : "Karma Eyewear";

    string hotline = Model != null && !string.IsNullOrWhiteSpace(Model.Hotline)
        ? Model.Hotline.Trim()
        : "";

    string hotlineHref = "";
    if (!string.IsNullOrWhiteSpace(hotline))
    {
        hotlineHref = hotline
            .Replace(" ", "")
            .Replace(".", "")
            .Replace("-", "")
            .Replace("(", "")
            .Replace(")", "");
    }

    string email = Model != null && !string.IsNullOrWhiteSpace(Model.Email)
        ? Model.Email.Trim()
        : "";

    string emailHref = email;

    string address = Model != null && !string.IsNullOrWhiteSpace(Model.DiaChi)
        ? Model.DiaChi.Trim()
        : "";

    string shortDesc = Model != null && !string.IsNullOrWhiteSpace(Model.MoTaNgan)
        ? Model.MoTaNgan.Trim()
        : "";

    string intro = Model != null && !string.IsNullOrWhiteSpace(Model.GioiThieu)
        ? Model.GioiThieu.Trim()
        : "";

    string facebookUrl = Model != null && !string.IsNullOrWhiteSpace(Model.FacebookUrl)
        ? Model.FacebookUrl.Trim()
        : "";

    string instagramUrl = Model != null && !string.IsNullOrWhiteSpace(Model.InstagramUrl)
        ? Model.InstagramUrl.Trim()
        : "";

    string zaloUrl = Model != null && !string.IsNullOrWhiteSpace(Model.ZaloUrl)
        ? Model.ZaloUrl.Trim()
        : "";

    bool hasContactInfo =
        !string.IsNullOrWhiteSpace(address) ||
        !string.IsNullOrWhiteSpace(hotline) ||
        !string.IsNullOrWhiteSpace(email);

    bool hasSocial =
        !string.IsNullOrWhiteSpace(facebookUrl) ||
        !string.IsNullOrWhiteSpace(instagramUrl) ||
        !string.IsNullOrWhiteSpace(zaloUrl);

    string breadcrumbDesc = !string.IsNullOrWhiteSpace(shortDesc)
        ? shortDesc
        : "Kết nối với Karma Eyewear để được tư vấn sản phẩm, hỗ trợ đơn hàng và giải đáp các thông tin cần thiết.";
}

<section class="contact-page">
    <section class="optical-breadcrumb contact-breadcrumb">
        <div class="container">
            <div class="optical-breadcrumb__inner">
                <span class="optical-breadcrumb__eyebrow">@storeName</span>
                <h1>Liên hệ với chúng tôi</h1>
                <p class="optical-breadcrumb__desc">
                    @breadcrumbDesc
                </p>
                <nav>
                    <a href="@Url.Action("Index","Home")">Trang chủ</a>
                    <span>/</span>
                    <span>Liên hệ</span>
                </nav>
            </div>
        </div>
    </section>

    <section class="contact-section">
        <div class="container">

            @if (ViewBag.ContactNotice != null)
            {
                <div class="contact-notice">
                    <span class="contact-notice__icon">
                        <i class="fa fa-info"></i>
                    </span>
                    <div class="contact-notice__content">
                        @ViewBag.ContactNotice
                    </div>
                </div>
            }

            <div class="contact-intro-panel">
                <div>
                    <span class="contact-eyebrow">Karma Eyewear Support</span>
                    <h2>Chúng tôi luôn sẵn sàng hỗ trợ bạn</h2>
                    <p>
                        Tư vấn chọn kính, hỗ trợ đơn hàng, thông tin thanh toán, giao nhận và chính sách sau mua.
                        Hãy chọn cách liên hệ phù hợp nhất với bạn.
                    </p>
                </div>

                <div class="contact-intro-actions">
                    @if (!string.IsNullOrWhiteSpace(hotlineHref))
                    {
                        <a href="tel:@hotlineHref" class="optical-btn optical-btn--dark">
                            <i class="fa fa-phone mr-2"></i>Gọi ngay
                        </a>
                    }

                    @if (!string.IsNullOrWhiteSpace(emailHref))
                    {
                        <a href="mailto:@emailHref" class="optical-btn optical-btn--light">
                            <i class="fa fa-envelope mr-2"></i>Gửi email
                        </a>
                    }
                </div>
            </div>

            <div class="contact-grid">
                <div class="contact-info-card">
                    <div class="contact-card-head">
                        <span class="contact-eyebrow">Contact info</span>
                        <h3>Thông tin cửa hàng</h3>
                        <p>
                            Thông tin chính thức để bạn liên hệ với @storeName.
                        </p>
                    </div>

                    @if (!hasContactInfo)
                    {
                        <div class="contact-empty-info">
                            Thông tin liên hệ đang được cập nhật. Vui lòng quay lại sau hoặc tiếp tục xem sản phẩm tại cửa hàng.
                        </div>
                    }

                    <div class="contact-info-list">
                        <div class="contact-info-item">
                            <div class="contact-info-icon">
                                <i class="lnr lnr-home"></i>
                            </div>

                            <div class="contact-info-content">
                                <strong>Địa chỉ</strong>
                                <p>@(string.IsNullOrWhiteSpace(address) ? "Chưa cập nhật địa chỉ." : address)</p>
                            </div>
                        </div>

                        <div class="contact-info-item">
                            <div class="contact-info-icon">
                                <i class="lnr lnr-phone-handset"></i>
                            </div>

                            <div class="contact-info-content">
                                <strong>Số điện thoại</strong>
                                <p>
                                    @if (!string.IsNullOrWhiteSpace(hotlineHref))
                                    {
                                        <a href="tel:@hotlineHref">@hotline</a>
                                    }
                                    else
                                    {
                                        <span>Chưa cập nhật số điện thoại.</span>
                                    }
                                </p>
                            </div>
                        </div>

                        <div class="contact-info-item">
                            <div class="contact-info-icon">
                                <i class="lnr lnr-envelope"></i>
                            </div>

                            <div class="contact-info-content">
                                <strong>Email</strong>
                                <p>
                                    @if (!string.IsNullOrWhiteSpace(emailHref))
                                    {
                                        <a href="mailto:@emailHref">@email</a>
                                    }
                                    else
                                    {
                                        <span>Chưa cập nhật email.</span>
                                    }
                                </p>
                            </div>
                        </div>
                    </div>

                    <div class="contact-extra">
                        <div class="contact-extra-card">
                            <span>Thời gian hỗ trợ</span>
                            <strong>08:00 – 22:00</strong>
                            <p>Từ Thứ 2 đến Chủ nhật</p>
                        </div>

                        <div class="contact-extra-desc">
                            @if (!string.IsNullOrWhiteSpace(intro))
                            {
                                <p>@intro</p>
                            }
                            else
                            {
                                <p>
                                    Karma Eyewear hỗ trợ tư vấn lựa chọn mắt kính, xử lý đơn hàng, thanh toán,
                                    giao nhận và các chính sách sau mua một cách rõ ràng, tận tâm.
                                </p>
                            }
                        </div>
                    </div>

                    @if (hasSocial)
                    {
                        <div class="contact-social-wrap">
                            <span class="contact-social-title">Kết nối với chúng tôi</span>

                            <div class="contact-social-links">
                                @if (!string.IsNullOrWhiteSpace(facebookUrl))
                                {
                                    <a href="@facebookUrl"
                                       target="_blank"
                                       rel="noopener noreferrer"
                                       class="contact-social-link">
                                        <i class="fa fa-facebook"></i>
                                        <span>Facebook</span>
                                    </a>
                                }

                                @if (!string.IsNullOrWhiteSpace(instagramUrl))
                                {
                                    <a href="@instagramUrl"
                                       target="_blank"
                                       rel="noopener noreferrer"
                                       class="contact-social-link">
                                        <i class="fa fa-instagram"></i>
                                        <span>Instagram</span>
                                    </a>
                                }

                                @if (!string.IsNullOrWhiteSpace(zaloUrl))
                                {
                                    <a href="@zaloUrl"
                                       target="_blank"
                                       rel="noopener noreferrer"
                                       class="contact-social-link">
                                        <i class="fa fa-comment"></i>
                                        <span>Zalo</span>
                                    </a>
                                }
                            </div>
                        </div>
                    }
                </div>

                <div class="contact-map-card">
                    <div class="contact-map-label">
                        <span>Showroom location</span>
                        <strong>@storeName</strong>
                    </div>

                    <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3916.7704806485776!2d106.67178467480811!3d10.98068928918078!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x3174d1085e2b1c37%3A0x73bfa5616464d0ee!2sThu%20Dau%20Mot%20University!5e0!3m2!1sen!2s!4v1773818804398!5m2!1sen!2s"
                            width="100%"
                            height="100%"
                            style="border:0;"
                            allowfullscreen=""
                            loading="lazy"
                            referrerpolicy="no-referrer-when-downgrade">
                    </iframe>
                </div>
            </div>

            <div class="contact-service-grid">
                <div class="contact-service-card">
                    <div class="contact-service-icon">
                        <i class="fa fa-comments-o"></i>
                    </div>
                    <h4>Tư vấn chọn kính</h4>
                    <p>Hỗ trợ chọn gọng, kiểu dáng và phong cách phù hợp với nhu cầu sử dụng.</p>
                </div>

                <div class="contact-service-card">
                    <div class="contact-service-icon">
                        <i class="fa fa-shopping-bag"></i>
                    </div>
                    <h4>Hỗ trợ đơn hàng</h4>
                    <p>Kiểm tra tình trạng đơn hàng, thanh toán, giao nhận và thông tin sau mua.</p>
                </div>

                <div class="contact-service-card">
                    <div class="contact-service-icon">
                        <i class="fa fa-refresh"></i>
                    </div>
                    <h4>Chính sách sau mua</h4>
                    <p>Giải đáp đổi trả, bảo hành và các chính sách chăm sóc khách hàng.</p>
                </div>
            </div>

            <div class="contact-cta">
                <span class="contact-cta-eyebrow">Need help?</span>
                <h3>Bạn cần hỗ trợ nhanh?</h3>
                <p>
                    Liên hệ trực tiếp với chúng tôi để được tư vấn về sản phẩm, đơn hàng, giao hàng hoặc thanh toán.
                </p>

                <div class="contact-cta-actions">
                    @if (!string.IsNullOrWhiteSpace(hotlineHref))
                    {
                        <a href="tel:@hotlineHref" class="optical-btn optical-btn--light">
                            <i class="fa fa-phone mr-2"></i>Gọi ngay
                        </a>
                    }

                    @if (!string.IsNullOrWhiteSpace(emailHref))
                    {
                        <a href="mailto:@emailHref" class="optical-btn optical-btn--light">
                            <i class="fa fa-envelope mr-2"></i>Gửi email
                        </a>
                    }

                    <a href="@Url.Action("Index", "Product")" class="optical-btn optical-btn--light">
                        Tiếp tục mua sắm
                    </a>
                </div>
            </div>
        </div>
    </section>
</section>