@{
    Layout = null;

    ViewBag.Title = "Không có quyền truy cập";

    bool isAdminLike = ViewBag.IsAdminLike != null && (bool)ViewBag.IsAdminLike;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Không có quyền truy cập</title>

    <link href="~/Content/css/error.css" rel="stylesheet" />
</head>

<body class="error-page-modern">
    <div class="error-container">
        <div class="error-card">
            <span class="error-code">403</span>

            <h1>Không có quyền truy cập</h1>

            <p>
                Bạn không có quyền truy cập vào trang này.
                Nếu bạn nghĩ đây là nhầm lẫn, vui lòng liên hệ quản trị viên hoặc cửa hàng để được hỗ trợ.
            </p>

            <div class="error-actions">
                @if (isAdminLike)
                {
                    <a href="@Url.Action("Index", "Dashboard", new { area = "AdminPage" })"
                       class="error-btn error-btn--dark">
                        Về trang quản trị
                    </a>
                }
                else
                {
                    <a href="@Url.Action("Index", "Home", new { area = "" })"
                       class="error-btn error-btn--dark">
                        Về trang chủ
                    </a>

                    <a href="@Url.Action("Index", "Product", new { area = "" })"
                       class="error-btn error-btn--light">
                        Xem sản phẩm
                    </a>
                }
            </div>
        </div>
    </div>
</body>
</html>