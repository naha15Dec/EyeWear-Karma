@{
    ViewBag.Title = "AI tư vấn chọn kính";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link href="@Url.Content("~/Content/css/face-ai.css")" rel="stylesheet" />

<section class="face-ai-page">
    <div class="container">

        <div class="face-ai-hero">
            <span class="face-ai-badge">
                <i class="fa fa-magic"></i>
                AI FACE RECOMMENDATION
            </span>

            <h1>AI tư vấn gọng kính phù hợp với khuôn mặt</h1>

            <p>
                Bật camera hoặc tải ảnh lên để AI phân tích dáng khuôn mặt
                và gợi ý những mẫu gọng kính phù hợp với bạn.
            </p>
        </div>

        <div class="face-ai-layout">
            <div class="face-ai-left">
                <div class="face-ai-card upload-card">

                    <div class="camera-zone">
                        <div class="camera-frame">
                            <video id="cameraVideo" autoplay muted playsinline></video>
                            <canvas id="cameraCanvas"></canvas>

                            <img id="previewImage" alt="Ảnh xem trước" />

                            <div class="camera-placeholder" id="cameraPlaceholder">
                                <div class="upload-icon">
                                    <i class="fa fa-camera"></i>
                                </div>
                                <h3>Camera AI tư vấn kính</h3>
                                <p>Bấm bật camera, nhìn thẳng khuôn mặt và chờ AI phân tích.</p>
                            </div>
                        </div>

                        <div class="face-ai-actions">
                            <button type="button" id="btnStartCamera" class="ai-main-btn">
                                <i class="fa fa-video-camera"></i>
                                Bật camera
                            </button>

                            <button type="button" id="btnAnalyzeFace" class="ai-outline-btn" disabled>
                                <i class="fa fa-magic"></i>
                                Phân tích khuôn mặt
                            </button>

                            <label for="imageUpload" class="ai-upload-small">
                                <i class="fa fa-image"></i>
                                Chọn ảnh
                            </label>

                            <input type="file" id="imageUpload" accept="image/*" />
                        </div>
                    </div>

                    <div class="ai-result-box">
                        <span class="result-label">Kết quả phân tích</span>
                        <h3 id="result">Chưa có kết quả</h3>
                        <p id="suggestion">Hãy bật camera hoặc chọn ảnh để AI bắt đầu tư vấn.</p>
                    </div>
                </div>
            </div>

            <div class="face-ai-right">
                <div class="face-ai-card guide-card">
                    <span class="guide-label">Hướng dẫn</span>
                    <h3>Cách dùng AI chọn kính</h3>

                    <div class="guide-list">
                        <div class="guide-item">
                            <div class="guide-number">1</div>
                            <div>
                                <strong>Bật camera hoặc chọn ảnh</strong>
                                <p>Bạn có thể dùng camera trực tiếp hoặc tải ảnh khuôn mặt rõ nét.</p>
                            </div>
                        </div>

                        <div class="guide-item">
                            <div class="guide-number">2</div>
                            <div>
                                <strong>Nhìn thẳng khuôn mặt</strong>
                                <p>Giữ mặt rõ, đủ sáng, không che mắt và không nghiêng quá nhiều.</p>
                            </div>
                        </div>

                        <div class="guide-item">
                            <div class="guide-number">3</div>
                            <div>
                                <strong>AI phân tích dáng mặt</strong>
                                <p>Hệ thống nhận diện mặt tròn, vuông, dài, oval hoặc trái tim.</p>
                            </div>
                        </div>

                        <div class="guide-item">
                            <div class="guide-number">4</div>
                            <div>
                                <strong>Xem sản phẩm phù hợp</strong>
                                <p>Gọng kính được gợi ý dựa trên dáng mặt và kiểu gọng phù hợp.</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="products-heading">
            <span>Sản phẩm phù hợp</span>
            <h2 id="recommendedTitle">Gợi ý dành riêng cho bạn</h2>
            <p id="recommendedDesc">
                Danh sách sản phẩm sẽ hiển thị sau khi AI hoàn tất phân tích khuôn mặt.
            </p>
        </div>

        <div id="recommendedProducts" class="recommended-products">
            <div class="ai-products-status">
                <h3>Chưa có sản phẩm gợi ý</h3>
                <p>Hãy bật camera hoặc chọn ảnh để AI tư vấn mẫu kính phù hợp.</p>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        var getProductsUrl = '@Url.Action("GetRecommendedProducts", "FaceAI")';
        var predictByModelUrl = '@Url.Action("PredictByModel", "FaceAI")';
    </script>

    <script src="https://unpkg.com/%40mediapipe/camera_utils/camera_utils.js"></script>
    <script src="https://unpkg.com/%40mediapipe/drawing_utils/drawing_utils.js"></script>
    <script src="https://unpkg.com/%40mediapipe/face_mesh/face_mesh.js"></script>

    <script src="@Url.Content("~/Content/js/face-ai.js?v=4001")"></script>
}