@model MatKinh.Models.SanPham
@using MatKinh.Models
@using System.Globalization
@using System.Collections.Generic
@using System.Linq

@{
    ViewBag.Title = "Chi tiết sản phẩm";

    var vi = CultureInfo.GetCultureInfo("vi-VN");
    var recommendedProducts = ViewBag.RecommendedProducts as List<SanPham> ?? new List<SanPham>();

    string fallbackImg = Url.Content("~/Asset/img/no-image.png");

    Func<string, string> normalizeImage = (path) =>
    {
        if (string.IsNullOrWhiteSpace(path))
        {
            return fallbackImg;
        }

        path = path.Trim();

        if (path.StartsWith("http", StringComparison.OrdinalIgnoreCase))
        {
            return path;
        }

        if (path.StartsWith("~/"))
        {
            return Url.Content(path);
        }

        if (path.StartsWith("/"))
        {
            return Url.Content("~" + path);
        }

        return Url.Content("~/" + path);
    };

    Func<decimal, string> money = value => string.Format(vi, "{0:N0}", value);

    string mainImg = normalizeImage(Model != null ? Model.HinhAnhChinh : null);

    decimal giaGoc = Model != null ? Model.GiaGoc : 0m;
    decimal giaBan = Model != null ? Model.GiaBan : 0m;
    bool isSale = giaGoc > giaBan;

    int soLuongTon = Model != null ? Model.SoLuongTon : 0;
    bool conHang = Model != null && Model.TrangThai == 1 && soLuongTon > 0;

    string stockText = "Hết hàng";
    string stockCss = "out-stock";

    if (conHang)
    {
        if (soLuongTon <= 3)
        {
            stockText = "Chỉ còn " + soLuongTon + " sản phẩm";
            stockCss = "low-stock";
        }
        else
        {
            stockText = "Còn hàng";
            stockCss = "in-stock";
        }
    }

    string tenSP = Model != null && !string.IsNullOrWhiteSpace(Model.TenSanPham)
        ? Model.TenSanPham
        : "Sản phẩm";

    string maSP = Model != null && !string.IsNullOrWhiteSpace(Model.MaSanPham)
        ? Model.MaSanPham
        : "—";

    string tenLoai = Model != null && Model.LoaiSanPham != null
        ? Model.LoaiSanPham.TenLoaiSanPham
        : "—";

    string tenThuongHieu = Model != null && Model.ThuongHieu != null
        ? Model.ThuongHieu.TenThuongHieu
        : "—";

    string moTaNgan = Model != null ? Model.MoTaNgan : null;
    string moTaChiTiet = Model != null ? Model.MoTaChiTiet : null;
}

<section class="detail-page">
    <section class="optical-breadcrumb product-breadcrumb-compact">
        <div class="container">
            <div class="optical-breadcrumb__inner">
                <span class="optical-breadcrumb__eyebrow">Karma Eyewear Product</span>
                <h1>Chi tiết sản phẩm</h1>
                <p class="optical-breadcrumb__desc">
                    Xem thông tin sản phẩm, giá bán, tình trạng tồn kho và các mẫu kính gợi ý phù hợp.
                </p>
                <nav>
                    <a href="@Url.Action("Index", "Home")">Trang chủ</a>
                    <span>/</span>
                    <a href="@Url.Action("Index", "Product")">Sản phẩm</a>
                    <span>/</span>
                    <span>Chi tiết sản phẩm</span>
                </nav>
            </div>
        </div>
    </section>

    <section class="detail-main-section">
        <div class="container">
            <div class="detail-card @(conHang ? "" : "is-soldout")">
                <div class="row align-items-start">
                    <div class="col-lg-6 mb-4 mb-lg-0">
                        <div class="detail-gallery">
                            <div class="detail-gallery__main">
                                @if (!conHang)
                                {
                                    <span class="product-status-badge soldout detail-image-badge">Hết hàng</span>
                                }
                                else if (isSale)
                                {
                                    <span class="product-status-badge sale detail-image-badge">Sale</span>
                                }

                                <img id="mainImage"
                                     src="@mainImg"
                                     alt="@tenSP"
                                     onerror="this.onerror=null;this.src='@fallbackImg';" />
                            </div>

                            <div class="detail-gallery__thumbs">
                                <img class="thumb active"
                                     src="@mainImg"
                                     data-src="@mainImg"
                                     alt="@tenSP"
                                     onclick="swapImage(this)"
                                     onerror="this.onerror=null;this.src='@fallbackImg';" />
                            </div>
                        </div>
                    </div>

                    <div class="col-lg-6">
                        <div class="detail-info">
                            <div class="detail-badges">
                                <span class="detail-badge">@tenLoai</span>
                                <span class="detail-badge detail-badge--light">@tenThuongHieu</span>
                                <span class="detail-stock @stockCss">@stockText</span>
                            </div>

                            <h2 class="detail-title">@tenSP</h2>

                            <div class="detail-meta">
                                <span><strong>Mã sản phẩm:</strong> @maSP</span>
                                <span><strong>Thương hiệu:</strong> @tenThuongHieu</span>
                                <span><strong>Tình trạng:</strong> @stockText</span>
                            </div>

                            <div class="detail-price-box">
                                @if (isSale)
                                {
                                    <div class="detail-price-sale">
                                        @money(giaBan) ₫
                                    </div>

                                    <div class="detail-price-row">
                                        <span class="detail-price-old">@money(giaGoc) ₫</span>
                                        <span class="detail-discount-save">
                                            Tiết kiệm @money(giaGoc - giaBan) ₫
                                        </span>
                                    </div>
                                }
                                else
                                {
                                    <div class="detail-price-sale">
                                        @money(giaBan) ₫
                                    </div>
                                }
                            </div>

                            <div class="detail-short-desc">
                                @if (!string.IsNullOrWhiteSpace(moTaNgan))
                                {
                                    @moTaNgan
                                }
                                else
                                {
                                    <text>Thiết kế mắt kính hiện đại, phù hợp cho nhu cầu sử dụng hằng ngày và định hình phong cách thanh lịch.</text>
                                }
                            </div>

                            <div class="detail-actions">
                                @if (conHang && Model != null)
                                {
                                    using (Html.BeginForm("AddItemToCart", "ShoppingCart", FormMethod.Post, new { @class = "add-cart-form" }))
                                    {
                                        @Html.AntiForgeryToken()

                                        <input type="hidden" name="sanPhamId" value="@Model.SanPhamId" />
                                        <input type="hidden" name="returnUrl" value="@Request.RawUrl" />

                                        <button type="submit" class="optical-btn optical-btn--dark">
                                            <i class="ti-bag mr-2"></i>Thêm vào giỏ hàng
                                        </button>
                                    }
                                }
                                else
                                {
                                    <button type="button"
                                            class="optical-btn optical-btn--disabled"
                                            disabled>
                                        <i class="ti-na mr-2"></i>Hết hàng
                                    </button>
                                }

                                <a class="optical-btn optical-btn--light"
                                   href="@Url.Action("Index", "Product")">
                                    Xem thêm sản phẩm
                                </a>
                            </div>

                            <div class="detail-trust-note">
                                <span><i class="fa fa-shield"></i> Thanh toán an toàn</span>
                                <span><i class="fa fa-refresh"></i> Hỗ trợ đổi trả</span>
                                <span><i class="fa fa-comments-o"></i> Tư vấn chọn kính</span>
                            </div>

                            @if (!conHang)
                            {
                                <div class="detail-stock-note">
                                    Sản phẩm hiện đã hết hàng. Bạn có thể xem thêm các mẫu kính tương tự hoặc quay lại danh sách sản phẩm để lựa chọn mẫu khác.
                                </div>
                            }

                            <div class="detail-extra-grid">
                                <div class="detail-extra-item">
                                    <span class="label">Loại sản phẩm</span>
                                    <span class="value">@tenLoai</span>
                                </div>

                                <div class="detail-extra-item">
                                    <span class="label">Thương hiệu</span>
                                    <span class="value">@tenThuongHieu</span>
                                </div>

                                <div class="detail-extra-item">
                                    <span class="label">Tình trạng</span>
                                    <span class="value">@stockText</span>
                                </div>

                                <div class="detail-extra-item">
                                    <span class="label">Mã sản phẩm</span>
                                    <span class="value">@maSP</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="detail-tabs-section">
        <div class="container">
            <div class="detail-tabs-card">
                <ul class="nav nav-tabs detail-tabs-nav" id="productDetailTabs" role="tablist">
                    <li class="nav-item">
                        <a class="nav-link active"
                           id="description-tab"
                           data-toggle="tab"
                           href="#description"
                           role="tab"
                           aria-controls="description"
                           aria-selected="true">
                            Mô tả chi tiết
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link"
                           id="info-tab"
                           data-toggle="tab"
                           href="#info"
                           role="tab"
                           aria-controls="info"
                           aria-selected="false">
                            Thông tin sản phẩm
                        </a>
                    </li>
                </ul>

                <div class="tab-content detail-tabs-content" id="productDetailTabsContent">
                    <div class="tab-pane fade show active"
                         id="description"
                         role="tabpanel"
                         aria-labelledby="description-tab">
                        @if (!string.IsNullOrWhiteSpace(moTaChiTiet))
                        {
                            @Html.Raw(moTaChiTiet)
                        }
                        else
                        {
                            <p>Chưa có mô tả chi tiết cho sản phẩm này.</p>
                        }
                    </div>

                    <div class="tab-pane fade"
                         id="info"
                         role="tabpanel"
                         aria-labelledby="info-tab">
                        <div class="table-responsive">
                            <table class="table detail-info-table">
                                <tbody>
                                    <tr>
                                        <td>Mã sản phẩm</td>
                                        <td>@maSP</td>
                                    </tr>
                                    <tr>
                                        <td>Tên sản phẩm</td>
                                        <td>@tenSP</td>
                                    </tr>
                                    <tr>
                                        <td>Loại sản phẩm</td>
                                        <td>@tenLoai</td>
                                    </tr>
                                    <tr>
                                        <td>Thương hiệu</td>
                                        <td>@tenThuongHieu</td>
                                    </tr>
                                    <tr>
                                        <td>Giá gốc</td>
                                        <td>@money(giaGoc) ₫</td>
                                    </tr>
                                    <tr>
                                        <td>Giá bán</td>
                                        <td>@money(giaBan) ₫</td>
                                    </tr>
                                    <tr>
                                        <td>Tình trạng</td>
                                        <td>@stockText</td>
                                    </tr>
                                    <tr>
                                        <td>Số lượng tồn</td>
                                        <td>@soLuongTon</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="detail-recommend-section">
        <div class="container">
            <div class="section-heading">
                <span class="eyebrow">Gợi ý cho bạn</span>
                <h2>Sản phẩm gợi ý</h2>
                <p>
                    Những mẫu kính tương đồng về phong cách, thương hiệu hoặc mức giá,
                    giúp bạn dễ dàng so sánh và lựa chọn sản phẩm phù hợp hơn.
                </p>
            </div>

            @if (recommendedProducts.Any())
            {
                <div class="row">
                    @foreach (var item in recommendedProducts)
                    {
                        string itemImg = normalizeImage(item.HinhAnhChinh);
                        bool itemIsSale = item.GiaGoc > item.GiaBan;
                        bool itemConHang = item.TrangThai == 1 && item.SoLuongTon > 0;

                        string itemName = !string.IsNullOrWhiteSpace(item.TenSanPham)
                            ? item.TenSanPham
                            : "Sản phẩm";

                        string itemBrand = item.ThuongHieu != null
                            ? item.ThuongHieu.TenThuongHieu
                            : "Karma Eyewear";

                        <div class="col-md-6 col-lg-3 mb-4">
                            <div class="recommend-product-card @(itemConHang ? "" : "is-soldout")">
                                <a href="@Url.Action("DetailProduct", "Product", new { sanPhamId = item.SanPhamId })"
                                   class="recommend-product-link">
                                    <div class="recommend-product-image">
                                        @if (!itemConHang)
                                        {
                                            <span class="product-status-badge soldout">Hết hàng</span>
                                        }
                                        else if (itemIsSale)
                                        {
                                            <span class="product-status-badge sale">Sale</span>
                                        }

                                        <img src="@itemImg"
                                             alt="@itemName"
                                             onerror="this.onerror=null;this.src='@fallbackImg';" />
                                    </div>

                                    <div class="recommend-product-body">
                                        <div class="product-card-meta">
                                            <span>@itemBrand</span>
                                        </div>

                                        <h5 class="recommend-product-title">
                                            @(itemName.Length > 45 ? itemName.Substring(0, 45) + "..." : itemName)
                                        </h5>

                                        @if (itemIsSale)
                                        {
                                            <div class="recommend-product-price-sale">
                                                @money(item.GiaBan) ₫
                                            </div>
                                            <div class="recommend-product-price-old">
                                                @money(item.GiaGoc) ₫
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="recommend-product-price-sale">
                                                @money(item.GiaBan) ₫
                                            </div>
                                        }

                                        <div class="recommend-product-action">
                                            <span>Xem chi tiết</span>
                                        </div>
                                    </div>
                                </a>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="catalog-empty">
                    <div class="catalog-empty-icon">
                        <i class="fa fa-lightbulb-o"></i>
                    </div>

                    <h3>Chưa có dữ liệu gợi ý</h3>
                    <p>Hệ thống sẽ sớm cập nhật thêm các sản phẩm phù hợp dành cho bạn.</p>

                    <a href="@Url.Action("Index", "Product")"
                       class="optical-btn optical-btn--dark catalog-empty-btn">
                        Xem tất cả sản phẩm
                    </a>
                </div>
            }
        </div>
    </section>
</section>

@section Scripts {
    <script>
        function swapImage(el) {
            var main = document.getElementById('mainImage');
            if (!main || !el) return;

            var nextSrc = el.getAttribute('data-src');
            if (!nextSrc) return;

            main.src = nextSrc;

            var thumbs = document.querySelectorAll('.detail-gallery__thumbs .thumb');
            for (var i = 0; i < thumbs.length; i++) {
                thumbs[i].classList.remove('active');
            }

            el.classList.add('active');
        }
    </script>
}