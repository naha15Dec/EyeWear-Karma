@using System
@using System.Collections.Generic
@using MatKinh.Models
@model MatKinh.Models.DonHang

@{
    ViewBag.Title = "Chi tiết đơn hàng";

    List<ChiTietDonHang> details = ViewData["listOfProductInOrder"] as List<ChiTietDonHang> ?? new List<ChiTietDonHang>();
    List<LichSuTrangThaiDonHang> histories = ViewData["orderHistories"] as List<LichSuTrangThaiDonHang> ?? new List<LichSuTrangThaiDonHang>();
    Dictionary<int, DanhGiaSanPham> reviewMap = ViewData["reviewMap"] as Dictionary<int, DanhGiaSanPham> ?? new Dictionary<int, DanhGiaSanPham>();

    YeuCauTraHang returnRequest = ViewData["returnRequest"] as YeuCauTraHang;
    bool canCreateReturnRequest = ViewBag.CanCreateReturnRequest != null && (bool)ViewBag.CanCreateReturnRequest;

    bool canCancelOrder = ViewBag.CanCancelOrder != null && (bool)ViewBag.CanCancelOrder;
    bool canReviewOrder = ViewBag.CanReviewOrder != null && (bool)ViewBag.CanReviewOrder;

    string fallbackImg = Url.Content("~/Asset/img/no-image.png");

    bool isCancelledPaidVnPayOrder =
        Model != null
        && Model.TrangThai == OrderStatusConstants.CANCELLED
        && string.Equals(Model.PhuongThucThanhToan, PaymentConstants.VNPAY, StringComparison.OrdinalIgnoreCase)
        && string.Equals(Model.TrangThaiThanhToan, PaymentConstants.PAID, StringComparison.OrdinalIgnoreCase);

    Func<string, string> normalizeImage = path =>
    {
        if (string.IsNullOrWhiteSpace(path))
        {
            return fallbackImg;
        }

        path = path.Trim();

        if (path.StartsWith("http", StringComparison.OrdinalIgnoreCase))
        {
            return path;
        }

        if (path.StartsWith("~/"))
        {
            return Url.Content(path);
        }

        if (path.StartsWith("/"))
        {
            return Url.Content("~" + path);
        }

        return Url.Content("~/" + path);
    };

    Func<int, string> orderStatusClass = status =>
    {
        switch (status)
        {
            case OrderStatusConstants.DELIVERED:
                return "success";

            case OrderStatusConstants.CANCELLED:
                return "danger";

            case OrderStatusConstants.DELIVERY_FAILED:
                return "warning";

            case OrderStatusConstants.DELIVERING:
            case OrderStatusConstants.ASSIGNED_TO_SHIPPER:
                return "info";

            default:
                return "processing";
        }
    };

    Func<string, string> paymentMethodText = method =>
    {
        if (string.Equals(method, PaymentConstants.VNPAY, StringComparison.OrdinalIgnoreCase))
        {
            return "Thanh toán online qua VNPay";
        }

        return "Thanh toán khi nhận hàng";
    };

    Func<string, string> paymentStatusText = status =>
    {
        if (string.Equals(status, PaymentConstants.PAID, StringComparison.OrdinalIgnoreCase))
        {
            return "Đã thanh toán";
        }

        if (string.Equals(status, PaymentConstants.FAILED, StringComparison.OrdinalIgnoreCase))
        {
            return "Thanh toán thất bại";
        }

        if (string.Equals(status, PaymentConstants.REFUNDED, StringComparison.OrdinalIgnoreCase))
        {
            return "Đã hoàn tiền";
        }

        return "Chờ thanh toán";
    };

    Func<string, string> paymentStatusClass = status =>
    {
        if (string.Equals(status, PaymentConstants.PAID, StringComparison.OrdinalIgnoreCase))
        {
            return "success";
        }

        if (string.Equals(status, PaymentConstants.FAILED, StringComparison.OrdinalIgnoreCase))
        {
            return "danger";
        }

        if (string.Equals(status, PaymentConstants.REFUNDED, StringComparison.OrdinalIgnoreCase))
        {
            return "warning";
        }

        return "processing";
    };

    decimal tongTienHang = Model.TongTienHang;
    decimal phiVanChuyen = Model.PhiVanChuyen;
    decimal giamGia = Model.GiamGia;
    decimal tongThanhToan = Model.TongThanhToan;
}

<section class="order-detail-page">
    <section class="optical-breadcrumb order-detail-breadcrumb">
        <div class="container">
            <div class="optical-breadcrumb__inner">
                <span class="optical-breadcrumb__eyebrow">Order detail</span>
                <h1>Chi tiết đơn hàng</h1>
                <p class="optical-breadcrumb__desc">
                    Theo dõi thông tin giao hàng, thanh toán, sản phẩm và lịch sử trạng thái của đơn hàng.
                </p>
                <nav>
                    <a href="@Url.Action("Index","Home")">Trang chủ</a>
                    <span>/</span>
                    <a href="@Url.Action("Profile","ProfileUser")">Tài khoản</a>
                    <span>/</span>
                    <span>Chi tiết đơn</span>
                </nav>
            </div>
        </div>
    </section>

    <section class="order-detail-section">
        <div class="container">
            <div class="order-detail-header">
                <div>
                    <span class="order-detail-eyebrow">Order #@Model.MaDonHang</span>
                    <h2>Đơn hàng của bạn</h2>
                    <p>Kiểm tra trạng thái đơn hàng, thanh toán và lịch sử xử lý.</p>
                </div>

                <div class="order-detail-status">
                    <span class="status-badge @orderStatusClass(Model.TrangThai)">
                        @OrderStatusConstants.GetName(Model.TrangThai)
                    </span>
                </div>
            </div>

            <div class="order-detail-grid">
                <div class="order-info-card">
                    <h3>Thông tin giao hàng</h3>

                    <div class="order-info-list">
                        <div class="order-info-item">
                            <span>Người nhận</span>
                            <strong>@Model.HoTenNguoiNhan</strong>
                        </div>

                        <div class="order-info-item">
                            <span>Số điện thoại</span>
                            <strong>@Model.SoDienThoaiNguoiNhan</strong>
                        </div>

                        <div class="order-info-item">
                            <span>Địa chỉ</span>
                            <strong>@Model.DiaChiNhanHang</strong>
                        </div>

                        <div class="order-info-item">
                            <span>Email</span>
                            <strong>@(Model.KhachHang != null && !string.IsNullOrWhiteSpace(Model.KhachHang.Email) ? Model.KhachHang.Email : "—")</strong>
                        </div>
                    </div>
                </div>

                <div class="order-info-card">
                    <h3>Thông tin đơn hàng</h3>

                    <div class="order-info-list">
                        <div class="order-info-item">
                            <span>Mã đơn</span>
                            <strong>#@Model.MaDonHang</strong>
                        </div>

                        <div class="order-info-item">
                            <span>Ngày đặt</span>
                            <strong>@Model.NgayDat.ToString("dd/MM/yyyy HH:mm")</strong>
                        </div>

                        <div class="order-info-item">
                            <span>Trạng thái đơn</span>
                            <strong>
                                <span class="status-badge @orderStatusClass(Model.TrangThai)">
                                    @OrderStatusConstants.GetName(Model.TrangThai)
                                </span>
                            </strong>
                        </div>

                        <div class="order-info-item">
                            <span>Ghi chú</span>
                            <strong>@(string.IsNullOrWhiteSpace(Model.GhiChu) ? "Không có ghi chú." : Model.GhiChu)</strong>
                        </div>
                    </div>
                </div>

                <div class="order-info-card">
                    <h3>Thông tin thanh toán</h3>

                    <div class="order-info-list">
                        <div class="order-info-item">
                            <span>Phương thức</span>
                            <strong>@paymentMethodText(Model.PhuongThucThanhToan)</strong>
                        </div>

                        <div class="order-info-item">
                            <span>Trạng thái</span>
                            <strong>
                                <span class="status-badge @paymentStatusClass(Model.TrangThaiThanhToan)">
                                    @paymentStatusText(Model.TrangThaiThanhToan)
                                </span>
                            </strong>
                        </div>

                        <div class="order-info-item">
                            <span>Mã giao dịch</span>
                            <strong>@(string.IsNullOrWhiteSpace(Model.MaGiaoDichThanhToan) ? "—" : Model.MaGiaoDichThanhToan)</strong>
                        </div>

                        <div class="order-info-item">
                            <span>Ngày thanh toán</span>
                            <strong>@(Model.NgayThanhToan.HasValue ? Model.NgayThanhToan.Value.ToString("dd/MM/yyyy HH:mm") : "—")</strong>
                        </div>
                    </div>
                </div>
            </div>

            @if (isCancelledPaidVnPayOrder)
            {
                <div class="order-refund-note">
                    <span class="order-refund-note__icon">
                        <i class="fa fa-info"></i>
                    </span>
                    <div>
                        <strong>Thông tin hoàn tiền:</strong>
                        Đơn hàng đã được hủy sau khi thanh toán qua VNPay. Cửa hàng sẽ kiểm tra giao dịch và xử lý hoàn tiền trong vòng 3–5 ngày làm việc.
                    </div>
                </div>
            }

            <div class="order-products-card">
                <div class="order-products-head">
                    <span class="order-detail-eyebrow">Products</span>
                    <h3>Sản phẩm trong đơn</h3>
                </div>

                @if (details.Any())
                {
                    <div class="order-table-wrap">
                        <table class="order-table-modern">
                            <thead>
                                <tr>
                                    <th>Sản phẩm</th>
                                    <th>Số lượng</th>
                                    <th>Đơn giá</th>
                                    <th>Giảm</th>
                                    <th>Thành tiền</th>
                                    <th>Đánh giá</th>
                                </tr>
                            </thead>

                            <tbody>
                                @foreach (var item in details)
                                {
                                    string imageUrl = item.SanPham != null ? normalizeImage(item.SanPham.HinhAnhChinh) : fallbackImg;
                                    string productCode = item.SanPham != null ? item.SanPham.MaSanPham : item.SanPhamId.ToString();

                                    <tr>
                                        <td>
                                            <div class="order-product">
                                                @{
                                                    string productDetailUrl = item.SanPham != null
                                                        ? Url.Action("DetailProduct", "Product", new { sanPhamId = item.SanPhamId })
                                                        : "javascript:void(0)";
                                                }

                                                <a href="@productDetailUrl" class="order-product__image">
                                                    <img src="@imageUrl"
                                                         alt="@item.TenSanPhamSnapshot"
                                                         onerror="this.onerror=null;this.src='@fallbackImg';" />
                                                </a>

                                                <div class="order-product__info">
                                                    <h4>
                                                        <a href="@productDetailUrl" class="order-product-name-link">
                                                            @item.TenSanPhamSnapshot
                                                        </a>
                                                    </h4>
                                                    <span>Mã SP: @productCode</span>
                                                </div>
                                            </div>
                                        </td>

                                        <td>x @item.SoLuong</td>
                                        <td>@string.Format("{0:N0}", item.DonGiaSnapshot) ₫</td>
                                        <td>@string.Format("{0:N0}", item.GiamGiaSnapshot) ₫</td>

                                        <td class="order-total-line">
                                            @string.Format("{0:N0}", item.ThanhTien) ₫
                                        </td>

                                        <td>
                                            @{
                                                DanhGiaSanPham review = reviewMap.ContainsKey(item.ChiTietDonHangId)
                                                    ? reviewMap[item.ChiTietDonHangId]
                                                    : null;
                                            }

                                            @if (review != null)
                                            {
                                                <span class="status-badge @(review.TrangThai == ReviewStatusConstants.APPROVED ? "success" : (review.TrangThai == ReviewStatusConstants.HIDDEN ? "danger" : "processing"))">
                                                    @ReviewStatusConstants.GetName(review.TrangThai)
                                                </span>

                                                <div style="margin-top:6px;font-size:13px;color:#8d8376;">
                                                    @review.SoSao sao
                                                </div>
                                            }
                                            else if (canReviewOrder)
                                            {
                                                <button type="button"
                                                        class="optical-btn optical-btn--light"
                                                        data-toggle="modal"
                                                        data-target="#reviewModal_@item.ChiTietDonHangId">
                                                    Đánh giá
                                                </button>
                                            }
                                            else
                                            {
                                                <span style="font-size:13px;color:#8d8376;">Chưa thể đánh giá</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <div class="order-mobile-list">
                        @foreach (var item in details)
                        {
                            string imageUrl = item.SanPham != null ? normalizeImage(item.SanPham.HinhAnhChinh) : fallbackImg;
                            string productCode = item.SanPham != null ? item.SanPham.MaSanPham : item.SanPhamId.ToString();

                            <div class="order-mobile-item">
                                @{
                                    string productDetailUrl = item.SanPham != null
                                        ? Url.Action("DetailProduct", "Product", new { sanPhamId = item.SanPhamId })
                                        : "javascript:void(0)";
                                }

                                <div class="order-mobile-product">
                                    <a href="@productDetailUrl" class="order-mobile-product-image-link">
                                        <img src="@imageUrl"
                                             alt="@item.TenSanPhamSnapshot"
                                             onerror="this.onerror=null;this.src='@fallbackImg';" />
                                    </a>

                                    <div>
                                        <h4>
                                            <a href="@productDetailUrl" class="order-product-name-link">
                                                @item.TenSanPhamSnapshot
                                            </a>
                                        </h4>
                                        <p>Mã SP: @productCode</p>
                                    </div>
                                </div>

                                <div class="order-mobile-row">
                                    <span>Số lượng</span>
                                    <strong>x @item.SoLuong</strong>
                                </div>

                                <div class="order-mobile-row">
                                    <span>Đơn giá</span>
                                    <strong>@string.Format("{0:N0}", item.DonGiaSnapshot) ₫</strong>
                                </div>

                                <div class="order-mobile-row">
                                    <span>Giảm</span>
                                    <strong>@string.Format("{0:N0}", item.GiamGiaSnapshot) ₫</strong>
                                </div>

                                <div class="order-mobile-row order-mobile-row--total">
                                    <span>Thành tiền</span>
                                    <strong>@string.Format("{0:N0}", item.ThanhTien) ₫</strong>
                                </div>

                                <div class="order-mobile-row">
                                    <span>Đánh giá</span>
                                    <strong>
                                        @{
                                            DanhGiaSanPham mobileReview = reviewMap.ContainsKey(item.ChiTietDonHangId)
                                                ? reviewMap[item.ChiTietDonHangId]
                                                : null;
                                        }

                                        @if (mobileReview != null)
                                        {
                                            <span class="status-badge @(mobileReview.TrangThai == ReviewStatusConstants.APPROVED ? "success" : (mobileReview.TrangThai == ReviewStatusConstants.HIDDEN ? "danger" : "processing"))">
                                                @ReviewStatusConstants.GetName(mobileReview.TrangThai)
                                            </span>
                                        }
                                        else if (canReviewOrder)
                                        {
                                            <button type="button"
                                                    class="optical-btn optical-btn--light"
                                                    data-toggle="modal"
                                                    data-target="#reviewModal_@item.ChiTietDonHangId">
                                                Đánh giá
                                            </button>
                                        }
                                        else
                                        {
                                            <span>Chưa thể đánh giá</span>
                                        }
                                    </strong>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="order-empty-card">
                        <h3>Không có dữ liệu sản phẩm</h3>
                        <p>Đơn hàng hiện chưa tải được danh sách sản phẩm.</p>
                    </div>
                }
            </div>

            @if (returnRequest != null)
            {
                <div class="order-return-card">
                    <div class="order-return-card-main">
                        <div class="order-return-card-icon">
                            <i class="fa fa-refresh"></i>
                        </div>

                        <div>
                            <span class="order-detail-eyebrow">Return request</span>
                            <h3>Yêu cầu trả hàng</h3>

                            <p>
                                Yêu cầu trả hàng <strong>#@returnRequest.MaYeuCau</strong>
                                đang ở trạng thái
                                <strong>@ReturnRequestStatusConstants.GetName(returnRequest.TrangThai)</strong>.
                            </p>

                            <div class="order-return-card-meta">
                                <span>
                                    <i class="fa fa-calendar"></i>
                                    Ngày yêu cầu: @returnRequest.NgayYeuCau.ToString("dd/MM/yyyy HH:mm")
                                </span>

                                <span>
                                    <i class="fa fa-money"></i>
                                    Dự kiến hoàn: @string.Format("{0:N0}", returnRequest.TongTienHoanDuKien) ₫
                                </span>
                            </div>
                        </div>
                    </div>

                    <div class="order-return-card-side">
                        <span class="status-badge processing">
                            @ReturnRequestStatusConstants.GetName(returnRequest.TrangThai)
                        </span>

                        <a href="@Url.Action("DetailReturnRequest", "ProfileUser", new { maYeuCau = returnRequest.MaYeuCau })"
                           class="optical-btn optical-btn--light order-return-detail-btn">
                            Xem chi tiết trả hàng
                        </a>
                    </div>
                </div>
            }

            @if (details.Any() && canReviewOrder)
            {
                foreach (var item in details)
                {
                    bool hasReview = reviewMap.ContainsKey(item.ChiTietDonHangId);

                    if (!hasReview)
                    {
                        string imageUrl = item.SanPham != null ? normalizeImage(item.SanPham.HinhAnhChinh) : fallbackImg;
                        string productCode = item.SanPham != null ? item.SanPham.MaSanPham : item.SanPhamId.ToString();

                        <div class="modal fade order-review-modal"
                             id="reviewModal_@item.ChiTietDonHangId"
                             tabindex="-1"
                             role="dialog"
                             aria-hidden="true">
                            <div class="modal-dialog modal-dialog-centered" role="document">
                                <div class="modal-content order-review-modal-content">
                                    @using (Html.BeginForm("SubmitProductReview", "ProfileUser", FormMethod.Post, new { autocomplete = "off" }))
                                    {
                                        @Html.AntiForgeryToken()

                                        <input type="hidden" name="maDonHang" value="@Model.MaDonHang" />
                                        <input type="hidden" name="chiTietDonHangId" value="@item.ChiTietDonHangId" />

                                        <div class="modal-header order-review-modal-header">
                                            <div>
                                                <h5 class="modal-title">Đánh giá sản phẩm</h5>
                                                <p>
                                                    Chia sẻ trải nghiệm của bạn để khách hàng khác có thêm thông tin khi chọn sản phẩm.
                                                </p>
                                            </div>

                                            <button type="button" class="close order-review-modal-close" data-dismiss="modal" aria-label="Close">
                                                <span aria-hidden="true">&times;</span>
                                            </button>
                                        </div>

                                        <div class="modal-body">
                                            <div class="order-review-product-box">
                                                <div class="order-review-product-image">
                                                    <img src="@imageUrl"
                                                         alt="@item.TenSanPhamSnapshot"
                                                         onerror="this.onerror=null;this.src='@fallbackImg';" />
                                                </div>

                                                <div class="order-review-product-info">
                                                    <div class="order-review-product-name">
                                                        @item.TenSanPhamSnapshot
                                                    </div>

                                                    <div class="order-review-product-code">
                                                        Mã SP: @productCode
                                                    </div>
                                                </div>
                                            </div>

                                            <div class="form-group order-review-form-group">
                                                <label class="order-review-label">Số sao</label>

                                                <select name="soSao"
                                                        class="form-control order-review-input order-review-native-select"
                                                        required>
                                                    <option value="5">5 sao - Rất hài lòng</option>
                                                    <option value="4">4 sao - Hài lòng</option>
                                                    <option value="3">3 sao - Bình thường</option>
                                                    <option value="2">2 sao - Chưa hài lòng</option>
                                                    <option value="1">1 sao - Không hài lòng</option>
                                                </select>
                                            </div>

                                            <div class="form-group order-review-form-group mb-0">
                                                <label class="order-review-label">Nội dung đánh giá</label>

                                                <textarea name="noiDung"
                                                          class="form-control order-review-textarea"
                                                          rows="4"
                                                          maxlength="1000"
                                                          placeholder="Chia sẻ cảm nhận của bạn về sản phẩm..."></textarea>
                                            </div>
                                        </div>

                                        <div class="modal-footer order-review-modal-footer">
                                            <button type="button" class="optical-btn optical-btn--light" data-dismiss="modal">
                                                Hủy
                                            </button>

                                            <button type="submit" class="optical-btn optical-btn--dark">
                                                Gửi đánh giá
                                            </button>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                }
            }

            <div class="order-summary-card">
                <div class="order-summary-left">
                    <h3>Lịch sử trạng thái</h3>

                    @if (histories.Any())
                    {
                        <div class="order-timeline">
                            @foreach (var history in histories)
                            {
                                <div class="order-timeline__item">
                                    <div class="order-timeline__dot"></div>

                                    <div class="order-timeline__content">
                                        <div class="order-timeline__top">
                                            <strong>@OrderStatusConstants.GetName(history.TrangThaiMoi)</strong>
                                            <span>@history.CreatedAt.ToString("dd/MM/yyyy HH:mm")</span>
                                        </div>

                                        <p>
                                            @(string.IsNullOrWhiteSpace(history.GhiChu) ? "Cập nhật trạng thái đơn hàng." : history.GhiChu)
                                        </p>

                                        @if (history.TaiKhoan != null)
                                        {
                                            <small>Cập nhật bởi: @history.TaiKhoan.HoTen</small>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <p>Chưa có lịch sử trạng thái.</p>
                    }
                </div>

                <div class="order-summary-right">
                    <div class="order-summary-line">
                        <span>Tổng tiền hàng</span>
                        <strong>@string.Format("{0:N0}", tongTienHang) ₫</strong>
                    </div>

                    @if (giamGia > 0)
                    {
                        <div class="order-summary-line">
                            <span>Giảm giá</span>
                            <strong>-@string.Format("{0:N0}", giamGia) ₫</strong>
                        </div>
                    }

                    <div class="order-summary-line">
                        <span>Phí giao hàng</span>
                        <strong>@string.Format("{0:N0}", phiVanChuyen) ₫</strong>
                    </div>

                    <div class="order-summary-line grand">
                        <span>Tổng cộng</span>
                        <strong>@string.Format("{0:N0}", tongThanhToan) ₫</strong>
                    </div>
                </div>
            </div>

            @if (canCancelOrder)
            {
                <div class="order-cancel-card">
                    <div>
                        <h3>Hủy đơn hàng</h3>
                        <p>
                            Bạn có thể hủy đơn khi đơn hàng vẫn đang chờ xác nhận.
                            Sau khi cửa hàng đã xác nhận hoặc chuẩn bị hàng, vui lòng liên hệ cửa hàng để được hỗ trợ.
                        </p>

                        @if (string.Equals(Model.PhuongThucThanhToan, PaymentConstants.VNPAY, StringComparison.OrdinalIgnoreCase)
                            && string.Equals(Model.TrangThaiThanhToan, PaymentConstants.PAID, StringComparison.OrdinalIgnoreCase))
                        {
                            <p class="order-cancel-refund-hint">
                                Lưu ý: Đơn hàng đã thanh toán qua VNPay. Nếu hủy đơn, cửa hàng sẽ kiểm tra và xử lý hoàn tiền trong vòng 3–5 ngày làm việc.
                            </p>
                        }
                    </div>

                    @using (Html.BeginForm("CancelPurchaseOrder", "ProfileUser", FormMethod.Post, new { @class = "order-cancel-form", onsubmit = "return confirm('Bạn chắc chắn muốn hủy đơn hàng này?');" }))
                    {
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="maDonHang" value="@Model.MaDonHang" />

                        <input type="text"
                               name="lyDoHuy"
                               class="order-cancel-input"
                               placeholder="Lý do hủy đơn, có thể bỏ trống" />

                        <button type="submit" class="optical-btn optical-btn--danger">
                            Hủy đơn hàng
                        </button>
                    }
                </div>
            }
            else if (Model.TrangThai != OrderStatusConstants.CANCELLED &&
                     Model.TrangThai != OrderStatusConstants.DELIVERED)
            {
                <div class="order-cancel-card order-cancel-card--disabled">
                    <div>
                        <h3>Không thể hủy đơn hàng</h3>
                        <p>
                            Đơn hàng hiện đang ở trạng thái
                            <strong>@OrderStatusConstants.GetName(Model.TrangThai)</strong>,
                            nên bạn không thể tự hủy trên hệ thống.
                            Nếu cần hỗ trợ, vui lòng liên hệ cửa hàng.
                        </p>
                    </div>

                    <button type="button" class="optical-btn optical-btn--disabled" disabled>
                        Không thể hủy
                    </button>
                </div>
            }

            <div class="order-actions">
                @if (canCreateReturnRequest)
                {
                    <button type="button"
                            class="optical-btn optical-btn--light"
                            data-toggle="modal"
                            data-target="#returnRequestModal">
                        Yêu cầu trả hàng
                    </button>
                }

                <a href="@Url.Action("Profile", "ProfileUser")"
                   class="optical-btn optical-btn--light">
                    Quay lại tài khoản
                </a>

                <a href="@Url.Action("Index","Product")"
                   class="optical-btn optical-btn--dark">
                    Mua thêm sản phẩm
                </a>
            </div>
        </div>
    </section>
    @if (canCreateReturnRequest && details.Any())
    {
        <div class="modal fade order-return-modal"
             id="returnRequestModal"
             tabindex="-1"
             role="dialog"
             aria-hidden="true">

            <div class="modal-dialog modal-dialog-centered modal-lg" role="document">
                <div class="modal-content order-return-modal-content">

                    @using (Html.BeginForm("SubmitReturnRequest", "ProfileUser", FormMethod.Post, new { autocomplete = "off" }))
                    {
                        @Html.AntiForgeryToken()

                        <input type="hidden" name="maDonHang" value="@Model.MaDonHang" />

                        <div class="modal-header order-return-modal-header">
                            <div>
                                <h5 class="modal-title">Yêu cầu trả hàng</h5>
                                <p>
                                    Chọn sản phẩm cần trả và nhập lý do để cửa hàng kiểm tra, xử lý.
                                </p>
                            </div>

                            <button type="button" class="close order-return-modal-close" data-dismiss="modal" aria-label="Close">
                                <span aria-hidden="true">&times;</span>
                            </button>
                        </div>

                        <div class="modal-body">
                            <div class="order-return-form-group">
                                <label>Lý do trả hàng</label>
                                <input type="text"
                                       name="lyDo"
                                       class="form-control order-return-input"
                                       maxlength="500"
                                       required
                                       placeholder="Ví dụ: Sản phẩm không phù hợp, lỗi sản phẩm, giao sai mẫu..." />
                            </div>

                            <div class="order-return-form-group">
                                <label>Ghi chú thêm</label>
                                <textarea name="ghiChuKhachHang"
                                          class="form-control order-return-textarea"
                                          rows="3"
                                          maxlength="1000"
                                          placeholder="Mô tả thêm tình trạng sản phẩm hoặc mong muốn xử lý..."></textarea>
                            </div>

                            <div class="order-return-products">
                                <div class="order-return-products-head">
                                    <strong>Chọn sản phẩm muốn trả</strong>
                                    <span>Có thể chọn một hoặc nhiều sản phẩm trong đơn</span>
                                </div>

                                @foreach (var item in details)
                                {
                                    string imageUrl = item.SanPham != null ? normalizeImage(item.SanPham.HinhAnhChinh) : fallbackImg;
                                    string productCode = item.SanPham != null ? item.SanPham.MaSanPham : item.SanPhamId.ToString();

                                    <div class="order-return-product-item">
                                        <label class="order-return-check">
                                            <input type="checkbox"
                                                   name="selectedDetailIds"
                                                   value="@item.ChiTietDonHangId"
                                                   class="return-product-checkbox" />
                                            <span></span>
                                        </label>

                                        <div class="order-return-product-image">
                                            <img src="@imageUrl"
                                                 alt="@item.TenSanPhamSnapshot"
                                                 onerror="this.onerror=null;this.src='@fallbackImg';" />
                                        </div>

                                        <div class="order-return-product-info">
                                            <h4>@item.TenSanPhamSnapshot</h4>
                                            <p>Mã SP: @productCode</p>
                                            <small>Đã mua: @item.SoLuong</small>
                                        </div>

                                        <div class="order-return-quantity">
                                            <label>Số lượng trả</label>
                                            <input type="number"
                                                   name="soLuongTra"
                                                   class="form-control order-return-qty-input"
                                                   min="1"
                                                   max="@item.SoLuong"
                                                   value="1"
                                                   disabled />
                                        </div>
                                    </div>
                                }
                            </div>

                            <div class="order-return-note">
                                Sau khi gửi yêu cầu, cửa hàng sẽ kiểm tra và phản hồi. Nếu được duyệt, shipper sẽ được phân công lấy hàng trả.
                            </div>
                        </div>

                        <div class="modal-footer order-return-modal-footer">
                            <button type="button" class="optical-btn optical-btn--light" data-dismiss="modal">
                                Hủy
                            </button>

                            <button type="submit" class="optical-btn optical-btn--dark">
                                Gửi yêu cầu
                            </button>
                        </div>
                    }
                </div>
            </div>
        </div>
    }
</section>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var checkboxes = document.querySelectorAll('.return-product-checkbox');

            checkboxes.forEach(function (checkbox) {
                checkbox.addEventListener('change', function () {
                    var item = this.closest('.order-return-product-item');
                    if (!item) return;

                    var qtyInput = item.querySelector('.order-return-qty-input');
                    if (!qtyInput) return;

                    qtyInput.disabled = !this.checked;

                    if (this.checked) {
                        var currentValue = parseInt(qtyInput.value, 10);
                        qtyInput.value = currentValue > 0 ? currentValue : 1;
                    }
                });
            });
        });
    </script>
}