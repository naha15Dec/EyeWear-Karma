@using System
@using System.Linq
@using MatKinh.Models
@model MatKinh.Models.TaiKhoan

@{
    ViewBag.Title = "Thông tin tài khoản";

    List<DonHang> orders = ViewData["listOrderUser"] as List<DonHang> ?? new List<DonHang>();

    int currentPage = ViewBag.Page != null ? (int)ViewBag.Page : 1;
    int totalPages = ViewBag.TotalPages != null ? (int)ViewBag.TotalPages : 1;
    int noOfPages = ViewBag.NoOfPages != null ? (int)ViewBag.NoOfPages : totalPages;
    int displayPage = ViewBag.DisplayPage != null ? (int)ViewBag.DisplayPage : 0;

    int prevPage = currentPage - 1;
    if (prevPage <= 0)
    {
        prevPage = 1;
    }

    int nextPage = currentPage + 1;
    if (nextPage > totalPages)
    {
        nextPage = totalPages;
    }

    string fullName = (Model.HoTen ?? "").Trim();
    if (string.IsNullOrWhiteSpace(fullName))
    {
        fullName = Model.TenDangNhap;
    }

    string[] nameParts = fullName.Split(new[] { ' ' }, StringSplitOptions.RemoveEmptyEntries);
    string firstName = nameParts.Length > 0 ? nameParts[nameParts.Length - 1] : "";
    string lastName = nameParts.Length > 1 ? string.Join(" ", nameParts.Take(nameParts.Length - 1)) : "";

    string avatarText = "U";
    if (!string.IsNullOrWhiteSpace(Model.HoTen))
    {
        avatarText = Model.HoTen.Substring(0, 1).ToUpper();
    }
    else if (!string.IsNullOrWhiteSpace(Model.TenDangNhap))
    {
        avatarText = Model.TenDangNhap.Substring(0, 1).ToUpper();
    }

    Func<int, string> orderStatusText = status =>
    {
        return OrderStatusConstants.GetName(status);
    };

    Func<int, string> orderStatusClass = status =>
    {
        switch (status)
        {
            case OrderStatusConstants.DELIVERED:
                return "success";

            case OrderStatusConstants.CANCELLED:
                return "danger";

            case OrderStatusConstants.DELIVERY_FAILED:
                return "warning";

            case OrderStatusConstants.DELIVERING:
            case OrderStatusConstants.ASSIGNED_TO_SHIPPER:
                return "info";

            default:
                return "processing";
        }
    };

    Func<string, string> paymentMethodText = method =>
    {
        if (string.Equals(method, PaymentConstants.VNPAY, StringComparison.OrdinalIgnoreCase))
        {
            return "VNPay";
        }

        return "COD";
    };

    Func<string, string> paymentStatusText = status =>
    {
        if (string.Equals(status, PaymentConstants.PAID, StringComparison.OrdinalIgnoreCase))
        {
            return "Đã thanh toán";
        }

        if (string.Equals(status, PaymentConstants.FAILED, StringComparison.OrdinalIgnoreCase))
        {
            return "Thanh toán thất bại";
        }

        if (string.Equals(status, PaymentConstants.REFUNDED, StringComparison.OrdinalIgnoreCase))
        {
            return "Đã hoàn tiền";
        }

        return "Chờ thanh toán";
    };

    Func<string, string> paymentStatusClass = status =>
    {
        if (string.Equals(status, PaymentConstants.PAID, StringComparison.OrdinalIgnoreCase))
        {
            return "success";
        }

        if (string.Equals(status, PaymentConstants.FAILED, StringComparison.OrdinalIgnoreCase))
        {
            return "danger";
        }

        if (string.Equals(status, PaymentConstants.REFUNDED, StringComparison.OrdinalIgnoreCase))
        {
            return "warning";
        }

        return "processing";
    };

    int totalOrderCount = orders.Count;
    bool isActiveAccount = Model.IsActive;
}

<section class="profile-page">
    <section class="optical-breadcrumb profile-breadcrumb">
        <div class="container">
            <div class="optical-breadcrumb__inner">
                <span class="optical-breadcrumb__eyebrow">Karma Eyewear Account</span>
                <h1>Thông tin tài khoản</h1>
                <p class="optical-breadcrumb__desc">
                    Quản lý thông tin cá nhân, bảo mật tài khoản và theo dõi lịch sử mua hàng tại Karma Eyewear.
                </p>
                <nav>
                    <a href="@Url.Action("Index", "Home")">Trang chủ</a>
                    <span>/</span>
                    <span>Thông tin tài khoản</span>
                </nav>
            </div>
        </div>
    </section>

    <section class="profile-section">
        <div class="container">
            <div class="profile-shell">
                <div class="profile-top-card">
                    <div class="profile-top-card__avatar">
                        @avatarText
                    </div>

                    <div class="profile-top-card__content">
                        <span class="profile-top-card__eyebrow">Member profile</span>
                        <h2>@fullName</h2>
                        <p>
                            Quản lý thông tin cá nhân, cập nhật mật khẩu và theo dõi lịch sử đơn hàng của bạn tại Karma Eyewear.
                        </p>
                    </div>

                    <div class="profile-top-card__stats">
                        <div class="profile-stat-item">
                            <span>Đơn hàng</span>
                            <strong>@totalOrderCount</strong>
                        </div>
                        <div class="profile-stat-item">
                            <span>Trạng thái</span>
                            <strong>@(isActiveAccount ? "Hoạt động" : "Ngừng")</strong>
                        </div>
                    </div>
                </div>

                <div class="profile-main-card">
                    <ul class="nav nav-pills profile-tabs" role="tablist">
                        <li class="nav-item">
                            <a class="nav-link active" href="#profileInformationAccount" data-toggle="tab">
                                <i class="fa fa-user-o mr-2"></i>Thông tin tài khoản
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="#changePassword" data-toggle="tab">
                                <i class="fa fa-lock mr-2"></i>Đổi mật khẩu
                            </a>
                        </li>
                    </ul>

                    <div class="tab-content profile-tab-content">
                        <div class="tab-pane active" id="profileInformationAccount">
                            <div class="profile-content-grid">
                                <div class="profile-form-card">
                                    <div class="profile-card-head">
                                        <span class="profile-card-head__eyebrow">Account settings</span>
                                        <h3>Thông tin cá nhân</h3>
                                        <p>Cập nhật thông tin liên hệ và địa chỉ giao hàng mặc định của bạn.</p>
                                    </div>

                                    @using (Html.BeginForm("UpdateInformationAccount", "ProfileUser", FormMethod.Post, new { @class = "profile-form" }))
                                    {
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="idAccount" value="@Model.TaiKhoanId" />

                                        <div class="profile-form-grid">
                                            <div class="profile-form-group profile-grid-full">
                                                <label class="profile-label">Tên đăng nhập</label>
                                                <div class="profile-input-wrap">
                                                    <span class="profile-input-icon"><i class="fa fa-user"></i></span>
                                                    <input type="text" class="profile-input profile-input--with-icon profile-input--disabled" value="@Model.TenDangNhap" disabled />
                                                </div>
                                            </div>

                                            <div class="profile-form-group profile-grid-full">
                                                <label class="profile-label">Email</label>
                                                <div class="profile-input-wrap">
                                                    <span class="profile-input-icon"><i class="fa fa-envelope"></i></span>
                                                    <input type="email" class="profile-input profile-input--with-icon profile-input--disabled" value="@Model.Email" disabled />
                                                </div>
                                            </div>

                                            <div class="profile-form-group">
                                                <label class="profile-label">Số điện thoại</label>
                                                <div class="profile-input-wrap">
                                                    <span class="profile-input-icon"><i class="fa fa-phone"></i></span>
                                                    <input type="text" class="profile-input profile-input--with-icon" id="Mobile" name="Mobile" value="@Model.SoDienThoai" />
                                                </div>
                                            </div>

                                            <div class="profile-form-group">
                                                <label class="profile-label">Trạng thái tài khoản</label>
                                                <div class="profile-input-wrap">
                                                    <span class="profile-input-icon"><i class="fa fa-check-circle"></i></span>
                                                    <input type="text"
                                                           class="profile-input profile-input--with-icon profile-input--disabled"
                                                           value="@(Model.IsActive ? "Hoạt động" : "Ngừng hoạt động")"
                                                           disabled />
                                                </div>
                                            </div>

                                            <div class="profile-form-group">
                                                <label class="profile-label">Họ</label>
                                                <div class="profile-input-wrap">
                                                    <span class="profile-input-icon"><i class="fa fa-id-card-o"></i></span>
                                                    <input type="text" class="profile-input profile-input--with-icon" id="LastName" name="LastName" value="@lastName" />
                                                </div>
                                            </div>

                                            <div class="profile-form-group">
                                                <label class="profile-label">Tên</label>
                                                <div class="profile-input-wrap">
                                                    <span class="profile-input-icon"><i class="fa fa-id-card-o"></i></span>
                                                    <input type="text" class="profile-input profile-input--with-icon" id="FirstName" name="FirstName" value="@firstName" />
                                                </div>
                                            </div>

                                            <div class="profile-form-group">
                                                <label class="profile-label">Giới tính</label>
                                                <div class="profile-input-wrap">
                                                    <span class="profile-input-icon"><i class="fa fa-venus-mars"></i></span>
                                                    <select name="Sex" class="profile-input profile-input--with-icon profile-select">
                                                        <option value="">Chọn giới tính</option>
                                                        <option value="Nam" @(Model.GioiTinh == true ? "selected" : "")>Nam</option>
                                                        <option value="Nữ" @(Model.GioiTinh == false ? "selected" : "")>Nữ</option>
                                                    </select>
                                                </div>
                                            </div>

                                            <div class="profile-form-group">
                                                <label class="profile-label">Ngày sinh</label>
                                                <div class="profile-input-wrap">
                                                    <span class="profile-input-icon"><i class="fa fa-calendar"></i></span>
                                                    <input type="text"
                                                           class="profile-input profile-input--with-icon profile-input--disabled"
                                                           value="@(Model.NgaySinh.HasValue ? Model.NgaySinh.Value.ToString("dd/MM/yyyy") : "Chưa cập nhật")"
                                                           disabled />
                                                </div>
                                            </div>

                                            <div class="profile-form-group profile-grid-full">
                                                <label class="profile-label">Địa chỉ</label>
                                                <div class="profile-input-wrap">
                                                    <span class="profile-input-icon"><i class="fa fa-map-marker"></i></span>
                                                    <input type="text" class="profile-input profile-input--with-icon" id="Address" name="Address" value="@Model.DiaChi" />
                                                </div>
                                            </div>
                                        </div>

                                        <div class="profile-form-actions">
                                            <button type="submit" class="optical-btn optical-btn--dark">
                                                Lưu thay đổi
                                            </button>
                                        </div>
                                    }
                                </div>

                                <div class="profile-history-card">
                                    <div class="profile-card-head">
                                        <span class="profile-card-head__eyebrow">Order history</span>
                                        <h3>Lịch sử đơn hàng</h3>
                                        <p>Theo dõi các đơn hàng đã đặt, trạng thái giao hàng và tình trạng thanh toán.</p>
                                    </div>

                                    @if (orders.Any())
                                    {
                                        <div class="profile-order-table-wrap">
                                            <table class="profile-order-table">
                                                <thead>
                                                    <tr>
                                                        <th>Mã đơn hàng</th>
                                                        <th>Ngày đặt</th>
                                                        <th>Tổng thanh toán</th>
                                                        <th>Đơn hàng</th>
                                                        <th>Thanh toán</th>
                                                        <th></th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @foreach (var item in orders)
                                                    {
                                                        <tr>
                                                            <td class="profile-order-money">@item.MaDonHang</td>
                                                            <td>@item.NgayDat.ToString("dd/MM/yyyy HH:mm")</td>
                                                            <td class="profile-order-money">@string.Format("{0:N0}", item.TongThanhToan) ₫</td>
                                                            <td>
                                                                <span class="profile-status-badge @orderStatusClass(item.TrangThai)">
                                                                    @orderStatusText(item.TrangThai)
                                                                </span>
                                                            </td>
                                                            <td>
                                                                <span class="profile-status-badge @paymentStatusClass(item.TrangThaiThanhToan)">
                                                                    @paymentStatusText(item.TrangThaiThanhToan)
                                                                </span>
                                                                <div class="profile-payment-method">
                                                                    @paymentMethodText(item.PhuongThucThanhToan)
                                                                </div>
                                                            </td>
                                                            <td>
                                                                <a href='@Url.Action("DetailPurchaseOrder", "ProfileUser", new { maDonHang = item.MaDonHang })'
                                                                   class="optical-btn optical-btn--light profile-detail-btn">
                                                                    Chi tiết
                                                                </a>
                                                            </td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </div>

                                        <div class="profile-order-mobile">
                                            @foreach (var item in orders)
                                            {
                                                <div class="profile-order-mobile__item">
                                                    <div class="profile-order-mobile__top">
                                                        <h4>@item.MaDonHang</h4>
                                                        <span class="profile-status-badge @orderStatusClass(item.TrangThai)">
                                                            @orderStatusText(item.TrangThai)
                                                        </span>
                                                    </div>

                                                    <div class="profile-mobile-row">
                                                        <span>Ngày đặt</span>
                                                        <strong>@item.NgayDat.ToString("dd/MM/yyyy HH:mm")</strong>
                                                    </div>

                                                    <div class="profile-mobile-row">
                                                        <span>Tổng thanh toán</span>
                                                        <strong>@string.Format("{0:N0}", item.TongThanhToan) ₫</strong>
                                                    </div>

                                                    <div class="profile-mobile-row">
                                                        <span>Phương thức</span>
                                                        <strong>@paymentMethodText(item.PhuongThucThanhToan)</strong>
                                                    </div>

                                                    <div class="profile-mobile-row">
                                                        <span>Thanh toán</span>
                                                        <strong>
                                                            <span class="profile-status-badge @paymentStatusClass(item.TrangThaiThanhToan)">
                                                                @paymentStatusText(item.TrangThaiThanhToan)
                                                            </span>
                                                        </strong>
                                                    </div>

                                                    <a href='@Url.Action("DetailPurchaseOrder", "ProfileUser", new { maDonHang = item.MaDonHang })'
                                                       class="optical-btn optical-btn--light profile-detail-btn">
                                                        Xem chi tiết
                                                    </a>
                                                </div>
                                            }
                                        </div>

                                        if (totalPages > 1)
                                        {
                                            <div class="catalog-pagination bottom">
                                                <a href='@Url.Action("Profile", "ProfileUser", new { page = prevPage })'
                                                   class="page-arrow @(currentPage == 1 ? "disabled" : "")">
                                                    <span class="lnr lnr-chevron-left"></span>
                                                </a>

                                                @for (int i = displayPage; i < noOfPages; i++)
                                                {
                                                    if (i + 1 == currentPage)
                                                    {
                                                        <a href='@Url.Action("Profile", "ProfileUser", new { page = i + 1 })' class="active">@(i + 1)</a>
                                                    }
                                                    else
                                                    {
                                                        <a href='@Url.Action("Profile", "ProfileUser", new { page = i + 1 })'>@(i + 1)</a>
                                                    }
                                                }

                                                <a href='@Url.Action("Profile", "ProfileUser", new { page = nextPage })'
                                                   class="page-arrow @(currentPage == totalPages ? "disabled" : "")">
                                                    <span class="lnr lnr-chevron-right"></span>
                                                </a>
                                            </div>
                                        }
                                    }
                                    else
                                    {
                                        <div class="profile-empty-order">
                                            <div class="profile-empty-order__icon">
                                                <i class="ti-bag"></i>
                                            </div>
                                            <h3>Chưa có đơn hàng nào</h3>
                                            <p>Bạn chưa phát sinh đơn hàng nào trong tài khoản này.</p>
                                            <a href="@Url.Action("Index", "Product")" class="optical-btn optical-btn--dark">
                                                Mua sắm ngay
                                            </a>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>

                        <div class="tab-pane" id="changePassword">
                            <div class="profile-password-card">
                                <div class="profile-card-head">
                                    <span class="profile-card-head__eyebrow">Security</span>
                                    <h3>Đổi mật khẩu</h3>
                                    <p>Mật khẩu mới nên có tối thiểu 8 ký tự và nên kết hợp chữ, số để tăng độ an toàn.</p>
                                </div>

                                @using (Html.BeginForm("ChangePasswordAccount", "ProfileUser", FormMethod.Post, new { @class = "profile-form", onsubmit = "return confirm('Bạn xác nhận đổi mật khẩu?');" }))
                                {
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="idAccount" value="@Model.TaiKhoanId" />

                                    <div class="profile-form-grid">
                                        <div class="profile-form-group profile-grid-full">
                                            <label class="profile-label">Tên đăng nhập</label>
                                            <div class="profile-input-wrap">
                                                <span class="profile-input-icon"><i class="fa fa-user"></i></span>
                                                <input type="text" class="profile-input profile-input--with-icon profile-input--disabled" value="@Model.TenDangNhap" disabled />
                                            </div>
                                        </div>

                                        <div class="profile-form-group profile-grid-full">
                                            <label class="profile-label">Mật khẩu hiện tại</label>
                                            <div class="profile-input-wrap">
                                                <span class="profile-input-icon"><i class="fa fa-lock"></i></span>
                                                <input type="password" class="profile-input profile-input--with-icon" id="inputPassCurrent" name="passwdCurrent" />
                                            </div>
                                        </div>

                                        <div class="profile-form-group">
                                            <label class="profile-label">Mật khẩu mới</label>
                                            <div class="profile-input-wrap">
                                                <span class="profile-input-icon"><i class="fa fa-shield"></i></span>
                                                <input type="password" class="profile-input profile-input--with-icon" id="PassWord" name="PassWord" />
                                            </div>
                                        </div>

                                        <div class="profile-form-group">
                                            <label class="profile-label">Nhập lại mật khẩu mới</label>
                                            <div class="profile-input-wrap">
                                                <span class="profile-input-icon"><i class="fa fa-shield"></i></span>
                                                <input type="password" class="profile-input profile-input--with-icon" id="ComfirmPassword" name="ComfirmPassword" />
                                            </div>
                                        </div>
                                    </div>

                                    <div class="profile-form-actions">
                                        <button type="submit" class="optical-btn optical-btn--dark">
                                            Cập nhật mật khẩu
                                        </button>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</section>