@model List<MatKinh.ViewModel.Cart>
@using System.Globalization
@using MatKinh.ViewModel

@{
    ViewBag.Title = "Giỏ hàng";

    var cart = Model ?? new List<Cart>();
    var vi = CultureInfo.GetCultureInfo("vi-VN");

    decimal totalMoney = cart.Sum(x => x.ThanhTien);
    decimal shippingFee = cart.Any() ? 30000m : 0m;
    decimal grandTotal = totalMoney + shippingFee;

    int totalQuantity = cart.Sum(x => x.SoLuong);

    string fallbackImg = Url.Content("~/Asset/img/no-image.png");

    Func<string, string> normalizeImage = (path) =>
    {
        if (string.IsNullOrWhiteSpace(path))
        {
            return fallbackImg;
        }

        path = path.Trim();

        if (path.StartsWith("http", StringComparison.OrdinalIgnoreCase))
        {
            return path;
        }

        if (path.StartsWith("~/"))
        {
            return Url.Content(path);
        }

        if (path.StartsWith("/"))
        {
            return Url.Content("~" + path);
        }

        return Url.Content("~/" + path);
    };
}

<section class="cart-page">
    <section class="optical-breadcrumb cart-breadcrumb">
        <div class="container">
            <div class="optical-breadcrumb__inner">
                <span class="optical-breadcrumb__eyebrow">Karma Eyewear Cart</span>
                <h1>Giỏ hàng của bạn</h1>
                <p class="optical-breadcrumb__desc">
                    Kiểm tra lại sản phẩm đã chọn, cập nhật số lượng và tiếp tục thanh toán khi bạn đã sẵn sàng.
                </p>
                <nav>
                    <a href="@Url.Action("Index", "Home")">Trang chủ</a>
                    <span>/</span>
                    <span>Giỏ hàng</span>
                </nav>
            </div>
        </div>
    </section>

    <section class="cart-section">
        <div class="container">
            @if (cart.Any())
            {
                <div class="cart-layout">
                    <div class="cart-main-card">
                        <div class="cart-main-head">
                            <div>
                                <span class="cart-main-head__eyebrow">Shopping bag</span>
                                <h2>Sản phẩm đã chọn</h2>
                                <p>Kiểm tra sản phẩm, số lượng và giá trước khi thanh toán.</p>
                            </div>

                            <div class="cart-main-head__count">
                                <i class="fa fa-shopping-bag mr-2"></i>
                                @totalQuantity sản phẩm
                            </div>
                        </div>

                        <div class="cart-table-wrap">
                            <table class="cart-table-modern">
                                <thead>
                                    <tr>
                                        <th>Sản phẩm</th>
                                        <th>Đơn giá</th>
                                        <th>Giảm giá</th>
                                        <th>Số lượng</th>
                                        <th>Thành tiền</th>
                                        <th></th>
                                    </tr>
                                </thead>

                                <tbody>
                                    @foreach (var item in cart)
                                    {
                                        string imageUrl = normalizeImage(item.HinhAnh);

                                        <tr>
                                            <td>
                                                <div class="cart-product">
                                                    <a href="@Url.Action("DetailProduct", "Product", new { sanPhamId = item.SanPhamId })"
                                                       class="cart-product__image">
                                                        <img src="@imageUrl"
                                                             alt="@item.TenSanPham"
                                                             onerror="this.onerror=null;this.src='@fallbackImg';" />
                                                    </a>

                                                    <div class="cart-product__info">
                                                        <h4>
                                                            <a href="@Url.Action("DetailProduct", "Product", new { sanPhamId = item.SanPhamId })">
                                                                @item.TenSanPham
                                                            </a>
                                                        </h4>
                                                        <p>Mã sản phẩm: #@item.SanPhamId</p>
                                                    </div>
                                                </div>
                                            </td>

                                            <td>
                                                <div class="cart-money">
                                                    @item.DonGia.ToString("N0", vi) ₫
                                                </div>
                                            </td>

                                            <td>
                                                <div class="cart-discount">
                                                    @item.GiamGia.ToString("N0", vi) ₫
                                                </div>
                                            </td>

                                            <td>
                                                @using (Html.BeginForm("UpdateQuantityItem", "ShoppingCart", FormMethod.Post, new { @class = "cart-update-form" }))
                                                {
                                                    @Html.AntiForgeryToken()

                                                    <input type="hidden" name="sanPhamId" value="@item.SanPhamId" />

                                                    <div class="cart-quantity-box">
                                                        <input type="number"
                                                               name="soLuong"
                                                               min="1"
                                                               max="10"
                                                               value="@item.SoLuong"
                                                               aria-label="Số lượng @item.TenSanPham"
                                                               onchange="this.form.submit();" />
                                                    </div>
                                                }
                                            </td>

                                            <td>
                                                <div class="cart-total-line">
                                                    @item.ThanhTien.ToString("N0", vi) ₫
                                                </div>
                                            </td>

                                            <td class="cart-remove-cell">
                                                @using (Html.BeginForm("RemoveItem", "ShoppingCart", FormMethod.Post, new { @class = "cart-remove-form" }))
                                                {
                                                    @Html.AntiForgeryToken()

                                                    <input type="hidden" name="sanPhamId" value="@item.SanPhamId" />

                                                    <button type="submit"
                                                            class="cart-remove-btn"
                                                            title="Xóa sản phẩm"
                                                            onclick="return confirm('Bạn có chắc muốn xóa sản phẩm này khỏi giỏ hàng?');">
                                                        <i class="fa fa-trash"></i>
                                                    </button>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <div class="cart-mobile-list">
                            @foreach (var item in cart)
                            {
                                string imageUrl = normalizeImage(item.HinhAnh);

                                <div class="cart-mobile-item">
                                    <div class="cart-mobile-item__top">
                                        <a href="@Url.Action("DetailProduct", "Product", new { sanPhamId = item.SanPhamId })"
                                           class="cart-product__image">
                                            <img src="@imageUrl"
                                                 alt="@item.TenSanPham"
                                                 onerror="this.onerror=null;this.src='@fallbackImg';" />
                                        </a>

                                        <div class="cart-mobile-item__info">
                                            <h4>
                                                <a href="@Url.Action("DetailProduct", "Product", new { sanPhamId = item.SanPhamId })">
                                                    @item.TenSanPham
                                                </a>
                                            </h4>

                                            <p>Mã sản phẩm: #@item.SanPhamId</p>

                                            <div class="cart-mobile-price-grid">
                                                <div>
                                                    <span>Đơn giá</span>
                                                    <strong>@item.DonGia.ToString("N0", vi) ₫</strong>
                                                </div>

                                                <div>
                                                    <span>Giảm giá</span>
                                                    <strong>@item.GiamGia.ToString("N0", vi) ₫</strong>
                                                </div>
                                            </div>

                                            <div class="cart-total-line">
                                                @item.ThanhTien.ToString("N0", vi) ₫
                                            </div>
                                        </div>
                                    </div>

                                    <div class="cart-mobile-item__bottom">
                                        @using (Html.BeginForm("UpdateQuantityItem", "ShoppingCart", FormMethod.Post, new { @class = "cart-update-form" }))
                                        {
                                            @Html.AntiForgeryToken()

                                            <input type="hidden" name="sanPhamId" value="@item.SanPhamId" />

                                            <div class="cart-quantity-field">
                                                <span>Số lượng</span>
                                                <div class="cart-quantity-box">
                                                    <input type="number"
                                                           name="soLuong"
                                                           min="1"
                                                           max="10"
                                                           value="@item.SoLuong"
                                                           aria-label="Số lượng @item.TenSanPham"
                                                           onchange="this.form.submit();" />
                                                </div>
                                            </div>
                                        }

                                        @using (Html.BeginForm("RemoveItem", "ShoppingCart", FormMethod.Post, new { @class = "cart-remove-form" }))
                                        {
                                            @Html.AntiForgeryToken()

                                            <input type="hidden" name="sanPhamId" value="@item.SanPhamId" />

                                            <button type="submit"
                                                    class="cart-remove-btn"
                                                    title="Xóa sản phẩm"
                                                    onclick="return confirm('Bạn có chắc muốn xóa sản phẩm này khỏi giỏ hàng?');">
                                                <i class="fa fa-trash mr-2"></i>
                                                Xóa
                                            </button>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    </div>

                    <aside class="cart-summary-card">
                        <span class="cart-summary-card__eyebrow">Order summary</span>
                        <h3>Tóm tắt đơn hàng</h3>

                        <div class="cart-summary-line">
                            <span>Số sản phẩm</span>
                            <strong>@totalQuantity</strong>
                        </div>

                        <div class="cart-summary-line">
                            <span>Tạm tính</span>
                            <strong>@totalMoney.ToString("N0", vi) ₫</strong>
                        </div>

                        <div class="cart-summary-line">
                            <span>Phí vận chuyển dự kiến</span>
                            <strong>@shippingFee.ToString("N0", vi) ₫</strong>
                        </div>

                        <div class="cart-summary-total">
                            <span>Tổng dự kiến</span>
                            <strong>@grandTotal.ToString("N0", vi) ₫</strong>
                        </div>

                        <div class="cart-summary-note">
                            <i class="fa fa-info-circle"></i>
                            <span>
                                Phí vận chuyển hiện được tạm tính theo mức mặc định 30.000đ và sẽ được xác nhận lại ở bước thanh toán.
                            </span>
                        </div>

                        <div class="cart-summary-benefits">
                            <span><i class="fa fa-shield"></i> Thanh toán an toàn</span>
                            <span><i class="fa fa-truck"></i> Giao hàng toàn quốc</span>
                            <span><i class="fa fa-refresh"></i> Hỗ trợ sau mua</span>
                        </div>

                        <div class="cart-summary-actions">
                            <a class="optical-btn optical-btn--dark cart-btn-full" href="@Url.Action("Index", "Checkout")">
                                Tiếp tục thanh toán
                            </a>

                            <a class="optical-btn optical-btn--light cart-btn-full" href="@Url.Action("Index", "Product")">
                                Tiếp tục mua sắm
                            </a>

                            @using (Html.BeginForm("ClearCart", "ShoppingCart", FormMethod.Post, new { @class = "cart-clear-form" }))
                            {
                                @Html.AntiForgeryToken()

                                <button type="submit"
                                        class="optical-btn cart-btn-full cart-clear-btn"
                                        onclick="return confirm('Bạn có chắc muốn xóa toàn bộ giỏ hàng?');">
                                    Xóa toàn bộ giỏ hàng
                                </button>
                            }
                        </div>
                    </aside>
                </div>
            }
            else
            {
                <div class="cart-empty-card">
                    <div class="cart-empty-icon">
                        <i class="ti-bag"></i>
                    </div>

                    <h3>Giỏ hàng của bạn đang trống</h3>

                    <p>
                        Hãy khám phá thêm các mẫu mắt kính thời trang để bắt đầu đơn hàng của bạn.
                    </p>

                    <a class="optical-btn optical-btn--dark" href="@Url.Action("Index", "Product")">
                        Mua sắm ngay
                    </a>
                </div>
            }
        </div>
    </section>
</section>